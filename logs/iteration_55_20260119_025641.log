{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fpqb8Jh6LAnh6tFUpYPsHP","type":"tool_result","content":"     1→\"\"\"\n     2→Configuration for the agent architecture.\n     3→\n     4→Provides per-agent configuration (model selection, parameters) and\n     5→orchestrator-level settings (quality gates, parallel execution).\n     6→\"\"\"\n     7→\n     8→from dataclasses import dataclass, field\n     9→from typing import Optional, Union\n    10→import os\n    11→\n    12→\n    13→@dataclass\n    14→class AgentConfig:\n    15→    \"\"\"\n    16→    Configuration for a specific agent.\n    17→\n    18→    Each agent can have its own model, temperature, and behavior settings.\n    19→    This allows optimizing each agent for its specific task.\n    20→    \"\"\"\n    21→    # Model selection\n    22→    model: Optional[str] = None  # None = use orchestrator default\n    23→    provider: str = \"ollama\"\n    24→    base_url: str = \"http://localhost:11434\"\n    25→    api_key: Optional[str] = None\n    26→\n    27→    # Model parameters\n    28→    temperature: float = 0.3\n    29→    max_tokens: int = 4096\n    30→    context_length: int = 32768  # Context window size (num_ctx for Ollama)\n    31→\n    32→    # Behavior\n    33→    enable_verification: bool = True\n    34→    max_refinement_passes: int = 3\n    35→    retry_on_low_confidence: bool = True\n    36→\n    37→    # Quality thresholds\n    38→    min_acceptable_confidence: float = 0.4\n    39→    target_high_confidence_ratio: float = 0.8  # Target 80% high confidence\n    40→\n    41→    # Reasoning control (for Qwen3, GPT-OSS, Nemotron)\n    42→    think_mode: Optional[Union[bool, str]] = False  # False, True, \"low\", \"medium\", \"high\"\n    43→    system_prompt: Optional[str] = None  # Agent-specific system prompt override\n    44→\n    45→    def get_api_key(self) -> Optional[str]:\n    46→        \"\"\"Get API key from config or environment.\"\"\"\n    47→        if self.api_key:\n    48→            return self.api_key\n    49→        if self.provider == \"openai\":\n    50→            return os.environ.get(\"OPENAI_API_KEY\")\n    51→        if self.provider == \"anthropic\":\n    52→            return os.environ.get(\"ANTHROPIC_API_KEY\")\n    53→        return None\n    54→\n    55→\n    56→@dataclass\n    57→class PipelineTuningConfig:\n    58→    \"\"\"\n    59→    User-tunable knobs for chunking and local context windows.\n    60→\n    61→    These are deliberately independent of model context length: the goal is to let\n    62→    users empirically find a \"sweet spot\" for speed vs quality on their hardware/model.\n    63→    \"\"\"\n    64→    # Chapter detection (LLM proposers) - character counts\n    65→    chapter_marker_chunk_chars: int = 15000\n    66→    chapter_marker_chunk_overlap_chars: int = 1000\n    67→    chapter_narrative_chunk_chars: int = 20000\n    68→    chapter_narrative_chunk_overlap_chars: int = 2000\n    69→\n    70→    # Character extraction - LLM chunk size and mention context window (characters)\n    71→    character_llm_chunk_chars: int = 8000\n    72→    character_mention_context_chars: int = 250  # Increased from 200 to 250 to capture death scenes where both entities appear (e.g., \"fell prostrate in death the Prince Prospero... seizing the mummer\" = 221 chars)\n    73→\n    74→    # Chapter summaries - chunk sizes in words\n    75→    summary_chunk_words: int = 2500\n    76→    summary_chunk_overlap_words: int = 200\n    77→\n    78→\n    79→@dataclass\n    80→class OrchestratorConfig:\n    81→    \"\"\"\n    82→    Configuration for the agent orchestrator.\n    83→\n    84→    Controls global behavior like parallel execution, quality gates,\n    85→    and default model settings.\n    86→    \"\"\"\n    87→    # Default model (used when agent doesn't specify one)\n    88→    default_model: str = \"llama3.2\"\n    89→    default_provider: str = \"ollama\"\n    90→    default_base_url: str = \"http://localhost:11434\"\n    91→    context_length: int = 32768  # Default context window size\n    92→\n    93→    # Per-agent configs (keyed by agent name)\n    94→    agent_configs: dict[str, AgentConfig] = field(default_factory=dict)\n    95→\n    96→    # Experimental tuning knobs (chunk sizes, context windows)\n    97→    tuning: PipelineTuningConfig = field(default_factory=PipelineTuningConfig)\n    98→\n    99→    # Execution settings\n   100→    parallel_execution: bool = False  # Enable parallel agent execution\n   101→    max_parallel_workers: int = 4  # Max threads for parallel execution\n   102→    parallel_chapter_summaries: bool = True  # Parallelize per-chapter summaries\n   103→    checkpoint_between_agents: bool = True\n   104→\n   105→    # Quality gates\n   106→    enable_quality_gates: bool = True\n   107→    quality_gate_threshold: float = 0.7  # Min quality score to proceed\n   108→    max_quality_gate_retries: int = 2\n   109→\n   110→    # Logging\n   111→    verbose: bool = False\n   112→\n   113→    def get_agent_config(self, agent_name: str) -> AgentConfig:\n   114→        \"\"\"\n   115→        Get configuration for a specific agent.\n   116→\n   117→        Returns the agent-specific config if defined, otherwise\n   118→        returns a default config using orchestrator defaults.\n   119→        \"\"\"\n   120→        if agent_name in self.agent_configs:\n   121→            return self.agent_configs[agent_name]\n   122→\n   123→        # Return default config\n   124→        return AgentConfig(\n   125→            model=self.default_model,\n   126→            provider=self.default_provider,\n   127→            base_url=self.default_base_url,\n   128→        )\n   129→\n   130→    def set_agent_config(self, agent_name: str, config: AgentConfig) -> None:\n   131→        \"\"\"Set configuration for a specific agent.\"\"\"\n   132→        self.agent_configs[agent_name] = config\n   133→\n   134→    @classmethod\n   135→    def from_env(cls) -> \"OrchestratorConfig\":\n   136→        \"\"\"\n   137→        Create configuration from environment variables.\n   138→\n   139→        Environment variables:\n   140→        - AUDIOBOOK_LLM_MODEL: Default model name\n   141→        - AUDIOBOOK_LLM_PROVIDER: Provider (ollama, openai, anthropic)\n   142→        - AUDIOBOOK_LLM_BASE_URL: Base URL for Ollama\n   143→        - AUDIOBOOK_PARALLEL: Enable parallel execution (true/false)\n   144→        - AUDIOBOOK_VERBOSE: Verbose logging (true/false)\n   145→        \"\"\"\n   146→        return cls(\n   147→            default_model=os.environ.get(\"AUDIOBOOK_LLM_MODEL\", \"llama3.2\"),\n   148→            default_provider=os.environ.get(\"AUDIOBOOK_LLM_PROVIDER\", \"ollama\"),\n   149→            default_base_url=os.environ.get(\"AUDIOBOOK_LLM_BASE_URL\", \"http://localhost:11434\"),\n   150→            parallel_execution=os.environ.get(\"AUDIOBOOK_PARALLEL\", \"\").lower() == \"true\",\n   151→            max_parallel_workers=int(os.environ.get(\"AUDIOBOOK_PARALLEL_WORKERS\", \"4\")),\n   152→            parallel_chapter_summaries=os.environ.get(\"AUDIOBOOK_PARALLEL_SUMMARIES\", \"true\").lower() != \"false\",\n   153→            verbose=os.environ.get(\"AUDIOBOOK_VERBOSE\", \"\").lower() == \"true\",\n   154→        )\n   155→\n   156→\n   157→# Recommended model configurations for different agents\n   158→# These are suggestions based on model characteristics\n   159→# Models are listed in preference order - first available will be used\n   160→#\n   161→# NOTE: We favor qwen2.5 and llama3 over qwen3 because:\n   162→# - qwen3 variants may use \"reasoning mode\" which outputs <think> tags\n   163→# - Reasoning models may use training knowledge instead of analyzing provided text\n   164→# - This causes unreliable results, especially for famous novels\n   165→RECOMMENDED_AGENT_MODELS = {\n   166→    \"structure\": {\n   167→        \"description\": \"Fast model for pattern recognition and chapter detection\",\n   168→        \"models\": [\"qwen2.5:14b\", \"qwen2.5:7b\", \"llama3.2\", \"mistral\", \"gpt-oss:20b\"],\n   169→        \"temperature\": 0.2,  # Low for consistency\n   170→        \"think_mode\": False,  # Disable reasoning for speed\n   171→        \"system_prompt\": \"You are a document structure analyzer. Extract chapter boundaries and titles from text. Return ONLY valid JSON. No commentary or explanation.\",\n   172→    },\n   173→    \"characters\": {\n   174→        \"description\": \"Deep narrative model for character understanding\",\n   175→        \"models\": [\"qwen2.5:32b\", \"qwen2.5:72b\", \"llama3.1:70b\", \"llama3.3:70b\", \"gpt-oss:120b\"],\n   176→        \"temperature\": 0.3,\n   177→        \"think_mode\": False,  # JSON extraction doesn't benefit from reasoning chains\n   178→        \"system_prompt\": \"You are a literary analyst extracting character information for audiobook narration. Identify characters, aliases, and relationships. Return ONLY valid JSON with no additional text.\",\n   179→    },\n   180→    \"summaries\": {\n   181→        \"description\": \"Narrative-focused model for story comprehension\",\n   182→        \"models\": [\"qwen2.5:32b\", \"qwen2.5:72b\", \"llama3.1:70b\", \"llama3.3:70b\", \"llama3.2\"],\n   183→        \"temperature\": 0.4,  # Slightly higher for natural language\n   184→        \"think_mode\": False,  # Summaries should be direct\n   185→        \"system_prompt\": \"You are a literary analyst creating chapter summaries for audiobook narration preparation. Your summaries should help a narrator understand plot, tone, and character presence. Return ONLY valid JSON.\",\n   186→    },\n   187→    \"pronunciation\": {\n   188→        \"description\": \"Phonetically-aware model for pronunciation\",\n   189→        \"models\": [\"qwen2.5:14b\", \"qwen2.5:32b\", \"llama3.2\", \"llama3.1:8b\"],\n   190→        \"temperature\": 0.2,  # Low for accuracy\n   191→        \"think_mode\": False,  # Phonetic analysis is pattern-based\n   192→        \"system_prompt\": \"You are a pronunciation expert for audiobook narration. Identify words requiring special pronunciation guidance (names, places, foreign words). Return ONLY valid JSON.\",\n   193→    },\n   194→}\n   195→\n   196→\n   197→def create_optimized_config(\n   198→    available_models: list[str],\n   199→    provider: str = \"ollama\",\n   200→    base_url: str = \"http://localhost:11434\",\n   201→) -> OrchestratorConfig:\n   202→    \"\"\"\n   203→    Create an orchestrator config optimized for available models.\n   204→\n   205→    Attempts to assign the best available model to each agent based on\n   206→    the RECOMMENDED_AGENT_MODELS mapping.\n   207→\n   208→    Args:\n   209→        available_models: List of model names available on the system\n   210→        provider: LLM provider\n   211→        base_url: Base URL for the provider\n   212→\n   213→    Returns:\n   214→        OrchestratorConfig with agent-specific settings\n   215→    \"\"\"\n   216→    config = OrchestratorConfig(\n   217→        default_provider=provider,\n   218→        default_base_url=base_url,\n   219→    )\n   220→\n   221→    # Normalize available models for matching\n   222→    available_set = set(m.lower() for m in available_models)\n   223→\n   224→    for agent_name, recommendations in RECOMMENDED_AGENT_MODELS.items():\n   225→        # Find first available recommended model\n   226→        selected_model = None\n   227→        for model in recommendations[\"models\"]:\n   228→            if model.lower() in available_set:\n   229→                selected_model = model\n   230→                break\n   231→\n   232→        if selected_model:\n   233→            config.set_agent_config(agent_name, AgentConfig(\n   234→                model=selected_model,\n   235→                provider=provider,\n   236→                base_url=base_url,\n   237→                temperature=recommendations.get(\"temperature\", 0.3),\n   238→                think_mode=recommendations.get(\"think_mode\", False),\n   239→                system_prompt=recommendations.get(\"system_prompt\"),\n   240→            ))\n   241→\n   242→    # Set default model (first available from any recommendation, or first available)\n   243→    if available_models:\n   244→        config.default_model = available_models[0]\n   245→\n   246→    return config\n   247→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"510b9767-e567-40b5-bc06-3d57a25e9010","uuid":"64d4e4a7-5603-4895-9cae-e0cb01bc2d90","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/agents/config.py","content":"\"\"\"\nConfiguration for the agent architecture.\n\nProvides per-agent configuration (model selection, parameters) and\norchestrator-level settings (quality gates, parallel execution).\n\"\"\"\n\nfrom dataclasses import dataclass, field\nfrom typing import Optional, Union\nimport os\n\n\n@dataclass\nclass AgentConfig:\n    \"\"\"\n    Configuration for a specific agent.\n\n    Each agent can have its own model, temperature, and behavior settings.\n    This allows optimizing each agent for its specific task.\n    \"\"\"\n    # Model selection\n    model: Optional[str] = None  # None = use orchestrator default\n    provider: str = \"ollama\"\n    base_url: str = \"http://localhost:11434\"\n    api_key: Optional[str] = None\n\n    # Model parameters\n    temperature: float = 0.3\n    max_tokens: int = 4096\n    context_length: int = 32768  # Context window size (num_ctx for Ollama)\n\n    # Behavior\n    enable_verification: bool = True\n    max_refinement_passes: int = 3\n    retry_on_low_confidence: bool = True\n\n    # Quality thresholds\n    min_acceptable_confidence: float = 0.4\n    target_high_confidence_ratio: float = 0.8  # Target 80% high confidence\n\n    # Reasoning control (for Qwen3, GPT-OSS, Nemotron)\n    think_mode: Optional[Union[bool, str]] = False  # False, True, \"low\", \"medium\", \"high\"\n    system_prompt: Optional[str] = None  # Agent-specific system prompt override\n\n    def get_api_key(self) -> Optional[str]:\n        \"\"\"Get API key from config or environment.\"\"\"\n        if self.api_key:\n            return self.api_key\n        if self.provider == \"openai\":\n            return os.environ.get(\"OPENAI_API_KEY\")\n        if self.provider == \"anthropic\":\n            return os.environ.get(\"ANTHROPIC_API_KEY\")\n        return None\n\n\n@dataclass\nclass PipelineTuningConfig:\n    \"\"\"\n    User-tunable knobs for chunking and local context windows.\n\n    These are deliberately independent of model context length: the goal is to let\n    users empirically find a \"sweet spot\" for speed vs quality on their hardware/model.\n    \"\"\"\n    # Chapter detection (LLM proposers) - character counts\n    chapter_marker_chunk_chars: int = 15000\n    chapter_marker_chunk_overlap_chars: int = 1000\n    chapter_narrative_chunk_chars: int = 20000\n    chapter_narrative_chunk_overlap_chars: int = 2000\n\n    # Character extraction - LLM chunk size and mention context window (characters)\n    character_llm_chunk_chars: int = 8000\n    character_mention_context_chars: int = 250  # Increased from 200 to 250 to capture death scenes where both entities appear (e.g., \"fell prostrate in death the Prince Prospero... seizing the mummer\" = 221 chars)\n\n    # Chapter summaries - chunk sizes in words\n    summary_chunk_words: int = 2500\n    summary_chunk_overlap_words: int = 200\n\n\n@dataclass\nclass OrchestratorConfig:\n    \"\"\"\n    Configuration for the agent orchestrator.\n\n    Controls global behavior like parallel execution, quality gates,\n    and default model settings.\n    \"\"\"\n    # Default model (used when agent doesn't specify one)\n    default_model: str = \"llama3.2\"\n    default_provider: str = \"ollama\"\n    default_base_url: str = \"http://localhost:11434\"\n    context_length: int = 32768  # Default context window size\n\n    # Per-agent configs (keyed by agent name)\n    agent_configs: dict[str, AgentConfig] = field(default_factory=dict)\n\n    # Experimental tuning knobs (chunk sizes, context windows)\n    tuning: PipelineTuningConfig = field(default_factory=PipelineTuningConfig)\n\n    # Execution settings\n    parallel_execution: bool = False  # Enable parallel agent execution\n    max_parallel_workers: int = 4  # Max threads for parallel execution\n    parallel_chapter_summaries: bool = True  # Parallelize per-chapter summaries\n    checkpoint_between_agents: bool = True\n\n    # Quality gates\n    enable_quality_gates: bool = True\n    quality_gate_threshold: float = 0.7  # Min quality score to proceed\n    max_quality_gate_retries: int = 2\n\n    # Logging\n    verbose: bool = False\n\n    def get_agent_config(self, agent_name: str) -> AgentConfig:\n        \"\"\"\n        Get configuration for a specific agent.\n\n        Returns the agent-specific config if defined, otherwise\n        returns a default config using orchestrator defaults.\n        \"\"\"\n        if agent_name in self.agent_configs:\n            return self.agent_configs[agent_name]\n\n        # Return default config\n        return AgentConfig(\n            model=self.default_model,\n            provider=self.default_provider,\n            base_url=self.default_base_url,\n        )\n\n    def set_agent_config(self, agent_name: str, config: AgentConfig) -> None:\n        \"\"\"Set configuration for a specific agent.\"\"\"\n        self.agent_configs[agent_name] = config\n\n    @classmethod\n    def from_env(cls) -> \"OrchestratorConfig\":\n        \"\"\"\n        Create configuration from environment variables.\n\n        Environment variables:\n        - AUDIOBOOK_LLM_MODEL: Default model name\n        - AUDIOBOOK_LLM_PROVIDER: Provider (ollama, openai, anthropic)\n        - AUDIOBOOK_LLM_BASE_URL: Base URL for Ollama\n        - AUDIOBOOK_PARALLEL: Enable parallel execution (true/false)\n        - AUDIOBOOK_VERBOSE: Verbose logging (true/false)\n        \"\"\"\n        return cls(\n            default_model=os.environ.get(\"AUDIOBOOK_LLM_MODEL\", \"llama3.2\"),\n            default_provider=os.environ.get(\"AUDIOBOOK_LLM_PROVIDER\", \"ollama\"),\n            default_base_url=os.environ.get(\"AUDIOBOOK_LLM_BASE_URL\", \"http://localhost:11434\"),\n            parallel_execution=os.environ.get(\"AUDIOBOOK_PARALLEL\", \"\").lower() == \"true\",\n            max_parallel_workers=int(os.environ.get(\"AUDIOBOOK_PARALLEL_WORKERS\", \"4\")),\n            parallel_chapter_summaries=os.environ.get(\"AUDIOBOOK_PARALLEL_SUMMARIES\", \"true\").lower() != \"false\",\n            verbose=os.environ.get(\"AUDIOBOOK_VERBOSE\", \"\").lower() == \"true\",\n        )\n\n\n# Recommended model configurations for different agents\n# These are suggestions based on model characteristics\n# Models are listed in preference order - first available will be used\n#\n# NOTE: We favor qwen2.5 and llama3 over qwen3 because:\n# - qwen3 variants may use \"reasoning mode\" which outputs <think> tags\n# - Reasoning models may use training knowledge instead of analyzing provided text\n# - This causes unreliable results, especially for famous novels\nRECOMMENDED_AGENT_MODELS = {\n    \"structure\": {\n        \"description\": \"Fast model for pattern recognition and chapter detection\",\n        \"models\": [\"qwen2.5:14b\", \"qwen2.5:7b\", \"llama3.2\", \"mistral\", \"gpt-oss:20b\"],\n        \"temperature\": 0.2,  # Low for consistency\n        \"think_mode\": False,  # Disable reasoning for speed\n        \"system_prompt\": \"You are a document structure analyzer. Extract chapter boundaries and titles from text. Return ONLY valid JSON. No commentary or explanation.\",\n    },\n    \"characters\": {\n        \"description\": \"Deep narrative model for character understanding\",\n        \"models\": [\"qwen2.5:32b\", \"qwen2.5:72b\", \"llama3.1:70b\", \"llama3.3:70b\", \"gpt-oss:120b\"],\n        \"temperature\": 0.3,\n        \"think_mode\": False,  # JSON extraction doesn't benefit from reasoning chains\n        \"system_prompt\": \"You are a literary analyst extracting character information for audiobook narration. Identify characters, aliases, and relationships. Return ONLY valid JSON with no additional text.\",\n    },\n    \"summaries\": {\n        \"description\": \"Narrative-focused model for story comprehension\",\n        \"models\": [\"qwen2.5:32b\", \"qwen2.5:72b\", \"llama3.1:70b\", \"llama3.3:70b\", \"llama3.2\"],\n        \"temperature\": 0.4,  # Slightly higher for natural language\n        \"think_mode\": False,  # Summaries should be direct\n        \"system_prompt\": \"You are a literary analyst creating chapter summaries for audiobook narration preparation. Your summaries should help a narrator understand plot, tone, and character presence. Return ONLY valid JSON.\",\n    },\n    \"pronunciation\": {\n        \"description\": \"Phonetically-aware model for pronunciation\",\n        \"models\": [\"qwen2.5:14b\", \"qwen2.5:32b\", \"llama3.2\", \"llama3.1:8b\"],\n        \"temperature\": 0.2,  # Low for accuracy\n        \"think_mode\": False,  # Phonetic analysis is pattern-based\n        \"system_prompt\": \"You are a pronunciation expert for audiobook narration. Identify words requiring special pronunciation guidance (names, places, foreign words). Return ONLY valid JSON.\",\n    },\n}\n\n\ndef create_optimized_config(\n    available_models: list[str],\n    provider: str = \"ollama\",\n    base_url: str = \"http://localhost:11434\",\n) -> OrchestratorConfig:\n    \"\"\"\n    Create an orchestrator config optimized for available models.\n\n    Attempts to assign the best available model to each agent based on\n    the RECOMMENDED_AGENT_MODELS mapping.\n\n    Args:\n        available_models: List of model names available on the system\n        provider: LLM provider\n        base_url: Base URL for the provider\n\n    Returns:\n        OrchestratorConfig with agent-specific settings\n    \"\"\"\n    config = OrchestratorConfig(\n        default_provider=provider,\n        default_base_url=base_url,\n    )\n\n    # Normalize available models for matching\n    available_set = set(m.lower() for m in available_models)\n\n    for agent_name, recommendations in RECOMMENDED_AGENT_MODELS.items():\n        # Find first available recommended model\n        selected_model = None\n        for model in recommendations[\"models\"]:\n            if model.lower() in available_set:\n                selected_model = model\n                break\n\n        if selected_model:\n            config.set_agent_config(agent_name, AgentConfig(\n                model=selected_model,\n                provider=provider,\n                base_url=base_url,\n                temperature=recommendations.get(\"temperature\", 0.3),\n                think_mode=recommendations.get(\"think_mode\", False),\n                system_prompt=recommendations.get(\"system_prompt\"),\n            ))\n\n    # Set default model (first available from any recommendation, or first available)\n    if available_models:\n        config.default_model = available_models[0]\n\n    return config\n","numLines":247,"startLine":1,"totalLines":247}}}
