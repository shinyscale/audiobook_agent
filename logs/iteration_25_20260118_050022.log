    'Justine Moritz': ['justine', 'moritz'],\n}\n\nprint(\"\\nExpected major characters and fragmentation status:\\n\")\nfor expected_name, variants in expected.items():\n    matches = []\n    for char in char_list:\n        name = char.get('canonical_name', '').lower()\n        for variant in variants:\n            if variant in name or name in variant:\n                matches.append({\n                    'name': char.get('canonical_name'),\n                    'mentions': char.get('mention_count', 0),\n                    'aliases': char.get('aliases', [])\n                })\n                break\n    \n    if len(matches) == 0:\n        print(f\"✗ {expected_name:<45} MISSING\")\n    elif len(matches) == 1:\n        m = matches[0]\n        alias_info = f\" (aliases: {', '.join(m['aliases'])})\" if m['aliases'] else \"\"\n        print(f\"✓ {expected_name:<45} OK: '{m['name']}' ({m['mentions']} mentions){alias_info}\")\n    else:\n        print(f\"⚠ {expected_name:<45} FRAGMENTED into {len(matches)} entries:\")\n        for m in matches:\n            alias_info = f\" | aliases: {', '.join(m['aliases'])}\" if m['aliases'] else \"\"\n            print(f\"    - '{m['name']}' ({m['mentions']} mentions){alias_info}\")\n\n# Check for problematic entries\nprint(\"\\n\" + \"=\" * 90)\nprint(\"PROBLEMATIC ENTRIES\")\nprint(\"=\" * 90)\n\nproblems = []\nfor char in char_list:\n    name = char.get('canonical_name', '').lower()\n    mentions = char.get('mention_count', 0)\n    \n    if name in ['m.', 'de']:\n        problems.append(f\"  ⚠ Incomplete name: '{char.get('canonical_name')}' ({mentions} mentions)\")\n    elif name in ['my father', 'father', 'my mother', 'mother'] and mentions > 5:\n        problems.append(f\"  ⚠ Relational descriptor: '{char.get('canonical_name')}' ({mentions} mentions)\")\n    elif name in ['old man', 'stranger', 'man'] and mentions > 5:\n        problems.append(f\"  ⚠ Generic descriptor: '{char.get('canonical_name')}' ({mentions} mentions)\")\n\nif problems:\n    for p in problems:\n        print(p)\nelse:\n    print(\"  ✓ No obvious problematic entries found\")\n\nPYEOF\n","description":"Full character analysis with fragmentation check"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":734,"cache_read_input_tokens":60065,"cache_creation":{"ephemeral_5m_input_tokens":734,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"07185c06-f7d4-4b27-99ad-ef3e65820d0e","uuid":"9170ffa9-25a9-44d9-a494-b543344f9b25"}
