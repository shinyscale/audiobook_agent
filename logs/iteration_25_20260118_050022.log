 display: grid;\n   167→            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n   168→            gap: 1rem;\n   169→            margin-bottom: 2rem;\n   170→        }\n   171→\n   172→        .stat-card {\n   173→            background: var(--surface);\n   174→            padding: 1.5rem;\n   175→            border-radius: 8px;\n   176→            text-align: center;\n   177→        }\n   178→\n   179→        .stat-card .value {\n   180→            font-size: 2rem;\n   181→            font-weight: bold;\n   182→            color: var(--accent);\n   183→        }\n   184→\n   185→        .stat-card .label { color: var(--muted); }\n   186→\n   187→        section {\n   188→            background: var(--surface);\n   189→            border-radius: 8px;\n   190→            padding: 1.5rem;\n   191→            margin-bottom: 2rem;\n   192→        }\n   193→\n   194→        section h2 {\n   195→            color: var(--accent);\n   196→            border-bottom: 2px solid var(--primary);\n   197→            padding-bottom: 0.5rem;\n   198→            margin-bottom: 1rem;\n   199→            font-size: 1.5rem;\n   200→        }\n   201→\n   202→        section h3 {\n   203→            color: var(--accent-soft);\n   204→            margin: 1.5rem 0 1rem 0;\n   205→            font-size: 1.2rem;\n   206→        }\n   207→\n   208→        table {\n   209→            width: 100%;\n   210→            border-collapse: collapse;\n   211→        }\n   212→\n   213→        th, td {\n   214→            padding: 0.75rem;\n   215→            text-align: left;\n   216→            border-bottom: 1px solid var(--primary);\n   217→        }\n   218→\n   219→        th { color: var(--accent); font-weight: 600; }\n   220→\n   221→        tr:hover { background: var(--primary); }\n   222→\n   223→        .tag {\n   224→            display: inline-block;\n   225→            padding: 0.25rem 0.5rem;\n   226→            border-radius: 4px;\n   227→            font-size: 0.85rem;\n   228→            background: var(--primary);\n   229→            margin: 0.1rem;\n   230→        }\n   231→\n   232→        .tag.homograph { background: #5a3d7a; }\n   233→        .tag.proper_noun { background: #3d5a7a; }\n   234→        .tag.foreign { background: #7a5a3d; }\n   235→        .tag.unknown { background: #5a5a5a; }\n   236→        .tag.llm_refined { background: var(--success); }\n   237→        .tag.high { background: var(--success); }\n   238→        .tag.medium { background: var(--warning); }\n   239→        .tag.low { background: #5a2727; }\n   240→\n   241→        /* Confidence badges */\n   242→        .confidence-badge {\n   243→            display: inline-block;\n   244→            padding: 0.25rem 0.5rem;\n   245→            border-radius: 50%;\n   246→            font-size: 0.9rem;\n   247→            font-weight: bold;\n   248→            cursor: help;\n   249→            margin-left: 0.5rem;\n   250→        }\n   251→        .confidence-badge.high {\n   252→            background: var(--success);\n   253→            color: #fff;\n   254→        }\n   255→        .confidence-badge.medium {\n   256→            background: var(--warning);\n   257→            color: #333;\n   258→        }\n   259→        .confidence-badge.low {\n   260→            background: #5a2727;\n   261→            color: #fff;\n   262→        }\n   263→\n   264→        .context {\n   265→            font-style: italic;\n   266→            color: var(--muted);\n   267→            font-size: 0.9rem;\n   268→        }\n   269→\n   270→        .aliases { color: var(--muted); font-size: 0.9rem; }\n   271→\n   272→        .description {\n   273→            font-style: italic;\n   274→            color: var(--muted);\n   275→            font-size: 0.9rem;\n   276→            margin-top: 0.25rem;\n   277→        }\n   278→\n   279→        .warning {\n   280→            background: #5a4a27;\n   281→            padding: 0.5rem 1rem;\n   282→            border-radius: 4px;\n 