ts for mentions of the proper name\n  2020→        for ctx in epithet_contexts:\n  2021→            # Check if proper name or its parts appear in this epithet context\n  2022→            has_proper_name = False\n  2023→            if proper_normalized in ctx:\n  2024→                has_proper_name = True\n  2025→            else:\n  2026→                # Check for partial matches (any part of the proper name)\n  2027→                for part in proper_parts:\n  2028→                    if len(part) > 2 and part in ctx:  # Avoid matching very short words\n  2029→                        has_proper_name = True\n  2030→                        break\n  2031→\n  2032→            if has_proper_name:\n  2033→                total_cooccurrence += 1\n  2034→                # Check for confrontation patterns\n  2035→                for pattern in confrontation_patterns:\n  2036→                    if re.search(pattern, ctx, re.IGNORECASE):\n  2037→                        confrontation_count += 1\n  2038→                        logger.info(f\"Confrontation detected between '{epithet_name}' and '{proper_name}': {ctx[:100]}\")\n  2039→                        break  # Count each context only once\n  2040→\n  2041→        # Check proper name contexts for mentions of the epithet\n  2042→        for ctx in proper_contexts:\n  2043→            if epithet_normalized in ctx:\n  2044→                total_cooccurrence += 1\n  2045→                # Check for confrontation patterns\n  2046→                for pattern in confrontation_patterns:\n  2047→                    if re.search(pattern, ctx, re.IGNORECASE):\n  2048→                        confrontation_count += 1\n  2049→                        logger.info(f\"Confrontation detected between '{epithet_name}' and '{proper_name}': {ctx[:100]}\")\n  2050→                        break\n  2051→\n  2052→        # ENHANCED: Also check for confrontation patterns in ANY context, even without direct co-occurrence\n  2053→        # This handle