ls/audiobook_agent/output/masque_of_red_death/analysis.json","content":"{\n  \"metadata\": {\n    \"title\": \"Masque of the Red Death - Poe\",\n    \"author\": \"Edgar Allan Poe\",\n    \"source_file\": \"Test_Texts/Masque of the Red Death - Poe.txt\",\n    \"source_format\": \"txt\",\n    \"total_word_count\": 2449,\n    \"total_character_count\": 13811,\n    \"estimated_total_duration_minutes\": 16.286666666666665,\n    \"words_per_minute\": 150\n  },\n  \"structure\": [\n    {\n      \"type\": \"chapter\",\n      \"title\": null,\n      \"index\": 1,\n      \"start_position\": 28,\n      \"end_position\": 13811,\n      \"word_count\": 2443,\n      \"estimated_duration_minutes\": 16.286666666666665,\n      \"confidence\": \"medium\",\n      \"children\": [],\n      \"characters_present\": [\n        \"Prince Prospero\",\n        \"The masked figure (Red Death)\",\n        \"Courtiers\",\n        \"Musicians\",\n        \"Buffoons\",\n        \"Improvisatori\",\n        \"Ballet-dancers\",\n        \"Beauty\"\n      ],\n      \"summary\": \"The chapter opens with the devastating spread of the 'Red Death,' a gruesome plague marked by bleeding pores and rapid death, prompting Prince Prospero to seal himself and a thousand courtiers within a fortified, elaborately designed abbey to escape the contagion. Inside, seven uniquely colored rooms—each with stained-glass windows matching their decor, except the final black chamber with blood-red panes—host a lavish masked ball, illuminated only by firelight from external tripods. As the night progresses, the ominous ebony clock in the black room chimes hourly, halting the revelry and instilling dread, until a mysterious figure dressed as the Red Death, drenched in blood and wearing a corpse-like mask, appears and walks deliberately through all seven rooms. Enraged, Prince Prospero pursues the figure with a dagger, but when he confronts it in the black chamber, he collapses dead; the courtiers rush in only to discover the mask and robes are empty, revealing the Red Death itself has infiltrated their sanctuary, and one by one, all revelers die as the clock stops and darkness claims the abbey.\"\n    }\n  ],\n  \"characters\": [\n    {\n      \"id\": \"char_the_prince_prospero_d85685e9\",\n      \"canonical_name\": \"the Prince Prospero\",\n      \"aliases\": [\n        \"the mummer\"\n      ],\n      \"role\": null,\n      \"appearance\": null,\n      \"personality\": null,\n      \"voice_guidance\": null,\n      \"descriptions\": [\n        {\n          \"text\": \"Prince Prospero is a bold and robust man who holds authority over a group of revellers in a secluded abbey. He reacts with intense anger and fear when confronted by a masked figure dressed as the Red Death, ultimately pursuing the intruder into a black chamber before being killed. His actions shift from commanding authority to panicked pursuit, ending in his death.\",\n          \"source_position\": 10339,\n          \"chapter_index\": null,\n          \"confidence\": \"llm_refined\"\n        }\n      ],\n      \"relationships\": {},\n      \"evidence\": [\n        {\n          \"statement\": \"Prince Prospero is described as bold and robust\",\n          \"quote\": \"the prince was a bold and robust man\",\n          \"position\": 11148,\n          \"confidence\": \"high\"\n        },\n        {\n          \"statement\": \"He commands the revellers and expresses outrage at the intruder\",\n          \"quote\": \"insult us with this blasphemous mockery? Seize him and unmask him -- that we may know whom we have to hang at sunrise, from the battlements!\",\n          \"position\": 11148,\n          \"confidence\": \"high\"\n        },\n        {\n          \"statement\": \"He pursues the masked figure through multiple chambers\",\n          \"quote\": \"the Prince Prospero, maddening with rage and the shame of his own momentary cowardice, rushed hurriedly through the six chambers\",\n          \"position\": 12389,\n          \"confidence\": \"high\"\n        },\n        {\n          \"statement\": \"He confronts the intruder in the black chamber and is killed\",\n          \"quote\": \"turned suddenly and confronted his pursuer. There was a sharp cry -- and the dagger dropped gleaming upon the sable carpet, upon which, instantly afterwards, fell prostrate in death the Prince Prospero\",\n          \"position\": 12980,\n          \"confidence\": \"high\"\n        },\n        {\n          \"statement\": \"He is killed by the masked figure in the black chamber\",\n          \"quote\": \"fell prostrate in death the Prince Prospero\",\n          \"position\": 13136,\n          \"confidence\": \"high\"\n        }\n      ],\n      \"voice_notes\": null,\n      \"first_appearance_chapter\": 1,\n      \"mention_count\": 6,\n      \"confidence\": \"high\",\n      \"is_narrator\": false,\n      \"narrative_role\": null\n    }\n  ],\n  \"pronunciations\": [\n    {\n      \"word\": \"Prospero\",\n      \"flag_reason\": \"proper_noun\",\n      \"occurrences\": 18,\n      \"first_position\": 631,\n      \"chapter_indices\": [\n        1\n      ],\n      \"context_examples\": [\n        \"...izure, progress and termination of the disease, were the incidents of half an hour. But the Prince Prospero was happy and dauntless and sagacious. When his dominions were half depopulated, he summoned to his...\",\n        \"...sixth month of his seclusion, and while the pestilence raged most furiously abroad, that the Prince Prospero entertained his thousand friends at a masked ball of the most unusual magnificence. It was a volup...\",\n        \"...ith all the features of the face, was besprinkled with the scarlet horror. When the eyes of Prince Prospero fell upon this spectral image (which with a slow and solemn movement, as if more fully to sustain i...\"\n      ],\n      \"confidence\": \"high\",\n      \"ipa\": \"/prɒˈspɪərəʊ/\",\n      \"phonetic_spelling\": \"PROS-per-oh\",\n      \"audio_url\": null,\n     