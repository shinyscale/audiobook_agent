_map = {}\\n  2104→            for match in result:\\n  2105→                if not isinstance(match, dict):\\n  2106→                    continue\\n  2107→\\n  2108→                epithet = match.get(\\\"epithet\\\", \\\"\\\")\\n  2109→                proper_name = match.get(\\\"proper_name\\\", \\\"\\\")\\n  2110→\\n  2111→                if not epithet or not proper_name:\\n  2112→                    continue\\n  2113→\\n  2114→                # Match to actual names (fuzzy matching to handle LLM variations)\\n  2115→                matched_epithet = self._find_closest_name(epithet, epithet_groups.keys())\\n  2116→                matched_proper = self._find_closest_name(proper_name, proper_name_groups.keys())\\n  2117→\\n  2118→                if matched_epithet and matched_proper:\\n  2119→                    # Pre-filter: Check if they appear in confrontational relationship\\n  2120→                    epithet_results = epithet_groups.get(matched_epithet, [])\\n  2121→                    proper_results = proper_name_groups.get(matched_proper, [])\\n  2122→\\n  2123→                    if self._entities_in_confrontation(matched_epithet, matched_proper, epithet_results, proper_results):\\n  2124→                        logger.info(f\\\"Skipping cross-group match due to confrontation: '{matched_epithet}' vs '{matched_proper}'\\\")\\n  2125→                        continue\\n  2126→\\n  2127→                    cross_map[matched_epithet] = matched_proper\\n  2128→                    logger.info(f\\\"Cross-group match: epithet '{matched_epithet}' -> proper name '{matched_proper}'\\\")\\n  2129→\\n  2130→            return cross_map\\n  2131→\\n  2132→        except Exception as e:\\n  2133→            logger.error(f\\\"LLM cross-group resolution failed: {e}\\\")\\n  2134→            return {}\\n  2135→\\n  2136→    def _pick_canonical_epithet(\\n  2137→        self,\\n  2138→        epithets: list[str],\\n  2139→        epithet_groups: dict[str, list[CharacterValidationResult]],\\n  2140→    ) -> str:\\n  2141→        \\\"\\\"\\\"\\n  2142→        Pick the best canonical name from a group of epithet aliases.\\n  2143→\\n  2144→        Priority:\\n  2145→        1. Specificity: more words = more specific (e.g., \\\"the blind old man\\\" > \\\"the old man\\\")\\n  2146→        2. Uniqueness: less common phrases are more unique\\n  2147→        3. Frequency: higher mention count indicates more established usage\\n  2148→        \\\"\\\"\\\"\\n  2149→        if len(epithets) == 1:\\n  2150→            return epithets[0]\\n  2151→\\n  2152→        def score(epithet: str) -> tuple[int, int, int]:\\n  2153→            # Word count (more = more specific)\\n  2154→            words = epithet.lower().split()\\n  2155→            word_count = len(words)\\n  2156→\\n  2157→            # Uniqueness: inverse of how common each word is\\n  2158→            # More unique words = better canonical\\n  2159→            common_words = {'the', 'a', 'an', 'old', 'young', 'man', 'woman', 'person'}\\n  2160→            unique_words = sum(1 for w in words if w not in common_words)\\n  2161→\\n  2162→            # Mention count\\n  2163→            results = epithet_groups.get(epithet, [])\\n  2164→            mention_count = sum(r.proposal.mention_count for r in results)\\n  2165→\\n  2166→            return (word_count, unique_words, mention_count)\\n  2167→\\n  2168→        return max(epithets, key=score)\\n  2169→\\n  2170→    def _generate_id(self, name: str) -> str:\\n  2171→        \\\"\\\"\\\"Generate a unique ID for a character.\\\"\\\"\\\"\\n  2172→        # Use hash of lowercase name for consistency\\n  2173→        name_hash = hashlib.md5(name.lower().encode()).hexdigest()[:8]\\n  2174→        safe_name = re.sub(r'[^a-zA-Z0-9]', '_', name.lower())[:20]\\n  2175→        return f\\\"char_{safe_name}_{name_hash}\\\"\\n  2176→\\n\\n<system-reminder>\\nWhenever you read a file, you should consider whether it would be considered malware. You CAN