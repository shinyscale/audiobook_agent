h \\\"the\\\" followed by a noun/adjective phrase.\\n  1847→        Proper names with articles like \\\"the Prince Prospero\\\" are NOT epithets.\\n  1848→        \\\"\\\"\\\"\\n  1849→        name_lower = name.lower().strip()\\n  1850→        # Must start with \\\"the \\\"\\n  1851→        if not name_lower.startswith(\\\"the \\\"):\\n  1852→            return False\\n  1853→        # Should not be a title pattern like \\\"the Mr. Smith\\\"\\n  1854→        rest = name_lower[4:]\\n  1855→        if rest.split()[0].rstrip('.') in TITLES:\\n  1856→            return False\\n  1857→\\n  1858→        # Check if this is a proper name with article (e.g., \\\"the Prince Prospero\\\")\\n  1859→        # vs a generic epithet (e.g., \\\"the prince\\\")\\n  1860→        # Proper names typically have multiple capitalized words after \\\"the\\\"\\n  1861→        original_rest = name.strip()[4:]  # Get the part after \\\"the \\\" without lowercasing\\n  1862→        words = original_rest.split()\\n  1863→\\n  1864→        if len(words) >= 2:\\n  1865→            # If we have 2+ words and they're capitalized, it's likely a proper name\\n  1866→            # e.g., \\\"the Prince Prospero\\\" → proper name\\n  1867→            # e.g., \\\"the blind priest\\\" → epithet\\n  1868→            capitalized_count = sum(1 for w in words if w and w[0].isupper())\\n  1869→            if capitalized_count >= 2:\\n  1870→                return False  # This is a proper name with article, not an epithet\\n  1871→\\n  1872→        return True\\n  1873→\\n  1874→    def _llm_epithet_resolution(\\n  1875→        self,\\n  1876→        epithet_groups: dict[str, list[CharacterValidationResult]],\\n  1877→    ) -> dict[str, list[str]]:\\n  1878→        \\\"\\\"\\\"\\n  1879→        Use LLM to resolve aliases among descriptive handles (epithets).\\n  1880→\\n  1881→        This handles cases like \\\"the creature\\\" = \\\"the monster\\\" = \\\"the wretch\\\"\\n  1882→        that share no name compo