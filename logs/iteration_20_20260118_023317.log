{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jcuxv2XAjKbddK23Vvpie2","type":"tool_result","content":"   824→    def _candidate_pairs_for_merge(\n   825→        self,\n   826→        name_groups: dict[str, list[CharacterValidationResult]],\n   827→        *,\n   828→        max_pairs: int = 250,\n   829→    ) -> list[tuple[str, str]]:\n   830→        \"\"\"\n   831→        Generate plausible alias candidate pairs using cheap heuristics.\n   832→\n   833→        Goal: avoid O(n^2) on large casts while still capturing obvious merges.\n   834→        \"\"\"\n   835→        names = list(name_groups.keys())\n   836→        if len(names) < 2:\n   837→            return []\n   838→\n   839→        # Token index for significant words (excluding titles)\n   840→        token_to_names: dict[str, list[str]] = defaultdict(list)\n   841→        for name in names:\n   842→            words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n   843→            sig = self._filter_title_words(words)\n   844→            for w in sig:\n   845→                token_to_names[w].append(name)\n   846→\n   847→        # Rank names by mention count for throttling big token buckets\n   848→        mention_rank = {n: self._total_mentions_for_name(n, name_groups) for n in names}\n   849→\n   850→        pairs_set: set[tuple[str, str]] = set()\n   851→\n   852→        def add_pair(a: str, b: str):\n   853→            if a == b:\n   854→                return\n   855→            x, y = (a, b) if a < b else (b, a)\n   856→            pairs_set.add((x, y))\n   857→\n   858→        # Generate within token buckets\n   859→        for token, bucket in token_to_names.items():\n   860→            if len(bucket) < 2:\n   861→                continue\n   862→            # For very common tokens, only consider the top-N by mentions to avoid blowup\n   863→            bucket_sorted = sorted(bucket, key=lambda n: -mention_rank.get(n, 0))\n   864→            cap = 20 if len(bucket_sorted) > 20 else len(bucket_sorted)\n   865→            bucket_sorted = bucket_sorted[:cap]\n   866→\n   867→            for i in range(len(bucket_sorted)):\n   868→                for j in range(i + 1, len(bucket_sorted)):\n   869→                    add_pair(bucket_sorted[i], bucket_sorted[j])\n   870→                    if len(pairs_set) >= max_pairs:\n   871→                        break\n   872→                if len(pairs_set) >= max_pairs:\n   873→                    break\n   874→            if len(pairs_set) >= max_pairs:\n   875→                break\n   876→\n   877→        # Add substring-based candidates (e.g., \"Gatsby\" in \"Jay Gatsby\")\n   878→        if len(pairs_set) < max_pairs:\n   879→            # Only compare top-N by mentions to keep it bounded\n   880→            top = sorted(names, key=lambda n: -mention_rank.get(n, 0))[:80]\n   881→            norm = {n: self._normalize_name(n) for n in top}\n   882→            for i in range(len(top)):\n   883→                for j in range(i + 1, len(top)):\n   884→                    n1, n2 = top[i], top[j]\n   885→                    a, b = norm[n1], norm[n2]\n   886→                    if a and b and (a in b or b in a):\n   887→                        add_pair(n1, n2)\n   888→                        if len(pairs_set) >= max_pairs:\n   889→                            break\n   890→                if len(pairs_set) >= max_pairs:\n   891→                    break\n   892→\n   893→        # Add nickname-based candidates (e.g., \"Kate\" and \"Cathy\", \"Elizabeth\" and \"Lizzy\")\n   894→        # This catches aliases that share no words but are known nickname variants\n   895→        if len(pairs_set) < max_pairs:\n   896→            # Build index of names by their first significant word (likely the first name)\n   897→            # Only consider top characters by mention count to avoid explosion\n   898→            top = sorted(names, key=lambda n: -mention_rank.get(n, 0))[:100]\n   899→\n   900→            # Extract the likely \"first name\" from each name for nickname matching\n   901→            def extract_first_name(name: str) -> str:\n   902→                \"\"\"Extract the first name (excluding titles) for nickname matching.\"\"\"\n   903→                words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n   904→                significant = self._filter_title_words(words)\n   905→                return list(significant)[0] if significant else \"\"\n   906→\n   907→            first_names = {n: extract_first_name(n) for n in top}\n   908→\n   909→            # Group names by their nickname variant sets\n   910→            # Names with overlapping variant sets should be paired\n   911→            for i in range(len(top)):\n   912→                if len(pairs_set) >= max_pairs:\n   913→                    break\n   914→                n1 = top[i]\n   915→                fn1 = first_names[n1]\n   916→                if not fn1:\n   917→                    continue\n   918→\n   919→                for j in range(i + 1, len(top)):\n   920→                    if len(pairs_set) >= max_pairs:\n   921→                        break\n   922→                    n2 = top[j]\n   923→                    fn2 = first_names[n2]\n   924→                    if not fn2:\n   925→                        continue\n   926→\n   927→                    # Check if the first names are potential nickname variants\n   928→                    if are_potential_nicknames(fn1, fn2):\n   929→                        add_pair(n1, n2)\n   930→                        logger.debug(\n   931→                            f\"Nickname match: '{n1}' ({fn1}) <-> '{n2}' ({fn2})\"\n   932→                        )\n   933→\n   934→        return list(pairs_set)\n   935→\n   936→    def _llm_pairwise_merge_decision(\n   937→        self,\n   938→        name_a: str,\n   939→        name_b: str,\n   940→        name_groups: dict[str, list[CharacterValidationResult]],\n   941→    ) -> tuple[bool, float, Optional[str], Optional[str]]:\n   942→        \"\"\"\n   943→        Ask the LLM whether two names should be merged.\n   944→\n   945→        Returns:\n   946→          (same_person, confidence, canonical, alias)\n   947→        \"\"\"\n   948→        results_a = name_groups.get(name_a, [])\n   949→        results_b = name_groups.get(name_b, [])\n   950→\n   951→        # More evidence when ambiguous\n   952→        amb = self._is_ambiguous_name(name_a) or self._is_ambiguous_name(name_b)\n   953→        ctx_a = self._format_contexts(results_a, max_contexts=6 if amb else 4, max_chars=200 if amb else 160)\n   954→        ctx_b = self._format_contexts(results_b, max_contexts=6 if amb else 4, max_chars=200 if amb else 160)\n   955→\n   956→        prompt = PAIRWISE_ALIAS_PROMPT.format(\n   957→            name_a=name_a,\n   958→            mentions_a=self._total_mentions_for_name(name_a, name_groups),\n   959→            chapters_a=self._chapters_for_name(name_a, name_groups, max_chapters=16),\n   960→            contexts_a=ctx_a,\n   961→            name_b=name_b,\n   962→            mentions_b=self._total_mentions_for_name(name_b, name_groups),\n   963→            chapters_b=self._chapters_for_name(name_b, name_groups, max_chapters=16),\n   964→            contexts_b=ctx_b,\n   965→        )\n   966→\n   967→        result, response = self.llm.query_json(prompt, system=PAIRWISE_ALIAS_SYSTEM)\n   968→        if not response.success or result is None or not isinstance(result, dict):\n   969→            raise ValueError(f\"Pairwise alias LLM failed for '{name_a}' vs '{name_b}'\")\n   970→\n   971→        same = bool(result.get(\"same_person\", False))\n   972→        conf = float(result.get(\"confidence\", 0.0) or 0.0)\n   973→        canonical = result.get(\"canonical\")\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bfefdb08-6e29-453e-a2e4-75379a31713f","uuid":"2984fde0-571c-4395-9e19-a95b556b6ea1","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/consensus.py","content":"    def _candidate_pairs_for_merge(\n        self,\n        name_groups: dict[str, list[CharacterValidationResult]],\n        *,\n        max_pairs: int = 250,\n    ) -> list[tuple[str, str]]:\n        \"\"\"\n        Generate plausible alias candidate pairs using cheap heuristics.\n\n        Goal: avoid O(n^2) on large casts while still capturing obvious merges.\n        \"\"\"\n        names = list(name_groups.keys())\n        if len(names) < 2:\n            return []\n\n        # Token index for significant words (excluding titles)\n        token_to_names: dict[str, list[str]] = defaultdict(list)\n        for name in names:\n            words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n            sig = self._filter_title_words(words)\n            for w in sig:\n                token_to_names[w].append(name)\n\n        # Rank names by mention count for throttling big token buckets\n        mention_rank = {n: self._total_mentions_for_name(n, name_groups) for n in names}\n\n        pairs_set: set[tuple[str, str]] = set()\n\n        def add_pair(a: str, b: str):\n            if a == b:\n                return\n            x, y = (a, b) if a < b else (b, a)\n            pairs_set.add((x, y))\n\n        # Generate within token buckets\n        for token, bucket in token_to_names.items():\n            if len(bucket) < 2:\n                continue\n            # For very common tokens, only consider the top-N by mentions to avoid blowup\n            bucket_sorted = sorted(bucket, key=lambda n: -mention_rank.get(n, 0))\n            cap = 20 if len(bucket_sorted) > 20 else len(bucket_sorted)\n            bucket_sorted = bucket_sorted[:cap]\n\n            for i in range(len(bucket_sorted)):\n                for j in range(i + 1, len(bucket_sorted)):\n                    add_pair(bucket_sorted[i], bucket_sorted[j])\n                    if len(pairs_set) >= max_pairs:\n                        break\n                if len(pairs_set) >= max_pairs:\n                    break\n            if len(pairs_set) >= max_pairs:\n                break\n\n        # Add substring-based candidates (e.g., \"Gatsby\" in \"Jay Gatsby\")\n        if len(pairs_set) < max_pairs:\n            # Only compare top-N by mentions to keep it bounded\n            top = sorted(names, key=lambda n: -mention_rank.get(n, 0))[:80]\n            norm = {n: self._normalize_name(n) for n in top}\n            for i in range(len(top)):\n                for j in range(i + 1, len(top)):\n                    n1, n2 = top[i], top[j]\n                    a, b = norm[n1], norm[n2]\n                    if a and b and (a in b or b in a):\n                        add_pair(n1, n2)\n                        if len(pairs_set) >= max_pairs:\n                            break\n                if len(pairs_set) >= max_pairs:\n                    break\n\n        # Add nickname-based candidates (e.g., \"Kate\" and \"Cathy\", \"Elizabeth\" and \"Lizzy\")\n        # This catches aliases that share no words but are known nickname variants\n        if len(pairs_set) < max_pairs:\n            # Build index of names by their first significant word (likely the first name)\n            # Only consider top characters by mention count to avoid explosion\n            top = sorted(names, key=lambda n: -mention_rank.get(n, 0))[:100]\n\n            # Extract the likely \"first name\" from each name for nickname matching\n            def extract_first_name(name: str) -> str:\n                \"\"\"Extract the first name (excluding titles) for nickname matching.\"\"\"\n                words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n                significant = self._filter_title_words(words)\n                return list(significant)[0] if significant else \"\"\n\n            first_names = {n: extract_first_name(n) for n in top}\n\n            # Group names by their nickname variant sets\n            # Names with overlapping variant sets should be paired\n            for i in range(len(top)):\n                if len(pairs_set) >= max_pairs:\n                    break\n                n1 = top[i]\n                fn1 = first_names[n1]\n                if not fn1:\n                    continue\n\n                for j in range(i + 1, len(top)):\n                    if len(pairs_set) >= max_pairs:\n                        break\n                    n2 = top[j]\n                    fn2 = first_names[n2]\n                    if not fn2:\n                        continue\n\n                    # Check if the first names are potential nickname variants\n                    if are_potential_nicknames(fn1, fn2):\n                        add_pair(n1, n2)\n                        logger.debug(\n                            f\"Nickname match: '{n1}' ({fn1}) <-> '{n2}' ({fn2})\"\n                        )\n\n        return list(pairs_set)\n\n    def _llm_pairwise_merge_decision(\n        self,\n        name_a: str,\n        name_b: str,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> tuple[bool, float, Optional[str], Optional[str]]:\n        \"\"\"\n        Ask the LLM whether two names should be merged.\n\n        Returns:\n          (same_person, confidence, canonical, alias)\n        \"\"\"\n        results_a = name_groups.get(name_a, [])\n        results_b = name_groups.get(name_b, [])\n\n        # More evidence when ambiguous\n        amb = self._is_ambiguous_name(name_a) or self._is_ambiguous_name(name_b)\n        ctx_a = self._format_contexts(results_a, max_contexts=6 if amb else 4, max_chars=200 if amb else 160)\n        ctx_b = self._format_contexts(results_b, max_contexts=6 if amb else 4, max_chars=200 if amb else 160)\n\n        prompt = PAIRWISE_ALIAS_PROMPT.format(\n            name_a=name_a,\n            mentions_a=self._total_mentions_for_name(name_a, name_groups),\n            chapters_a=self._chapters_for_name(name_a, name_groups, max_chapters=16),\n            contexts_a=ctx_a,\n            name_b=name_b,\n            mentions_b=self._total_mentions_for_name(name_b, name_groups),\n            chapters_b=self._chapters_for_name(name_b, name_groups, max_chapters=16),\n            contexts_b=ctx_b,\n        )\n\n        result, response = self.llm.query_json(prompt, system=PAIRWISE_ALIAS_SYSTEM)\n        if not response.success or result is None or not isinstance(result, dict):\n            raise ValueError(f\"Pairwise alias LLM failed for '{name_a}' vs '{name_b}'\")\n\n        same = bool(result.get(\"same_person\", False))\n        conf = float(result.get(\"confidence\", 0.0) or 0.0)\n        canonical = result.get(\"canonical\")","numLines":150,"startLine":824,"totalLines":2209}}}
