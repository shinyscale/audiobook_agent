_name(name1)\n   598→        norm2 = self._normalize_name(name2)\n   599→\n   600→        if norm1 == norm2:\n   601→            return True\n   602→\n   603→        parts1 = norm1.split()\n   604→        parts2 = norm2.split()\n   605→\n   606→        # Check if one is FIRST name of the other (safe to match)\n   607→        if len(parts1) == 1 and len(parts2) > 1:\n   608→            # name1 might be first name of name2\n   609→            if parts1[0] == parts2[0]:\n   610→                return True\n   611→            # Note: We NO LONGER match last names here - too risky for family members\n   612→            # The LLM alias resolution with _validate_merge handles this case\n   613→\n   614→        if len(parts2) == 1 and len(parts1) > 1:\n   615→            # name2 might be first name of name1\n   616→            if parts2[0] == parts1[0]:\n   617→                return True\n   618→\n   619→        # Check for titled version (Mr. Smith == Smith) - but be careful\n   620→        # Only match if the title suggests same gender/role\n   621→        if len(parts1) == 1 and len(parts2) == 2:\n   622→            title = parts2[0].rstrip('.').lower()\n   623→            if title in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n   624→                if parts1[0] == parts2[1]:\n   625→                    # This is a last-name match - risky, don't auto-merge\n   626→                    # Let LLM handle it with proper validation\n   627→                    return False\n   628→\n   629→        if len(parts2) == 1 and len(parts1) == 2:\n   630→            title = parts1[0].rstrip('.').lower()\n   631→            if title in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n   632→                if parts2[0] == parts1[1]:\n   633→                    # This is a last-name match - risky, don't auto-merge\n   634→                    return False\n   635→\n   636→        return False\n   637→\n   638→    def _normalize_name(self, name: str) -> str:\n   639→        \"\"\"Normalize a name for comparison.\"\"\"\n   640→        # Remove common titles\n   641→        name = re.sub(\n   642→            r'^(mr|mrs|ms|miss|dr|sir|lady|lord)\\.?\\s+',\n   643→            '',\n   644→            name,\n   645→            flags=re.IGNORECASE\n   646→        )\n   647→        return ' '.join(name.lower().split())\n   648→\n   649→    def _pick_canonical(self, name1: str, name2: str, count1: int = 0, count2: int = 0) -> tuple[str, str]:\n   650→        \"\"\"\n   651→        Pick which name should be canonical vs alias.\n   652→\n   653→        F15: Priority order (mention count is PRIMARY):\n   654→        1. Higher mention count (most frequently used form is canonical)\n   655→        2. Longer names (more complete)\n   656→        3. Untitled over titled\n   657→        4. Alphabetically first (tiebreaker only)\n   658→        \"\"\"\n   659→        # F15: Prefer higher mention count FIRST (most used form is canonical)\n   660→        if count1 != count2:\n   661→            return (name1, name2) if count1 > count2 else (name2, name1)\n   662→\n   663→        # Prefer full names over first names\n   664→        parts1 = name1.split()\n   665→        parts2 = name2.split()\n   666→\n   667→        if len(parts1) > len(parts2):\n   668→            return name1, name2\n   669→        elif len(parts2) > len(parts1):\n   670→            return name2, name1\n   671→\n   672→        # Prefer untitled over titled (Jay Gatsby over Mr. Gatsby)\n   673→        has_title1 = parts1[0].rstrip('.').lower() in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n   674→        has_title2 = parts2[0].rstrip('.').lower() in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n   675→\n   676→        if has_title1 and not has_title2:\n   677→            return name2, name1\n   678→        elif has_title2 and not has_title1:\n   679→            return name1, name2\n   680→\n   681→        # Default: alphabetically first is canonical\n   682→        return (name1, name2) if name1 < name2 else (name2, name1)\n   683→\n   684→    def _is_ambiguous_name(self, name: str) -> bool:\n   685→        \"\"\"\n   686→        Heuristic for names that require more evidence during alias resolution.\n   687→\n   688→        Ambiguous examples:\n   689→        - Single-word names (often last-name-only)\n   690→        - Titled names (Mr./Mrs./Dr. X)\n   691→        \"\"\"\n   692→        words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n   693→        if not words:\n   694→            return True\n   695→        if words[0] in TITLES:\n   696→            return True\n   697→        significant = self._filter_title_words(words)\n   698→        return len(significant) <= 1\n   699→\n   700→    def _iter_all_mentions(self, results: list[CharacterValidationResult]) -> list[CharacterMention]:\n   701→        \"\"\"Collect all mentions from a list of validation results (can be many).\"\"\"\n   702→        mentions: list[CharacterMention] = []\n   703→        for r in results:\n   704→            if r.proposal and r.proposal.mentions:\n   705→                mentions.extend(r.proposal.mentions)\n   706→        return mentions\n   707→\n   708→    def _format_contexts(\n   709→        self,\n   710→        results: list[CharacterValidationResult],\n   711→        *,\n   712→        max_contexts: int,\n   713→        max_chars: int,\n   714→    ) -> str:\n   715→        \"\"\"\n   716→        Format diverse context snippets sampled across early/mid/late mentions.\n   717→\n   718→        Notes:\n   719→        - Mention contexts are already short (~100 chars) upstream; we avoid over-truncating further.\n   720→        - We prefer chapter diversity and narrative spread over \"first 2 mentions\".\n   721→        \"\"\"\n   722→        mentions = self._iter_all_mentions(results)\n   723→        if not mentions:\n   724→            return \"(no context)\"\n   725→\n   726→        # Sort for deterministic sampling across the narrative\n   727→        mentions_sorted = sorted(mentions, key=lambda m: (m.chapter_index, m.position))\n   728→\n   729→        # Seed picks: early / middle / late\n   730→        picks: list[CharacterMention] = []\n   731→        for idx in {0, len(mentions_sorted) // 2, len(mentions_sorted) - 1}:\n   732→            if 0 <= idx < len(mentions_sorted):\n   733→                picks.append(mentions_sorted[idx])\n   734→\n   735→        # Fill with additional mentions from new chapters if needed\n   736→        seen_chapters = {m.chapter_index for m in picks}\n   737→        seen_contexts = {m.context for m in picks if m.context}\n   738→\n   739→        for m in mentions_sorted:\n   740→            if len(picks) >= max_contexts:\n   741→                break\n   742→            if not m.context:\n   743→                continue\n   744→            if m.chapter_index in seen_chapters and m.context in seen_contexts:\n   745→                continue\n   746→            # Prefer new chapters\n   747→            if m.chapter_index not in seen_chapters:\n   748→                picks.append(m)\n   749→                seen_chapters.add(m.chapter_index)\n   750→                seen_contexts.add(m.context)\n   751→\n   752→        # Still short? Add any remaining distinct contexts (even same chapter)\n   753→        if len(picks) < max_contexts:\n   754→            for m in mentions_sorted:\n   755→                if len(picks) >= max_contexts:\n   756→                    break\n   757→                if not m.context or m.context in seen_contexts:\n   758→                    continue\n   759→                picks.append(m)\n   760→                seen_contexts.add(m.context)\n   761→\n   762→        # Render\n   763→        lines = []\n   764→        for i, m in enumerate(picks[:max_contexts], 1):\n   765→            ctx = (m.context or \"\").replace(\"\\n\", \" \").strip()\n   766→            if max_chars > 0 and len(ctx) > max_chars:\n   767→                ctx = ctx[:max_chars].rstrip() + \"...\"\n   768→            dlg = \"dialogue\" if getattr(m, \"in_dialogue\", False) else \"narrative\"\n   769→            lines.append(f\"{i}. [ch {m.chapter_index}, {dlg}] \\\"{ctx}\\\"\")\n   770→        return \"\\n\".join(lines) if lines else \"(no context)\"\n   771→\n   772→    def _total_mentions_for_name(\n   773→        self,\n   774→        name: str,\n   775→        name_groups: dict[str, list[CharacterValidationResult]],\n   776→    ) -> int:\n   777→        results = name_groups.get(name, [])\n   778→        return sum(r.proposal.mention_count for r in results)\n   779→\n   780→    def _chapters_for_name(\n   781→        self,\n   782→        name: str,\n   783→        name_groups: dict[str, list[CharacterValidationResult]],\n   784→        *,\n   785→        max_chapters: int = 12,\n   786→    ) -> str:\n   787→        results = name_groups.get(name, [])\n   788→        chapters = sorted(set(r.proposal.chapter_index for r in results))\n   789→        if not chapters:\n   790→            return \"(none)\"\n   791→        if len(chapters) <= max_chapters:\n   792→            return \", \".join(str(c) for c in chapters)\n   793→        return \", \".join(str(c) for c in chapters[:max_chapters]) + f\"... ({len(chapters)} total)\"\n   794→\n   795→    def _build_alias_prompt_global(\n   796→        self,\n   797→        name_groups: dict[str, list[CharacterValidationResult]],\n   798→    ) -> str:\n   799→        \"\"\"Build the global alias-resolution prompt with richer contexts.\"\"\"\n   800→        char_lines: list[str] = []\n   801→\n   802→        # Sort by total mention count (desc) for more salient characters first.\n   803→        sorted_items = sorted(\n   804→            name_groups.items(),\n   805→            key=lambda x: -sum(r.proposal.mention_count for r in x[1]),\n   806→        )\n   807→\n   808→        for name, results in sorted_items:\n   809→            total_mentions = sum(r.proposal.mention_count for r in results)\n   810→            chapters_str = self._chapters_for_name(name, name_groups, max_chapters=12)\n   811→\n   812→            # More evidence for ambiguous names (last-name-only, titled forms)\n   813→            ambiguous = self._is_ambiguous_name(name)\n   814→            max_ctx = 6 if ambiguous else 4\n   815→            max_chars = 180 if ambiguous else 140\n   816→            context_str = self._format_contexts(results, max_contexts=max_ctx, max_chars=max_chars)\n   817→\n   818→            char_lines.append(f\"- {name} ({total_mentions} mentions, chapters: {chapters_str})\")\n   819→            char_lines.append(f\"  Context:\\n{context_str}\")\n   820→\n   821→        characters_str = \"\\n\".join(char_lines)\n   822→        return ALIAS_RESOLUTION_PROMPT.format(characters=characters_str)\n   823→\n   824→    def _candidate_pairs_for_merge(\n   825→        self,\n   826→        name_groups: dict[str, list[CharacterValidationResult]],\n   827→        *,\n   828→        max_pairs: int = 250,\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bfefdb08-6e29-453e-a2e4-75379a31713f","uuid":"5c05756f-52c1-4d59-b8f1-ab6fdc00868b","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/consensus.py","content":"    def _heuristic_alias_resolution(\n        self,\n        name_groups: dict[str, list[CharacterValidationResult]],\n        all_results: list[CharacterValidationResult],\n    ) -> dict[str, list[str]]:\n        \"\"\"\n        Resolve aliases using heuristics.\n\n        Returns dict mapping canonical name to list of aliases.\n        \"\"\"\n        # Start with each name as its own group\n        alias_map = {name: set() for name in name_groups.keys()}\n\n        # Collect alias candidates from validation\n        alias_candidates = defaultdict(set)\n        for result in all_results:\n            name = result.proposal.name\n            for candidate in result.alias_candidates:\n                alias_candidates[name].add(candidate)\n\n        names = list(name_groups.keys())\n\n        # Find matches based on name components\n        for i, name1 in enumerate(names):\n            for name2 in names[i + 1:]:\n                if self._names_match(name1, name2):\n                    # Merge: keep longer/more complete name as canonical\n                    # Calculate mention counts for both names\n                    count1 = sum(r.proposal.mention_count for r in name_groups[name1])\n                    count2 = sum(r.proposal.mention_count for r in name_groups[name2])\n                    canonical, alias = self._pick_canonical(name1, name2, count1, count2)\n                    if canonical in alias_map:\n                        alias_map[canonical].add(alias)\n                        # Merge alias's aliases\n                        if alias in alias_map:\n                            alias_map[canonical].update(alias_map[alias])\n                            del alias_map[alias]\n\n        # Add validator's alias candidates if they match actual names\n        for name, candidates in alias_candidates.items():\n            if name in alias_map:\n                for candidate in candidates:\n                    # Check if candidate matches any actual name\n                    for actual_name in name_groups.keys():\n                        if actual_name != name and self._names_match(candidate, actual_name):\n                            # Calculate mention counts for both names\n                            count_name = sum(r.proposal.mention_count for r in name_groups[name])\n                            count_actual = sum(r.proposal.mention_count for r in name_groups[actual_name])\n                            canonical, alias = self._pick_canonical(name, actual_name, count_name, count_actual)\n                            if canonical in alias_map and alias in alias_map:\n                                alias_map[canonical].add(alias)\n                                alias_map[canonical].update(alias_map[alias])\n                                del alias_map[alias]\n\n        return {k: list(v) for k, v in alias_map.items()}\n\n    def _names_match(self, name1: str, name2: str) -> bool:\n        \"\"\"\n        Check if two names likely refer to the same person.\n\n        Note: This is a simple heuristic check. For last-name-only matches,\n        the caller should verify there aren't multiple people with that last name.\n        \"\"\"\n        # Exact match (case insensitive)\n        if name1.lower() == name2.lower():\n            return True\n\n        # Normalize: remove titles, lowercase\n        norm1 = self._normalize_name(name1)\n        norm2 = self._normalize_name(name2)\n\n        if norm1 == norm2:\n            return True\n\n        parts1 = norm1.split()\n        parts2 = norm2.split()\n\n        # Check if one is FIRST name of the other (safe to match)\n        if len(parts1) == 1 and len(parts2) > 1:\n            # name1 might be first name of name2\n            if parts1[0] == parts2[0]:\n                return True\n            # Note: We NO LONGER match last names here - too risky for family members\n            # The LLM alias resolution with _validate_merge handles this case\n\n        if len(parts2) == 1 and len(parts1) > 1:\n            # name2 might be first name of name1\n            if parts2[0] == parts1[0]:\n                return True\n\n        # Check for titled version (Mr. Smith == Smith) - but be careful\n        # Only match if the title suggests same gender/role\n        if len(parts1) == 1 and len(parts2) == 2:\n            title = parts2[0].rstrip('.').lower()\n            if title in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n                if parts1[0] == parts2[1]:\n                    # This is a last-name match - risky, don't auto-merge\n                    # Let LLM handle it with proper validation\n                    return False\n\n        if len(parts2) == 1 and len(parts1) == 2:\n            title = parts1[0].rstrip('.').lower()\n            if title in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n                if parts2[0] == parts1[1]:\n                    # This is a last-name match - risky, don't auto-merge\n                    return False\n\n        return False\n\n    def _normalize_name(self, name: str) -> str:\n        \"\"\"Normalize a name for comparison.\"\"\"\n        # Remove common titles\n        name = re.sub(\n            r'^(mr|mrs|ms|miss|dr|sir|lady|lord)\\.?\\s+',\n            '',\n            name,\n            flags=re.IGNORECASE\n        )\n        return ' '.join(name.lower().split())\n\n    def _pick_canonical(self, name1: str, name2: str, count1: int = 0, count2: int = 0) -> tuple[str, str]:\n        \"\"\"\n        Pick which name should be canonical vs alias.\n\n        F15: Priority order (mention count is PRIMARY):\n        1. Higher mention count (most frequently used form is canonical)\n        2. Longer names (more complete)\n        3. Untitled over titled\n        4. Alphabetically first (tiebreaker only)\n        \"\"\"\n        # F15: Prefer higher mention count FIRST (most used form is canonical)\n        if count1 != count2:\n            return (name1, name2) if count1 > count2 else (name2, name1)\n\n        # Prefer full names over first names\n        parts1 = name1.split()\n        parts2 = name2.split()\n\n        if len(parts1) > len(parts2):\n            return name1, name2\n        elif len(parts2) > len(parts1):\n            return name2, name1\n\n        # Prefer untitled over titled (Jay Gatsby over Mr. Gatsby)\n        has_title1 = parts1[0].rstrip('.').lower() in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n        has_title2 = parts2[0].rstrip('.').lower() in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n\n        if has_title1 and not has_title2:\n            return name2, name1\n        elif has_title2 and not has_title1:\n            return name1, name2\n\n        # Default: alphabetically first is canonical\n        return (name1, name2) if name1 < name2 else (name2, name1)\n\n    def _is_ambiguous_name(self, name: str) -> bool:\n        \"\"\"\n        Heuristic for names that require more evidence during alias resolution.\n\n        Ambiguous examples:\n        - Single-word names (often last-name-only)\n        - Titled names (Mr./Mrs./Dr. X)\n        \"\"\"\n        words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n        if not words:\n            return True\n        if words[0] in TITLES:\n            return True\n        significant = self._filter_title_words(words)\n        return len(significant) <= 1\n\n    def _iter_all_mentions(self, results: list[CharacterValidationResult]) -> list[CharacterMention]:\n        \"\"\"Collect all mentions from a list of validation results (can be many).\"\"\"\n        mentions: list[CharacterMention] = []\n        for r in results:\n            if r.proposal and r.proposal.mentions:\n                mentions.extend(r.proposal.mentions)\n        return mentions\n\n    def _format_contexts(\n        self,\n        results: list[CharacterValidationResult],\n        *,\n        max_contexts: int,\n        max_chars: int,\n    ) -> str:\n        \"\"\"\n        Format diverse context snippets sampled across early/mid/late mentions.\n\n        Notes:\n        - Mention contexts are already short (~100 chars) upstream; we avoid over-truncating further.\n        - We prefer chapter diversity and narrative spread over \"first 2 mentions\".\n        \"\"\"\n        mentions = self._iter_all_mentions(results)\n        if not mentions:\n            return \"(no context)\"\n\n        # Sort for deterministic sampling across the narrative\n        mentions_sorted = sorted(mentions, key=lambda m: (m.chapter_index, m.position))\n\n        # Seed picks: early / middle / late\n        picks: list[CharacterMention] = []\n        for idx in {0, len(mentions_sorted) // 2, len(mentions_sorted) - 1}:\n            if 0 <= idx < len(mentions_sorted):\n                picks.append(mentions_sorted[idx])\n\n        # Fill with additional mentions from new chapters if needed\n        seen_chapters = {m.chapter_index for m in picks}\n        seen_contexts = {m.context for m in picks if m.context}\n\n        for m in mentions_sorted:\n            if len(picks) >= max_contexts:\n                break\n            if not m.context:\n                continue\n            if m.chapter_index in seen_chapters and m.context in seen_contexts:\n                continue\n            # Prefer new chapters\n            if m.chapter_index not in seen_chapters:\n                picks.append(m)\n                seen_chapters.add(m.chapter_index)\n                seen_contexts.add(m.context)\n\n        # Still short? Add any remaining distinct contexts (even same chapter)\n        if len(picks) < max_contexts:\n            for m in mentions_sorted:\n                if len(picks) >= max_contexts:\n                    break\n                if not m.context or m.context in seen_contexts:\n                    continue\n                picks.append(m)\n                seen_contexts.add(m.context)\n\n        # Render\n        lines = []\n        for i, m in enumerate(picks[:max_contexts], 1):\n            ctx = (m.context or \"\").replace(\"\\n\", \" \").strip()\n            if max_chars > 0 and len(ctx) > max_chars:\n                ctx = ctx[:max_chars].rstrip() + \"...\"\n            dlg = \"dialogue\" if getattr(m, \"in_dialogue\", False) else \"narrative\"\n            lines.append(f\"{i}. [ch {m.chapter_index}, {dlg}] \\\"{ctx}\\\"\")\n        return \"\\n\".join(lines) if lines else \"(no context)\"\n\n    def _total_mentions_for_name(\n        self,\n        name: str,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> int:\n        results = name_groups.get(name, [])\n        return sum(r.proposal.mention_count for r in results)\n\n    def _chapters_for_name(\n        self,\n        name: str,\n        name_groups: dict[str, list[CharacterValidationResult]],\n        *,\n        max_chapters: int = 12,\n    ) -> str:\n        results = name_groups.get(name, [])\n        chapters = sorted(set(r.proposal.chapter_index for r in results))\n        if not chapters:\n            return \"(none)\"\n        if len(chapters) <= max_chapters:\n            return \", \".join(str(c) for c in chapters)\n        return \", \".join(str(c) for c in chapters[:max_chapters]) + f\"... ({len(chapters)} total)\"\n\n    def _build_alias_prompt_global(\n        self,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> str:\n        \"\"\"Build the global alias-resolution prompt with richer contexts.\"\"\"\n        char_lines: list[str] = []\n\n        # Sort by total mention count (desc) for more salient characters first.\n        sorted_items = sorted(\n            name_groups.items(),\n            key=lambda x: -sum(r.proposal.mention_count for r in x[1]),\n        )\n\n        for name, results in sorted_items:\n            total_mentions = sum(r.proposal.mention_count for r in results)\n            chapters_str = self._chapters_for_name(name, name_groups, max_chapters=12)\n\n            # More evidence for ambiguous names (last-name-only, titled forms)\n            ambiguous = self._is_ambiguous_name(name)\n            max_ctx = 6 if ambiguous else 4\n            max_chars = 180 if ambiguous else 140\n            context_str = self._format_contexts(results, max_contexts=max_ctx, max_chars=max_chars)\n\n            char_lines.append(f\"- {name} ({total_mentions} mentions, chapters: {chapters_str})\")\n            char_lines.append(f\"  Context:\\n{context_str}\")\n\n        characters_str = \"\\n\".join(char_lines)\n        return ALIAS_RESOLUTION_PROMPT.format(characters=characters_str)\n\n    def _candidate_pairs_for_merge(\n        self,\n        name_groups: dict[str, list[CharacterValidationResult]],\n        *,\n        max_pairs: int = 250,","numLines":300,"startLine":529,"totalLines":2209}}}
