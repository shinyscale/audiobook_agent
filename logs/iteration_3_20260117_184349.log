{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QKsnjqV6tUPGiCTznrSpKj","type":"tool_result","content":"     1→\"\"\"\n     2→StructureAgent: Specialized agent for chapter/structure detection.\n     3→\n     4→Wraps the ChapterDetectionPipeline with self-verification to ensure\n     5→high-quality chapter detection regardless of book format.\n     6→\"\"\"\n     7→\n     8→import time\n     9→import logging\n    10→from typing import Optional\n    11→\n    12→from .base import (\n    13→    Agent,\n    14→    AgentContext,\n    15→    AgentResult,\n    16→    VerificationResult,\n    17→    VerificationIssue,\n    18→    VerificationLevel,\n    19→)\n    20→from .config import AgentConfig, PipelineTuningConfig\n    21→from ..pipeline.chapter_detection import ChapterDetectionPipeline, ChapterMap\n    22→from ..pipeline.llm import LLMClient, LLMConfig\n    23→\n    24→logger = logging.getLogger(__name__)\n    25→\n    26→\n    27→# Verification prompts\n    28→SEQUENCE_CHECK_SYSTEM = \"\"\"You are a document structure analyst checking chapter sequences for logical consistency.\n    29→\n    30→Your job is to identify potential issues with a proposed chapter structure.\"\"\"\n    31→\n    32→SEQUENCE_CHECK_PROMPT = \"\"\"Review this chapter structure for a book and identify any issues:\n    33→\n    34→{chapter_summary}\n    35→\n    36→Check for:\n    37→1. Unusual chapter sizes (one chapter much larger/smaller than others)\n    38→2. Missing chapters (gaps in numbering that seem unintentional)\n    39→3. Chapters that might be incorrectly split or merged\n    40→4. Any structural anomalies that seem wrong for a book\n    41→\n    42→Return JSON:\n    43→{{\n    44→  \"issues\": [\n    45→    {{\"description\": \"...\", \"severity\": \"error|warning|info\", \"chapter_index\": null or number}}\n    46→  ],\n    47→  \"overall_assessment\": \"good|acceptable|needs_review\",\n    48→  \"suggestions\": [\"...\"]\n    49→}}\n    50→\n    51→If the structure looks correct, return {{\"issues\": [], \"overall_assessment\": \"good\", \"suggestions\": []}}\n    52→\n    53→Return ONLY valid JSON.\"\"\"\n    54→\n    55→\n    56→class StructureAgent(Agent):\n    57→    \"\"\"\n    58→    Agent for detecting and validating book structure (chapters).\n    59→\n    60→    Wraps ChapterDetectionPipeline with additional self-verification\n    61→    to catch issues the pipeline might miss.\n    62→\n    63→    Verification checks:\n    64→    - Chapter sequence logic (no out-of-order or missing chapters)\n    65→    - Chapter size consistency (flag unusually small/large chapters)\n    66→    - TOC agreement (if TOC exists, chapters should match)\n    67→    - Low-confidence boundary detection\n    68→    \"\"\"\n    69→\n    70→    def __init__(\n    71→        self,\n    72→        llm_client: Optional[LLMClient] = None,\n    73→        config: Optional[AgentConfig] = None,\n    74→        tuning: Optional[PipelineTuningConfig] = None,\n    75→    ):\n    76→        \"\"\"\n    77→        Initialize the StructureAgent.\n    78→\n    79→        Args:\n    80→            llm_client: LLM client for the pipeline and verification\n    81→            config: Agent configuration (model, thresholds, etc.)\n    82→        \"\"\"\n    83→        self._llm_client = llm_client\n    84→        self._config = config or AgentConfig()\n    85→        self._tuning = tuning\n    86→        self._pipeline: Optional[ChapterDetectionPipeline] = None\n    87→\n    88→    @property\n    89→    def name(self) -> str:\n    90→        return \"structure\"\n    91→\n    92→    @property\n    93→    def depends_on(self) -> list[str]:\n    94→        # Structure detection is the first step - no dependencies\n    95→        return []\n    96→\n    97→    @property\n    98→    def recommended_models(self) -> list[str]:\n    99→        return [\"qwen2.5:7b\", \"llama3.2\", \"mistral\"]\n   100→\n   101→    def _get_pipeline(self) -> ChapterDetectionPipeline:\n   102→        \"\"\"Get or create the chapter detection pipeline.\"\"\"\n   103→        if self._pipeline is None:\n   104→            t = self._tuning or PipelineTuningConfig()\n   105→            self._pipeline = ChapterDetectionPipeline(\n   106→                llm_client=self._llm_client,\n   107→                llm_marker_chunk_size=t.chapter_marker_chunk_chars,\n   108→                llm_marker_chunk_overlap=t.chapter_marker_chunk_overlap_chars,\n   109→                llm_narrative_chunk_size=t.chapter_narrative_chunk_chars,\n   110→                llm_narrative_chunk_overlap=t.chapter_narrative_chunk_overlap_chars,\n   111→            )\n   112→        return self._pipeline\n   113→\n   114→    def run(self, context: AgentContext) -> AgentResult[ChapterMap]:\n   115→        \"\"\"\n   116→        Run chapter detection on the document.\n   117→\n   118→        Args:\n   119→            context: Input context with document text\n   120→\n   121→        Returns:\n   122→            AgentResult containing ChapterMap\n   123→        \"\"\"\n   124→        start_time = time.perf_counter()\n   125→\n   126→        pipeline = self._get_pipeline()\n   127→        chapter_map = pipeline.run(\n   128→            text=context.text,\n   129→            source_file=context.source_file,\n   130→        )\n   131→\n   132→        # Calculate confidence breakdown\n   133→        high = sum(1 for c in chapter_map.chapters if c.confidence >= 0.7)\n   134→        medium = sum(1 for c in chapter_map.chapters if 0.4 <= c.confidence < 0.7)\n   135→        low = sum(1 for c in chapter_map.chapters if c.confidence < 0.4)\n   136→\n   137→        # Collect issues\n   138→        issues = []\n   139→        if chapter_map.low_confidence_boundaries:\n   140→            issues.append(\n   141→                f\"{len(chapter_map.low_confidence_boundaries)} low-confidence boundaries flagged\"\n   142→            )\n   143→        if chapter_map.toc_agreement_score >= 0 and chapter_map.toc_agreement_score < 0.8:\n   144→            issues.append(\n   145→                f\"TOC agreement is only {chapter_map.toc_agreement_score:.0%}\"\n   146→            )\n   147→\n   148→        elapsed = time.perf_counter() - start_time\n   149→\n   150→        # Get model info from config or client\n   151→        model_used = None\n   152→        provider_used = None\n   153→        if self._config and self._config.model:\n   154→            model_used = self._config.model\n   155→            provider_used = self._config.provider\n   156→        elif self._llm_client and self._llm_client.config:\n   157→            model_used = self._llm_client.config.model\n   158→            provider_used = self._llm_client.config.provider\n   159→\n   160→        return AgentResult(\n   161→            data=chapter_map,\n   162→            confidence_scores=[c.confidence for c in chapter_map.chapters],\n   163→            high_confidence_count=high,\n   164→            medium_confidence_count=medium,\n   165→            low_confidence_count=low,\n   166→            issues=issues,\n   167→            processing_time_seconds=elapsed,\n   168→            model_used=model_used,\n   169→            provider_used=provider_used,\n   170→        )\n   171→\n   172→    def verify(\n   173→        self,\n   174→        result: AgentResult[ChapterMap],\n   175→        level: VerificationLevel = VerificationLevel.SELF_CHECK,\n   176→        context: Optional[AgentContext] = None,\n   177→    ) -> VerificationResult:\n   178→        \"\"\"\n   179→        Verify the chapter structure for quality issues.\n   180→\n   181→        Checks:\n   182→        1. Low-confidence chapters\n   183→        2. Chapter size consistency\n   184→        3. TOC agreement\n   185→        4. Sequence logic (via LLM if available)\n   186→        \"\"\"\n   187→        issues = []\n   188→        suggestions = []\n   189→        chapter_map = result.data\n   190→\n   191→        # Check 1: Low confidence items\n   192→        if result.low_confidence_count > 0:\n   193→            issues.append(VerificationIssue(\n   194→                description=f\"{result.low_confidence_count} chapters have low confidence\",\n   195→                severity=\"warning\",\n   196→            ))\n   197→\n   198→        # Check 2: Chapter size consistency\n   199→        size_issues = self._check_chapter_sizes(chapter_map)\n   200→        issues.extend(size_issues)\n   201→\n   202→        # Check 3: TOC agreement\n   203→        if chapter_map.toc_agreement_score >= 0:\n   204→            if chapter_map.toc_agreement_score < 0.5:\n   205→                issues.append(VerificationIssue(\n   206→                    description=f\"Poor TOC agreement ({chapter_map.toc_agreement_score:.0%})\",\n   207→                    severity=\"error\",\n   208→                    suggested_fix=\"Review chapter boundaries against table of contents\",\n   209→                ))\n   210→            elif chapter_map.toc_agreement_score < 0.8:\n   211→                issues.append(VerificationIssue(\n   212→                    description=f\"Moderate TOC agreement ({chapter_map.toc_agreement_score:.0%})\",\n   213→                    severity=\"warning\",\n   214→                ))\n   215→\n   216→        # Check 4: Low-confidence boundaries\n   217→        if chapter_map.low_confidence_boundaries:\n   218→            for boundary in chapter_map.low_confidence_boundaries[:3]:  # Report first 3\n   219→                issues.append(VerificationIssue(\n   220→                    description=f\"Low-confidence boundary at position {boundary.position}: {boundary.title or '(untitled)'}\",\n   221→                    severity=\"info\",\n   222→                ))\n   223→\n   224→        # Check 5: LLM sequence verification (if available)\n   225→        if self._llm_client and self._config.enable_verification:\n   226→            llm_issues = self._llm_verify_sequence(chapter_map)\n   227→            issues.extend(llm_issues)\n   228→\n   229→        # Determine if passed\n   230→        error_count = sum(1 for i in issues if i.severity == \"error\")\n   231→        passed = error_count == 0\n   232→\n   233→        return VerificationResult(\n   234→            passed=passed,\n   235→            issues=issues,\n   236→            suggestions=suggestions,\n   237→        )\n   238→\n   239→    def _check_chapter_sizes(self, chapter_map: ChapterMap) -> list[VerificationIssue]:\n   240→        \"\"\"Check for unusual chapter sizes.\"\"\"\n   241→        issues = []\n   242→        chapters = chapter_map.chapters\n   243→\n   244→        if len(chapters) < 2:\n   245→            return issues\n   246→\n   247→        # Calculate statistics\n   248→        word_counts = [c.word_count for c in chapters]\n   249→        avg_words = sum(word_counts) / len(word_counts)\n   250→        min_words = min(word_counts)\n   251→        max_words = max(word_counts)\n   252→\n   253→        # Flag very small chapters (< 20% of average)\n   254→        for i, chapter in enumerate(chapters):\n   255→            if chapter.word_count < avg_words * 0.2 and chapter.word_count < 500:\n   256→                issues.append(VerificationIssue(\n   257→                    description=f\"Chapter {chapter.index} is unusually small ({chapter.word_count} words)\",\n   258→                    severity=\"warning\",\n   259→                    item_index=i,\n   260→                    suggested_fix=\"May be incorrectly split or a section header\",\n   261→                ))\n   262→\n   263→        # Flag very large chapters (> 3x average)\n   264→        for i, chapter in enumerate(chapters):\n   265→            if chapter.word_count > avg_words * 3:\n   266→                issues.append(VerificationIssue(\n   267→                    description=f\"Chapter {chapter.index} is unusually large ({chapter.word_count} words, avg is {int(avg_words)})\",\n   268→                    severity=\"info\",\n   269→                    item_index=i,\n   270→                    suggested_fix=\"May contain missed chapter boundaries\",\n   271→                ))\n   272→\n   273→        return issues\n   274→\n   275→    def _llm_verify_sequence(self, chapter_map: ChapterMap) -> list[VerificationIssue]:\n   276→        \"\"\"Use LLM to verify chapter sequence logic.\"\"\"\n   277→        issues = []\n   278→\n   279→        if not self._llm_client or len(chapter_map.chapters) < 3:\n   280→            return issues\n   281→\n   282→        # Build chapter summary for LLM\n   283→        summary_lines = []\n   284→        for ch in chapter_map.chapters:\n   285→            title = ch.title or \"(untitled)\"\n   286→            conf = \"high\" if ch.confidence >= 0.7 else \"medium\" if ch.confidence >= 0.4 else \"low\"\n   287→            summary_lines.append(\n   288→                f\"Chapter {ch.index}: {title} ({ch.word_count:,} words, {conf} confidence)\"\n   289→            )\n   290→\n   291→        chapter_summary = \"\\n\".join(summary_lines)\n   292→        prompt = SEQUENCE_CHECK_PROMPT.format(chapter_summary=chapter_summary)\n   293→\n   294→        try:\n   295→            result, response = self._llm_client.query_json(\n   296→                prompt,\n   297→                system=SEQUENCE_CHECK_SYSTEM,\n   298→            )\n   299→\n   300→            if result and isinstance(result, dict):\n   301→                llm_issues = result.get(\"issues\", [])\n   302→                for issue in llm_issues:\n   303→                    if isinstance(issue, dict):\n   304→                        issues.append(VerificationIssue(\n   305→                            description=issue.get(\"description\", \"Unknown issue\"),\n   306→                            severity=issue.get(\"severity\", \"warning\"),\n   307→                            item_index=issue.get(\"chapter_index\"),\n   308→                        ))\n   309→\n   310→        except Exception as e:\n   311→            logger.warning(f\"LLM sequence verification failed: {e}\")\n   312→\n   313→        return issues\n   314→\n   315→    def refine(\n   316→        self,\n   317→        result: AgentResult[ChapterMap],\n   318→        issues: list[VerificationIssue],\n   319→    ) -> AgentResult[ChapterMap]:\n   320→        \"\"\"\n   321→        Attempt to refine the chapter structure based on verification issues.\n   322→\n   323→        Currently returns the original result - refinement logic would be\n   324→        added here to address specific issues (e.g., re-running detection\n   325→        with different parameters for problem areas).\n   326→        \"\"\"\n   327→        # For now, log the issues and return unchanged\n   328→        # Future: implement specific refinement strategies\n   329→        error_issues = [i for i in issues if i.severity == \"error\"]\n   330→\n   331→        if error_issues:\n   332→            logger.warning(\n   333→                f\"StructureAgent: {len(error_issues)} errors found but refinement not yet implemented\"\n   334→            )\n   335→\n   336→        return result\n   337→\n   338→\n   339→def create_structure_agent(\n   340→    llm_client: Optional[LLMClient] = None,\n   341→    config: Optional[AgentConfig] = None,\n   342→) -> StructureAgent:\n   343→    \"\"\"\n   344→    Factory function to create a StructureAgent.\n   345→\n   346→    Args:\n   347→        llm_client: LLM client for detection and verification\n   348→        config: Agent configuration\n   349→\n   350→    Returns:\n   351→        Configured StructureAgent\n   352→    \"\"\"\n   353→    return StructureAgent(llm_client=llm_client, config=config)\n   354→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"44602e68-9e9b-4be9-ba12-3b6ee8adb801","uuid":"2ab38629-8af5-4366-b7ea-9a2b151311ad","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/agents/structure.py","content":"\"\"\"\nStructureAgent: Specialized agent for chapter/structure detection.\n\nWraps the ChapterDetectionPipeline with self-verification to ensure\nhigh-quality chapter detection regardless of book format.\n\"\"\"\n\nimport time\nimport logging\nfrom typing import Optional\n\nfrom .base import (\n    Agent,\n    AgentContext,\n    AgentResult,\n    VerificationResult,\n    VerificationIssue,\n    VerificationLevel,\n)\nfrom .config import AgentConfig, PipelineTuningConfig\nfrom ..pipeline.chapter_detection import ChapterDetectionPipeline, ChapterMap\nfrom ..pipeline.llm import LLMClient, LLMConfig\n\nlogger = logging.getLogger(__name__)\n\n\n# Verification prompts\nSEQUENCE_CHECK_SYSTEM = \"\"\"You are a document structure analyst checking chapter sequences for logical consistency.\n\nYour job is to identify potential issues with a proposed chapter structure.\"\"\"\n\nSEQUENCE_CHECK_PROMPT = \"\"\"Review this chapter structure for a book and identify any issues:\n\n{chapter_summary}\n\nCheck for:\n1. Unusual chapter sizes (one chapter much larger/smaller than others)\n2. Missing chapters (gaps in numbering that seem unintentional)\n3. Chapters that might be incorrectly split or merged\n4. Any structural anomalies that seem wrong for a book\n\nReturn JSON:\n{{\n  \"issues\": [\n    {{\"description\": \"...\", \"severity\": \"error|warning|info\", \"chapter_index\": null or number}}\n  ],\n  \"overall_assessment\": \"good|acceptable|needs_review\",\n  \"suggestions\": [\"...\"]\n}}\n\nIf the structure looks correct, return {{\"issues\": [], \"overall_assessment\": \"good\", \"suggestions\": []}}\n\nReturn ONLY valid JSON.\"\"\"\n\n\nclass StructureAgent(Agent):\n    \"\"\"\n    Agent for detecting and validating book structure (chapters).\n\n    Wraps ChapterDetectionPipeline with additional self-verification\n    to catch issues the pipeline might miss.\n\n    Verification checks:\n    - Chapter sequence logic (no out-of-order or missing chapters)\n    - Chapter size consistency (flag unusually small/large chapters)\n    - TOC agreement (if TOC exists, chapters should match)\n    - Low-confidence boundary detection\n    \"\"\"\n\n    def __init__(\n        self,\n        llm_client: Optional[LLMClient] = None,\n        config: Optional[AgentConfig] = None,\n        tuning: Optional[PipelineTuningConfig] = None,\n    ):\n        \"\"\"\n        Initialize the StructureAgent.\n\n        Args:\n            llm_client: LLM client for the pipeline and verification\n            config: Agent configuration (model, thresholds, etc.)\n        \"\"\"\n        self._llm_client = llm_client\n        self._config = config or AgentConfig()\n        self._tuning = tuning\n        self._pipeline: Optional[ChapterDetectionPipeline] = None\n\n    @property\n    def name(self) -> str:\n        return \"structure\"\n\n    @property\n    def depends_on(self) -> list[str]:\n        # Structure detection is the first step - no dependencies\n        return []\n\n    @property\n    def recommended_models(self) -> list[str]:\n        return [\"qwen2.5:7b\", \"llama3.2\", \"mistral\"]\n\n    def _get_pipeline(self) -> ChapterDetectionPipeline:\n        \"\"\"Get or create the chapter detection pipeline.\"\"\"\n        if self._pipeline is None:\n            t = self._tuning or PipelineTuningConfig()\n            self._pipeline = ChapterDetectionPipeline(\n                llm_client=self._llm_client,\n                llm_marker_chunk_size=t.chapter_marker_chunk_chars,\n                llm_marker_chunk_overlap=t.chapter_marker_chunk_overlap_chars,\n                llm_narrative_chunk_size=t.chapter_narrative_chunk_chars,\n                llm_narrative_chunk_overlap=t.chapter_narrative_chunk_overlap_chars,\n            )\n        return self._pipeline\n\n    def run(self, context: AgentContext) -> AgentResult[ChapterMap]:\n        \"\"\"\n        Run chapter detection on the document.\n\n        Args:\n            context: Input context with document text\n\n        Returns:\n            AgentResult containing ChapterMap\n        \"\"\"\n        start_time = time.perf_counter()\n\n        pipeline = self._get_pipeline()\n        chapter_map = pipeline.run(\n            text=context.text,\n            source_file=context.source_file,\n        )\n\n        # Calculate confidence breakdown\n        high = sum(1 for c in chapter_map.chapters if c.confidence >= 0.7)\n        medium = sum(1 for c in chapter_map.chapters if 0.4 <= c.confidence < 0.7)\n        low = sum(1 for c in chapter_map.chapters if c.confidence < 0.4)\n\n        # Collect issues\n        issues = []\n        if chapter_map.low_confidence_boundaries:\n            issues.append(\n                f\"{len(chapter_map.low_confidence_boundaries)} low-confidence boundaries flagged\"\n            )\n        if chapter_map.toc_agreement_score >= 0 and chapter_map.toc_agreement_score < 0.8:\n            issues.append(\n                f\"TOC agreement is only {chapter_map.toc_agreement_score:.0%}\"\n            )\n\n        elapsed = time.perf_counter() - start_time\n\n        # Get model info from config or client\n        model_used = None\n        provider_used = None\n        if self._config and self._config.model:\n            model_used = self._config.model\n            provider_used = self._config.provider\n        elif self._llm_client and self._llm_client.config:\n            model_used = self._llm_client.config.model\n            provider_used = self._llm_client.config.provider\n\n        return AgentResult(\n            data=chapter_map,\n            confidence_scores=[c.confidence for c in chapter_map.chapters],\n            high_confidence_count=high,\n            medium_confidence_count=medium,\n            low_confidence_count=low,\n            issues=issues,\n            processing_time_seconds=elapsed,\n            model_used=model_used,\n            provider_used=provider_used,\n        )\n\n    def verify(\n        self,\n        result: AgentResult[ChapterMap],\n        level: VerificationLevel = VerificationLevel.SELF_CHECK,\n        context: Optional[AgentContext] = None,\n    ) -> VerificationResult:\n        \"\"\"\n        Verify the chapter structure for quality issues.\n\n        Checks:\n        1. Low-confidence chapters\n        2. Chapter size consistency\n        3. TOC agreement\n        4. Sequence logic (via LLM if available)\n        \"\"\"\n        issues = []\n        suggestions = []\n        chapter_map = result.data\n\n        # Check 1: Low confidence items\n        if result.low_confidence_count > 0:\n            issues.append(VerificationIssue(\n                description=f\"{result.low_confidence_count} chapters have low confidence\",\n                severity=\"warning\",\n            ))\n\n        # Check 2: Chapter size consistency\n        size_issues = self._check_chapter_sizes(chapter_map)\n        issues.extend(size_issues)\n\n        # Check 3: TOC agreement\n        if chapter_map.toc_agreement_score >= 0:\n            if chapter_map.toc_agreement_score < 0.5:\n                issues.append(VerificationIssue(\n                    description=f\"Poor TOC agreement ({chapter_map.toc_agreement_score:.0%})\",\n                    severity=\"error\",\n                    suggested_fix=\"Review chapter boundaries against table of contents\",\n                ))\n            elif chapter_map.toc_agreement_score < 0.8:\n                issues.append(VerificationIssue(\n                    description=f\"Moderate TOC agreement ({chapter_map.toc_agreement_score:.0%})\",\n                    severity=\"warning\",\n                ))\n\n        # Check 4: Low-confidence boundaries\n        if chapter_map.low_confidence_boundaries:\n            for boundary in chapter_map.low_confidence_boundaries[:3]:  # Report first 3\n                issues.append(VerificationIssue(\n                    description=f\"Low-confidence boundary at position {boundary.position}: {boundary.title or '(untitled)'}\",\n                    severity=\"info\",\n                ))\n\n        # Check 5: LLM sequence verification (if available)\n        if self._llm_client and self._config.enable_verification:\n            llm_issues = self._llm_verify_sequence(chapter_map)\n            issues.extend(llm_issues)\n\n        # Determine if passed\n        error_count = sum(1 for i in issues if i.severity == \"error\")\n        passed = error_count == 0\n\n        return VerificationResult(\n            passed=passed,\n            issues=issues,\n            suggestions=suggestions,\n        )\n\n    def _check_chapter_sizes(self, chapter_map: ChapterMap) -> list[VerificationIssue]:\n        \"\"\"Check for unusual chapter sizes.\"\"\"\n        issues = []\n        chapters = chapter_map.chapters\n\n        if len(chapters) < 2:\n            return issues\n\n        # Calculate statistics\n        word_counts = [c.word_count for c in chapters]\n        avg_words = sum(word_counts) / len(word_counts)\n        min_words = min(word_counts)\n        max_words = max(word_counts)\n\n        # Flag very small chapters (< 20% of average)\n        for i, chapter in enumerate(chapters):\n            if chapter.word_count < avg_words * 0.2 and chapter.word_count < 500:\n                issues.append(VerificationIssue(\n                    description=f\"Chapter {chapter.index} is unusually small ({chapter.word_count} words)\",\n                    severity=\"warning\",\n                    item_index=i,\n                    suggested_fix=\"May be incorrectly split or a section header\",\n                ))\n\n        # Flag very large chapters (> 3x average)\n        for i, chapter in enumerate(chapters):\n            if chapter.word_count > avg_words * 3:\n                issues.append(VerificationIssue(\n                    description=f\"Chapter {chapter.index} is unusually large ({chapter.word_count} words, avg is {int(avg_words)})\",\n                    severity=\"info\",\n                    item_index=i,\n                    suggested_fix=\"May contain missed chapter boundaries\",\n                ))\n\n        return issues\n\n    def _llm_verify_sequence(self, chapter_map: ChapterMap) -> list[VerificationIssue]:\n        \"\"\"Use LLM to verify chapter sequence logic.\"\"\"\n        issues = []\n\n        if not self._llm_client or len(chapter_map.chapters) < 3:\n            return issues\n\n        # Build chapter summary for LLM\n        summary_lines = []\n        for ch in chapter_map.chapters:\n            title = ch.title or \"(untitled)\"\n            conf = \"high\" if ch.confidence >= 0.7 else \"medium\" if ch.confidence >= 0.4 else \"low\"\n            summary_lines.append(\n                f\"Chapter {ch.index}: {title} ({ch.word_count:,} words, {conf} confidence)\"\n            )\n\n        chapter_summary = \"\\n\".join(summary_lines)\n        prompt = SEQUENCE_CHECK_PROMPT.format(chapter_summary=chapter_summary)\n\n        try:\n            result, response = self._llm_client.query_json(\n                prompt,\n                system=SEQUENCE_CHECK_SYSTEM,\n            )\n\n            if result and isinstance(result, dict):\n                llm_issues = result.get(\"issues\", [])\n                for issue in llm_issues:\n                    if isinstance(issue, dict):\n                        issues.append(VerificationIssue(\n                            description=issue.get(\"description\", \"Unknown issue\"),\n                            severity=issue.get(\"severity\", \"warning\"),\n                            item_index=issue.get(\"chapter_index\"),\n                        ))\n\n        except Exception as e:\n            logger.warning(f\"LLM sequence verification failed: {e}\")\n\n        return issues\n\n    def refine(\n        self,\n        result: AgentResult[ChapterMap],\n        issues: list[VerificationIssue],\n    ) -> AgentResult[ChapterMap]:\n        \"\"\"\n        Attempt to refine the chapter structure based on verification issues.\n\n        Currently returns the original result - refinement logic would be\n        added here to address specific issues (e.g., re-running detection\n        with different parameters for problem areas).\n        \"\"\"\n        # For now, log the issues and return unchanged\n        # Future: implement specific refinement strategies\n        error_issues = [i for i in issues if i.severity == \"error\"]\n\n        if error_issues:\n            logger.warning(\n                f\"StructureAgent: {len(error_issues)} errors found but refinement not yet implemented\"\n            )\n\n        return result\n\n\ndef create_structure_agent(\n    llm_client: Optional[LLMClient] = None,\n    config: Optional[AgentConfig] = None,\n) -> StructureAgent:\n    \"\"\"\n    Factory function to create a StructureAgent.\n\n    Args:\n        llm_client: LLM client for detection and verification\n        config: Agent configuration\n\n    Returns:\n        Configured StructureAgent\n    \"\"\"\n    return StructureAgent(llm_client=llm_client, config=config)\n","numLines":354,"startLine":1,"totalLines":354}}}
