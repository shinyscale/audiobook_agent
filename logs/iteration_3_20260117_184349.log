{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CEbtxo3evSJVya3xUK6Tin","type":"tool_result","content":"     1→\"\"\"\n     2→Chapter Detection Pipeline Orchestrator.\n     3→\n     4→Coordinates the multi-stage pipeline:\n     5→1. Document Profiling (+ TOC extraction)\n     6→2. Proposal Generation (multiple strategies)\n     7→3. Proposal Validation\n     8→4. Consensus Building\n     9→\n    10→Supports checkpointing for save/resume functionality.\n    11→\"\"\"\n    12→\n    13→import hashlib\n    14→from datetime import datetime\n    15→from pathlib import Path\n    16→from typing import Optional, Callable\n    17→import logging\n    18→\n    19→from .models import (\n    20→    ChapterMap,\n    21→    PipelineCheckpoint,\n    22→    ChapterProposal,\n    23→    ValidationResult,\n    24→    DocumentProfile,\n    25→)\n    26→from .profiler import DocumentProfiler\n    27→from .proposers import RegexProposer, LLMMarkerProposer, LLMNarrativeProposer\n    28→from .validator import ProposalValidator\n    29→from .consensus import ConsensusBuilder\n    30→from ..llm import LLMClient, LLMConfig, create_client\n    31→\n    32→logger = logging.getLogger(__name__)\n    33→\n    34→\n    35→class ChapterDetectionPipeline:\n    36→    \"\"\"\n    37→    Orchestrates the multi-agent chapter detection pipeline.\n    38→\n    39→    Usage:\n    40→        # Basic usage\n    41→        pipeline = ChapterDetectionPipeline()\n    42→        result = pipeline.run(text, source_file=\"book.txt\")\n    43→\n    44→        # With LLM enhancement\n    45→        pipeline = ChapterDetectionPipeline.with_ollama(\"llama3.2\")\n    46→        result = pipeline.run(text, source_file=\"book.txt\")\n    47→\n    48→        # Resume from checkpoint\n    49→        result = pipeline.run(text, source_file=\"book.txt\", checkpoint_path=\"checkpoint.json\")\n    50→    \"\"\"\n    51→\n    52→    def __init__(\n    53→        self,\n    54→        llm_client: Optional[LLMClient] = None,\n    55→        checkpoint_dir: Optional[Path] = None,\n    56→        progress_callback: Optional[Callable[[str, float], None]] = None,\n    57→        llm_marker_chunk_size: int = 15000,\n    58→        llm_marker_chunk_overlap: int = 1000,\n    59→        llm_narrative_chunk_size: int = 20000,\n    60→        llm_narrative_chunk_overlap: int = 2000,\n    61→    ):\n    62→        \"\"\"\n    63→        Args:\n    64→            llm_client: Optional LLM client for enhanced detection\n    65→            checkpoint_dir: Directory to save checkpoints\n    66→            progress_callback: Optional callback(stage_name, progress_percent)\n    67→        \"\"\"\n    68→        self.llm = llm_client\n    69→        self.checkpoint_dir = checkpoint_dir\n    70→        self.progress_callback = progress_callback\n    71→\n    72→        # Initialize components\n    73→        self.profiler = DocumentProfiler(llm_client=llm_client)\n    74→        self.regex_proposer = RegexProposer()\n    75→        self.validator = ProposalValidator(llm_client=llm_client)\n    76→        self.consensus_builder = ConsensusBuilder(llm_client=llm_client)\n    77→\n    78→        # LLM proposers (only if LLM available)\n    79→        if llm_client:\n    80→            self.llm_marker_proposer = LLMMarkerProposer(\n    81→                llm_client,\n    82→                chunk_size=llm_marker_chunk_size,\n    83→                chunk_overlap=llm_marker_chunk_overlap,\n    84→            )\n    85→            self.llm_narrative_proposer = LLMNarrativeProposer(\n    86→                llm_client,\n    87→                chunk_size=llm_narrative_chunk_size,\n    88→                chunk_overlap=llm_narrative_chunk_overlap,\n    89→            )\n    90→        else:\n    91→            self.llm_marker_proposer = None\n    92→            self.llm_narrative_proposer = None\n    93→\n    94→    @classmethod\n    95→    def with_ollama(\n    96→        cls,\n    97→        model: str = \"llama3.2\",\n    98→        base_url: str = \"http://localhost:11434\",\n    99→        **kwargs,\n   100→    ) -> \"ChapterDetectionPipeline\":\n   101→        \"\"\"Create pipeline with Ollama LLM.\"\"\"\n   102→        client = create_client(\"ollama\", model=model, base_url=base_url)\n   103→        return cls(llm_client=client, **kwargs)\n   104→\n   105→    @classmethod\n   106→    def with_openai(\n   107→        cls,\n   108→        model: str = \"gpt-4o-mini\",\n   109→        api_key: Optional[str] = None,\n   110→        **kwargs,\n   111→    ) -> \"ChapterDetectionPipeline\":\n   112→        \"\"\"Create pipeline with OpenAI LLM.\"\"\"\n   113→        client = create_client(\"openai\", model=model, api_key=api_key)\n   114→        return cls(llm_client=client, **kwargs)\n   115→\n   116→    @classmethod\n   117→    def with_anthropic(\n   118→        cls,\n   119→        model: str = \"claude-3-5-sonnet-20241022\",\n   120→        api_key: Optional[str] = None,\n   121→        **kwargs,\n   122→    ) -> \"ChapterDetectionPipeline\":\n   123→        \"\"\"Create pipeline with Anthropic LLM.\"\"\"\n   124→        client = create_client(\"anthropic\", model=model, api_key=api_key)\n   125→        return cls(llm_client=client, **kwargs)\n   126→\n   127→    @classmethod\n   128→    def deterministic_only(cls, **kwargs) -> \"ChapterDetectionPipeline\":\n   129→        \"\"\"Create pipeline without LLM (regex-only, fast).\"\"\"\n   130→        return cls(llm_client=None, **kwargs)\n   131→\n   132→    def run(\n   133→        self,\n   134→        text: str,\n   135→        source_file: str = \"document\",\n   136→        checkpoint_path: Optional[Path] = None,\n   137→        save_checkpoint: bool = True,\n   138→    ) -> ChapterMap:\n   139→        \"\"\"\n   140→        Run the chapter detection pipeline.\n   141→\n   142→        Args:\n   143→            text: Full document text\n   144→            source_file: Source file path (for checkpoint identification)\n   145→            checkpoint_path: Path to existing checkpoint to resume from\n   146→            save_checkpoint: Whether to save checkpoints after each stage\n   147→\n   148→        Returns:\n   149→            ChapterMap with detected chapters\n   150→        \"\"\"\n   151→        # Create or load checkpoint\n   152→        text_hash = self._hash_text(text)\n   153→\n   154→        if checkpoint_path and checkpoint_path.exists():\n   155→            checkpoint = PipelineCheckpoint.load(checkpoint_path)\n   156→\n   157→            # Verify same document\n   158→            if checkpoint.text_hash != text_hash:\n   159→                logger.warning(\"Checkpoint text hash mismatch - starting fresh\")\n   160→                checkpoint = PipelineCheckpoint.create_new(source_file, text_hash)\n   161→        else:\n   162→            checkpoint = PipelineCheckpoint.create_new(source_file, text_hash)\n   163→\n   164→        # Determine checkpoint save path\n   165→        if save_checkpoint and self.checkpoint_dir:\n   166→            self.checkpoint_dir.mkdir(parents=True, exist_ok=True)\n   167→            save_path = self.checkpoint_dir / f\"checkpoint_{Path(source_file).stem}.json\"\n   168→        else:\n   169→            save_path = None\n   170→\n   171→        # Run pipeline stages\n   172→        try:\n   173→            # Stage 1: Profiling\n   174→            if checkpoint.stage == \"profiling\" or checkpoint.document_profile is None:\n   175→                self._report_progress(\"Profiling document\", 0.1)\n   176→                checkpoint.document_profile = self.profiler.profile(text)\n   177→                checkpoint.stage = \"proposals\"\n   178→                self._save_checkpoint(checkpoint, save_path)\n   179→\n   180→            # Stage 2: Proposals\n   181→            if checkpoint.stage == \"proposals\" or checkpoint.proposals is None:\n   182→                self._report_progress(\"Generating proposals\", 0.3)\n   183→                checkpoint.proposals = self._generate_proposals(text, checkpoint.document_profile)\n   184→                checkpoint.stage = \"validation\"\n   185→                self._save_checkpoint(checkpoint, save_path)\n   186→\n   187→            # Stage 3: Validation\n   188→            if checkpoint.stage == \"validation\" or checkpoint.validations is None:\n   189→                self._report_progress(\"Validating proposals\", 0.6)\n   190→                checkpoint.validations = self.validator.validate(\n   191→                    checkpoint.proposals, text, checkpoint.document_profile\n   192→                )\n   193→                checkpoint.stage = \"consensus\"\n   194→                self._save_checkpoint(checkpoint, save_path)\n   195→\n   196→            # Stage 4: Consensus\n   197→            if checkpoint.stage == \"consensus\" or checkpoint.chapter_map is None:\n   198→                self._report_progress(\"Building consensus\", 0.9)\n   199→                checkpoint.chapter_map = self.consensus_builder.build_consensus(\n   200→                    checkpoint.validations, text, checkpoint.document_profile\n   201→                )\n   202→                checkpoint.stage = \"complete\"\n   203→                self._save_checkpoint(checkpoint, save_path)\n   204→\n   205→            self._report_progress(\"Complete\", 1.0)\n   206→\n   207→            # Add pipeline metadata\n   208→            checkpoint.chapter_map.pipeline_metadata.update({\n   209→                \"completed_at\": datetime.now().isoformat(),\n   210→                \"llm_enabled\": self.llm is not None,\n   211→                \"proposal_count\": len(checkpoint.proposals) if checkpoint.proposals else 0,\n   212→                \"validation_count\": len(checkpoint.validations) if checkpoint.validations else 0,\n   213→            })\n   214→\n   215→            return checkpoint.chapter_map\n   216→\n   217→        except Exception as e:\n   218→            checkpoint.errors.append(f\"{checkpoint.stage}: {str(e)}\")\n   219→            self._save_checkpoint(checkpoint, save_path)\n   220→            raise\n   221→\n   222→    def _generate_proposals(\n   223→        self,\n   224→        text: str,\n   225→        profile: DocumentProfile,\n   226→    ) -> list[ChapterProposal]:\n   227→        \"\"\"Generate proposals from all available strategies.\"\"\"\n   228→        proposals = []\n   229→\n   230→        # Always run regex proposer\n   231→        logger.info(\"Running regex proposer...\")\n   232→        regex_proposals = self.regex_proposer.propose(text, profile)\n   233→        proposals.extend(regex_proposals)\n   234→        logger.info(f\"Regex proposer found {len(regex_proposals)} proposals\")\n   235→\n   236→        # Run LLM proposers if available\n   237→        if self.llm_marker_proposer:\n   238→            logger.info(\"Running LLM marker proposer...\")\n   239→            try:\n   240→                marker_proposals = self.llm_marker_proposer.propose(text, profile)\n   241→                proposals.extend(marker_proposals)\n   242→                logger.info(f\"LLM marker proposer found {len(marker_proposals)} proposals\")\n   243→            except Exception as e:\n   244→                logger.warning(f\"LLM marker proposer failed: {e}\")\n   245→\n   246→        if self.llm_narrative_proposer and not profile.has_explicit_markers:\n   247→            logger.info(\"Running LLM narrative proposer...\")\n   248→            try:\n   249→                narrative_proposals = self.llm_narrative_proposer.propose(text, profile)\n   250→                proposals.extend(narrative_proposals)\n   251→                logger.info(f\"LLM narrative proposer found {len(narrative_proposals)} proposals\")\n   252→            except Exception as e:\n   253→                logger.warning(f\"LLM narrative proposer failed: {e}\")\n   254→\n   255→        logger.info(f\"Total proposals: {len(proposals)}\")\n   256→        return proposals\n   257→\n   258→    def _hash_text(self, text: str) -> str:\n   259→        \"\"\"Create a hash of the text for checkpoint verification.\"\"\"\n   260→        return hashlib.sha256(text.encode()).hexdigest()[:16]\n   261→\n   262→    def _save_checkpoint(self, checkpoint: PipelineCheckpoint, path: Optional[Path]) -> None:\n   263→        \"\"\"Save checkpoint if path is provided.\"\"\"\n   264→        if path:\n   265→            checkpoint.timestamp = datetime.now().isoformat()\n   266→            checkpoint.save(path)\n   267→            logger.debug(f\"Checkpoint saved to {path}\")\n   268→\n   269→    def _report_progress(self, stage: str, progress: float) -> None:\n   270→        \"\"\"Report progress via callback if available.\"\"\"\n   271→        logger.info(f\"Pipeline stage: {stage} ({progress:.0%})\")\n   272→        if self.progress_callback:\n   273→            self.progress_callback(stage, progress)\n   274→\n   275→\n   276→def detect_chapters(\n   277→    text: str,\n   278→    source_file: str = \"document\",\n   279→    llm_provider: Optional[str] = None,\n   280→    llm_model: Optional[str] = None,\n   281→    checkpoint_dir: Optional[Path] = None,\n   282→) -> ChapterMap:\n   283→    \"\"\"\n   284→    Convenience function to detect chapters in a document.\n   285→\n   286→    Args:\n   287→        text: Full document text\n   288→        source_file: Source file path\n   289→        llm_provider: Optional LLM provider (\"ollama\", \"openai\", \"anthropic\")\n   290→        llm_model: Optional LLM model name\n   291→        checkpoint_dir: Optional directory for checkpoints\n   292→\n   293→    Returns:\n   294→        ChapterMap with detected chapters\n   295→    \"\"\"\n   296→    if llm_provider:\n   297→        llm_client = create_client(llm_provider, model=llm_model)\n   298→    else:\n   299→        llm_client = None\n   300→\n   301→    pipeline = ChapterDetectionPipeline(\n   302→        llm_client=llm_client,\n   303→        checkpoint_dir=checkpoint_dir,\n   304→    )\n   305→\n   306→    return pipeline.run(text, source_file=source_file)\n   307→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"44602e68-9e9b-4be9-ba12-3b6ee8adb801","uuid":"94d47a32-468d-485c-92be-943658132124","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/chapter_detection/pipeline.py","content":"\"\"\"\nChapter Detection Pipeline Orchestrator.\n\nCoordinates the multi-stage pipeline:\n1. Document Profiling (+ TOC extraction)\n2. Proposal Generation (multiple strategies)\n3. Proposal Validation\n4. Consensus Building\n\nSupports checkpointing for save/resume functionality.\n\"\"\"\n\nimport hashlib\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Optional, Callable\nimport logging\n\nfrom .models import (\n    ChapterMap,\n    PipelineCheckpoint,\n    ChapterProposal,\n    ValidationResult,\n    DocumentProfile,\n)\nfrom .profiler import DocumentProfiler\nfrom .proposers import RegexProposer, LLMMarkerProposer, LLMNarrativeProposer\nfrom .validator import ProposalValidator\nfrom .consensus import ConsensusBuilder\nfrom ..llm import LLMClient, LLMConfig, create_client\n\nlogger = logging.getLogger(__name__)\n\n\nclass ChapterDetectionPipeline:\n    \"\"\"\n    Orchestrates the multi-agent chapter detection pipeline.\n\n    Usage:\n        # Basic usage\n        pipeline = ChapterDetectionPipeline()\n        result = pipeline.run(text, source_file=\"book.txt\")\n\n        # With LLM enhancement\n        pipeline = ChapterDetectionPipeline.with_ollama(\"llama3.2\")\n        result = pipeline.run(text, source_file=\"book.txt\")\n\n        # Resume from checkpoint\n        result = pipeline.run(text, source_file=\"book.txt\", checkpoint_path=\"checkpoint.json\")\n    \"\"\"\n\n    def __init__(\n        self,\n        llm_client: Optional[LLMClient] = None,\n        checkpoint_dir: Optional[Path] = None,\n        progress_callback: Optional[Callable[[str, float], None]] = None,\n        llm_marker_chunk_size: int = 15000,\n        llm_marker_chunk_overlap: int = 1000,\n        llm_narrative_chunk_size: int = 20000,\n        llm_narrative_chunk_overlap: int = 2000,\n    ):\n        \"\"\"\n        Args:\n            llm_client: Optional LLM client for enhanced detection\n            checkpoint_dir: Directory to save checkpoints\n            progress_callback: Optional callback(stage_name, progress_percent)\n        \"\"\"\n        self.llm = llm_client\n        self.checkpoint_dir = checkpoint_dir\n        self.progress_callback = progress_callback\n\n        # Initialize components\n        self.profiler = DocumentProfiler(llm_client=llm_client)\n        self.regex_proposer = RegexProposer()\n        self.validator = ProposalValidator(llm_client=llm_client)\n        self.consensus_builder = ConsensusBuilder(llm_client=llm_client)\n\n        # LLM proposers (only if LLM available)\n        if llm_client:\n            self.llm_marker_proposer = LLMMarkerProposer(\n                llm_client,\n                chunk_size=llm_marker_chunk_size,\n                chunk_overlap=llm_marker_chunk_overlap,\n            )\n            self.llm_narrative_proposer = LLMNarrativeProposer(\n                llm_client,\n                chunk_size=llm_narrative_chunk_size,\n                chunk_overlap=llm_narrative_chunk_overlap,\n            )\n        else:\n            self.llm_marker_proposer = None\n            self.llm_narrative_proposer = None\n\n    @classmethod\n    def with_ollama(\n        cls,\n        model: str = \"llama3.2\",\n        base_url: str = \"http://localhost:11434\",\n        **kwargs,\n    ) -> \"ChapterDetectionPipeline\":\n        \"\"\"Create pipeline with Ollama LLM.\"\"\"\n        client = create_client(\"ollama\", model=model, base_url=base_url)\n        return cls(llm_client=client, **kwargs)\n\n    @classmethod\n    def with_openai(\n        cls,\n        model: str = \"gpt-4o-mini\",\n        api_key: Optional[str] = None,\n        **kwargs,\n    ) -> \"ChapterDetectionPipeline\":\n        \"\"\"Create pipeline with OpenAI LLM.\"\"\"\n        client = create_client(\"openai\", model=model, api_key=api_key)\n        return cls(llm_client=client, **kwargs)\n\n    @classmethod\n    def with_anthropic(\n        cls,\n        model: str = \"claude-3-5-sonnet-20241022\",\n        api_key: Optional[str] = None,\n        **kwargs,\n    ) -> \"ChapterDetectionPipeline\":\n        \"\"\"Create pipeline with Anthropic LLM.\"\"\"\n        client = create_client(\"anthropic\", model=model, api_key=api_key)\n        return cls(llm_client=client, **kwargs)\n\n    @classmethod\n    def deterministic_only(cls, **kwargs) -> \"ChapterDetectionPipeline\":\n        \"\"\"Create pipeline without LLM (regex-only, fast).\"\"\"\n        return cls(llm_client=None, **kwargs)\n\n    def run(\n        self,\n        text: str,\n        source_file: str = \"document\",\n        checkpoint_path: Optional[Path] = None,\n        save_checkpoint: bool = True,\n    ) -> ChapterMap:\n        \"\"\"\n        Run the chapter detection pipeline.\n\n        Args:\n            text: Full document text\n            source_file: Source file path (for checkpoint identification)\n            checkpoint_path: Path to existing checkpoint to resume from\n            save_checkpoint: Whether to save checkpoints after each stage\n\n        Returns:\n            ChapterMap with detected chapters\n        \"\"\"\n        # Create or load checkpoint\n        text_hash = self._hash_text(text)\n\n        if checkpoint_path and checkpoint_path.exists():\n            checkpoint = PipelineCheckpoint.load(checkpoint_path)\n\n            # Verify same document\n            if checkpoint.text_hash != text_hash:\n                logger.warning(\"Checkpoint text hash mismatch - starting fresh\")\n                checkpoint = PipelineCheckpoint.create_new(source_file, text_hash)\n        else:\n            checkpoint = PipelineCheckpoint.create_new(source_file, text_hash)\n\n        # Determine checkpoint save path\n        if save_checkpoint and self.checkpoint_dir:\n            self.checkpoint_dir.mkdir(parents=True, exist_ok=True)\n            save_path = self.checkpoint_dir / f\"checkpoint_{Path(source_file).stem}.json\"\n        else:\n            save_path = None\n\n        # Run pipeline stages\n        try:\n            # Stage 1: Profiling\n            if checkpoint.stage == \"profiling\" or checkpoint.document_profile is None:\n                self._report_progress(\"Profiling document\", 0.1)\n                checkpoint.document_profile = self.profiler.profile(text)\n                checkpoint.stage = \"proposals\"\n                self._save_checkpoint(checkpoint, save_path)\n\n            # Stage 2: Proposals\n            if checkpoint.stage == \"proposals\" or checkpoint.proposals is None:\n                self._report_progress(\"Generating proposals\", 0.3)\n                checkpoint.proposals = self._generate_proposals(text, checkpoint.document_profile)\n                checkpoint.stage = \"validation\"\n                self._save_checkpoint(checkpoint, save_path)\n\n            # Stage 3: Validation\n            if checkpoint.stage == \"validation\" or checkpoint.validations is None:\n                self._report_progress(\"Validating proposals\", 0.6)\n                checkpoint.validations = self.validator.validate(\n                    checkpoint.proposals, text, checkpoint.document_profile\n                )\n                checkpoint.stage = \"consensus\"\n                self._save_checkpoint(checkpoint, save_path)\n\n            # Stage 4: Consensus\n            if checkpoint.stage == \"consensus\" or checkpoint.chapter_map is None:\n                self._report_progress(\"Building consensus\", 0.9)\n                checkpoint.chapter_map = self.consensus_builder.build_consensus(\n                    checkpoint.validations, text, checkpoint.document_profile\n                )\n                checkpoint.stage = \"complete\"\n                self._save_checkpoint(checkpoint, save_path)\n\n            self._report_progress(\"Complete\", 1.0)\n\n            # Add pipeline metadata\n            checkpoint.chapter_map.pipeline_metadata.update({\n                \"completed_at\": datetime.now().isoformat(),\n                \"llm_enabled\": self.llm is not None,\n                \"proposal_count\": len(checkpoint.proposals) if checkpoint.proposals else 0,\n                \"validation_count\": len(checkpoint.validations) if checkpoint.validations else 0,\n            })\n\n            return checkpoint.chapter_map\n\n        except Exception as e:\n            checkpoint.errors.append(f\"{checkpoint.stage}: {str(e)}\")\n            self._save_checkpoint(checkpoint, save_path)\n            raise\n\n    def _generate_proposals(\n        self,\n        text: str,\n        profile: DocumentProfile,\n    ) -> list[ChapterProposal]:\n        \"\"\"Generate proposals from all available strategies.\"\"\"\n        proposals = []\n\n        # Always run regex proposer\n        logger.info(\"Running regex proposer...\")\n        regex_proposals = self.regex_proposer.propose(text, profile)\n        proposals.extend(regex_proposals)\n        logger.info(f\"Regex proposer found {len(regex_proposals)} proposals\")\n\n        # Run LLM proposers if available\n        if self.llm_marker_proposer:\n            logger.info(\"Running LLM marker proposer...\")\n            try:\n                marker_proposals = self.llm_marker_proposer.propose(text, profile)\n                proposals.extend(marker_proposals)\n                logger.info(f\"LLM marker proposer found {len(marker_proposals)} proposals\")\n            except Exception as e:\n                logger.warning(f\"LLM marker proposer failed: {e}\")\n\n        if self.llm_narrative_proposer and not profile.has_explicit_markers:\n            logger.info(\"Running LLM narrative proposer...\")\n            try:\n                narrative_proposals = self.llm_narrative_proposer.propose(text, profile)\n                proposals.extend(narrative_proposals)\n                logger.info(f\"LLM narrative proposer found {len(narrative_proposals)} proposals\")\n            except Exception as e:\n                logger.warning(f\"LLM narrative proposer failed: {e}\")\n\n        logger.info(f\"Total proposals: {len(proposals)}\")\n        return proposals\n\n    def _hash_text(self, text: str) -> str:\n        \"\"\"Create a hash of the text for checkpoint verification.\"\"\"\n        return hashlib.sha256(text.encode()).hexdigest()[:16]\n\n    def _save_checkpoint(self, checkpoint: PipelineCheckpoint, path: Optional[Path]) -> None:\n        \"\"\"Save checkpoint if path is provided.\"\"\"\n        if path:\n            checkpoint.timestamp = datetime.now().isoformat()\n            checkpoint.save(path)\n            logger.debug(f\"Checkpoint saved to {path}\")\n\n    def _report_progress(self, stage: str, progress: float) -> None:\n        \"\"\"Report progress via callback if available.\"\"\"\n        logger.info(f\"Pipeline stage: {stage} ({progress:.0%})\")\n        if self.progress_callback:\n            self.progress_callback(stage, progress)\n\n\ndef detect_chapters(\n    text: str,\n    source_file: str = \"document\",\n    llm_provider: Optional[str] = None,\n    llm_model: Optional[str] = None,\n    checkpoint_dir: Optional[Path] = None,\n) -> ChapterMap:\n    \"\"\"\n    Convenience function to detect chapters in a document.\n\n    Args:\n        text: Full document text\n        source_file: Source file path\n        llm_provider: Optional LLM provider (\"ollama\", \"openai\", \"anthropic\")\n        llm_model: Optional LLM model name\n        checkpoint_dir: Optional directory for checkpoints\n\n    Returns:\n        ChapterMap with detected chapters\n    \"\"\"\n    if llm_provider:\n        llm_client = create_client(llm_provider, model=llm_model)\n    else:\n        llm_client = None\n\n    pipeline = ChapterDetectionPipeline(\n        llm_client=llm_client,\n        checkpoint_dir=checkpoint_dir,\n    )\n\n    return pipeline.run(text, source_file=source_file)\n","numLines":307,"startLine":1,"totalLines":307}}}
