            high_confidence, low_confidence, text, profile\n   216→        )\n   217→\n   218→    def _cluster_proposals(\n   219→        self,\n   220→        validations: list[ValidationResult],\n   221→    ) -> list[ProposalCluster]:\n   222→        \"\"\"Cluster proposals by position.\"\"\"\n   223→        if not validations:\n   224→            return []\n   225→\n   226→        # Sort by position\n   227→        sorted_vals = sorted(validations, key=lambda v: v.proposal.position)\n   228→\n   229→        clusters = []\n   230→        current_cluster = [sorted_vals[0]]\n   231→\n   232→        for val in sorted_vals[1:]:\n   233→            # Check if close to current cluster\n   234→            cluster_center = sum(v.proposal.position for v in current_cluster) // len(current_cluster)\n   235→\n   236→            if val.proposal.position - cluster_center <= self.position_threshold:\n   237→                current_cluster.append(val)\n   238→            else:\n   239→                # Start new cluster\n   240→                clusters.append(self._make_cluster(current_cluster))\n   241→                current_cluster = [val]\n   242→\n   243→        # Don't forget last cluster\n   244→        clusters.append(self._make_cluster(current_cluster))\n   245→\n   246→        return clusters\n   247→\n   248→    def _make_cluster(self, validations: list[ValidationResult]) -> ProposalCluster:\n   249→        \"\"\"Create a cluster from a list of validations.\"\"\"\n   250→        positions = [v.proposal.position for v in validations]\n   251→        center = sum(positions) // len(positions)\n   252→\n   253→        # Pick best title (highest confidence proposal with a title)\n   254→        best_title = None\n   255→        best_title_score = 0\n   256→        for v in validations:\n   257→            if v.proposal.title and v.overall_score > best_title_score:\n   258→                best_title = v.proposal.title\n   259→                best_title_score = v.overall_score\n   260→\n   261→        # Strategies that contributed\n   262→        strategies = list(set(v.proposal.strategy for v in validations))\n   263→\n   264→        # Combined score (average weighted by strategy)\n   265→        total_weight = 0\n   266→        weighted_score = 0\n   267→        for v in validations:\n   268→            weight = self.strategy_weights.get(v.proposal.strategy, 0.8)\n   269→            weighted_score += v.overall_score * weight\n   270→            total_weight += weight\n   271→\n   272→        combined_score = weighted_score / total_weight if total_weight > 0 else 0\n   273→\n   274→        # F10: Check if any proposal is a hard boundary (explicit marker)\n   275→        is_hard = any(\n   276→            getattr(v.proposal, 'is_hard_boundary', False)\n   277→            for v in validations\n   278→        )\n   279→\n   280→        return ProposalCluster(\n   281→            proposals=validations,\n   282→            center_position=center,\n   283→            best_title=best_title,\n   284→            combined_score=combined_score,\n   285→            strategies=strategies,\n   286→            is_hard_boundary=is_hard,\n   287→        )\n   288→\n   289→    def _score_clusters(\n   290→        self,\n   291→        clusters: list[ProposalCluster],\n   292→        profile: DocumentProfile,\n   293→    ) -> list[ProposalCluster]:\n   294→        \"\"\"Enhance cluster scores with additional signals.\n   295→\n   296→        F10: Hard boundaries (explicit markers like 'Chapter N', centered Roman numerals)\n   297→        receive maximum score to dominate over soft signals.\n   298→        \"\"\"\n   299→        for cluster in clusters:\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the