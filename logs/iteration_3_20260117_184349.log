{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0174W7UnkYbybnWTfTepXdNj","type":"tool_result","content":"     1→\"\"\"\n     2→Regex-based chapter proposer.\n     3→\n     4→This is the deterministic baseline - fast, reproducible, no LLM dependency.\n     5→\"\"\"\n     6→\n     7→import re\n     8→import logging\n     9→from typing import Optional\n    10→from dataclasses import dataclass\n    11→\n    12→from .base import BaseProposer\n    13→from ..models import ChapterProposal, DocumentProfile\n    14→\n    15→logger = logging.getLogger(__name__)\n    16→\n    17→\n    18→@dataclass\n    19→class ChapterPattern:\n    20→    \"\"\"A pattern for detecting chapter markers.\"\"\"\n    21→    pattern: re.Pattern\n    22→    confidence: float\n    23→    description: str\n    24→    # F10: Explicit hard boundaries dominate over soft signals\n    25→    is_hard_boundary: bool = False  # True for explicit markers\n    26→\n    27→\n    28→# Patterns ordered from most to least specific\n    29→# F10: Explicit markers (is_hard_boundary=True) dominate over soft signals\n    30→CHAPTER_PATTERNS = [\n    31→    # Explicit \"Chapter\" markers - HARD BOUNDARIES\n    32→    ChapterPattern(\n    33→        re.compile(r\"^\\s*(Chapter|CHAPTER)\\s+(\\d+|[IVXLC]+)(?:\\s*[:\\.\\-—–]\\s*(.+?))?$\", re.MULTILINE),\n    34→        confidence=0.95,\n    35→        description=\"explicit_chapter_numbered\",\n    36→        is_hard_boundary=True,\n    37→    ),\n    38→    ChapterPattern(\n    39→        re.compile(r\"^\\s*(CHAPTER|Chapter)\\s+([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)$\", re.MULTILINE),\n    40→        confidence=0.90,\n    41→        description=\"explicit_chapter_word_number\",\n    42→        is_hard_boundary=True,\n    43→    ),\n    44→\n    45→    # Part markers - HARD BOUNDARIES\n    46→    ChapterPattern(\n    47→        re.compile(r\"^\\s*(Part|PART)\\s+(\\d+|[IVXLC]+|One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten)(?:\\s*[:\\.\\-—–]\\s*(.+?))?$\", re.MULTILINE | re.IGNORECASE),\n    48→        confidence=0.95,\n    49→        description=\"part_marker\",\n    50→        is_hard_boundary=True,\n    51→    ),\n    52→\n    53→    # Roman numeral only (common in classic literature)\n    54→    # STRICT: Must be centered (10+ spaces) - works for all Roman numerals including \"I\"\n    55→    # HARD BOUNDARY\n    56→    ChapterPattern(\n    57→        re.compile(r\"^\\s{10,}([IVXLC]+)\\s*$\", re.MULTILINE),\n    58→        confidence=0.85,\n    59→        description=\"roman_numeral_centered\",\n    60→        is_hard_boundary=True,\n    61→    ),\n    62→    # RELAXED but safer: Requires 2+ characters to avoid matching \"I\" pronoun in dialogue\n    63→    # This is a softer signal, not a hard boundary\n    64→    ChapterPattern(\n    65→        re.compile(r\"^\\s*([IVXLC]{2,7})\\s*$\", re.MULTILINE),\n    66→        confidence=0.70,\n    67→        description=\"roman_numeral_line\",\n    68→        is_hard_boundary=False,\n    69→    ),\n    70→\n    71→    # Arabic numeral only (centered) - HARD BOUNDARY when centered\n    72→    ChapterPattern(\n    73→        re.compile(r\"^\\s{10,}(\\d{1,3})\\s*$\", re.MULTILINE),\n    74→        confidence=0.75,\n    75→        description=\"arabic_numeral_centered\",\n    76→        is_hard_boundary=True,\n    77→    ),\n    78→\n    79→    # Named chapters (all caps on own line) - softer signal\n    80→    ChapterPattern(\n    81→        re.compile(r\"^\\s*([A-Z][A-Z\\s]{5,40})\\s*$\", re.MULTILINE),\n    82→        confidence=0.60,\n    83→        description=\"all_caps_title\",\n    84→        is_hard_boundary=False,\n    85→    ),\n    86→\n    87→    # Prologue/Epilogue and other special sections - HARD BOUNDARIES\n    88→    ChapterPattern(\n    89→        re.compile(\n    90→            r\"^\\s*(Prologue|PROLOGUE|Epilogue|EPILOGUE|Introduction|INTRODUCTION|Preface|PREFACE|\"\n    91→            r\"Foreword|FOREWORD|Afterword|AFTERWORD|Appendix|APPENDIX|Acknowledgments|ACKNOWLEDGMENTS|\"\n    92→            r\"Dedication|DEDICATION|Notes|NOTES|Glossary|GLOSSARY|Interlude|INTERLUDE|Intermezzo|INTERMEZZO)\\s*$\",\n    93→            re.MULTILINE\n    94→        ),\n    95→        confidence=0.95,\n    96→        description=\"special_section\",\n    97→        is_hard_boundary=True,\n    98→    ),\n    99→\n   100→    # Letters in epistolary novels (Letter 1, Letter I, etc.) - HARD BOUNDARIES\n   101→    ChapterPattern(\n   102→        re.compile(\n   103→            r\"^\\s*(Letter|LETTER)\\s+(\\d+|[IVXLC]+|One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten)(?:\\s*[:\\.\\-—–]\\s*(.+?))?$\",\n   104→            re.MULTILINE | re.IGNORECASE\n   105→        ),\n   106→        confidence=0.95,\n   107→        description=\"letter_section\",\n   108→        is_hard_boundary=True,\n   109→    ),\n   110→\n   111→    # \"Book One\", \"Book Two\" etc. - HARD BOUNDARIES\n   112→    ChapterPattern(\n   113→        re.compile(r\"^\\s*(Book|BOOK)\\s+(\\d+|One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten|[IVXLC]+)(?:\\s*[:\\.\\-—–]\\s*(.+?))?$\", re.MULTILINE | re.IGNORECASE),\n   114→        confidence=0.95,\n   115→        description=\"book_division\",\n   116→        is_hard_boundary=True,\n   117→    ),\n   118→]\n   119→\n   120→\n   121→class RegexProposer(BaseProposer):\n   122→    \"\"\"\n   123→    Proposes chapter boundaries using regex patterns.\n   124→\n   125→    This is the baseline proposer - deterministic and fast.\n   126→    \"\"\"\n   127→\n   128→    name = \"regex\"\n   129→\n   130→    def __init__(self, min_chapter_words: int = 100):\n   131→        \"\"\"\n   132→        Args:\n   133→            min_chapter_words: Minimum words between chapter markers to be considered valid\n   134→        \"\"\"\n   135→        self.min_chapter_words = min_chapter_words\n   136→\n   137→    def propose(\n   138→        self,\n   139→        text: str,\n   140→        profile: Optional[DocumentProfile] = None,\n   141→    ) -> list[ChapterProposal]:\n   142→        \"\"\"Find chapter boundaries using regex patterns.\"\"\"\n   143→        proposals = []\n   144→        seen_positions = set()  # Avoid duplicates\n   145→\n   146→        # If we have a profile with front matter info, start after it\n   147→        start_position = profile.front_matter_end if profile else 0\n   148→        logger.debug(f\"RegexProposer: start_position={start_position} (front_matter_end)\")\n   149→\n   150→        # Track matches per pattern for debugging\n   151→        pattern_match_counts = {}\n   152→        skipped_front_matter = 0\n   153→        skipped_duplicate = 0\n   154→\n   155→        for pattern_def in CHAPTER_PATTERNS:\n   156→            pattern_matches = 0\n   157→            for match in pattern_def.pattern.finditer(text):\n   158→                position = match.start()\n   159→\n   160→                # Skip if in front matter\n   161→                if position < start_position:\n   162→                    skipped_front_matter += 1\n   163→                    logger.debug(\n   164→                        f\"  Skipped (front matter): '{match.group(0).strip()[:40]}' \"\n   165→                        f\"at pos {position}\"\n   166→                    )\n   167→                    continue\n   168→\n   169→                # Skip if we already have a proposal very close to this position\n   170→                if any(abs(position - p) < 50 for p in seen_positions):\n   171→                    skipped_duplicate += 1\n   172→                    logger.debug(\n   173→                        f\"  Skipped (duplicate): '{match.group(0).strip()[:40]}' \"\n   174→                        f\"at pos {position}\"\n   175→                    )\n   176→                    continue\n   177→\n   178→                # Extract title from match groups\n   179→                title = self._extract_title(match, pattern_def.description)\n   180→\n   181→                # Get the matched text as evidence\n   182→                evidence = match.group(0).strip()\n   183→\n   184→                # Adjust confidence based on context\n   185→                confidence = self._adjust_confidence(\n   186→                    text, position, pattern_def.confidence, pattern_def.description\n   187→                )\n   188→\n   189→                proposals.append(ChapterProposal(\n   190→                    strategy=self.name,\n   191→                    position=position,\n   192→                    title=title,\n   193→                    evidence=evidence,\n   194→                    confidence=confidence,\n   195→                    reasoning=f\"Matched pattern: {pattern_def.description}\",\n   196→                    is_hard_boundary=pattern_def.is_hard_boundary,\n   197→                ))\n   198→                seen_positions.add(position)\n   199→                pattern_matches += 1\n   200→\n   201→            if pattern_matches > 0:\n   202→                pattern_match_counts[pattern_def.description] = pattern_matches\n   203→\n   204→        # Log summary of matches found\n   205→        if pattern_match_counts:\n   206→            logger.info(f\"RegexProposer matches by pattern: {pattern_match_counts}\")\n   207→        logger.debug(\n   208→            f\"RegexProposer: skipped {skipped_front_matter} (front matter), \"\n   209→            f\"{skipped_duplicate} (duplicate)\"\n   210→        )\n   211→\n   212→        # Log all proposals before filtering\n   213→        logger.info(f\"RegexProposer: {len(proposals)} proposals before size filtering:\")\n   214→        for p in sorted(proposals, key=lambda x: x.position):\n   215→            logger.debug(f\"  pos={p.position}: '{p.title}' (conf={p.confidence:.2f})\")\n   216→\n   217→        # Filter proposals that are too close together (likely false positives)\n   218→        pre_filter_count = len(proposals)\n   219→        proposals = self._filter_too_close(text, proposals)\n   220→\n   221→        if len(proposals) != pre_filter_count:\n   222→            logger.info(\n   223→                f\"RegexProposer: filtered {pre_filter_count - len(proposals)} \"\n   224→                f\"proposals (too close), {len(proposals)} remaining\"\n   225→            )\n   226→\n   227→        # Sort by position\n   228→        proposals.sort(key=lambda p: p.position)\n   229→\n   230→        # Final summary\n   231→        logger.info(f\"RegexProposer: returning {len(proposals)} proposals\")\n   232→        for p in proposals:\n   233→            logger.info(f\"  [{p.position}] {p.title} (conf={p.confidence:.2f})\")\n   234→\n   235→        return proposals\n   236→\n   237→    def _extract_title(self, match: re.Match, pattern_type: str) -> Optional[str]:\n   238→        \"\"\"Extract chapter title from regex match.\"\"\"\n   239→        groups = match.groups()\n   240→\n   241→        if pattern_type in [\"explicit_chapter_numbered\", \"explicit_chapter_word_number\"]:\n   242→            # Groups: (Chapter/CHAPTER, number, optional title)\n   243→            base = f\"Chapter {groups[1]}\"\n   244→            if len(groups) > 2 and groups[2]:\n   245→                return f\"{base}: {groups[2].strip()}\"\n   246→            return base\n   247→\n   248→        elif pattern_type == \"part_marker\":\n   249→            base = f\"Part {groups[1]}\"\n   250→            if len(groups) > 2 and groups[2]:\n   251→                return f\"{base}: {groups[2].strip()}\"\n   252→            return base\n   253→\n   254→        elif pattern_type in [\"roman_numeral_centered\", \"roman_numeral_line\"]:\n   255→            return f\"Chapter {groups[0]}\"\n   256→\n   257→        elif pattern_type == \"arabic_numeral_centered\":\n   258→            return f\"Chapter {groups[0]}\"\n   259→\n   260→        elif pattern_type == \"all_caps_title\":\n   261→            return groups[0].strip().title()\n   262→\n   263→        elif pattern_type == \"special_section\":\n   264→            return groups[0].strip().title()\n   265→\n   266→        elif pattern_type == \"book_division\":\n   267→            base = f\"Book {groups[1]}\"\n   268→            if len(groups) > 2 and groups[2]:\n   269→                return f\"{base}: {groups[2].strip()}\"\n   270→            return base\n   271→\n   272→        return match.group(0).strip()\n   273→\n   274→    def _adjust_confidence(\n   275→        self,\n   276→        text: str,\n   277→        position: int,\n   278→        base_confidence: float,\n   279→        pattern_type: str,\n   280→    ) -> float:\n   281→        \"\"\"Adjust confidence based on context around the match.\"\"\"\n   282→        confidence = base_confidence\n   283→\n   284→        # Check if there's significant whitespace before (chapter markers often follow blank lines)\n   285→        before = text[max(0, position - 50):position]\n   286→        blank_lines_before = before.count(\"\\n\\n\") + before.count(\"\\n \\n\")\n   287→        if blank_lines_before >= 1:\n   288→            confidence = min(1.0, confidence + 0.05)\n   289→\n   290→        # Check if there's text after (not just end of document)\n   291→        after = text[position:min(len(text), position + 500)]\n   292→        if len(after.strip()) < 100:\n   293→            confidence -= 0.1  # Might be end matter, not a real chapter\n   294→\n   295→        # All caps titles need more validation - check they're not just headers in text\n   296→        if pattern_type == \"all_caps_title\":\n   297→            # Lower confidence if surrounded by regular text (not preceded by blank lines)\n   298→            if blank_lines_before < 1:\n   299→                confidence -= 0.2\n   300→\n   301→        return max(0.0, min(1.0, confidence))\n   302→\n   303→    def _filter_too_close(\n   304→        self,\n   305→        text: str,\n   306→        proposals: list[ChapterProposal],\n   307→    ) -> list[ChapterProposal]:\n   308→        \"\"\"Filter out proposals that would create chapters smaller than min_chapter_words.\"\"\"\n   309→        if len(proposals) < 2:\n   310→            return proposals\n   311→\n   312→        # Sort by position\n   313→        sorted_proposals = sorted(proposals, key=lambda p: p.position)\n   314→\n   315→        filtered = [sorted_proposals[0]]\n   316→        for proposal in sorted_proposals[1:]:\n   317→            last_pos = filtered[-1].position\n   318→            text_between = text[last_pos:proposal.position]\n   319→            word_count = len(text_between.split())\n   320→\n   321→            if word_count >= self.min_chapter_words:\n   322→                filtered.append(proposal)\n   323→            else:\n   324→                # Keep the one with higher confidence\n   325→                if proposal.confidence > filtered[-1].confidence:\n   326→                    logger.debug(\n   327→                        f\"  Replaced '{filtered[-1].title}' (conf={filtered[-1].confidence:.2f}) \"\n   328→                        f\"with '{proposal.title}' (conf={proposal.confidence:.2f}) \"\n   329→                        f\"- only {word_count} words between\"\n   330→                    )\n   331→                    filtered[-1] = proposal\n   332→                else:\n   333→                    logger.debug(\n   334→                        f\"  Discarded '{proposal.title}' (conf={proposal.confidence:.2f}) \"\n   335→                        f\"- only {word_count} words from '{filtered[-1].title}'\"\n   336→                    )\n   337→\n   338→        return filtered\n   339→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"44602e68-9e9b-4be9-ba12-3b6ee8adb801","uuid":"8b1c85e4-341f-46a9-b62c-853559a3e936","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/chapter_detection/proposers/regex.py","content":"\"\"\"\nRegex-based chapter proposer.\n\nThis is the deterministic baseline - fast, reproducible, no LLM dependency.\n\"\"\"\n\nimport re\nimport logging\nfrom typing import Optional\nfrom dataclasses import dataclass\n\nfrom .base import BaseProposer\nfrom ..models import ChapterProposal, DocumentProfile\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass ChapterPattern:\n    \"\"\"A pattern for detecting chapter markers.\"\"\"\n    pattern: re.Pattern\n    confidence: float\n    description: str\n    # F10: Explicit hard boundaries dominate over soft signals\n    is_hard_boundary: bool = False  # True for explicit markers\n\n\n# Patterns ordered from most to least specific\n# F10: Explicit markers (is_hard_boundary=True) dominate over soft signals\nCHAPTER_PATTERNS = [\n    # Explicit \"Chapter\" markers - HARD BOUNDARIES\n    ChapterPattern(\n        re.compile(r\"^\\s*(Chapter|CHAPTER)\\s+(\\d+|[IVXLC]+)(?:\\s*[:\\.\\-—–]\\s*(.+?))?$\", re.MULTILINE),\n        confidence=0.95,\n        description=\"explicit_chapter_numbered\",\n        is_hard_boundary=True,\n    ),\n    ChapterPattern(\n        re.compile(r\"^\\s*(CHAPTER|Chapter)\\s+([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)$\", re.MULTILINE),\n        confidence=0.90,\n        description=\"explicit_chapter_word_number\",\n        is_hard_boundary=True,\n    ),\n\n    # Part markers - HARD BOUNDARIES\n    ChapterPattern(\n        re.compile(r\"^\\s*(Part|PART)\\s+(\\d+|[IVXLC]+|One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten)(?:\\s*[:\\.\\-—–]\\s*(.+?))?$\", re.MULTILINE | re.IGNORECASE),\n        confidence=0.95,\n        description=\"part_marker\",\n        is_hard_boundary=True,\n    ),\n\n    # Roman numeral only (common in classic literature)\n    # STRICT: Must be centered (10+ spaces) - works for all Roman numerals including \"I\"\n    # HARD BOUNDARY\n    ChapterPattern(\n        re.compile(r\"^\\s{10,}([IVXLC]+)\\s*$\", re.MULTILINE),\n        confidence=0.85,\n        description=\"roman_numeral_centered\",\n        is_hard_boundary=True,\n    ),\n    # RELAXED but safer: Requires 2+ characters to avoid matching \"I\" pronoun in dialogue\n    # This is a softer signal, not a hard boundary\n    ChapterPattern(\n        re.compile(r\"^\\s*([IVXLC]{2,7})\\s*$\", re.MULTILINE),\n        confidence=0.70,\n        description=\"roman_numeral_line\",\n        is_hard_boundary=False,\n    ),\n\n    # Arabic numeral only (centered) - HARD BOUNDARY when centered\n    ChapterPattern(\n        re.compile(r\"^\\s{10,}(\\d{1,3})\\s*$\", re.MULTILINE),\n        confidence=0.75,\n        description=\"arabic_numeral_centered\",\n        is_hard_boundary=True,\n    ),\n\n    # Named chapters (all caps on own line) - softer signal\n    ChapterPattern(\n        re.compile(r\"^\\s*([A-Z][A-Z\\s]{5,40})\\s*$\", re.MULTILINE),\n        confidence=0.60,\n        description=\"all_caps_title\",\n        is_hard_boundary=False,\n    ),\n\n    # Prologue/Epilogue and other special sections - HARD BOUNDARIES\n    ChapterPattern(\n        re.compile(\n            r\"^\\s*(Prologue|PROLOGUE|Epilogue|EPILOGUE|Introduction|INTRODUCTION|Preface|PREFACE|\"\n            r\"Foreword|FOREWORD|Afterword|AFTERWORD|Appendix|APPENDIX|Acknowledgments|ACKNOWLEDGMENTS|\"\n            r\"Dedication|DEDICATION|Notes|NOTES|Glossary|GLOSSARY|Interlude|INTERLUDE|Intermezzo|INTERMEZZO)\\s*$\",\n            re.MULTILINE\n        ),\n        confidence=0.95,\n        description=\"special_section\",\n        is_hard_boundary=True,\n    ),\n\n    # Letters in epistolary novels (Letter 1, Letter I, etc.) - HARD BOUNDARIES\n    ChapterPattern(\n        re.compile(\n            r\"^\\s*(Letter|LETTER)\\s+(\\d+|[IVXLC]+|One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten)(?:\\s*[:\\.\\-—–]\\s*(.+?))?$\",\n            re.MULTILINE | re.IGNORECASE\n        ),\n        confidence=0.95,\n        description=\"letter_section\",\n        is_hard_boundary=True,\n    ),\n\n    # \"Book One\", \"Book Two\" etc. - HARD BOUNDARIES\n    ChapterPattern(\n        re.compile(r\"^\\s*(Book|BOOK)\\s+(\\d+|One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten|[IVXLC]+)(?:\\s*[:\\.\\-—–]\\s*(.+?))?$\", re.MULTILINE | re.IGNORECASE),\n        confidence=0.95,\n        description=\"book_division\",\n        is_hard_boundary=True,\n    ),\n]\n\n\nclass RegexProposer(BaseProposer):\n    \"\"\"\n    Proposes chapter boundaries using regex patterns.\n\n    This is the baseline proposer - deterministic and fast.\n    \"\"\"\n\n    name = \"regex\"\n\n    def __init__(self, min_chapter_words: int = 100):\n        \"\"\"\n        Args:\n            min_chapter_words: Minimum words between chapter markers to be considered valid\n        \"\"\"\n        self.min_chapter_words = min_chapter_words\n\n    def propose(\n        self,\n        text: str,\n        profile: Optional[DocumentProfile] = None,\n    ) -> list[ChapterProposal]:\n        \"\"\"Find chapter boundaries using regex patterns.\"\"\"\n        proposals = []\n        seen_positions = set()  # Avoid duplicates\n\n        # If we have a profile with front matter info, start after it\n        start_position = profile.front_matter_end if profile else 0\n        logger.debug(f\"RegexProposer: start_position={start_position} (front_matter_end)\")\n\n        # Track matches per pattern for debugging\n        pattern_match_counts = {}\n        skipped_front_matter = 0\n        skipped_duplicate = 0\n\n        for pattern_def in CHAPTER_PATTERNS:\n            pattern_matches = 0\n            for match in pattern_def.pattern.finditer(text):\n                position = match.start()\n\n                # Skip if in front matter\n                if position < start_position:\n                    skipped_front_matter += 1\n                    logger.debug(\n                        f\"  Skipped (front matter): '{match.group(0).strip()[:40]}' \"\n                        f\"at pos {position}\"\n                    )\n                    continue\n\n                # Skip if we already have a proposal very close to this position\n                if any(abs(position - p) < 50 for p in seen_positions):\n                    skipped_duplicate += 1\n                    logger.debug(\n                        f\"  Skipped (duplicate): '{match.group(0).strip()[:40]}' \"\n                        f\"at pos {position}\"\n                    )\n                    continue\n\n                # Extract title from match groups\n                title = self._extract_title(match, pattern_def.description)\n\n                # Get the matched text as evidence\n                evidence = match.group(0).strip()\n\n                # Adjust confidence based on context\n                confidence = self._adjust_confidence(\n                    text, position, pattern_def.confidence, pattern_def.description\n                )\n\n                proposals.append(ChapterProposal(\n                    strategy=self.name,\n                    position=position,\n                    title=title,\n                    evidence=evidence,\n                    confidence=confidence,\n                    reasoning=f\"Matched pattern: {pattern_def.description}\",\n                    is_hard_boundary=pattern_def.is_hard_boundary,\n                ))\n                seen_positions.add(position)\n                pattern_matches += 1\n\n            if pattern_matches > 0:\n                pattern_match_counts[pattern_def.description] = pattern_matches\n\n        # Log summary of matches found\n        if pattern_match_counts:\n            logger.info(f\"RegexProposer matches by pattern: {pattern_match_counts}\")\n        logger.debug(\n            f\"RegexProposer: skipped {skipped_front_matter} (front matter), \"\n            f\"{skipped_duplicate} (duplicate)\"\n        )\n\n        # Log all proposals before filtering\n        logger.info(f\"RegexProposer: {len(proposals)} proposals before size filtering:\")\n        for p in sorted(proposals, key=lambda x: x.position):\n            logger.debug(f\"  pos={p.position}: '{p.title}' (conf={p.confidence:.2f})\")\n\n        # Filter proposals that are too close together (likely false positives)\n        pre_filter_count = len(proposals)\n        proposals = self._filter_too_close(text, proposals)\n\n        if len(proposals) != pre_filter_count:\n            logger.info(\n                f\"RegexProposer: filtered {pre_filter_count - len(proposals)} \"\n                f\"proposals (too close), {len(proposals)} remaining\"\n            )\n\n        # Sort by position\n        proposals.sort(key=lambda p: p.position)\n\n        # Final summary\n        logger.info(f\"RegexProposer: returning {len(proposals)} proposals\")\n        for p in proposals:\n            logger.info(f\"  [{p.position}] {p.title} (conf={p.confidence:.2f})\")\n\n        return proposals\n\n    def _extract_title(self, match: re.Match, pattern_type: str) -> Optional[str]:\n        \"\"\"Extract chapter title from regex match.\"\"\"\n        groups = match.groups()\n\n        if pattern_type in [\"explicit_chapter_numbered\", \"explicit_chapter_word_number\"]:\n            # Groups: (Chapter/CHAPTER, number, optional title)\n            base = f\"Chapter {groups[1]}\"\n            if len(groups) > 2 and groups[2]:\n                return f\"{base}: {groups[2].strip()}\"\n            return base\n\n        elif pattern_type == \"part_marker\":\n            base = f\"Part {groups[1]}\"\n            if len(groups) > 2 and groups[2]:\n                return f\"{base}: {groups[2].strip()}\"\n            return base\n\n        elif pattern_type in [\"roman_numeral_centered\", \"roman_numeral_line\"]:\n            return f\"Chapter {groups[0]}\"\n\n        elif pattern_type == \"arabic_numeral_centered\":\n            return f\"Chapter {groups[0]}\"\n\n        elif pattern_type == \"all_caps_title\":\n            return groups[0].strip().title()\n\n        elif pattern_type == \"special_section\":\n            return groups[0].strip().title()\n\n        elif pattern_type == \"book_division\":\n            base = f\"Book {groups[1]}\"\n            if len(groups) > 2 and groups[2]:\n                return f\"{base}: {groups[2].strip()}\"\n            return base\n\n        return match.group(0).strip()\n\n    def _adjust_confidence(\n        self,\n        text: str,\n        position: int,\n        base_confidence: float,\n        pattern_type: str,\n    ) -> float:\n        \"\"\"Adjust confidence based on context around the match.\"\"\"\n        confidence = base_confidence\n\n        # Check if there's significant whitespace before (chapter markers often follow blank lines)\n        before = text[max(0, position - 50):position]\n        blank_lines_before = before.count(\"\\n\\n\") + before.count(\"\\n \\n\")\n        if blank_lines_before >= 1:\n            confidence = min(1.0, confidence + 0.05)\n\n        # Check if there's text after (not just end of document)\n        after = text[position:min(len(text), position + 500)]\n        if len(after.strip()) < 100:\n            confidence -= 0.1  # Might be end matter, not a real chapter\n\n        # All caps titles need more validation - check they're not just headers in text\n        if pattern_type == \"all_caps_title\":\n            # Lower confidence if surrounded by regular text (not preceded by blank lines)\n            if blank_lines_before < 1:\n                confidence -= 0.2\n\n        return max(0.0, min(1.0, confidence))\n\n    def _filter_too_close(\n        self,\n        text: str,\n        proposals: list[ChapterProposal],\n    ) -> list[ChapterProposal]:\n        \"\"\"Filter out proposals that would create chapters smaller than min_chapter_words.\"\"\"\n        if len(proposals) < 2:\n            return proposals\n\n        # Sort by position\n        sorted_proposals = sorted(proposals, key=lambda p: p.position)\n\n        filtered = [sorted_proposals[0]]\n        for proposal in sorted_proposals[1:]:\n            last_pos = filtered[-1].position\n            text_between = text[last_pos:proposal.position]\n            word_count = len(text_between.split())\n\n            if word_count >= self.min_chapter_words:\n                filtered.append(proposal)\n            else:\n                # Keep the one with higher confidence\n                if proposal.confidence > filtered[-1].confidence:\n                    logger.debug(\n                        f\"  Replaced '{filtered[-1].title}' (conf={filtered[-1].confidence:.2f}) \"\n                        f\"with '{proposal.title}' (conf={proposal.confidence:.2f}) \"\n                        f\"- only {word_count} words between\"\n                    )\n                    filtered[-1] = proposal\n                else:\n                    logger.debug(\n                        f\"  Discarded '{proposal.title}' (conf={proposal.confidence:.2f}) \"\n                        f\"- only {word_count} words from '{filtered[-1].title}'\"\n                    )\n\n        return filtered\n","numLines":339,"startLine":1,"totalLines":339}}}
