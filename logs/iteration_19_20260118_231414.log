th Montresor's chilling declaration that no one has disturbed the tomb in fifty years.</div>\n                \n                \n                <div class=\"chapter-characters\" style=\"margin-top: 0.75rem;\">\n                    <strong style=\"margin-right: 0.5rem; color: var(--muted);\">Characters:</strong>\n                    \n                    <span class=\"tag\">Montresor</span>\n                    \n                    <span class=\"tag\">Fortunato</span>\n                    \n                    \n                </div>\n                \n            </div>\n            \n        </section>\n        </div>\n\n        <div id=\"characters\" class=\"tab-content\">\n        <section>\n            <h2>👥 Character Guide</h2>\n\n            <!-- Confidence Filter -->\n            <div style=\"margin-bottom: 1.5rem;\">\n                <label style=\"color: var(--muted); margin-right: 0.5rem;\">\n                    <input type=\"checkbox\" id=\"show-low-confidence-only\" onchange=\"filterByConfidence(this.checked)\">\n                    Show only low-confidence items\n                </label>\n            </div>\n\n            \n            <div class=\"character-group\">\n                <h3>Main Characters <span class=\"count\">1</span></h3>\n\n                \n                <div class=\"character-profile character-item\" data-confidence=\"high\">\n                    <h4>\n                        Fortunato\n                        \n                        \n                        <span class=\"confidence-badge high\" title=\"Confidence: high\">\n                            ✓\n                            \n                        </span>\n                    </h4>\n\n                    \n\n                    \n                    \n\n                    \n\n                    \n\n                    \n                    \n\n                    \n                    \n                    <div class=\"profile-body\">Fortunato is a prideful and i