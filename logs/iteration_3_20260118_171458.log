{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NwbrcikNNaAyLzBtnoVVNX","type":"tool_result","content":"     1→\"\"\"\n     2→Character proposal validator.\n     3→\n     4→Validates character proposals and identifies potential aliases.\n     5→\"\"\"\n     6→\n     7→import re\n     8→import time\n     9→from typing import Optional\n    10→import logging\n    11→\n    12→from .models import CharacterProposal, CharacterValidationResult\n    13→from .constants import NICKNAME_MAP\n    14→from ..llm import LLMClient\n    15→\n    16→logger = logging.getLogger(__name__)\n    17→\n    18→\n    19→# Known non-person entities that might be detected as characters\n    20→PLACE_NAMES = {\n    21→    'london', 'paris', 'new york', 'england', 'america', 'france', 'germany',\n    22→    'broadway', 'manhattan',\n    23→}\n    24→\n    25→TITLE_ONLY_PATTERN = re.compile(\n    26→    r'^(mr|mrs|ms|miss|dr|sir|lady|lord|captain|colonel|general|'\n    27→    r'professor|doctor|king|queen|prince|princess|duke|duchess)\\.?$',\n    28→    re.IGNORECASE\n    29→)\n    30→\n    31→# Words that indicate character context\n    32→CHARACTER_VERBS = {\n    33→    'said', 'asked', 'replied', 'whispered', 'shouted', 'muttered',\n    34→    'thought', 'wondered', 'felt', 'looked', 'smiled', 'laughed',\n    35→    'walked', 'ran', 'stood', 'sat', 'turned', 'nodded',\n    36→}\n    37→\n    38→\n    39→VALIDATION_SYSTEM_PROMPT = \"\"\"You are a literary analyst validating character names.\n    40→\n    41→Your task is to determine if a proposed name refers to a real character (person) in the story,\n    42→and identify other names that might refer to the same person.\n    43→\n    44→Consider:\n    45→- Is this a person's name (not a place, title alone, or abstract concept)?\n    46→- Does the context suggest this is a character who acts, speaks, or is spoken about?\n    47→- What other names/titles might refer to the same person?\"\"\"\n    48→\n    49→\n    50→VALIDATION_PROMPT_TEMPLATE = \"\"\"Validate this character proposal from a novel:\n    51→\n    52→PROPOSED NAME: {name}\n    53→STRATEGY: {strategy}\n    54→MENTION COUNT: {mention_count}\n    55→\n    56→SAMPLE CONTEXTS (where this name appears):\n    57→{contexts}\n    58→\n    59→Please analyze and return JSON with:\n    60→- \"is_person\": true/false - Is this a real person/character name (not a place, title, or concept)?\n    61→- \"is_person_reasoning\": Brief explanation\n    62→- \"context_supports\": 0.0-1.0 - How strongly does the context support this being a character?\n    63→- \"alias_candidates\": List of other names that might refer to the same person (e.g., \"Elizabeth\" -> [\"Lizzy\", \"Miss Bennet\"])\n    64→- \"overall_valid\": true/false - Should we include this as a character?\n    65→\n    66→Return ONLY valid JSON.\"\"\"\n    67→\n    68→\n    69→class CharacterValidator:\n    70→    \"\"\"\n    71→    Validates character proposals using heuristics and LLM.\n    72→\n    73→    Uses fast heuristics for clear cases, LLM for ambiguous ones.\n    74→    \"\"\"\n    75→\n    76→    def __init__(\n    77→        self,\n    78→        llm_client: Optional[LLMClient] = None,\n    79→        min_confidence: float = 0.5,\n    80→        use_llm_validation: bool = True,\n    81→    ):\n    82→        \"\"\"\n    83→        Args:\n    84→            llm_client: LLM client for ambiguous cases\n    85→            min_confidence: Minimum score to consider valid\n    86→            use_llm_validation: Whether to use LLM for validation\n    87→        \"\"\"\n    88→        self.llm = llm_client\n    89→        self.min_confidence = min_confidence\n    90→        self.use_llm_validation = use_llm_validation and llm_client is not None\n    91→\n    92→    def validate(self, proposal: CharacterProposal) -> CharacterValidationResult:\n    93→        \"\"\"Validate a single character proposal.\"\"\"\n    94→        # Quick heuristic checks\n    95→        heuristic_result = self._heuristic_validation(proposal)\n    96→\n    97→        if heuristic_result is not None:\n    98→            return heuristic_result\n    99→\n   100→        # Use LLM for ambiguous cases\n   101→        if self.use_llm_validation:\n   102→            return self._llm_validation(proposal)\n   103→\n   104→        # No LLM validation available - fail fast instead of using fallback confidence\n   105→        error_msg = f\"LLM validation is required but not enabled for proposal '{proposal.name}'\"\n   106→        logger.error(error_msg)\n   107→        raise ValueError(error_msg)\n   108→\n   109→    def validate_batch(\n   110→        self,\n   111→        proposals: list[CharacterProposal],\n   112→    ) -> list[CharacterValidationResult]:\n   113→        \"\"\"Validate multiple proposals.\"\"\"\n   114→        return [self.validate(p) for p in proposals]\n   115→\n   116→    def _heuristic_validation(\n   117→        self,\n   118→        proposal: CharacterProposal,\n   119→    ) -> Optional[CharacterValidationResult]:\n   120→        \"\"\"\n   121→        Apply fast heuristic checks.\n   122→\n   123→        Returns ValidationResult if we can determine validity,\n   124→        None if LLM validation is needed.\n   125→        \"\"\"\n   126→        name = proposal.name\n   127→        name_lower = name.lower()\n   128→\n   129→        # Reject: known places\n   130→        if name_lower in PLACE_NAMES:\n   131→            return CharacterValidationResult(\n   132→                proposal=proposal,\n   133→                is_person_score=0.0,\n   134→                context_score=0.0,\n   135→                alias_candidates=[],\n   136→                overall_score=0.0,\n   137→                is_valid=False,\n   138→                reasoning=f\"'{name}' is a known place name\",\n   139→            )\n   140→\n   141→        # Reject: title only (no actual name)\n   142→        if TITLE_ONLY_PATTERN.match(name):\n   143→            return CharacterValidationResult(\n   144→                proposal=proposal,\n   145→                is_person_score=0.0,\n   146→                context_score=0.0,\n   147→                alias_candidates=[],\n   148→                overall_score=0.0,\n   149→                is_valid=False,\n   150→                reasoning=f\"'{name}' is a title without a name\",\n   151→            )\n   152→\n   153→        # Accept: high mention count with dialogue\n   154→        dialogue_mentions = sum(1 for m in proposal.mentions if m.in_dialogue)\n   155→        if proposal.mention_count >= 10 and dialogue_mentions >= 3:\n   156→            # Strong signal: mentioned often and speaks\n   157→            alias_candidates = self._find_obvious_aliases(proposal)\n   158→            return CharacterValidationResult(\n   159→                proposal=proposal,\n   160→                is_person_score=0.95,\n   161→                context_score=0.9,\n   162→                alias_candidates=alias_candidates,\n   163→                overall_score=0.92,\n   164→                is_valid=True,\n   165→                reasoning=f\"High mention count ({proposal.mention_count}) with dialogue ({dialogue_mentions} in speech)\",\n   166→            )\n   167→\n   168→        # Accept: appears in dialogue tags (said X, asked X)\n   169→        dialogue_tag_count = self._count_dialogue_tags(proposal)\n   170→        if dialogue_tag_count >= 2:\n   171→            alias_candidates = self._find_obvious_aliases(proposal)\n   172→            return CharacterValidationResult(\n   173→                proposal=proposal,\n   174→                is_person_score=0.9,\n   175→                context_score=0.85,\n   176→                alias_candidates=alias_candidates,\n   177→                overall_score=0.87,\n   178→                is_valid=True,\n   179→                reasoning=f\"Appears in {dialogue_tag_count} dialogue tags (said/asked/replied)\",\n   180→            )\n   181→\n   182→        # Accept: titled name (Mr. Smith, Mrs. Jones)\n   183→        if re.match(r'^(Mr|Mrs|Ms|Miss|Dr|Sir|Lady|Lord)\\.?\\s+\\w+', name):\n   184→            alias_candidates = self._find_obvious_aliases(proposal)\n   185→            return CharacterValidationResult(\n   186→                proposal=proposal,\n   187→                is_person_score=0.85,\n   188→                context_score=0.8,\n   189→                alias_candidates=alias_candidates,\n   190→                overall_score=0.82,\n   191→                is_valid=True,\n   192→                reasoning=f\"Titled name pattern suggests person\",\n   193→            )\n   194→\n   195→        # Reject: single mention, no dialogue\n   196→        if proposal.mention_count == 1 and dialogue_mentions == 0:\n   197→            # Check context for character verbs\n   198→            context = proposal.mentions[0].context.lower() if proposal.mentions else \"\"\n   199→            has_character_verb = any(verb in context for verb in CHARACTER_VERBS)\n   200→\n   201→            if not has_character_verb:\n   202→                return CharacterValidationResult(\n   203→                    proposal=proposal,\n   204→                    is_person_score=0.3,\n   205→                    context_score=0.2,\n   206→                    alias_candidates=[],\n   207→                    overall_score=0.25,\n   208→                    is_valid=False,\n   209→                    reasoning=\"Single mention without dialogue or character verbs\",\n   210→                )\n   211→\n   212→        # Ambiguous: need LLM validation\n   213→        return None\n   214→\n   215→    def _llm_validation(self, proposal: CharacterProposal) -> CharacterValidationResult:\n   216→        \"\"\"Use LLM to validate ambiguous cases.\"\"\"\n   217→        # Prepare sample contexts\n   218→        contexts = []\n   219→        for mention in proposal.mentions[:5]:  # Up to 5 examples\n   220→            context_preview = mention.context[:200] if len(mention.context) > 200 else mention.context\n   221→            dialogue_marker = \"[in dialogue]\" if mention.in_dialogue else \"[narrative]\"\n   222→            contexts.append(f\"  {dialogue_marker} ...{context_preview}...\")\n   223→\n   224→        contexts_str = \"\\n\".join(contexts)\n   225→\n   226→        prompt = VALIDATION_PROMPT_TEMPLATE.format(\n   227→            name=proposal.name,\n   228→            strategy=proposal.strategy,\n   229→            mention_count=proposal.mention_count,\n   230→            contexts=contexts_str,\n   231→        )\n   232→\n   233→        # Retry logic with exponential backoff\n   234→        max_retries = 2\n   235→        last_error = None\n   236→\n   237→        for attempt in range(max_retries + 1):\n   238→            result, response = self.llm.query_json(prompt, system=VALIDATION_SYSTEM_PROMPT)\n   239→\n   240→            if not response.success:\n   241→                last_error = f\"LLM query failed: {response.error}\"\n   242→                logger.warning(f\"LLM validation attempt {attempt + 1} for '{proposal.name}' failed: {last_error}\")\n   243→                if attempt < max_retries:\n   244→                    time.sleep(2 ** attempt)  # Exponential backoff: 1s, 2s, 4s\n   245→                    continue\n   246→                else:\n   247→                    raise ValueError(f\"LLM validation failed for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\")\n   248→\n   249→            if result is None or not isinstance(result, dict):\n   250→                error_detail = f\"got {type(result).__name__}\" if result is not None else \"failed to parse JSON\"\n   251→                last_error = f\"Invalid JSON: {error_detail}\"\n   252→                logger.warning(f\"LLM validation attempt {attempt + 1} for '{proposal.name}' returned invalid JSON: {error_detail}\")\n   253→                if attempt < max_retries:\n   254→                    time.sleep(2 ** attempt)\n   255→                    continue\n   256→                else:\n   257→                    raise ValueError(f\"LLM validation returned invalid JSON for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\")\n   258→\n   259→            # Success - parse LLM response\n   260→            break\n   261→\n   262→        # Parse LLM response\n   263→        is_person = result.get(\"is_person\", True)\n   264→        is_person_score = 0.9 if is_person else 0.1\n   265→        # F14: Warn when LLM doesn't return context_supports score\n   266→        context_supports_raw = result.get(\"context_supports\")\n   267→        if context_supports_raw is None:\n   268→            logger.warning(\n   269→                f\"LLM validation for '{proposal.name}' did not return context_supports - \"\n   270→                \"using neutral default 0.5\"\n   271→            )\n   272→            context_score = 0.5\n   273→        else:\n   274→            context_score = float(context_supports_raw)\n   275→        alias_candidates = result.get(\"alias_candidates\", [])\n   276→        overall_valid = result.get(\"overall_valid\", is_person)\n   277→        reasoning = result.get(\"is_person_reasoning\", \"LLM validation\")\n   278→\n   279→        # F16: Include mention count in overall_score calculation\n   280→        # High-mention characters should get higher confidence scores\n   281→        base_score = (is_person_score + context_score) / 2\n   282→\n   283→        # Mention count boost: characters with many mentions are more likely real\n   284→        mention_count = proposal.mention_count\n   285→        if mention_count >= 100:\n   286→            mention_boost = 0.15\n   287→        elif mention_count >= 50:\n   288→            mention_boost = 0.10\n   289→        elif mention_count >= 20:\n   290→            mention_boost = 0.05\n   291→        elif mention_count >= 10:\n   292→            mention_boost = 0.02\n   293→        else:\n   294→            mention_boost = 0.0\n   295→\n   296→        overall_score = min(1.0, base_score + mention_boost)\n   297→\n   298→        logger.debug(\n   299→            f\"Validation score for '{proposal.name}': base={base_score:.2f}, \"\n   300→            f\"mention_boost={mention_boost:.2f} ({mention_count} mentions), \"\n   301→            f\"final={overall_score:.2f}\"\n   302→        )\n   303→\n   304→        return CharacterValidationResult(\n   305→            proposal=proposal,\n   306→            is_person_score=is_person_score,\n   307→            context_score=context_score,\n   308→            alias_candidates=alias_candidates,\n   309→            overall_score=overall_score,\n   310→            is_valid=overall_valid and overall_score >= self.min_confidence,\n   311→            reasoning=reasoning,\n   312→        )\n   313→\n   314→    def _count_dialogue_tags(self, proposal: CharacterProposal) -> int:\n   315→        \"\"\"Count how often the name appears in dialogue tags.\"\"\"\n   316→        count = 0\n   317→        name_pattern = re.escape(proposal.name)\n   318→\n   319→        # Patterns like: said Nick, asked Gatsby, replied Jordan\n   320→        tag_patterns = [\n   321→            rf'said\\s+{name_pattern}',\n   322→            rf'asked\\s+{name_pattern}',\n   323→            rf'replied\\s+{name_pattern}',\n   324→            rf'whispered\\s+{name_pattern}',\n   325→            rf'shouted\\s+{name_pattern}',\n   326→            rf'{name_pattern}\\s+said',\n   327→            rf'{name_pattern}\\s+asked',\n   328→            rf'{name_pattern}\\s+replied',\n   329→        ]\n   330→\n   331→        for mention in proposal.mentions:\n   332→            context = mention.context\n   333→            for pattern in tag_patterns:\n   334→                if re.search(pattern, context, re.IGNORECASE):\n   335→                    count += 1\n   336→                    break  # Count each mention only once\n   337→\n   338→        return count\n   339→\n   340→    def _find_obvious_aliases(self, proposal: CharacterProposal) -> list[str]:\n   341→        \"\"\"Find obvious alias candidates based on the name.\"\"\"\n   342→        aliases = []\n   343→        name = proposal.name\n   344→\n   345→        # Extract first and last name\n   346→        parts = name.split()\n   347→\n   348→        if len(parts) >= 2:\n   349→            first_name = parts[0]\n   350→            last_name = parts[-1]\n   351→\n   352→            # Handle titles\n   353→            if first_name.lower().rstrip('.') in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n   354→                if len(parts) >= 3:\n   355→                    first_name = parts[1]\n   356→                    last_name = parts[-1]\n   357→                else:\n   358→                    first_name = None\n   359→                    last_name = parts[-1]\n   360→\n   361→            if first_name:\n   362→                aliases.append(first_name)\n   363→\n   364→            # NOTE: We do NOT generate phantom titled versions here (e.g., \"Mr. LastName\")\n   365→            # because they may not exist in the text. The consensus stage, which has access\n   366→            # to all character names, will handle alias detection with the LLM's help.\n   367→            # Generating phantom aliases pollutes the system and wastes LLM tokens.\n   368→\n   369→        # Use shared nickname map from constants module\n   370→        name_lower = name.lower()\n   371→        for full_name, nicknames in NICKNAME_MAP.items():\n   372→            if full_name in name_lower:\n   373→                aliases.extend([n.title() for n in nicknames])\n   374→            elif any(nick in name_lower for nick in nicknames):\n   375→                aliases.append(full_name.title())\n   376→\n   377→        return list(set(aliases))\n   378→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"eb6051e2-acb8-49c7-9168-f3c046842986","uuid":"603cc15a-97a1-4e97-a4c5-98f3ff4d18a1","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/validator.py","content":"\"\"\"\nCharacter proposal validator.\n\nValidates character proposals and identifies potential aliases.\n\"\"\"\n\nimport re\nimport time\nfrom typing import Optional\nimport logging\n\nfrom .models import CharacterProposal, CharacterValidationResult\nfrom .constants import NICKNAME_MAP\nfrom ..llm import LLMClient\n\nlogger = logging.getLogger(__name__)\n\n\n# Known non-person entities that might be detected as characters\nPLACE_NAMES = {\n    'london', 'paris', 'new york', 'england', 'america', 'france', 'germany',\n    'broadway', 'manhattan',\n}\n\nTITLE_ONLY_PATTERN = re.compile(\n    r'^(mr|mrs|ms|miss|dr|sir|lady|lord|captain|colonel|general|'\n    r'professor|doctor|king|queen|prince|princess|duke|duchess)\\.?$',\n    re.IGNORECASE\n)\n\n# Words that indicate character context\nCHARACTER_VERBS = {\n    'said', 'asked', 'replied', 'whispered', 'shouted', 'muttered',\n    'thought', 'wondered', 'felt', 'looked', 'smiled', 'laughed',\n    'walked', 'ran', 'stood', 'sat', 'turned', 'nodded',\n}\n\n\nVALIDATION_SYSTEM_PROMPT = \"\"\"You are a literary analyst validating character names.\n\nYour task is to determine if a proposed name refers to a real character (person) in the story,\nand identify other names that might refer to the same person.\n\nConsider:\n- Is this a person's name (not a place, title alone, or abstract concept)?\n- Does the context suggest this is a character who acts, speaks, or is spoken about?\n- What other names/titles might refer to the same person?\"\"\"\n\n\nVALIDATION_PROMPT_TEMPLATE = \"\"\"Validate this character proposal from a novel:\n\nPROPOSED NAME: {name}\nSTRATEGY: {strategy}\nMENTION COUNT: {mention_count}\n\nSAMPLE CONTEXTS (where this name appears):\n{contexts}\n\nPlease analyze and return JSON with:\n- \"is_person\": true/false - Is this a real person/character name (not a place, title, or concept)?\n- \"is_person_reasoning\": Brief explanation\n- \"context_supports\": 0.0-1.0 - How strongly does the context support this being a character?\n- \"alias_candidates\": List of other names that might refer to the same person (e.g., \"Elizabeth\" -> [\"Lizzy\", \"Miss Bennet\"])\n- \"overall_valid\": true/false - Should we include this as a character?\n\nReturn ONLY valid JSON.\"\"\"\n\n\nclass CharacterValidator:\n    \"\"\"\n    Validates character proposals using heuristics and LLM.\n\n    Uses fast heuristics for clear cases, LLM for ambiguous ones.\n    \"\"\"\n\n    def __init__(\n        self,\n        llm_client: Optional[LLMClient] = None,\n        min_confidence: float = 0.5,\n        use_llm_validation: bool = True,\n    ):\n        \"\"\"\n        Args:\n            llm_client: LLM client for ambiguous cases\n            min_confidence: Minimum score to consider valid\n            use_llm_validation: Whether to use LLM for validation\n        \"\"\"\n        self.llm = llm_client\n        self.min_confidence = min_confidence\n        self.use_llm_validation = use_llm_validation and llm_client is not None\n\n    def validate(self, proposal: CharacterProposal) -> CharacterValidationResult:\n        \"\"\"Validate a single character proposal.\"\"\"\n        # Quick heuristic checks\n        heuristic_result = self._heuristic_validation(proposal)\n\n        if heuristic_result is not None:\n            return heuristic_result\n\n        # Use LLM for ambiguous cases\n        if self.use_llm_validation:\n            return self._llm_validation(proposal)\n\n        # No LLM validation available - fail fast instead of using fallback confidence\n        error_msg = f\"LLM validation is required but not enabled for proposal '{proposal.name}'\"\n        logger.error(error_msg)\n        raise ValueError(error_msg)\n\n    def validate_batch(\n        self,\n        proposals: list[CharacterProposal],\n    ) -> list[CharacterValidationResult]:\n        \"\"\"Validate multiple proposals.\"\"\"\n        return [self.validate(p) for p in proposals]\n\n    def _heuristic_validation(\n        self,\n        proposal: CharacterProposal,\n    ) -> Optional[CharacterValidationResult]:\n        \"\"\"\n        Apply fast heuristic checks.\n\n        Returns ValidationResult if we can determine validity,\n        None if LLM validation is needed.\n        \"\"\"\n        name = proposal.name\n        name_lower = name.lower()\n\n        # Reject: known places\n        if name_lower in PLACE_NAMES:\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.0,\n                context_score=0.0,\n                alias_candidates=[],\n                overall_score=0.0,\n                is_valid=False,\n                reasoning=f\"'{name}' is a known place name\",\n            )\n\n        # Reject: title only (no actual name)\n        if TITLE_ONLY_PATTERN.match(name):\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.0,\n                context_score=0.0,\n                alias_candidates=[],\n                overall_score=0.0,\n                is_valid=False,\n                reasoning=f\"'{name}' is a title without a name\",\n            )\n\n        # Accept: high mention count with dialogue\n        dialogue_mentions = sum(1 for m in proposal.mentions if m.in_dialogue)\n        if proposal.mention_count >= 10 and dialogue_mentions >= 3:\n            # Strong signal: mentioned often and speaks\n            alias_candidates = self._find_obvious_aliases(proposal)\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.95,\n                context_score=0.9,\n                alias_candidates=alias_candidates,\n                overall_score=0.92,\n                is_valid=True,\n                reasoning=f\"High mention count ({proposal.mention_count}) with dialogue ({dialogue_mentions} in speech)\",\n            )\n\n        # Accept: appears in dialogue tags (said X, asked X)\n        dialogue_tag_count = self._count_dialogue_tags(proposal)\n        if dialogue_tag_count >= 2:\n            alias_candidates = self._find_obvious_aliases(proposal)\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.9,\n                context_score=0.85,\n                alias_candidates=alias_candidates,\n                overall_score=0.87,\n                is_valid=True,\n                reasoning=f\"Appears in {dialogue_tag_count} dialogue tags (said/asked/replied)\",\n            )\n\n        # Accept: titled name (Mr. Smith, Mrs. Jones)\n        if re.match(r'^(Mr|Mrs|Ms|Miss|Dr|Sir|Lady|Lord)\\.?\\s+\\w+', name):\n            alias_candidates = self._find_obvious_aliases(proposal)\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.85,\n                context_score=0.8,\n                alias_candidates=alias_candidates,\n                overall_score=0.82,\n                is_valid=True,\n                reasoning=f\"Titled name pattern suggests person\",\n            )\n\n        # Reject: single mention, no dialogue\n        if proposal.mention_count == 1 and dialogue_mentions == 0:\n            # Check context for character verbs\n            context = proposal.mentions[0].context.lower() if proposal.mentions else \"\"\n            has_character_verb = any(verb in context for verb in CHARACTER_VERBS)\n\n            if not has_character_verb:\n                return CharacterValidationResult(\n                    proposal=proposal,\n                    is_person_score=0.3,\n                    context_score=0.2,\n                    alias_candidates=[],\n                    overall_score=0.25,\n                    is_valid=False,\n                    reasoning=\"Single mention without dialogue or character verbs\",\n                )\n\n        # Ambiguous: need LLM validation\n        return None\n\n    def _llm_validation(self, proposal: CharacterProposal) -> CharacterValidationResult:\n        \"\"\"Use LLM to validate ambiguous cases.\"\"\"\n        # Prepare sample contexts\n        contexts = []\n        for mention in proposal.mentions[:5]:  # Up to 5 examples\n            context_preview = mention.context[:200] if len(mention.context) > 200 else mention.context\n            dialogue_marker = \"[in dialogue]\" if mention.in_dialogue else \"[narrative]\"\n            contexts.append(f\"  {dialogue_marker} ...{context_preview}...\")\n\n        contexts_str = \"\\n\".join(contexts)\n\n        prompt = VALIDATION_PROMPT_TEMPLATE.format(\n            name=proposal.name,\n            strategy=proposal.strategy,\n            mention_count=proposal.mention_count,\n            contexts=contexts_str,\n        )\n\n        # Retry logic with exponential backoff\n        max_retries = 2\n        last_error = None\n\n        for attempt in range(max_retries + 1):\n            result, response = self.llm.query_json(prompt, system=VALIDATION_SYSTEM_PROMPT)\n\n            if not response.success:\n                last_error = f\"LLM query failed: {response.error}\"\n                logger.warning(f\"LLM validation attempt {attempt + 1} for '{proposal.name}' failed: {last_error}\")\n                if attempt < max_retries:\n                    time.sleep(2 ** attempt)  # Exponential backoff: 1s, 2s, 4s\n                    continue\n                else:\n                    raise ValueError(f\"LLM validation failed for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\")\n\n            if result is None or not isinstance(result, dict):\n                error_detail = f\"got {type(result).__name__}\" if result is not None else \"failed to parse JSON\"\n                last_error = f\"Invalid JSON: {error_detail}\"\n                logger.warning(f\"LLM validation attempt {attempt + 1} for '{proposal.name}' returned invalid JSON: {error_detail}\")\n                if attempt < max_retries:\n                    time.sleep(2 ** attempt)\n                    continue\n                else:\n                    raise ValueError(f\"LLM validation returned invalid JSON for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\")\n\n            # Success - parse LLM response\n            break\n\n        # Parse LLM response\n        is_person = result.get(\"is_person\", True)\n        is_person_score = 0.9 if is_person else 0.1\n        # F14: Warn when LLM doesn't return context_supports score\n        context_supports_raw = result.get(\"context_supports\")\n        if context_supports_raw is None:\n            logger.warning(\n                f\"LLM validation for '{proposal.name}' did not return context_supports - \"\n                \"using neutral default 0.5\"\n            )\n            context_score = 0.5\n        else:\n            context_score = float(context_supports_raw)\n        alias_candidates = result.get(\"alias_candidates\", [])\n        overall_valid = result.get(\"overall_valid\", is_person)\n        reasoning = result.get(\"is_person_reasoning\", \"LLM validation\")\n\n        # F16: Include mention count in overall_score calculation\n        # High-mention characters should get higher confidence scores\n        base_score = (is_person_score + context_score) / 2\n\n        # Mention count boost: characters with many mentions are more likely real\n        mention_count = proposal.mention_count\n        if mention_count >= 100:\n            mention_boost = 0.15\n        elif mention_count >= 50:\n            mention_boost = 0.10\n        elif mention_count >= 20:\n            mention_boost = 0.05\n        elif mention_count >= 10:\n            mention_boost = 0.02\n        else:\n            mention_boost = 0.0\n\n        overall_score = min(1.0, base_score + mention_boost)\n\n        logger.debug(\n            f\"Validation score for '{proposal.name}': base={base_score:.2f}, \"\n            f\"mention_boost={mention_boost:.2f} ({mention_count} mentions), \"\n            f\"final={overall_score:.2f}\"\n        )\n\n        return CharacterValidationResult(\n            proposal=proposal,\n            is_person_score=is_person_score,\n            context_score=context_score,\n            alias_candidates=alias_candidates,\n            overall_score=overall_score,\n            is_valid=overall_valid and overall_score >= self.min_confidence,\n            reasoning=reasoning,\n        )\n\n    def _count_dialogue_tags(self, proposal: CharacterProposal) -> int:\n        \"\"\"Count how often the name appears in dialogue tags.\"\"\"\n        count = 0\n        name_pattern = re.escape(proposal.name)\n\n        # Patterns like: said Nick, asked Gatsby, replied Jordan\n        tag_patterns = [\n            rf'said\\s+{name_pattern}',\n            rf'asked\\s+{name_pattern}',\n            rf'replied\\s+{name_pattern}',\n            rf'whispered\\s+{name_pattern}',\n            rf'shouted\\s+{name_pattern}',\n            rf'{name_pattern}\\s+said',\n            rf'{name_pattern}\\s+asked',\n            rf'{name_pattern}\\s+replied',\n        ]\n\n        for mention in proposal.mentions:\n            context = mention.context\n            for pattern in tag_patterns:\n                if re.search(pattern, context, re.IGNORECASE):\n                    count += 1\n                    break  # Count each mention only once\n\n        return count\n\n    def _find_obvious_aliases(self, proposal: CharacterProposal) -> list[str]:\n        \"\"\"Find obvious alias candidates based on the name.\"\"\"\n        aliases = []\n        name = proposal.name\n\n        # Extract first and last name\n        parts = name.split()\n\n        if len(parts) >= 2:\n            first_name = parts[0]\n            last_name = parts[-1]\n\n            # Handle titles\n            if first_name.lower().rstrip('.') in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n                if len(parts) >= 3:\n                    first_name = parts[1]\n                    last_name = parts[-1]\n                else:\n                    first_name = None\n                    last_name = parts[-1]\n\n            if first_name:\n                aliases.append(first_name)\n\n            # NOTE: We do NOT generate phantom titled versions here (e.g., \"Mr. LastName\")\n            # because they may not exist in the text. The consensus stage, which has access\n            # to all character names, will handle alias detection with the LLM's help.\n            # Generating phantom aliases pollutes the system and wastes LLM tokens.\n\n        # Use shared nickname map from constants module\n        name_lower = name.lower()\n        for full_name, nicknames in NICKNAME_MAP.items():\n            if full_name in name_lower:\n                aliases.extend([n.title() for n in nicknames])\n            elif any(nick in name_lower for nick in nicknames):\n                aliases.append(full_name.title())\n\n        return list(set(aliases))\n","numLines":378,"startLine":1,"totalLines":378}}}
