{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Q69G1CrfbVQXjiHSM4AmY","type":"tool_result","content":"     1→\"\"\"\n     2→Character extraction pipeline orchestrator.\n     3→\n     4→Coordinates the full character extraction workflow with checkpointing.\n     5→\"\"\"\n     6→\n     7→import hashlib\n     8→from pathlib import Path\n     9→from datetime import datetime\n    10→from typing import Optional, Callable\n    11→import logging\n    12→\n    13→from .models import (\n    14→    CharacterProposal,\n    15→    CharacterValidationResult,\n    16→    CharacterMap,\n    17→    CharacterPipelineCheckpoint,\n    18→)\n    19→from .proposers import BaseCharacterProposer, NERProposer, LLMCharacterProposer, create_coreference_proposer\n    20→from .validator import CharacterValidator\n    21→from .consensus import CharacterConsensusBuilder\n    22→from ..chapter_detection.models import ChapterMap as ChapterDetectionMap\n    23→from ..llm import LLMClient\n    24→\n    25→logger = logging.getLogger(__name__)\n    26→\n    27→\n    28→class CharacterExtractionPipeline:\n    29→    \"\"\"\n    30→    Orchestrates the full character extraction workflow.\n    31→\n    32→    Stages:\n    33→    1. Extraction: Run proposers on each chapter\n    34→    2. Validation: Validate each proposal\n    35→    3. Consensus: Merge across chapters, resolve aliases\n    36→\n    37→    Supports checkpointing to save/resume progress.\n    38→    \"\"\"\n    39→\n    40→    def __init__(\n    41→        self,\n    42→        llm_client: Optional[LLMClient] = None,\n    43→        proposers: Optional[list[BaseCharacterProposer]] = None,\n    44→        validator: Optional[CharacterValidator] = None,\n    45→        consensus_builder: Optional[CharacterConsensusBuilder] = None,\n    46→        checkpoint_dir: Optional[Path] = None,\n    47→        progress_callback: Optional[Callable[[str, int, int], None]] = None,\n    48→        llm_chunk_size: int = 8000,\n    49→        mention_context_window: int = 100,\n    50→        enable_coreference: bool = False,\n    51→    ):\n    52→        \"\"\"\n    53→        Args:\n    54→            llm_client: LLM client for LLM-based extraction and validation\n    55→            proposers: List of character proposers (default: NER + LLM if client provided)\n    56→            validator: Character validator instance\n    57→            consensus_builder: Consensus builder instance\n    58→            checkpoint_dir: Directory for saving checkpoints\n    59→            progress_callback: Callback(stage, current, total) for progress updates\n    60→            enable_coreference: Whether to enable coreference resolution (requires coreferee)\n    61→        \"\"\"\n    62→        self.llm = llm_client\n    63→        self.checkpoint_dir = checkpoint_dir\n    64→        self.progress_callback = progress_callback\n    65→\n    66→        # Set up proposers\n    67→        if proposers is not None:\n    68→            self.proposers = proposers\n    69→        else:\n    70→            self.proposers = [NERProposer(context_window=mention_context_window)]\n    71→            if llm_client:\n    72→                self.proposers.append(LLMCharacterProposer(\n    73→                    llm_client,\n    74→                    chunk_size=llm_chunk_size,\n    75→                    context_window=mention_context_window,\n    76→                ))\n    77→            # Add coreference proposer if enabled and available\n    78→            if enable_coreference:\n    79→                coref_proposer = create_coreference_proposer(\n    80→                    context_window=mention_context_window\n    81→                )\n    82→                if coref_proposer:\n    83→                    self.proposers.append(coref_proposer)\n    84→                    logger.info(\"Coreference proposer enabled\")\n    85→\n    86→        # Set up validator\n    87→        self.validator = validator or CharacterValidator(\n    88→            llm_client=llm_client,\n    89→            use_llm_validation=llm_client is not None,\n    90→        )\n    91→\n    92→        # Set up consensus builder\n    93→        self.consensus_builder = consensus_builder or CharacterConsensusBuilder(\n    94→            llm_client=llm_client,\n    95→            use_llm_alias_resolution=llm_client is not None,\n    96→        )\n    97→\n    98→    def run(\n    99→        self,\n   100→        full_text: str,\n   101→        chapter_map: ChapterDetectionMap,\n   102→        source_file: str = \"unknown\",\n   103→        resume_from: Optional[CharacterPipelineCheckpoint] = None,\n   104→    ) -> tuple[CharacterMap, CharacterPipelineCheckpoint]:\n   105→        \"\"\"\n   106→        Run the full character extraction pipeline.\n   107→\n   108→        Args:\n   109→            full_text: The complete document text\n   110→            chapter_map: Chapter boundaries from chapter detection\n   111→            source_file: Source file name for checkpointing\n   112→            resume_from: Optional checkpoint to resume from\n   113→\n   114→        Returns:\n   115→            Tuple of (CharacterMap, final checkpoint)\n   116→        \"\"\"\n   117→        # Calculate text hash for checkpoint validation\n   118→        text_hash = hashlib.md5(full_text.encode()).hexdigest()\n   119→\n   120→        # Initialize or validate checkpoint\n   121→        if resume_from:\n   122→            if resume_from.text_hash != text_hash:\n   123→                logger.warning(\"Text hash mismatch - starting fresh\")\n   124→                checkpoint = CharacterPipelineCheckpoint.create_new(source_file, text_hash)\n   125→            else:\n   126→                checkpoint = resume_from\n   127→                logger.info(f\"Resuming from stage: {checkpoint.stage}\")\n   128→        else:\n   129→            checkpoint = CharacterPipelineCheckpoint.create_new(source_file, text_hash)\n   130→\n   131→        import time as _time  # Local import for timing\n   132→\n   133→        # Stage 1: Extraction\n   134→        if checkpoint.stage == \"extraction\":\n   135→            stage_start = _time.perf_counter()\n   136→            logger.info(\"Stage 1: Character extraction from chapters\")\n   137→            checkpoint = self._run_extraction(full_text, chapter_map, checkpoint)\n   138→            self._save_checkpoint(checkpoint)\n   139→            elapsed = _time.perf_counter() - stage_start\n   140→            logger.info(f\"Stage 1 completed in {elapsed:.1f}s\")\n   141→\n   142→        # Stage 2: Validation\n   143→        if checkpoint.stage == \"validation\":\n   144→            stage_start = _time.perf_counter()\n   145→            logger.info(\"Stage 2: Validating character proposals\")\n   146→            checkpoint = self._run_validation(checkpoint)\n   147→            self._save_checkpoint(checkpoint)\n   148→            elapsed = _time.perf_counter() - stage_start\n   149→            logger.info(f\"Stage 2 completed in {elapsed:.1f}s\")\n   150→\n   151→        # Stage 3: Consensus\n   152→        if checkpoint.stage == \"consensus\":\n   153→            stage_start = _time.perf_counter()\n   154→            logger.info(\"Stage 3: Building cross-chapter consensus\")\n   155→            checkpoint = self._run_consensus(checkpoint, len(chapter_map.chapters))\n   156→            self._save_checkpoint(checkpoint)\n   157→            elapsed = _time.perf_counter() - stage_start\n   158→            logger.info(f\"Stage 3 completed in {elapsed:.1f}s\")\n   159→\n   160→        return checkpoint.character_map, checkpoint\n   161→\n   162→    def _run_extraction(\n   163→        self,\n   164→        full_text: str,\n   165→        chapter_map: ChapterDetectionMap,\n   166→        checkpoint: CharacterPipelineCheckpoint,\n   167→    ) -> CharacterPipelineCheckpoint:\n   168→        \"\"\"Run character extraction on all chapters.\"\"\"\n   169→        chapter_proposals = {}\n   170→        total_chapters = len(chapter_map.chapters)\n   171→\n   172→        for i, chapter in enumerate(chapter_map.chapters):\n   173→            chapter_idx = chapter.index\n   174→            self._report_progress(\"extraction\", i + 1, total_chapters)\n   175→\n   176→            # Extract chapter text\n   177→            start = chapter.start_position\n   178→            end = chapter.end_position\n   179→            chapter_text = full_text[start:end]\n   180→\n   181→            # Run all proposers\n   182→            proposals = []\n   183→            for proposer in self.proposers:\n   184→                try:\n   185→                    prop_results = proposer.propose(\n   186→                        chapter_text=chapter_text,\n   187→                        chapter_index=chapter_idx,\n   188→                        chapter_start_position=start,\n   189→                    )\n   190→                    proposals.extend(prop_results)\n   191→                    logger.debug(\n   192→                        f\"  {proposer.name}: found {len(prop_results)} proposals \"\n   193→                        f\"in chapter {chapter_idx}\"\n   194→                    )\n   195→                except Exception as e:\n   196→                    logger.error(f\"Proposer {proposer.name} failed on chapter {chapter_idx}: {e}\")\n   197→                    checkpoint.errors.append(\n   198→                        f\"Proposer {proposer.name} failed on chapter {chapter_idx}: {str(e)}\"\n   199→                    )\n   200→                    # Re-raise to fail fast instead of continuing with errors\n   201→                    raise\n   202→\n   203→            chapter_proposals[chapter_idx] = proposals\n   204→            logger.info(\n   205→                f\"Chapter {chapter_idx}: {len(proposals)} total proposals from \"\n   206→                f\"{len(self.proposers)} proposers\"\n   207→            )\n   208→\n   209→        checkpoint.chapter_proposals = chapter_proposals\n   210→        checkpoint.stage = \"validation\"\n   211→        checkpoint.timestamp = datetime.now().isoformat()\n   212→\n   213→        return checkpoint\n   214→\n   215→    def _run_validation(\n   216→        self,\n   217→        checkpoint: CharacterPipelineCheckpoint,\n   218→    ) -> CharacterPipelineCheckpoint:\n   219→        \"\"\"Validate all character proposals.\"\"\"\n   220→        if not checkpoint.chapter_proposals:\n   221→            checkpoint.warnings.append(\"No chapter proposals to validate\")\n   222→            checkpoint.validations = []\n   223→            checkpoint.stage = \"consensus\"\n   224→            return checkpoint\n   225→\n   226→        # Flatten all proposals\n   227→        all_proposals = []\n   228→        for chapter_idx, proposals in checkpoint.chapter_proposals.items():\n   229→            all_proposals.extend(proposals)\n   230→\n   231→        # IMPORTANT:\n   232→        # We cache validations by normalized name to avoid redundant LLM calls,\n   233→        # but we still emit a validation result for EVERY proposal.\n   234→        #\n   235→        # Why: downstream consensus/alias resolution needs per-chapter distribution\n   236→        # (mentions + chapter coverage). Deduplicating proposals before validation\n   237→        # discards that evidence and can significantly hurt merge accuracy.\n   238→        total_proposals = len(all_proposals)\n   239→        unique_names = len({p.name.lower().strip() for p in all_proposals})\n   240→        logger.info(\n   241→            f\"Validating {total_proposals} proposals across {unique_names} unique names \"\n   242→            f\"(caching enabled to avoid redundant LLM calls)\"\n   243→        )\n   244→\n   245→        validation_cache: dict[str, CharacterValidationResult] = {}\n   246→        validations: list[CharacterValidationResult] = []\n   247→\n   248→        for i, proposal in enumerate(all_proposals):\n   249→            self._report_progress(\"validation\", i + 1, total_proposals)\n   250→\n   251→            norm_name = proposal.name.lower().strip()\n   252→\n   253→            # If we've already validated this NAME, reuse the decision but keep\n   254→            # the original proposal (and its mentions/chapter index) for consensus.\n   255→            if norm_name in validation_cache:\n   256→                cached = validation_cache[norm_name]\n   257→                validations.append(CharacterValidationResult(\n   258→                    proposal=proposal,\n   259→                    is_person_score=cached.is_person_score,\n   260→                    context_score=cached.context_score,\n   261→                    alias_candidates=list(cached.alias_candidates),\n   262→                    overall_score=cached.overall_score,\n   263→                    is_valid=cached.is_valid,\n   264→                    reasoning=cached.reasoning,\n   265→                ))\n   266→                continue\n   267→\n   268→            try:\n   269→                result = self.validator.validate(proposal)\n   270→                validation_cache[norm_name] = result\n   271→                validations.append(result)\n   272→            except Exception as e:\n   273→                logger.error(f\"Validation failed for '{proposal.name}': {e}\")\n   274→                checkpoint.errors.append(f\"Validation failed for '{proposal.name}': {str(e)}\")\n   275→                # Re-raise to fail fast instead of continuing with errors\n   276→                raise\n   277→\n   278→        valid_count = sum(1 for v in validations if v.is_valid)\n   279→        logger.info(f\"Validation complete: {valid_count}/{total_proposals} valid (cached {len(validation_cache)} unique names)\")\n   280→\n   281→        checkpoint.validations = validations\n   282→        checkpoint.stage = \"consensus\"\n   283→        checkpoint.timestamp = datetime.now().isoformat()\n   284→\n   285→        return checkpoint\n   286→\n   287→    def _run_consensus(\n   288→        self,\n   289→        checkpoint: CharacterPipelineCheckpoint,\n   290→        total_chapters: int,\n   291→    ) -> CharacterPipelineCheckpoint:\n   292→        \"\"\"Build consensus across all chapters.\"\"\"\n   293→        if not checkpoint.validations:\n   294→            checkpoint.character_map = CharacterMap(\n   295→                characters=[],\n   296→                low_confidence_characters=[],\n   297→                total_mentions=0,\n   298→                total_chapters=total_chapters,\n   299→                pipeline_metadata={\"warning\": \"No validations to build consensus from\"},\n   300→            )\n   301→            checkpoint.stage = \"complete\"\n   302→            return checkpoint\n   303→\n   304→        self._report_progress(\"consensus\", 1, 1)\n   305→\n   306→        try:\n   307→            character_map = self.consensus_builder.build_consensus(\n   308→                validations=checkpoint.validations,\n   309→                total_chapters=total_chapters,\n   310→            )\n   311→            checkpoint.character_map = character_map\n   312→            logger.info(\n   313→                f\"Consensus complete: {len(character_map.characters)} characters, \"\n   314→                f\"{len(character_map.low_confidence_characters)} low-confidence\"\n   315→            )\n   316→        except Exception as e:\n   317→            logger.error(f\"Consensus building failed: {e}\")\n   318→            checkpoint.errors.append(f\"Consensus building failed: {str(e)}\")\n   319→            # Re-raise to fail fast instead of returning empty character map\n   320→            raise\n   321→\n   322→        checkpoint.stage = \"complete\"\n   323→        checkpoint.timestamp = datetime.now().isoformat()\n   324→\n   325→        return checkpoint\n   326→\n   327→    def _save_checkpoint(self, checkpoint: CharacterPipelineCheckpoint) -> None:\n   328→        \"\"\"Save checkpoint to disk if checkpoint_dir is configured.\"\"\"\n   329→        if not self.checkpoint_dir:\n   330→            return\n   331→\n   332→        self.checkpoint_dir.mkdir(parents=True, exist_ok=True)\n   333→\n   334→        # Use source file name for checkpoint file\n   335→        safe_name = Path(checkpoint.source_file).stem\n   336→        checkpoint_file = self.checkpoint_dir / f\"characters_{safe_name}.json\"\n   337→\n   338→        try:\n   339→            checkpoint.save(checkpoint_file)\n   340→            logger.debug(f\"Checkpoint saved: {checkpoint_file}\")\n   341→        except Exception as e:\n   342→            logger.error(f\"Failed to save checkpoint: {e}\")\n   343→\n   344→    def _report_progress(self, stage: str, current: int, total: int) -> None:\n   345→        \"\"\"Report progress if callback is configured.\"\"\"\n   346→        if self.progress_callback:\n   347→            self.progress_callback(stage, current, total)\n   348→\n   349→\n   350→def extract_characters(\n   351→    full_text: str,\n   352→    chapter_map: ChapterDetectionMap,\n   353→    llm_client: Optional[LLMClient] = None,\n   354→    checkpoint_dir: Optional[Path] = None,\n   355→    source_file: str = \"unknown\",\n   356→    progress_callback: Optional[Callable[[str, int, int], None]] = None,\n   357→) -> CharacterMap:\n   358→    \"\"\"\n   359→    Convenience function for character extraction.\n   360→\n   361→    Args:\n   362→        full_text: Complete document text\n   363→        chapter_map: Chapter boundaries from chapter detection\n   364→        llm_client: Optional LLM client\n   365→        checkpoint_dir: Optional directory for checkpoints\n   366→        source_file: Source file name\n   367→        progress_callback: Optional progress callback\n   368→\n   369→    Returns:\n   370→        CharacterMap with extracted characters\n   371→    \"\"\"\n   372→    pipeline = CharacterExtractionPipeline(\n   373→        llm_client=llm_client,\n   374→        checkpoint_dir=checkpoint_dir,\n   375→        progress_callback=progress_callback,\n   376→    )\n   377→\n   378→    character_map, _ = pipeline.run(\n   379→        full_text=full_text,\n   380→        chapter_map=chapter_map,\n   381→        source_file=source_file,\n   382→    )\n   383→\n   384→    return character_map\n   385→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"eb6051e2-acb8-49c7-9168-f3c046842986","uuid":"812a03d0-4f48-4e59-bd2a-0bde401bda2c","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/pipeline.py","content":"\"\"\"\nCharacter extraction pipeline orchestrator.\n\nCoordinates the full character extraction workflow with checkpointing.\n\"\"\"\n\nimport hashlib\nfrom pathlib import Path\nfrom datetime import datetime\nfrom typing import Optional, Callable\nimport logging\n\nfrom .models import (\n    CharacterProposal,\n    CharacterValidationResult,\n    CharacterMap,\n    CharacterPipelineCheckpoint,\n)\nfrom .proposers import BaseCharacterProposer, NERProposer, LLMCharacterProposer, create_coreference_proposer\nfrom .validator import CharacterValidator\nfrom .consensus import CharacterConsensusBuilder\nfrom ..chapter_detection.models import ChapterMap as ChapterDetectionMap\nfrom ..llm import LLMClient\n\nlogger = logging.getLogger(__name__)\n\n\nclass CharacterExtractionPipeline:\n    \"\"\"\n    Orchestrates the full character extraction workflow.\n\n    Stages:\n    1. Extraction: Run proposers on each chapter\n    2. Validation: Validate each proposal\n    3. Consensus: Merge across chapters, resolve aliases\n\n    Supports checkpointing to save/resume progress.\n    \"\"\"\n\n    def __init__(\n        self,\n        llm_client: Optional[LLMClient] = None,\n        proposers: Optional[list[BaseCharacterProposer]] = None,\n        validator: Optional[CharacterValidator] = None,\n        consensus_builder: Optional[CharacterConsensusBuilder] = None,\n        checkpoint_dir: Optional[Path] = None,\n        progress_callback: Optional[Callable[[str, int, int], None]] = None,\n        llm_chunk_size: int = 8000,\n        mention_context_window: int = 100,\n        enable_coreference: bool = False,\n    ):\n        \"\"\"\n        Args:\n            llm_client: LLM client for LLM-based extraction and validation\n            proposers: List of character proposers (default: NER + LLM if client provided)\n            validator: Character validator instance\n            consensus_builder: Consensus builder instance\n            checkpoint_dir: Directory for saving checkpoints\n            progress_callback: Callback(stage, current, total) for progress updates\n            enable_coreference: Whether to enable coreference resolution (requires coreferee)\n        \"\"\"\n        self.llm = llm_client\n        self.checkpoint_dir = checkpoint_dir\n        self.progress_callback = progress_callback\n\n        # Set up proposers\n        if proposers is not None:\n            self.proposers = proposers\n        else:\n            self.proposers = [NERProposer(context_window=mention_context_window)]\n            if llm_client:\n                self.proposers.append(LLMCharacterProposer(\n                    llm_client,\n                    chunk_size=llm_chunk_size,\n                    context_window=mention_context_window,\n                ))\n            # Add coreference proposer if enabled and available\n            if enable_coreference:\n                coref_proposer = create_coreference_proposer(\n                    context_window=mention_context_window\n                )\n                if coref_proposer:\n                    self.proposers.append(coref_proposer)\n                    logger.info(\"Coreference proposer enabled\")\n\n        # Set up validator\n        self.validator = validator or CharacterValidator(\n            llm_client=llm_client,\n            use_llm_validation=llm_client is not None,\n        )\n\n        # Set up consensus builder\n        self.consensus_builder = consensus_builder or CharacterConsensusBuilder(\n            llm_client=llm_client,\n            use_llm_alias_resolution=llm_client is not None,\n        )\n\n    def run(\n        self,\n        full_text: str,\n        chapter_map: ChapterDetectionMap,\n        source_file: str = \"unknown\",\n        resume_from: Optional[CharacterPipelineCheckpoint] = None,\n    ) -> tuple[CharacterMap, CharacterPipelineCheckpoint]:\n        \"\"\"\n        Run the full character extraction pipeline.\n\n        Args:\n            full_text: The complete document text\n            chapter_map: Chapter boundaries from chapter detection\n            source_file: Source file name for checkpointing\n            resume_from: Optional checkpoint to resume from\n\n        Returns:\n            Tuple of (CharacterMap, final checkpoint)\n        \"\"\"\n        # Calculate text hash for checkpoint validation\n        text_hash = hashlib.md5(full_text.encode()).hexdigest()\n\n        # Initialize or validate checkpoint\n        if resume_from:\n            if resume_from.text_hash != text_hash:\n                logger.warning(\"Text hash mismatch - starting fresh\")\n                checkpoint = CharacterPipelineCheckpoint.create_new(source_file, text_hash)\n            else:\n                checkpoint = resume_from\n                logger.info(f\"Resuming from stage: {checkpoint.stage}\")\n        else:\n            checkpoint = CharacterPipelineCheckpoint.create_new(source_file, text_hash)\n\n        import time as _time  # Local import for timing\n\n        # Stage 1: Extraction\n        if checkpoint.stage == \"extraction\":\n            stage_start = _time.perf_counter()\n            logger.info(\"Stage 1: Character extraction from chapters\")\n            checkpoint = self._run_extraction(full_text, chapter_map, checkpoint)\n            self._save_checkpoint(checkpoint)\n            elapsed = _time.perf_counter() - stage_start\n            logger.info(f\"Stage 1 completed in {elapsed:.1f}s\")\n\n        # Stage 2: Validation\n        if checkpoint.stage == \"validation\":\n            stage_start = _time.perf_counter()\n            logger.info(\"Stage 2: Validating character proposals\")\n            checkpoint = self._run_validation(checkpoint)\n            self._save_checkpoint(checkpoint)\n            elapsed = _time.perf_counter() - stage_start\n            logger.info(f\"Stage 2 completed in {elapsed:.1f}s\")\n\n        # Stage 3: Consensus\n        if checkpoint.stage == \"consensus\":\n            stage_start = _time.perf_counter()\n            logger.info(\"Stage 3: Building cross-chapter consensus\")\n            checkpoint = self._run_consensus(checkpoint, len(chapter_map.chapters))\n            self._save_checkpoint(checkpoint)\n            elapsed = _time.perf_counter() - stage_start\n            logger.info(f\"Stage 3 completed in {elapsed:.1f}s\")\n\n        return checkpoint.character_map, checkpoint\n\n    def _run_extraction(\n        self,\n        full_text: str,\n        chapter_map: ChapterDetectionMap,\n        checkpoint: CharacterPipelineCheckpoint,\n    ) -> CharacterPipelineCheckpoint:\n        \"\"\"Run character extraction on all chapters.\"\"\"\n        chapter_proposals = {}\n        total_chapters = len(chapter_map.chapters)\n\n        for i, chapter in enumerate(chapter_map.chapters):\n            chapter_idx = chapter.index\n            self._report_progress(\"extraction\", i + 1, total_chapters)\n\n            # Extract chapter text\n            start = chapter.start_position\n            end = chapter.end_position\n            chapter_text = full_text[start:end]\n\n            # Run all proposers\n            proposals = []\n            for proposer in self.proposers:\n                try:\n                    prop_results = proposer.propose(\n                        chapter_text=chapter_text,\n                        chapter_index=chapter_idx,\n                        chapter_start_position=start,\n                    )\n                    proposals.extend(prop_results)\n                    logger.debug(\n                        f\"  {proposer.name}: found {len(prop_results)} proposals \"\n                        f\"in chapter {chapter_idx}\"\n                    )\n                except Exception as e:\n                    logger.error(f\"Proposer {proposer.name} failed on chapter {chapter_idx}: {e}\")\n                    checkpoint.errors.append(\n                        f\"Proposer {proposer.name} failed on chapter {chapter_idx}: {str(e)}\"\n                    )\n                    # Re-raise to fail fast instead of continuing with errors\n                    raise\n\n            chapter_proposals[chapter_idx] = proposals\n            logger.info(\n                f\"Chapter {chapter_idx}: {len(proposals)} total proposals from \"\n                f\"{len(self.proposers)} proposers\"\n            )\n\n        checkpoint.chapter_proposals = chapter_proposals\n        checkpoint.stage = \"validation\"\n        checkpoint.timestamp = datetime.now().isoformat()\n\n        return checkpoint\n\n    def _run_validation(\n        self,\n        checkpoint: CharacterPipelineCheckpoint,\n    ) -> CharacterPipelineCheckpoint:\n        \"\"\"Validate all character proposals.\"\"\"\n        if not checkpoint.chapter_proposals:\n            checkpoint.warnings.append(\"No chapter proposals to validate\")\n            checkpoint.validations = []\n            checkpoint.stage = \"consensus\"\n            return checkpoint\n\n        # Flatten all proposals\n        all_proposals = []\n        for chapter_idx, proposals in checkpoint.chapter_proposals.items():\n            all_proposals.extend(proposals)\n\n        # IMPORTANT:\n        # We cache validations by normalized name to avoid redundant LLM calls,\n        # but we still emit a validation result for EVERY proposal.\n        #\n        # Why: downstream consensus/alias resolution needs per-chapter distribution\n        # (mentions + chapter coverage). Deduplicating proposals before validation\n        # discards that evidence and can significantly hurt merge accuracy.\n        total_proposals = len(all_proposals)\n        unique_names = len({p.name.lower().strip() for p in all_proposals})\n        logger.info(\n            f\"Validating {total_proposals} proposals across {unique_names} unique names \"\n            f\"(caching enabled to avoid redundant LLM calls)\"\n        )\n\n        validation_cache: dict[str, CharacterValidationResult] = {}\n        validations: list[CharacterValidationResult] = []\n\n        for i, proposal in enumerate(all_proposals):\n            self._report_progress(\"validation\", i + 1, total_proposals)\n\n            norm_name = proposal.name.lower().strip()\n\n            # If we've already validated this NAME, reuse the decision but keep\n            # the original proposal (and its mentions/chapter index) for consensus.\n            if norm_name in validation_cache:\n                cached = validation_cache[norm_name]\n                validations.append(CharacterValidationResult(\n                    proposal=proposal,\n                    is_person_score=cached.is_person_score,\n                    context_score=cached.context_score,\n                    alias_candidates=list(cached.alias_candidates),\n                    overall_score=cached.overall_score,\n                    is_valid=cached.is_valid,\n                    reasoning=cached.reasoning,\n                ))\n                continue\n\n            try:\n                result = self.validator.validate(proposal)\n                validation_cache[norm_name] = result\n                validations.append(result)\n            except Exception as e:\n                logger.error(f\"Validation failed for '{proposal.name}': {e}\")\n                checkpoint.errors.append(f\"Validation failed for '{proposal.name}': {str(e)}\")\n                # Re-raise to fail fast instead of continuing with errors\n                raise\n\n        valid_count = sum(1 for v in validations if v.is_valid)\n        logger.info(f\"Validation complete: {valid_count}/{total_proposals} valid (cached {len(validation_cache)} unique names)\")\n\n        checkpoint.validations = validations\n        checkpoint.stage = \"consensus\"\n        checkpoint.timestamp = datetime.now().isoformat()\n\n        return checkpoint\n\n    def _run_consensus(\n        self,\n        checkpoint: CharacterPipelineCheckpoint,\n        total_chapters: int,\n    ) -> CharacterPipelineCheckpoint:\n        \"\"\"Build consensus across all chapters.\"\"\"\n        if not checkpoint.validations:\n            checkpoint.character_map = CharacterMap(\n                characters=[],\n                low_confidence_characters=[],\n                total_mentions=0,\n                total_chapters=total_chapters,\n                pipeline_metadata={\"warning\": \"No validations to build consensus from\"},\n            )\n            checkpoint.stage = \"complete\"\n            return checkpoint\n\n        self._report_progress(\"consensus\", 1, 1)\n\n        try:\n            character_map = self.consensus_builder.build_consensus(\n                validations=checkpoint.validations,\n                total_chapters=total_chapters,\n            )\n            checkpoint.character_map = character_map\n            logger.info(\n                f\"Consensus complete: {len(character_map.characters)} characters, \"\n                f\"{len(character_map.low_confidence_characters)} low-confidence\"\n            )\n        except Exception as e:\n            logger.error(f\"Consensus building failed: {e}\")\n            checkpoint.errors.append(f\"Consensus building failed: {str(e)}\")\n            # Re-raise to fail fast instead of returning empty character map\n            raise\n\n        checkpoint.stage = \"complete\"\n        checkpoint.timestamp = datetime.now().isoformat()\n\n        return checkpoint\n\n    def _save_checkpoint(self, checkpoint: CharacterPipelineCheckpoint) -> None:\n        \"\"\"Save checkpoint to disk if checkpoint_dir is configured.\"\"\"\n        if not self.checkpoint_dir:\n            return\n\n        self.checkpoint_dir.mkdir(parents=True, exist_ok=True)\n\n        # Use source file name for checkpoint file\n        safe_name = Path(checkpoint.source_file).stem\n        checkpoint_file = self.checkpoint_dir / f\"characters_{safe_name}.json\"\n\n        try:\n            checkpoint.save(checkpoint_file)\n            logger.debug(f\"Checkpoint saved: {checkpoint_file}\")\n        except Exception as e:\n            logger.error(f\"Failed to save checkpoint: {e}\")\n\n    def _report_progress(self, stage: str, current: int, total: int) -> None:\n        \"\"\"Report progress if callback is configured.\"\"\"\n        if self.progress_callback:\n            self.progress_callback(stage, current, total)\n\n\ndef extract_characters(\n    full_text: str,\n    chapter_map: ChapterDetectionMap,\n    llm_client: Optional[LLMClient] = None,\n    checkpoint_dir: Optional[Path] = None,\n    source_file: str = \"unknown\",\n    progress_callback: Optional[Callable[[str, int, int], None]] = None,\n) -> CharacterMap:\n    \"\"\"\n    Convenience function for character extraction.\n\n    Args:\n        full_text: Complete document text\n        chapter_map: Chapter boundaries from chapter detection\n        llm_client: Optional LLM client\n        checkpoint_dir: Optional directory for checkpoints\n        source_file: Source file name\n        progress_callback: Optional progress callback\n\n    Returns:\n        CharacterMap with extracted characters\n    \"\"\"\n    pipeline = CharacterExtractionPipeline(\n        llm_client=llm_client,\n        checkpoint_dir=checkpoint_dir,\n        progress_callback=progress_callback,\n    )\n\n    character_map, _ = pipeline.run(\n        full_text=full_text,\n        chapter_map=chapter_map,\n        source_file=source_file,\n    )\n\n    return character_map\n","numLines":385,"startLine":1,"totalLines":385}}}
