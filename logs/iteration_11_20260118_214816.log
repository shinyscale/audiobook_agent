: Optional[Callable[[str, int, int], None]] = None,\n    49→        generate_rich_profiles: bool = True,\n    50→    ):\n    51→        \"\"\"\n    52→        Args:\n    53→            llm_client: LLM client for character identification and profiling\n    54→            progress_callback: Callback(stage, current, total) for progress updates\n    55→            generate_rich_profiles: Whether to generate rich profiles (requires LLM calls per character)\n    56→        \"\"\"\n    57→        self.llm = llm_client\n    58→        self.progress_callback = progress_callback\n    59→        self.generate_rich_profiles = generate_rich_profiles\n    60→\n    61→    def run(\n    62→        self,\n    63→        full_text: str,\n    64→        chapter_map: ChapterMap,\n    65→        summary_map: ChapterSummaryMap,\n    66→        plot_summary: Optional[str] = None,\n    67→        source_file: str = \"unknown\",\n    68→    ) -> CharacterProfileMap:\n    69→        \"\"\"\n    70→        Run the character profiling pipeline.\n    71→\n    72→        Args:\n    73→            full_text: Complete document text\n    74→            chapter_map: Chapter boundaries from chapter detection\n    75→            summary_map: Chapter summaries from summary pipeline\n    76→            plot_summary: Optional plot summary for better identification\n    77→            source_file: Source file name for metadata\n    78→\n    79→        Returns:\n    80→            CharacterProfileMap with all character profiles\n    81→        \"\"\"\n    82→        logger.info(\"Starting character profiling pipeline\")\n    83→        self._report_progress(\"identification\", 0, 3)\n    84→\n    85→        # Stage 1: Character Identification from Summaries\n    86→        logger.info(\"Stage 1: Identifying characters from summaries\")\n    87→        identifier = SummaryDrivenCharacterIdentifier(self.llm)\n    88→\n    89→        characters, narrator_name, narrative_style = identifier.identify_characters(