{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vcxc8iqxF8f11FY1Dev6Kv","type":"tool_result","content":"     1→\"\"\"\n     2→Character profile converter.\n     3→\n     4→Converts CharacterProfile to the existing Character model for backward compatibility,\n     5→while preserving rich profile data (appearance, personality, voice guidance).\n     6→\"\"\"\n     7→\n     8→from typing import Optional\n     9→from ...models import Character, CharacterDescription, ConfidenceLevel\n    10→from .models import CharacterProfile, CharacterProfileMap\n    11→\n    12→\n    13→def profile_to_character(profile: CharacterProfile) -> Character:\n    14→    \"\"\"\n    15→    Convert a CharacterProfile to a Character model.\n    16→\n    17→    This preserves all rich profile data by:\n    18→    1. Storing appearance/personality/voice summaries in descriptions\n    19→    2. Converting relationships to dict format\n    20→    3. Preserving evidence\n    21→\n    22→    Args:\n    23→        profile: CharacterProfile to convert\n    24→\n    25→    Returns:\n    26→        Character model with rich data\n    27→    \"\"\"\n    28→    # Build descriptions list with all profile sections\n    29→    descriptions = []\n    30→\n    31→    # Main profile description (combined summary)\n    32→    main_description = _build_main_description(profile)\n    33→    if main_description:\n    34→        descriptions.append(CharacterDescription(\n    35→            text=main_description,\n    36→            source_position=0,\n    37→            confidence=ConfidenceLevel.LLM_REFINED,\n    38→        ))\n    39→\n    40→    # Convert confidence from float to enum\n    41→    if profile.confidence >= 0.7:\n    42→        confidence = ConfidenceLevel.HIGH\n    43→    elif profile.confidence >= 0.4:\n    44→        confidence = ConfidenceLevel.MEDIUM\n    45→    else:\n    46→        confidence = ConfidenceLevel.LOW\n    47→\n    48→    # Convert relationships to dict format\n    49→    relationships = {}\n    50→    for rel in profile.relationships:\n    51→        relationships[rel.character] = rel.relationship_type\n    52→\n    53→    # Convert evidence to list of dicts\n    54→    evidence = []\n    55→    for ev in profile.evidence:\n    56→        evidence.append({\n    57→            \"type\": \"profile_evidence\",\n    58→            \"statement\": ev.statement,\n    59→            \"quote\": ev.quote,\n    60→            \"chapter\": ev.chapter,\n    61→            \"position\": ev.position,\n    62→        })\n    63→\n    64→    # Build voice notes from voice guidance\n    65→    voice_notes = _build_voice_notes(profile)\n    66→\n    67→    # Build structured data for F8: Simplified Character Output\n    68→    appearance_dict = None\n    69→    if profile.appearance and profile.appearance.summary:\n    70→        appearance_dict = {\n    71→            \"summary\": profile.appearance.summary,\n    72→            \"age_indication\": profile.appearance.age_indication,\n    73→            \"distinguishing_features\": profile.appearance.distinguishing_features or [],\n    74→        }\n    75→\n    76→    personality_dict = None\n    77→    if profile.personality and profile.personality.summary:\n    78→        personality_dict = {\n    79→            \"summary\": profile.personality.summary,\n    80→            \"traits\": profile.personality.traits or [],\n    81→            \"temperament\": profile.personality.temperament,\n    82→            \"moral_alignment\": profile.personality.moral_alignment,\n    83→        }\n    84→\n    85→    voice_guidance_dict = None\n    86→    vg = profile.voice_guidance\n    87→    if vg and (vg.suggested_tone or vg.dialect_notes or vg.verbal_tics):\n    88→        voice_guidance_dict = {\n    89→            \"suggested_tone\": vg.suggested_tone,\n    90→            \"dialect_notes\": vg.dialect_notes,\n    91→            \"verbal_tics\": vg.verbal_tics or [],\n    92→            \"formality_level\": vg.formality_level,\n    93→            \"emotional_range\": vg.emotional_range,\n    94→            \"example_quotes\": vg.example_quotes or [],\n    95→        }\n    96→\n    97→    return Character(\n    98→        id=profile.id,\n    99→        canonical_name=profile.canonical_name,\n   100→        aliases=profile.aliases,\n   101→        role=profile.role,\n   102→        appearance=appearance_dict,\n   103→        personality=personality_dict,\n   104→        voice_guidance=voice_guidance_dict,\n   105→        descriptions=descriptions,\n   106→        first_appearance_chapter=profile.first_appearance_chapter,\n   107→        mention_count=_estimate_mention_count(profile),\n   108→        relationships=relationships,\n   109→        voice_notes=voice_notes,\n   110→        evidence=evidence,\n   111→        confidence=confidence,\n   112→        is_narrator=profile.is_narrator,\n   113→        narrative_role=profile.narrative_role,\n   114→    )\n   115→\n   116→\n   117→def _build_main_description(profile: CharacterProfile) -> str:\n   118→    \"\"\"\n   119→    Build a comprehensive description from profile sections.\n   120→\n   121→    Combines appearance, personality summaries into readable prose.\n   122→    \"\"\"\n   123→    sections = []\n   124→\n   125→    # Appearance\n   126→    if profile.appearance.summary and profile.appearance.summary != \"No physical description available in text.\":\n   127→        sections.append(f\"**Appearance:** {profile.appearance.summary}\")\n   128→        if profile.appearance.age_indication and profile.appearance.age_indication != \"unknown\":\n   129→            sections.append(f\"Age: {profile.appearance.age_indication}\")\n   130→        if profile.appearance.distinguishing_features:\n   131→            features = \", \".join(profile.appearance.distinguishing_features)\n   132→            sections.append(f\"Distinguishing features: {features}\")\n   133→\n   134→    # Personality\n   135→    if profile.personality.summary and profile.personality.summary != \"Insufficient information for personality analysis.\":\n   136→        sections.append(f\"**Personality:** {profile.personality.summary}\")\n   137→        if profile.personality.traits:\n   138→            traits = \", \".join(profile.personality.traits)\n   139→            sections.append(f\"Traits: {traits}\")\n   140→        if profile.personality.temperament and profile.personality.temperament != \"unknown\":\n   141→            sections.append(f\"Temperament: {profile.personality.temperament}\")\n   142→\n   143→    # Role\n   144→    if profile.role:\n   145→        sections.append(f\"**Role:** {profile.role}\")\n   146→\n   147→    if not sections:\n   148→        return \"\"\n   149→\n   150→    return \"\\n\".join(sections)\n   151→\n   152→\n   153→def _build_voice_notes(profile: CharacterProfile) -> Optional[str]:\n   154→    \"\"\"\n   155→    Build voice notes from voice guidance.\n   156→\n   157→    Formats voice guidance into actionable narrator notes.\n   158→    \"\"\"\n   159→    vg = profile.voice_guidance\n   160→    if not vg.suggested_tone and not vg.dialect_notes and not vg.verbal_tics:\n   161→        return None\n   162→\n   163→    notes = []\n   164→\n   165→    if vg.suggested_tone and vg.suggested_tone != \"No specific voice guidance available.\":\n   166→        notes.append(f\"Tone: {vg.suggested_tone}\")\n   167→\n   168→    if vg.dialect_notes:\n   169→        notes.append(f\"Dialect: {vg.dialect_notes}\")\n   170→\n   171→    if vg.verbal_tics:\n   172→        tics = \", \".join(f'\"{t}\"' for t in vg.verbal_tics)\n   173→        notes.append(f\"Verbal tics: {tics}\")\n   174→\n   175→    if vg.formality_level and vg.formality_level != \"moderate\":\n   176→        notes.append(f\"Formality: {vg.formality_level}\")\n   177→\n   178→    if vg.emotional_range:\n   179→        notes.append(f\"Emotional range: {vg.emotional_range}\")\n   180→\n   181→    if vg.example_quotes:\n   182→        notes.append(\"Example quotes:\")\n   183→        for quote in vg.example_quotes[:3]:\n   184→            notes.append(f\"  - {quote}\")\n   185→\n   186→    return \"\\n\".join(notes) if notes else None\n   187→\n   188→\n   189→def _estimate_mention_count(profile: CharacterProfile) -> int:\n   190→    \"\"\"\n   191→    Estimate mention count from profile data.\n   192→\n   193→    Uses mention_frequency and chapters_present to estimate.\n   194→    \"\"\"\n   195→    frequency_map = {\n   196→        \"frequent\": 50,\n   197→        \"moderate\": 25,\n   198→        \"occasional\": 10,\n   199→        \"rare\": 3,\n   200→    }\n   201→\n   202→    base = frequency_map.get(profile.mention_frequency, 10)\n   203→    # Adjust based on chapters present\n   204→    chapter_factor = max(1, len(profile.chapters_present))\n   205→\n   206→    return base * chapter_factor\n   207→\n   208→\n   209→def profile_map_to_characters(profile_map: CharacterProfileMap) -> list[Character]:\n   210→    \"\"\"\n   211→    Convert a CharacterProfileMap to list of Character models.\n   212→\n   213→    Args:\n   214→        profile_map: CharacterProfileMap to convert\n   215→\n   216→    Returns:\n   217→        List of Character models with rich profile data\n   218→    \"\"\"\n   219→    return [profile_to_character(p) for p in profile_map.profiles]\n   220→\n   221→\n   222→def character_to_rich_dict(char: Character) -> dict:\n   223→    \"\"\"\n   224→    Convert Character to a rich dictionary format for JSON output.\n   225→\n   226→    This structures the output to prioritize narrator-useful information\n   227→    (appearance, personality, voice guidance) over metrics (mention counts).\n   228→\n   229→    Args:\n   230→        char: Character model to convert\n   231→\n   232→    Returns:\n   233→        Dictionary with structured rich profile data\n   234→    \"\"\"\n   235→    # Parse structured data from descriptions if available\n   236→    appearance = _extract_section(char.descriptions, \"Appearance\")\n   237→    personality = _extract_section(char.descriptions, \"Personality\")\n   238→    role = _extract_section(char.descriptions, \"Role\")\n   239→\n   240→    result = {\n   241→        \"id\": char.id,\n   242→        \"canonical_name\": char.canonical_name,\n   243→        \"aliases\": char.aliases,\n   244→        \"role\": role or \"unknown\",\n   245→        \"is_narrator\": char.is_narrator,\n   246→        \"narrative_role\": char.narrative_role,\n   247→\n   248→        # Primary profile data for narration\n   249→        \"appearance\": {\n   250→            \"summary\": appearance or \"No physical description available.\",\n   251→        },\n   252→        \"personality\": {\n   253→            \"summary\": personality or \"No personality analysis available.\",\n   254→        },\n   255→        \"voice_guidance\": _parse_voice_notes(char.voice_notes),\n   256→\n   257→        # Relationships\n   258→        \"relationships\": [\n   259→            {\"character\": name, \"type\": rel_type, \"description\": \"\"}\n   260→            for name, rel_type in char.relationships.items()\n   261→        ] if char.relationships else [],\n   262→\n   263→        # Evidence\n   264→        \"evidence\": char.evidence,\n   265→\n   266→        # Metadata (secondary)\n   267→        \"metadata\": {\n   268→            \"first_appearance_chapter\": char.first_appearance_chapter,\n   269→            \"mention_count\": char.mention_count,\n   270→            \"confidence\": char.confidence.value,\n   271→        },\n   272→    }\n   273→\n   274→    return result\n   275→\n   276→\n   277→def _extract_section(descriptions: list[CharacterDescription], section_name: str) -> Optional[str]:\n   278→    \"\"\"Extract a section from descriptions by marker.\"\"\"\n   279→    if not descriptions:\n   280→        return None\n   281→\n   282→    for desc in descriptions:\n   283→        if f\"**{section_name}:**\" in desc.text:\n   284→            # Extract the content after the marker\n   285→            parts = desc.text.split(f\"**{section_name}:**\")\n   286→            if len(parts) > 1:\n   287→                # Get content until next section or end\n   288→                content = parts[1].split(\"**\")[0].strip()\n   289→                return content\n   290→\n   291→    return None\n   292→\n   293→\n   294→def _parse_voice_notes(voice_notes: Optional[str]) -> dict:\n   295→    \"\"\"Parse voice notes string back into structured dict.\"\"\"\n   296→    if not voice_notes:\n   297→        return {\n   298→            \"suggested_tone\": \"\",\n   299→            \"dialect_notes\": \"\",\n   300→            \"verbal_tics\": [],\n   301→            \"formality_level\": \"moderate\",\n   302→            \"emotional_range\": \"\",\n   303→            \"example_quotes\": [],\n   304→        }\n   305→\n   306→    result = {\n   307→        \"suggested_tone\": \"\",\n   308→        \"dialect_notes\": \"\",\n   309→        \"verbal_tics\": [],\n   310→        \"formality_level\": \"moderate\",\n   311→        \"emotional_range\": \"\",\n   312→        \"example_quotes\": [],\n   313→    }\n   314→\n   315→    lines = voice_notes.split(\"\\n\")\n   316→    in_quotes = False\n   317→    quotes = []\n   318→\n   319→    for line in lines:\n   320→        line = line.strip()\n   321→        if line.startswith(\"Tone:\"):\n   322→            result[\"suggested_tone\"] = line[5:].strip()\n   323→        elif line.startswith(\"Dialect:\"):\n   324→            result[\"dialect_notes\"] = line[8:].strip()\n   325→        elif line.startswith(\"Verbal tics:\"):\n   326→            # Parse quoted strings\n   327→            import re\n   328→            tics = re.findall(r'\"([^\"]+)\"', line)\n   329→            result[\"verbal_tics\"] = tics\n   330→        elif line.startswith(\"Formality:\"):\n   331→            result[\"formality_level\"] = line[10:].strip()\n   332→        elif line.startswith(\"Emotional range:\"):\n   333→            result[\"emotional_range\"] = line[16:].strip()\n   334→        elif line == \"Example quotes:\":\n   335→            in_quotes = True\n   336→        elif in_quotes and line.startswith(\"- \"):\n   337→            quotes.append(line[2:])\n   338→\n   339→    if quotes:\n   340→        result[\"example_quotes\"] = quotes\n   341→\n   342→    return result\n   343→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef7a1348-36ae-43ad-a27c-fe7fef12baa3","uuid":"ee4b646f-5d68-4106-a8e9-9d4eb77aaf71","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_profiling/converter.py","content":"\"\"\"\nCharacter profile converter.\n\nConverts CharacterProfile to the existing Character model for backward compatibility,\nwhile preserving rich profile data (appearance, personality, voice guidance).\n\"\"\"\n\nfrom typing import Optional\nfrom ...models import Character, CharacterDescription, ConfidenceLevel\nfrom .models import CharacterProfile, CharacterProfileMap\n\n\ndef profile_to_character(profile: CharacterProfile) -> Character:\n    \"\"\"\n    Convert a CharacterProfile to a Character model.\n\n    This preserves all rich profile data by:\n    1. Storing appearance/personality/voice summaries in descriptions\n    2. Converting relationships to dict format\n    3. Preserving evidence\n\n    Args:\n        profile: CharacterProfile to convert\n\n    Returns:\n        Character model with rich data\n    \"\"\"\n    # Build descriptions list with all profile sections\n    descriptions = []\n\n    # Main profile description (combined summary)\n    main_description = _build_main_description(profile)\n    if main_description:\n        descriptions.append(CharacterDescription(\n            text=main_description,\n            source_position=0,\n            confidence=ConfidenceLevel.LLM_REFINED,\n        ))\n\n    # Convert confidence from float to enum\n    if profile.confidence >= 0.7:\n        confidence = ConfidenceLevel.HIGH\n    elif profile.confidence >= 0.4:\n        confidence = ConfidenceLevel.MEDIUM\n    else:\n        confidence = ConfidenceLevel.LOW\n\n    # Convert relationships to dict format\n    relationships = {}\n    for rel in profile.relationships:\n        relationships[rel.character] = rel.relationship_type\n\n    # Convert evidence to list of dicts\n    evidence = []\n    for ev in profile.evidence:\n        evidence.append({\n            \"type\": \"profile_evidence\",\n            \"statement\": ev.statement,\n            \"quote\": ev.quote,\n            \"chapter\": ev.chapter,\n            \"position\": ev.position,\n        })\n\n    # Build voice notes from voice guidance\n    voice_notes = _build_voice_notes(profile)\n\n    # Build structured data for F8: Simplified Character Output\n    appearance_dict = None\n    if profile.appearance and profile.appearance.summary:\n        appearance_dict = {\n            \"summary\": profile.appearance.summary,\n            \"age_indication\": profile.appearance.age_indication,\n            \"distinguishing_features\": profile.appearance.distinguishing_features or [],\n        }\n\n    personality_dict = None\n    if profile.personality and profile.personality.summary:\n        personality_dict = {\n            \"summary\": profile.personality.summary,\n            \"traits\": profile.personality.traits or [],\n            \"temperament\": profile.personality.temperament,\n            \"moral_alignment\": profile.personality.moral_alignment,\n        }\n\n    voice_guidance_dict = None\n    vg = profile.voice_guidance\n    if vg and (vg.suggested_tone or vg.dialect_notes or vg.verbal_tics):\n        voice_guidance_dict = {\n            \"suggested_tone\": vg.suggested_tone,\n            \"dialect_notes\": vg.dialect_notes,\n            \"verbal_tics\": vg.verbal_tics or [],\n            \"formality_level\": vg.formality_level,\n            \"emotional_range\": vg.emotional_range,\n            \"example_quotes\": vg.example_quotes or [],\n        }\n\n    return Character(\n        id=profile.id,\n        canonical_name=profile.canonical_name,\n        aliases=profile.aliases,\n        role=profile.role,\n        appearance=appearance_dict,\n        personality=personality_dict,\n        voice_guidance=voice_guidance_dict,\n        descriptions=descriptions,\n        first_appearance_chapter=profile.first_appearance_chapter,\n        mention_count=_estimate_mention_count(profile),\n        relationships=relationships,\n        voice_notes=voice_notes,\n        evidence=evidence,\n        confidence=confidence,\n        is_narrator=profile.is_narrator,\n        narrative_role=profile.narrative_role,\n    )\n\n\ndef _build_main_description(profile: CharacterProfile) -> str:\n    \"\"\"\n    Build a comprehensive description from profile sections.\n\n    Combines appearance, personality summaries into readable prose.\n    \"\"\"\n    sections = []\n\n    # Appearance\n    if profile.appearance.summary and profile.appearance.summary != \"No physical description available in text.\":\n        sections.append(f\"**Appearance:** {profile.appearance.summary}\")\n        if profile.appearance.age_indication and profile.appearance.age_indication != \"unknown\":\n            sections.append(f\"Age: {profile.appearance.age_indication}\")\n        if profile.appearance.distinguishing_features:\n            features = \", \".join(profile.appearance.distinguishing_features)\n            sections.append(f\"Distinguishing features: {features}\")\n\n    # Personality\n    if profile.personality.summary and profile.personality.summary != \"Insufficient information for personality analysis.\":\n        sections.append(f\"**Personality:** {profile.personality.summary}\")\n        if profile.personality.traits:\n            traits = \", \".join(profile.personality.traits)\n            sections.append(f\"Traits: {traits}\")\n        if profile.personality.temperament and profile.personality.temperament != \"unknown\":\n            sections.append(f\"Temperament: {profile.personality.temperament}\")\n\n    # Role\n    if profile.role:\n        sections.append(f\"**Role:** {profile.role}\")\n\n    if not sections:\n        return \"\"\n\n    return \"\\n\".join(sections)\n\n\ndef _build_voice_notes(profile: CharacterProfile) -> Optional[str]:\n    \"\"\"\n    Build voice notes from voice guidance.\n\n    Formats voice guidance into actionable narrator notes.\n    \"\"\"\n    vg = profile.voice_guidance\n    if not vg.suggested_tone and not vg.dialect_notes and not vg.verbal_tics:\n        return None\n\n    notes = []\n\n    if vg.suggested_tone and vg.suggested_tone != \"No specific voice guidance available.\":\n        notes.append(f\"Tone: {vg.suggested_tone}\")\n\n    if vg.dialect_notes:\n        notes.append(f\"Dialect: {vg.dialect_notes}\")\n\n    if vg.verbal_tics:\n        tics = \", \".join(f'\"{t}\"' for t in vg.verbal_tics)\n        notes.append(f\"Verbal tics: {tics}\")\n\n    if vg.formality_level and vg.formality_level != \"moderate\":\n        notes.append(f\"Formality: {vg.formality_level}\")\n\n    if vg.emotional_range:\n        notes.append(f\"Emotional range: {vg.emotional_range}\")\n\n    if vg.example_quotes:\n        notes.append(\"Example quotes:\")\n        for quote in vg.example_quotes[:3]:\n            notes.append(f\"  - {quote}\")\n\n    return \"\\n\".join(notes) if notes else None\n\n\ndef _estimate_mention_count(profile: CharacterProfile) -> int:\n    \"\"\"\n    Estimate mention count from profile data.\n\n    Uses mention_frequency and chapters_present to estimate.\n    \"\"\"\n    frequency_map = {\n        \"frequent\": 50,\n        \"moderate\": 25,\n        \"occasional\": 10,\n        \"rare\": 3,\n    }\n\n    base = frequency_map.get(profile.mention_frequency, 10)\n    # Adjust based on chapters present\n    chapter_factor = max(1, len(profile.chapters_present))\n\n    return base * chapter_factor\n\n\ndef profile_map_to_characters(profile_map: CharacterProfileMap) -> list[Character]:\n    \"\"\"\n    Convert a CharacterProfileMap to list of Character models.\n\n    Args:\n        profile_map: CharacterProfileMap to convert\n\n    Returns:\n        List of Character models with rich profile data\n    \"\"\"\n    return [profile_to_character(p) for p in profile_map.profiles]\n\n\ndef character_to_rich_dict(char: Character) -> dict:\n    \"\"\"\n    Convert Character to a rich dictionary format for JSON output.\n\n    This structures the output to prioritize narrator-useful information\n    (appearance, personality, voice guidance) over metrics (mention counts).\n\n    Args:\n        char: Character model to convert\n\n    Returns:\n        Dictionary with structured rich profile data\n    \"\"\"\n    # Parse structured data from descriptions if available\n    appearance = _extract_section(char.descriptions, \"Appearance\")\n    personality = _extract_section(char.descriptions, \"Personality\")\n    role = _extract_section(char.descriptions, \"Role\")\n\n    result = {\n        \"id\": char.id,\n        \"canonical_name\": char.canonical_name,\n        \"aliases\": char.aliases,\n        \"role\": role or \"unknown\",\n        \"is_narrator\": char.is_narrator,\n        \"narrative_role\": char.narrative_role,\n\n        # Primary profile data for narration\n        \"appearance\": {\n            \"summary\": appearance or \"No physical description available.\",\n        },\n        \"personality\": {\n            \"summary\": personality or \"No personality analysis available.\",\n        },\n        \"voice_guidance\": _parse_voice_notes(char.voice_notes),\n\n        # Relationships\n        \"relationships\": [\n            {\"character\": name, \"type\": rel_type, \"description\": \"\"}\n            for name, rel_type in char.relationships.items()\n        ] if char.relationships else [],\n\n        # Evidence\n        \"evidence\": char.evidence,\n\n        # Metadata (secondary)\n        \"metadata\": {\n            \"first_appearance_chapter\": char.first_appearance_chapter,\n            \"mention_count\": char.mention_count,\n            \"confidence\": char.confidence.value,\n        },\n    }\n\n    return result\n\n\ndef _extract_section(descriptions: list[CharacterDescription], section_name: str) -> Optional[str]:\n    \"\"\"Extract a section from descriptions by marker.\"\"\"\n    if not descriptions:\n        return None\n\n    for desc in descriptions:\n        if f\"**{section_name}:**\" in desc.text:\n            # Extract the content after the marker\n            parts = desc.text.split(f\"**{section_name}:**\")\n            if len(parts) > 1:\n                # Get content until next section or end\n                content = parts[1].split(\"**\")[0].strip()\n                return content\n\n    return None\n\n\ndef _parse_voice_notes(voice_notes: Optional[str]) -> dict:\n    \"\"\"Parse voice notes string back into structured dict.\"\"\"\n    if not voice_notes:\n        return {\n            \"suggested_tone\": \"\",\n            \"dialect_notes\": \"\",\n            \"verbal_tics\": [],\n            \"formality_level\": \"moderate\",\n            \"emotional_range\": \"\",\n            \"example_quotes\": [],\n        }\n\n    result = {\n        \"suggested_tone\": \"\",\n        \"dialect_notes\": \"\",\n        \"verbal_tics\": [],\n        \"formality_level\": \"moderate\",\n        \"emotional_range\": \"\",\n        \"example_quotes\": [],\n    }\n\n    lines = voice_notes.split(\"\\n\")\n    in_quotes = False\n    quotes = []\n\n    for line in lines:\n        line = line.strip()\n        if line.startswith(\"Tone:\"):\n            result[\"suggested_tone\"] = line[5:].strip()\n        elif line.startswith(\"Dialect:\"):\n            result[\"dialect_notes\"] = line[8:].strip()\n        elif line.startswith(\"Verbal tics:\"):\n            # Parse quoted strings\n            import re\n            tics = re.findall(r'\"([^\"]+)\"', line)\n            result[\"verbal_tics\"] = tics\n        elif line.startswith(\"Formality:\"):\n            result[\"formality_level\"] = line[10:].strip()\n        elif line.startswith(\"Emotional range:\"):\n            result[\"emotional_range\"] = line[16:].strip()\n        elif line == \"Example quotes:\":\n            in_quotes = True\n        elif in_quotes and line.startswith(\"- \"):\n            quotes.append(line[2:])\n\n    if quotes:\n        result[\"example_quotes\"] = quotes\n\n    return result\n","numLines":343,"startLine":1,"totalLines":343}}}
