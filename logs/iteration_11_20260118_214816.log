{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EE1HfmV3LHgzpC83uP1693","type":"tool_result","content":"     1→\"\"\"\n     2→Character passage gatherer.\n     3→\n     4→Gathers relevant passages from the full text for character profile generation.\n     5→\"\"\"\n     6→\n     7→import re\n     8→import logging\n     9→from typing import Optional\n    10→from dataclasses import dataclass, field\n    11→\n    12→from .models import IdentifiedCharacter\n    13→from ..chapter_detection.models import ChapterMap, Chapter\n    14→\n    15→logger = logging.getLogger(__name__)\n    16→\n    17→\n    18→@dataclass\n    19→class CharacterPassage:\n    20→    \"\"\"A passage of text relevant to a character.\"\"\"\n    21→    text: str\n    22→    chapter_index: int\n    23→    position: int  # Character position in full text\n    24→    name_matched: str  # Which name variant matched\n    25→    context_type: str = \"mention\"  # \"mention\", \"dialogue\", \"description\"\n    26→    score: float = 0.0  # Relevance score for prioritization\n    27→\n    28→    def to_dict(self) -> dict:\n    29→        return {\n    30→            \"text\": self.text,\n    31→            \"chapter_index\": self.chapter_index,\n    32→            \"position\": self.position,\n    33→            \"name_matched\": self.name_matched,\n    34→            \"context_type\": self.context_type,\n    35→            \"score\": self.score,\n    36→        }\n    37→\n    38→\n    39→class CharacterPassageGatherer:\n    40→    \"\"\"Gathers passages relevant to a character from full text.\"\"\"\n    41→\n    42→    def __init__(\n    43→        self,\n    44→        context_window: int = 500,\n    45→        max_passages_per_name: int = 20,\n    46→    ):\n    47→        \"\"\"\n    48→        Args:\n    49→            context_window: Characters of context around each mention\n    50→            max_passages_per_name: Max passages to gather per name variant\n    51→        \"\"\"\n    52→        self.context_window = context_window\n    53→        self.max_passages_per_name = max_passages_per_name\n    54→\n    55→    def gather_passages(\n    56→        self,\n    57→        character: IdentifiedCharacter,\n    58→        full_text: str,\n    59→        chapter_map: ChapterMap,\n    60→    ) -> list[CharacterPassage]:\n    61→        \"\"\"\n    62→        Gather passages relevant to this character.\n    63→\n    64→        Searches for all name variants, deduplicates, scores, and selects\n    65→        the most relevant passages distributed across the narrative.\n    66→\n    67→        Args:\n    68→            character: The character to gather passages for\n    69→            full_text: Complete document text\n    70→            chapter_map: Chapter boundaries\n    71→\n    72→        Returns:\n    73→            List of relevant passages, sorted by position\n    74→        \"\"\"\n    75→        all_names = [character.canonical_name] + character.aliases\n    76→\n    77→        # Gather passages for each name variant\n    78→        all_passages = []\n    79→        for name in all_names:\n    80→            passages = self._find_passages_for_name(name, full_text, chapter_map)\n    81→            all_passages.extend(passages)\n    82→\n    83→        # Deduplicate by position (overlapping contexts)\n    84→        passages = self._deduplicate_passages(all_passages)\n    85→\n    86→        # Score passages by descriptive content\n    87→        passages = self._score_passages(passages)\n    88→\n    89→        # Select best passages distributed across narrative\n    90→        passages = self._select_representative_passages(passages, chapter_map)\n    91→\n    92→        logger.info(\n    93→            f\"Gathered {len(passages)} passages for {character.canonical_name}\"\n    94→        )\n    95→\n    96→        return sorted(passages, key=lambda p: p.position)\n    97→\n    98→    def _find_passages_for_name(\n    99→        self,\n   100→        name: str,\n   101→        full_text: str,\n   102→        chapter_map: ChapterMap,\n   103→    ) -> list[CharacterPassage]:\n   104→        \"\"\"Find passages containing a specific name.\"\"\"\n   105→        passages = []\n   106→\n   107→        # Escape regex special characters but allow word boundaries\n   108→        escaped_name = re.escape(name)\n   109→        # Match the name as a word (with optional punctuation after)\n   110→        pattern = rf'\\b{escaped_name}\\b'\n   111→\n   112→        for match in re.finditer(pattern, full_text, re.IGNORECASE):\n   113→            position = match.start()\n   114→\n   115→            # Get context window\n   116→            start = max(0, position - self.context_window // 2)\n   117→            end = min(len(full_text), position + len(name) + self.context_window // 2)\n   118→\n   119→            # Expand to sentence boundaries if possible\n   120→            context = full_text[start:end]\n   121→\n   122→            # Clean up partial words at boundaries\n   123→            if start > 0:\n   124→                # Find first space and trim before it\n   125→                first_space = context.find(' ')\n   126→                if first_space > 0 and first_space < 20:\n   127→                    context = \"...\" + context[first_space + 1:]\n   128→            if end < len(full_text):\n   129→                # Find last sentence-ending punctuation\n   130→                last_period = max(\n   131→                    context.rfind('.'),\n   132→                    context.rfind('!'),\n   133→                    context.rfind('?'),\n   134→                    context.rfind('\"'),\n   135→                )\n   136→                if last_period > len(context) - 50:\n   137→                    context = context[:last_period + 1]\n   138→                else:\n   139→                    # Find last space and trim after it\n   140→                    last_space = context.rfind(' ')\n   141→                    if last_space > len(context) - 20:\n   142→                        context = context[:last_space] + \"...\"\n   143→\n   144→            # Determine chapter\n   145→            chapter_idx = self._find_chapter_for_position(position, chapter_map)\n   146→\n   147→            # Determine context type\n   148→            context_type = self._classify_context(context, name)\n   149→\n   150→            passages.append(CharacterPassage(\n   151→                text=context.strip(),\n   152→                chapter_index=chapter_idx,\n   153→                position=position,\n   154→                name_matched=name,\n   155→                context_type=context_type,\n   156→            ))\n   157→\n   158→            # Limit per name variant\n   159→            if len(passages) >= self.max_passages_per_name:\n   160→                break\n   161→\n   162→        return passages\n   163→\n   164→    def _find_chapter_for_position(\n   165→        self,\n   166→        position: int,\n   167→        chapter_map: ChapterMap,\n   168→    ) -> int:\n   169→        \"\"\"Find which chapter a position belongs to.\"\"\"\n   170→        for chapter in chapter_map.chapters:\n   171→            if chapter.start_position <= position < chapter.end_position:\n   172→                return chapter.index\n   173→        # Default to chapter 1 if not found\n   174→        return 1\n   175→\n   176→    def _classify_context(self, context: str, name: str) -> str:\n   177→        \"\"\"Classify the type of context (dialogue, description, mention).\"\"\"\n   178→        # Check for dialogue markers\n   179→        has_quotes = '\"' in context or \"'\" in context\n   180→        has_said = any(word in context.lower() for word in [\n   181→            'said', 'asked', 'replied', 'answered', 'shouted',\n   182→            'whispered', 'exclaimed', 'muttered', 'spoke'\n   183→        ])\n   184→\n   185→        if has_quotes and has_said:\n   186→            return \"dialogue\"\n   187→\n   188→        # Check for descriptive language\n   189→        descriptive_words = [\n   190→            'looked', 'appeared', 'wore', 'dressed', 'tall', 'short',\n   191→            'eyes', 'hair', 'face', 'voice', 'smile', 'expression',\n   192→            'young', 'old', 'beautiful', 'handsome'\n   193→        ]\n   194→        if any(word in context.lower() for word in descriptive_words):\n   195→            return \"description\"\n   196→\n   197→        return \"mention\"\n   198→\n   199→    def _deduplicate_passages(\n   200→        self,\n   201→        passages: list[CharacterPassage],\n   202→    ) -> list[CharacterPassage]:\n   203→        \"\"\"Remove passages with overlapping contexts.\"\"\"\n   204→        if not passages:\n   205→            return []\n   206→\n   207→        # Sort by position\n   208→        sorted_passages = sorted(passages, key=lambda p: p.position)\n   209→\n   210→        deduplicated = [sorted_passages[0]]\n   211→        for passage in sorted_passages[1:]:\n   212→            last = deduplicated[-1]\n   213→            # Check if positions are too close (overlapping contexts)\n   214→            if passage.position - last.position > self.context_window // 2:\n   215→                deduplicated.append(passage)\n   216→            elif passage.score > last.score:\n   217→                # Replace with higher-scoring passage\n   218→                deduplicated[-1] = passage\n   219→\n   220→        return deduplicated\n   221→\n   222→    def _score_passages(\n   223→        self,\n   224→        passages: list[CharacterPassage],\n   225→    ) -> list[CharacterPassage]:\n   226→        \"\"\"Score passages by relevance for profiling.\"\"\"\n   227→        for passage in passages:\n   228→            score = 0.0\n   229→\n   230→            text_lower = passage.text.lower()\n   231→\n   232→            # Dialogue is valuable for voice\n   233→            if passage.context_type == \"dialogue\":\n   234→                score += 2.0\n   235→\n   236→            # Descriptions are valuable\n   237→            if passage.context_type == \"description\":\n   238→                score += 3.0\n   239→\n   240→            # Physical description keywords\n   241→            physical_words = [\n   242→                'tall', 'short', 'thin', 'fat', 'stout', 'slender',\n   243→                'eyes', 'hair', 'face', 'hands', 'voice', 'smile',\n   244→                'beautiful', 'handsome', 'ugly', 'pretty', 'elegant'\n   245→            ]\n   246→            for word in physical_words:\n   247→                if word in text_lower:\n   248→                    score += 0.5\n   249→\n   250→            # Personality keywords\n   251→            personality_words = [\n   252→                'kind', 'cruel', 'gentle', 'harsh', 'nervous', 'calm',\n   253→                'arrogant', 'humble', 'intelligent', 'foolish',\n   254→                'honest', 'deceitful', 'brave', 'cowardly'\n   255→            ]\n   256→            for word in personality_words:\n   257→                if word in text_lower:\n   258→                    score += 0.5\n   259→\n   260→            # Relationship keywords\n   261→            relationship_words = [\n   262→                'husband', 'wife', 'married', 'love', 'hate',\n   263→                'friend', 'enemy', 'cousin', 'brother', 'sister',\n   264→                'father', 'mother', 'son', 'daughter'\n   265→            ]\n   266→            for word in relationship_words:\n   267→                if word in text_lower:\n   268→                    score += 0.5\n   269→\n   270→            passage.score = score\n   271→\n   272→        return passages\n   273→\n   274→    def _select_representative_passages(\n   275→        self,\n   276→        passages: list[CharacterPassage],\n   277→        chapter_map: ChapterMap,\n   278→        max_passages: int = 15,\n   279→    ) -> list[CharacterPassage]:\n   280→        \"\"\"\n   281→        Select representative passages distributed across the narrative.\n   282→\n   283→        Ensures coverage of early, middle, and late sections.\n   284→        \"\"\"\n   285→        if len(passages) <= max_passages:\n   286→            return passages\n   287→\n   288→        # Divide chapters into thirds\n   289→        num_chapters = len(chapter_map.chapters)\n   290→        early_end = num_chapters // 3\n   291→        mid_end = 2 * num_chapters // 3\n   292→\n   293→        early_passages = [p for p in passages if p.chapter_index <= early_end]\n   294→        mid_passages = [p for p in passages if early_end < p.chapter_index <= mid_end]\n   295→        late_passages = [p for p in passages if p.chapter_index > mid_end]\n   296→\n   297→        # Sort each group by score (descending)\n   298→        early_passages.sort(key=lambda p: p.score, reverse=True)\n   299→        mid_passages.sort(key=lambda p: p.score, reverse=True)\n   300→        late_passages.sort(key=lambda p: p.score, reverse=True)\n   301→\n   302→        # Select from each group (5 each, roughly)\n   303→        per_group = max_passages // 3\n   304→        selected = []\n   305→        selected.extend(early_passages[:per_group])\n   306→        selected.extend(mid_passages[:per_group])\n   307→        selected.extend(late_passages[:per_group])\n   308→\n   309→        # Fill remaining slots with highest-scoring overall\n   310→        remaining = max_passages - len(selected)\n   311→        if remaining > 0:\n   312→            all_remaining = [p for p in passages if p not in selected]\n   313→            all_remaining.sort(key=lambda p: p.score, reverse=True)\n   314→            selected.extend(all_remaining[:remaining])\n   315→\n   316→        return selected\n   317→\n   318→\n   319→def gather_character_passages(\n   320→    character: IdentifiedCharacter,\n   321→    full_text: str,\n   322→    chapter_map: ChapterMap,\n   323→    context_window: int = 500,\n   324→    max_passages: int = 15,\n   325→) -> list[CharacterPassage]:\n   326→    \"\"\"\n   327→    Convenience function to gather passages for a character.\n   328→\n   329→    Args:\n   330→        character: The character to gather passages for\n   331→        full_text: Complete document text\n   332→        chapter_map: Chapter boundaries\n   333→        context_window: Characters of context around each mention\n   334→        max_passages: Maximum passages to return\n   335→\n   336→    Returns:\n   337→        List of relevant passages\n   338→    \"\"\"\n   339→    gatherer = CharacterPassageGatherer(\n   340→        context_window=context_window,\n   341→        max_passages_per_name=max_passages * 2,  # Gather more, then select\n   342→    )\n   343→    return gatherer.gather_passages(character, full_text, chapter_map)\n   344→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef7a1348-36ae-43ad-a27c-fe7fef12baa3","uuid":"9a529dd0-7f0a-4b81-bcfc-0ca956f1a0d5","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_profiling/passage_gatherer.py","content":"\"\"\"\nCharacter passage gatherer.\n\nGathers relevant passages from the full text for character profile generation.\n\"\"\"\n\nimport re\nimport logging\nfrom typing import Optional\nfrom dataclasses import dataclass, field\n\nfrom .models import IdentifiedCharacter\nfrom ..chapter_detection.models import ChapterMap, Chapter\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass CharacterPassage:\n    \"\"\"A passage of text relevant to a character.\"\"\"\n    text: str\n    chapter_index: int\n    position: int  # Character position in full text\n    name_matched: str  # Which name variant matched\n    context_type: str = \"mention\"  # \"mention\", \"dialogue\", \"description\"\n    score: float = 0.0  # Relevance score for prioritization\n\n    def to_dict(self) -> dict:\n        return {\n            \"text\": self.text,\n            \"chapter_index\": self.chapter_index,\n            \"position\": self.position,\n            \"name_matched\": self.name_matched,\n            \"context_type\": self.context_type,\n            \"score\": self.score,\n        }\n\n\nclass CharacterPassageGatherer:\n    \"\"\"Gathers passages relevant to a character from full text.\"\"\"\n\n    def __init__(\n        self,\n        context_window: int = 500,\n        max_passages_per_name: int = 20,\n    ):\n        \"\"\"\n        Args:\n            context_window: Characters of context around each mention\n            max_passages_per_name: Max passages to gather per name variant\n        \"\"\"\n        self.context_window = context_window\n        self.max_passages_per_name = max_passages_per_name\n\n    def gather_passages(\n        self,\n        character: IdentifiedCharacter,\n        full_text: str,\n        chapter_map: ChapterMap,\n    ) -> list[CharacterPassage]:\n        \"\"\"\n        Gather passages relevant to this character.\n\n        Searches for all name variants, deduplicates, scores, and selects\n        the most relevant passages distributed across the narrative.\n\n        Args:\n            character: The character to gather passages for\n            full_text: Complete document text\n            chapter_map: Chapter boundaries\n\n        Returns:\n            List of relevant passages, sorted by position\n        \"\"\"\n        all_names = [character.canonical_name] + character.aliases\n\n        # Gather passages for each name variant\n        all_passages = []\n        for name in all_names:\n            passages = self._find_passages_for_name(name, full_text, chapter_map)\n            all_passages.extend(passages)\n\n        # Deduplicate by position (overlapping contexts)\n        passages = self._deduplicate_passages(all_passages)\n\n        # Score passages by descriptive content\n        passages = self._score_passages(passages)\n\n        # Select best passages distributed across narrative\n        passages = self._select_representative_passages(passages, chapter_map)\n\n        logger.info(\n            f\"Gathered {len(passages)} passages for {character.canonical_name}\"\n        )\n\n        return sorted(passages, key=lambda p: p.position)\n\n    def _find_passages_for_name(\n        self,\n        name: str,\n        full_text: str,\n        chapter_map: ChapterMap,\n    ) -> list[CharacterPassage]:\n        \"\"\"Find passages containing a specific name.\"\"\"\n        passages = []\n\n        # Escape regex special characters but allow word boundaries\n        escaped_name = re.escape(name)\n        # Match the name as a word (with optional punctuation after)\n        pattern = rf'\\b{escaped_name}\\b'\n\n        for match in re.finditer(pattern, full_text, re.IGNORECASE):\n            position = match.start()\n\n            # Get context window\n            start = max(0, position - self.context_window // 2)\n            end = min(len(full_text), position + len(name) + self.context_window // 2)\n\n            # Expand to sentence boundaries if possible\n            context = full_text[start:end]\n\n            # Clean up partial words at boundaries\n            if start > 0:\n                # Find first space and trim before it\n                first_space = context.find(' ')\n                if first_space > 0 and first_space < 20:\n                    context = \"...\" + context[first_space + 1:]\n            if end < len(full_text):\n                # Find last sentence-ending punctuation\n                last_period = max(\n                    context.rfind('.'),\n                    context.rfind('!'),\n                    context.rfind('?'),\n                    context.rfind('\"'),\n                )\n                if last_period > len(context) - 50:\n                    context = context[:last_period + 1]\n                else:\n                    # Find last space and trim after it\n                    last_space = context.rfind(' ')\n                    if last_space > len(context) - 20:\n                        context = context[:last_space] + \"...\"\n\n            # Determine chapter\n            chapter_idx = self._find_chapter_for_position(position, chapter_map)\n\n            # Determine context type\n            context_type = self._classify_context(context, name)\n\n            passages.append(CharacterPassage(\n                text=context.strip(),\n                chapter_index=chapter_idx,\n                position=position,\n                name_matched=name,\n                context_type=context_type,\n            ))\n\n            # Limit per name variant\n            if len(passages) >= self.max_passages_per_name:\n                break\n\n        return passages\n\n    def _find_chapter_for_position(\n        self,\n        position: int,\n        chapter_map: ChapterMap,\n    ) -> int:\n        \"\"\"Find which chapter a position belongs to.\"\"\"\n        for chapter in chapter_map.chapters:\n            if chapter.start_position <= position < chapter.end_position:\n                return chapter.index\n        # Default to chapter 1 if not found\n        return 1\n\n    def _classify_context(self, context: str, name: str) -> str:\n        \"\"\"Classify the type of context (dialogue, description, mention).\"\"\"\n        # Check for dialogue markers\n        has_quotes = '\"' in context or \"'\" in context\n        has_said = any(word in context.lower() for word in [\n            'said', 'asked', 'replied', 'answered', 'shouted',\n            'whispered', 'exclaimed', 'muttered', 'spoke'\n        ])\n\n        if has_quotes and has_said:\n            return \"dialogue\"\n\n        # Check for descriptive language\n        descriptive_words = [\n            'looked', 'appeared', 'wore', 'dressed', 'tall', 'short',\n            'eyes', 'hair', 'face', 'voice', 'smile', 'expression',\n            'young', 'old', 'beautiful', 'handsome'\n        ]\n        if any(word in context.lower() for word in descriptive_words):\n            return \"description\"\n\n        return \"mention\"\n\n    def _deduplicate_passages(\n        self,\n        passages: list[CharacterPassage],\n    ) -> list[CharacterPassage]:\n        \"\"\"Remove passages with overlapping contexts.\"\"\"\n        if not passages:\n            return []\n\n        # Sort by position\n        sorted_passages = sorted(passages, key=lambda p: p.position)\n\n        deduplicated = [sorted_passages[0]]\n        for passage in sorted_passages[1:]:\n            last = deduplicated[-1]\n            # Check if positions are too close (overlapping contexts)\n            if passage.position - last.position > self.context_window // 2:\n                deduplicated.append(passage)\n            elif passage.score > last.score:\n                # Replace with higher-scoring passage\n                deduplicated[-1] = passage\n\n        return deduplicated\n\n    def _score_passages(\n        self,\n        passages: list[CharacterPassage],\n    ) -> list[CharacterPassage]:\n        \"\"\"Score passages by relevance for profiling.\"\"\"\n        for passage in passages:\n            score = 0.0\n\n            text_lower = passage.text.lower()\n\n            # Dialogue is valuable for voice\n            if passage.context_type == \"dialogue\":\n                score += 2.0\n\n            # Descriptions are valuable\n            if passage.context_type == \"description\":\n                score += 3.0\n\n            # Physical description keywords\n            physical_words = [\n                'tall', 'short', 'thin', 'fat', 'stout', 'slender',\n                'eyes', 'hair', 'face', 'hands', 'voice', 'smile',\n                'beautiful', 'handsome', 'ugly', 'pretty', 'elegant'\n            ]\n            for word in physical_words:\n                if word in text_lower:\n                    score += 0.5\n\n            # Personality keywords\n            personality_words = [\n                'kind', 'cruel', 'gentle', 'harsh', 'nervous', 'calm',\n                'arrogant', 'humble', 'intelligent', 'foolish',\n                'honest', 'deceitful', 'brave', 'cowardly'\n            ]\n            for word in personality_words:\n                if word in text_lower:\n                    score += 0.5\n\n            # Relationship keywords\n            relationship_words = [\n                'husband', 'wife', 'married', 'love', 'hate',\n                'friend', 'enemy', 'cousin', 'brother', 'sister',\n                'father', 'mother', 'son', 'daughter'\n            ]\n            for word in relationship_words:\n                if word in text_lower:\n                    score += 0.5\n\n            passage.score = score\n\n        return passages\n\n    def _select_representative_passages(\n        self,\n        passages: list[CharacterPassage],\n        chapter_map: ChapterMap,\n        max_passages: int = 15,\n    ) -> list[CharacterPassage]:\n        \"\"\"\n        Select representative passages distributed across the narrative.\n\n        Ensures coverage of early, middle, and late sections.\n        \"\"\"\n        if len(passages) <= max_passages:\n            return passages\n\n        # Divide chapters into thirds\n        num_chapters = len(chapter_map.chapters)\n        early_end = num_chapters // 3\n        mid_end = 2 * num_chapters // 3\n\n        early_passages = [p for p in passages if p.chapter_index <= early_end]\n        mid_passages = [p for p in passages if early_end < p.chapter_index <= mid_end]\n        late_passages = [p for p in passages if p.chapter_index > mid_end]\n\n        # Sort each group by score (descending)\n        early_passages.sort(key=lambda p: p.score, reverse=True)\n        mid_passages.sort(key=lambda p: p.score, reverse=True)\n        late_passages.sort(key=lambda p: p.score, reverse=True)\n\n        # Select from each group (5 each, roughly)\n        per_group = max_passages // 3\n        selected = []\n        selected.extend(early_passages[:per_group])\n        selected.extend(mid_passages[:per_group])\n        selected.extend(late_passages[:per_group])\n\n        # Fill remaining slots with highest-scoring overall\n        remaining = max_passages - len(selected)\n        if remaining > 0:\n            all_remaining = [p for p in passages if p not in selected]\n            all_remaining.sort(key=lambda p: p.score, reverse=True)\n            selected.extend(all_remaining[:remaining])\n\n        return selected\n\n\ndef gather_character_passages(\n    character: IdentifiedCharacter,\n    full_text: str,\n    chapter_map: ChapterMap,\n    context_window: int = 500,\n    max_passages: int = 15,\n) -> list[CharacterPassage]:\n    \"\"\"\n    Convenience function to gather passages for a character.\n\n    Args:\n        character: The character to gather passages for\n        full_text: Complete document text\n        chapter_map: Chapter boundaries\n        context_window: Characters of context around each mention\n        max_passages: Maximum passages to return\n\n    Returns:\n        List of relevant passages\n    \"\"\"\n    gatherer = CharacterPassageGatherer(\n        context_window=context_window,\n        max_passages_per_name=max_passages * 2,  # Gather more, then select\n    )\n    return gatherer.gather_passages(character, full_text, chapter_map)\n","numLines":344,"startLine":1,"totalLines":344}}}
