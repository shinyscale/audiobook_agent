{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G9vToKuk38LL5eA364k8Lw","type":"tool_result","content":"  1459→    def _generate_character_profile(\n  1460→        self,\n  1461→        llm: \"LLMClient\",\n  1462→        character,\n  1463→        full_text: str,\n  1464→        chapter_map: Optional[\"ChapterMap\"] = None,\n  1465→        summary_evidence: Optional[\"CharacterSummaryEvidence\"] = None,\n  1466→        moral_valence: Optional[\"MoralValenceResult\"] = None,\n  1467→    ) -> tuple[str, list[dict], float, Optional[dict], Optional[dict], Optional[dict]]:\n  1468→        \"\"\"Generate prose profile for a character using LLM with evidence grounding.\n  1469→\n  1470→        Args:\n  1471→            llm: LLM client for generation\n  1472→            character: Character to profile\n  1473→            full_text: Full document text\n  1474→            chapter_map: Chapter boundaries (optional)\n  1475→            summary_evidence: F2 - Evidence extracted from chapter summaries (optional)\n  1476→            moral_valence: F3 - Moral valence classification result (optional)\n  1477→\n  1478→        Returns:\n  1479→            tuple: (profile_text, evidence_list, confidence_score, appearance, personality, voice_guidance)\n  1480→                evidence_list: List of dicts with 'statement', 'quote', 'position'\n  1481→                confidence_score: 0.0-1.0 based on evidence quality\n  1482→                appearance: Dict with appearance data or None\n  1483→                personality: Dict with personality data or None\n  1484→                voice_guidance: Dict with voice guidance data or None\n  1485→        \"\"\"\n  1486→        import json\n  1487→        import re\n  1488→        from .pipeline.character_extraction.models import CharacterMention\n  1489→\n  1490→        # Sample mentions from throughout the book (early, middle, late)\n  1491→        # to ensure character proof reflects the entire narrative\n  1492→        all_mentions = getattr(character, \"mentions\", []) or []\n  1493→        total_mentions = len(all_mentions)\n  1494→\n  1495→        # Fallback: if mention objects are unexpectedly missing (but the character exists),\n  1496→        # rebuild a small set of mention positions via regex so we can still generate a profile.\n  1497→        #\n  1498→        # This prevents \"No detailed profile available\" for major characters when upstream\n  1499→        # mention tracking is incomplete.\n  1500→        if total_mentions == 0 and getattr(character, \"canonical_name\", \"\"):\n  1501→            names = [getattr(character, \"canonical_name\", \"\")]\n  1502→            names.extend(getattr(character, \"aliases\", []) or [])\n  1503→            names = [n for n in names if isinstance(n, str) and n.strip()]\n  1504→\n  1505→            positions: set[int] = set()\n  1506→            for name in names:\n  1507→                # Allow flexible whitespace for multi-word names (e.g., \"De Lacey\")\n  1508→                escaped = re.escape(name).replace(r\"\\ \", r\"\\s+\")\n  1509→                pattern = rf\"\\b{escaped}\\b\"\n  1510→                for m in re.finditer(pattern, full_text, flags=re.IGNORECASE):\n  1511→                    positions.add(m.start())\n  1512→\n  1513→            pos_list = sorted(positions)\n  1514→\n  1515→            # Sample up to 10 positions spread across the text\n  1516→            if len(pos_list) > 10:\n  1517→                idxs = [int(i * (len(pos_list) - 1) / 9) for i in range(10)]\n  1518→                pos_list = [pos_list[i] for i in idxs]\n  1519→\n  1520→            def _chapter_for_pos(pos: int) -> int:\n  1521→                if chapter_map is None:\n  1522→                    return 0\n  1523→                for ch in chapter_map.chapters:\n  1524→                    if ch.start_position <= pos < ch.end_position:\n  1525→                        return ch.index\n  1526→                return 0\n  1527→\n  1528→            all_mentions = [\n  1529→                CharacterMention(\n  1530→                    text=getattr(character, \"canonical_name\", \"\") or \"\",\n  1531→                    position=pos,\n  1532→                    chapter_index=_chapter_for_pos(pos),\n  1533→                    context=\"\",\n  1534→                    in_dialogue=False,\n  1535→                )\n  1536→                for pos in pos_list\n  1537→            ]\n  1538→            total_mentions = len(all_mentions)\n  1539→\n  1540→        # Sample up to 10 mentions, distributed across the narrative\n  1541→        if total_mentions <= 10:\n  1542→            sampled_mentions = all_mentions\n  1543→        else:\n  1544→            # Divide mentions into thirds (early, middle, late) and sample from each\n  1545→            third = total_mentions // 3\n  1546→            early = all_mentions[:third]\n  1547→            middle = all_mentions[third:2*third]\n  1548→            late = all_mentions[2*third:]\n  1549→\n  1550→            # Sample 3-4 from each third\n  1551→            import random\n  1552→            sampled_mentions = []\n  1553→            sampled_mentions.extend(random.sample(early, min(3, len(early))))\n  1554→            sampled_mentions.extend(random.sample(middle, min(3, len(middle))))\n  1555→            sampled_mentions.extend(random.sample(late, min(4, len(late))))\n  1556→\n  1557→            # Sort by position to maintain chronological order in context\n  1558→            sampled_mentions.sort(key=lambda m: m.position)\n  1559→\n  1560→        # Gather context snippets from sampled mentions\n  1561→        contexts = []\n  1562→        mention_positions = []\n  1563→        for mention in sampled_mentions:\n  1564→            start = max(0, mention.position - 200)  # Increased context window\n  1565→            end = min(len(full_text), mention.position + 200)\n  1566→            snippet = full_text[start:end].strip()\n  1567→            # Clean up partial words at boundaries\n  1568→            if start > 0:\n  1569→                snippet = \"...\" + snippet.split(\" \", 1)[-1] if \" \" in snippet else snippet\n  1570→            if end < len(full_text):\n  1571→                snippet = snippet.rsplit(\" \", 1)[0] + \"...\" if \" \" in snippet else snippet\n  1572→            contexts.append({\n  1573→                \"text\": snippet,\n  1574→                \"position\": mention.position,\n  1575→                \"chapter\": mention.chapter_index\n  1576→            })\n  1577→            mention_positions.append(mention.position)\n  1578→\n  1579→        if not contexts:\n  1580→            logger.warning(f\"No context available for {character.canonical_name}\")\n  1581→            return \"\", [], 0.0, None, None, None\n  1582→\n  1583→        context_text = \"\\n\\n\".join([\n  1584→            f\"[Context {i+1}, Chapter {c['chapter']}, Position {c['position']}]:\\n{c['text']}\"\n  1585→            for i, c in enumerate(contexts)\n  1586→        ])\n  1587→\n  1588→        # Check if this character is the narrator\n  1589→        narrator_note = \"\"\n  1590→        if hasattr(character, 'is_narrator') and character.is_narrator:\n  1591→            narrator_note = f\"\\n\\nNOTE: This character is the NARRATOR of the story ({character.narrative_role or 'First-person narrator'}). Your description should mention their role as the narrator/storyteller.\"\n  1592→\n  1593→        # F2: Build summary evidence section if available\n  1594→        summary_evidence_text = \"\"\n  1595→        if summary_evidence and summary_evidence.evidence:\n  1596→            evidence_lines = []\n  1597→            for ev in summary_evidence.evidence[:5]:  # Limit to top 5 items\n  1598→                evidence_lines.append(f\"- Chapter {ev.chapter_index}: \\\"{ev.statement}\\\"\")\n  1599→            if evidence_lines:\n  1600→                summary_evidence_text = f\"\"\"\n  1601→\n  1602→ADDITIONAL CONTEXT FROM CHAPTER SUMMARIES (Feature F2):\n  1603→The following information about this character was extracted from chapter summaries:\n  1604→{chr(10).join(evidence_lines)}\n  1605→\n  1606→Use this summary evidence to enrich your profile, but prioritize direct text quotes as primary evidence.\"\"\"\n  1607→\n  1608→        # F3: Build moral valence constraint if available\n  1609→        moral_valence_constraint = \"\"\n  1610→        if moral_valence and moral_valence.valence:\n  1611→            constraint = MORAL_VALENCE_CONSTRAINTS.get(moral_valence.valence, \"\")\n  1612→            if constraint:\n  1613→                moral_valence_constraint = f\"\"\"\n  1614→\n  1615→MORAL VALENCE CONSTRAINT (Feature F3):\n  1616→This character has been classified as {moral_valence.valence.value} (confidence: {moral_valence.confidence:.0%}).\n  1617→{constraint}\n  1618→\n  1619→This is a HARD CONSTRAINT - your profile MUST respect this classification.\"\"\"\n  1620→\n  1621→        prompt = f\"\"\"Analyze the character \"{character.canonical_name}\" using ONLY the provided text evidence.\n  1622→\n  1623→The evidence below is sampled from throughout the entire narrative (early, middle, and late chapters).\n  1624→Your analysis should reflect the character's full arc, not just their initial appearance.{narrator_note}{summary_evidence_text}{moral_valence_constraint}\n  1625→\n  1626→Text Evidence:\n  1627→{context_text}\n  1628→\n  1629→CRITICAL REQUIREMENTS:\n  1630→1. Make ONLY claims that are directly supported by the provided text\n  1631→2. For each claim, provide the exact quote that supports it\n  1632→3. Consider how the character develops or changes throughout the narrative (if evident from the samples)\n  1633→4. If the text doesn't provide enough information about a trait or relationship, DO NOT invent it\n  1634→5. Distinguish between what the text explicitly states vs. what might be inferred\n  1635→\n  1636→Return a JSON response matching this example format exactly:\n  1637→\n  1638→```json\n  1639→{{\n  1640→  \"profile\": \"A brief 2-3 sentence overview based on provided evidence.\",\n  1641→  \"appearance\": {{\n  1642→    \"summary\": \"Brief physical description if available from text\",\n  1643→    \"age_indication\": \"young/middle-aged/elderly/unknown\",\n  1644→    \"distinguishing_features\": [\"feature1\", \"feature2\"]\n  1645→  }},\n  1646→  \"personality\": {{\n  1647→    \"summary\": \"Brief personality summary\",\n  1648→    \"traits\": [\"trait1\", \"trait2\"],\n  1649→    \"temperament\": \"calm/volatile/melancholic/cheerful/etc or unknown\",\n  1650→    \"emotional_range\": \"Brief note on emotional expression\"\n  1651→  }},\n  1652→  \"voice_guidance\": {{\n  1653→    \"suggested_tone\": \"authoritative/gentle/aggressive/etc based on dialogue\",\n  1654→    \"dialect_notes\": \"Any accent, regional speech, or class markers\",\n  1655→    \"verbal_tics\": [\"repeated phrase\", \"speech pattern\"],\n  1656→    \"formality_level\": \"formal/informal/moderate\",\n  1657→    \"example_quotes\": [\"quote1\", \"quote2\"]\n  1658→  }},\n  1659→  \"evidence\": [\n  1660→    {{\"statement\": \"Character is newly relocated\", \"quote\": \"I had just arrived in the city that spring\", \"position\": 1234}},\n  1661→    {{\"statement\": \"Has family in the area\", \"quote\": \"My cousin lived just across the bay\", \"position\": 2456}}\n  1662→  ],\n  1663→  \"confidence\": 0.85,\n  1664→  \"limitations\": \"What the text doesn't reveal\"\n  1665→}}\n  1666→```\n  1667→\n  1668→CRITICAL INSTRUCTIONS:\n  1669→- You MUST include ALL fields in your response: profile, appearance, personality, voice_guidance, evidence, confidence, limitations\n  1670→- If information is not available in the text, use \"unknown\" or empty arrays [] for that field\n  1671→- Do NOT omit any field - every field must be present even if the value is \"unknown\" or []\n  1672→- Do NOT invent details - only use what's explicitly or clearly implied in the provided text\n  1673→- For appearance: Only include if text mentions physical traits, otherwise use {{\"summary\": \"unknown\", \"age_indication\": \"unknown\", \"distinguishing_features\": []}}\n  1674→- For personality: Only include if you can infer from behavior, otherwise use {{\"summary\": \"unknown\", \"traits\": [], \"temperament\": \"unknown\", \"emotional_range\": \"unknown\"}}\n  1675→- For voice_guidance: Base on actual dialogue if present; otherwise use {{\"suggested_tone\": \"unknown\", \"dialect_notes\": \"unknown\", \"verbal_tics\": [], \"formality_level\": \"moderate\", \"example_quotes\": []}}\n  1676→- Return ONLY valid JSON matching the above structure. No other text.\"\"\"\n  1677→\n  1678→        # Helper to parse JSON from LLM response\n  1679→        def _parse_json_blob(s: str):\n  1680→            try:\n  1681→                return json.loads(s)\n  1682→            except json.JSONDecodeError:\n  1683→                start = s.find(\"{\")\n  1684→                end = s.rfind(\"}\")\n  1685→                if start != -1 and end != -1 and end > start:\n  1686→                    try:\n  1687→                        return json.loads(s[start:end + 1])\n  1688→                    except json.JSONDecodeError:\n  1689→                        return None\n  1690→                return None\n  1691→\n  1692→        # Retry loop: try up to 2 times on LLM errors\n  1693→        max_attempts = 2\n  1694→        for attempt in range(max_attempts):\n  1695→            try:\n  1696→                response = llm.query(prompt, system=CHARACTER_PROFILE_SYSTEM)\n  1697→                if response.success:\n  1698→                    # Clean up any thinking tags or extra formatting\n  1699→                    content = response.content.strip()\n  1700→\n  1701→                    # Try to extract JSON if wrapped in markdown code blocks\n  1702→                    if \"```json\" in content:\n  1703→                        content = content.split(\"```json\")[1].split(\"```\")[0].strip()\n  1704→                    elif \"```\" in content:\n  1705→                        content = content.split(\"```\")[1].split(\"```\")[0].strip()\n  1706→\n  1707→                    try:\n  1708→                        result = _parse_json_blob(content)\n  1709→                        if result is None:\n  1710→                            raise json.JSONDecodeError(\"Could not parse JSON\", content, 0)\n  1711→\n  1712→                        # Check if \"profile\" field itself contains JSON (double-encoded)\n  1713→                        profile = result.get(\"profile\", \"\")\n  1714→                        if profile and (profile.startswith(\"{\") or profile.startswith(\"[\")):\n  1715→                            # LLM returned nested JSON - try to parse it\n  1716→                            logger.warning(\n  1717→                                f\"Character profile for {character.canonical_name} contains nested JSON, attempting to parse\"\n  1718→                            )\n  1719→                            try:\n  1720→                                nested = json.loads(profile)\n  1721→                                if isinstance(nested, dict) and \"profile\" in nested:\n  1722→                                    # Double-encoded JSON\n  1723→                                    profile = nested[\"profile\"]\n  1724→                                    logger.info(f\"Successfully extracted profile from nested JSON for {character.canonical_name}\")\n  1725→                            except json.JSONDecodeError:\n  1726→                                # Not valid JSON - try to extract readable text\n  1727→                                logger.warning(f\"Nested JSON parse failed for {character.canonical_name}, extracting text\")\n  1728→                                profile = self._extract_text_from_malformed_json(profile)\n  1729→                                if not profile:\n  1730→                                    logger.warning(f\"Could not salvage text from malformed profile for {character.canonical_name}\")\n  1731→\n  1732→                        evidence = result.get(\"evidence\", [])\n  1733→                        confidence = float(result.get(\"confidence\", 0.5))\n  1734→\n  1735→                        # Extract structured fields (F8: Simplified Character Output)\n  1736→                        appearance = result.get(\"appearance\")\n  1737→                        personality = result.get(\"personality\")\n  1738→                        voice_guidance = result.get(\"voice_guidance\")\n  1739→\n  1740→                        # Debug logging\n  1741→                        logger.info(\n  1742→                            f\"Profile generation for {character.canonical_name}: \"\n  1743→                            f\"keys={list(result.keys())}, \"\n  1744→                            f\"appearance={'present' if appearance else 'missing'}, \"\n  1745→                            f\"personality={'present' if personality else 'missing'}, \"\n  1746→                            f\"voice_guidance={'present' if voice_guidance else 'missing'}\"\n  1747→                        )\n  1748→\n  1749→                        # DETAILED DEBUG: Log the actual structured field contents\n  1750→                        if appearance:\n  1751→                            logger.info(f\"  appearance content: {json.dumps(appearance)}\")\n  1752→                        if personality:\n  1753→                            logger.info(f\"  personality content: {json.dumps(personality)}\")\n  1754→                        if voice_guidance:\n  1755→                            logger.info(f\"  voice_guidance content: {json.dumps(voice_guidance)}\")\n  1756→\n  1757→                        # Preserve structured fields even if they contain \"unknown\" values\n  1758→                        def _clean_dict(d):\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"35a28cf5-fe4b-4748-8400-83d8252c761a","uuid":"91779d90-bafd-4200-8110-0a9611e905dd","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/analyzer.py","content":"    def _generate_character_profile(\n        self,\n        llm: \"LLMClient\",\n        character,\n        full_text: str,\n        chapter_map: Optional[\"ChapterMap\"] = None,\n        summary_evidence: Optional[\"CharacterSummaryEvidence\"] = None,\n        moral_valence: Optional[\"MoralValenceResult\"] = None,\n    ) -> tuple[str, list[dict], float, Optional[dict], Optional[dict], Optional[dict]]:\n        \"\"\"Generate prose profile for a character using LLM with evidence grounding.\n\n        Args:\n            llm: LLM client for generation\n            character: Character to profile\n            full_text: Full document text\n            chapter_map: Chapter boundaries (optional)\n            summary_evidence: F2 - Evidence extracted from chapter summaries (optional)\n            moral_valence: F3 - Moral valence classification result (optional)\n\n        Returns:\n            tuple: (profile_text, evidence_list, confidence_score, appearance, personality, voice_guidance)\n                evidence_list: List of dicts with 'statement', 'quote', 'position'\n                confidence_score: 0.0-1.0 based on evidence quality\n                appearance: Dict with appearance data or None\n                personality: Dict with personality data or None\n                voice_guidance: Dict with voice guidance data or None\n        \"\"\"\n        import json\n        import re\n        from .pipeline.character_extraction.models import CharacterMention\n\n        # Sample mentions from throughout the book (early, middle, late)\n        # to ensure character proof reflects the entire narrative\n        all_mentions = getattr(character, \"mentions\", []) or []\n        total_mentions = len(all_mentions)\n\n        # Fallback: if mention objects are unexpectedly missing (but the character exists),\n        # rebuild a small set of mention positions via regex so we can still generate a profile.\n        #\n        # This prevents \"No detailed profile available\" for major characters when upstream\n        # mention tracking is incomplete.\n        if total_mentions == 0 and getattr(character, \"canonical_name\", \"\"):\n            names = [getattr(character, \"canonical_name\", \"\")]\n            names.extend(getattr(character, \"aliases\", []) or [])\n            names = [n for n in names if isinstance(n, str) and n.strip()]\n\n            positions: set[int] = set()\n            for name in names:\n                # Allow flexible whitespace for multi-word names (e.g., \"De Lacey\")\n                escaped = re.escape(name).replace(r\"\\ \", r\"\\s+\")\n                pattern = rf\"\\b{escaped}\\b\"\n                for m in re.finditer(pattern, full_text, flags=re.IGNORECASE):\n                    positions.add(m.start())\n\n            pos_list = sorted(positions)\n\n            # Sample up to 10 positions spread across the text\n            if len(pos_list) > 10:\n                idxs = [int(i * (len(pos_list) - 1) / 9) for i in range(10)]\n                pos_list = [pos_list[i] for i in idxs]\n\n            def _chapter_for_pos(pos: int) -> int:\n                if chapter_map is None:\n                    return 0\n                for ch in chapter_map.chapters:\n                    if ch.start_position <= pos < ch.end_position:\n                        return ch.index\n                return 0\n\n            all_mentions = [\n                CharacterMention(\n                    text=getattr(character, \"canonical_name\", \"\") or \"\",\n                    position=pos,\n                    chapter_index=_chapter_for_pos(pos),\n                    context=\"\",\n                    in_dialogue=False,\n                )\n                for pos in pos_list\n            ]\n            total_mentions = len(all_mentions)\n\n        # Sample up to 10 mentions, distributed across the narrative\n        if total_mentions <= 10:\n            sampled_mentions = all_mentions\n        else:\n            # Divide mentions into thirds (early, middle, late) and sample from each\n            third = total_mentions // 3\n            early = all_mentions[:third]\n            middle = all_mentions[third:2*third]\n            late = all_mentions[2*third:]\n\n            # Sample 3-4 from each third\n            import random\n            sampled_mentions = []\n            sampled_mentions.extend(random.sample(early, min(3, len(early))))\n            sampled_mentions.extend(random.sample(middle, min(3, len(middle))))\n            sampled_mentions.extend(random.sample(late, min(4, len(late))))\n\n            # Sort by position to maintain chronological order in context\n            sampled_mentions.sort(key=lambda m: m.position)\n\n        # Gather context snippets from sampled mentions\n        contexts = []\n        mention_positions = []\n        for mention in sampled_mentions:\n            start = max(0, mention.position - 200)  # Increased context window\n            end = min(len(full_text), mention.position + 200)\n            snippet = full_text[start:end].strip()\n            # Clean up partial words at boundaries\n            if start > 0:\n                snippet = \"...\" + snippet.split(\" \", 1)[-1] if \" \" in snippet else snippet\n            if end < len(full_text):\n                snippet = snippet.rsplit(\" \", 1)[0] + \"...\" if \" \" in snippet else snippet\n            contexts.append({\n                \"text\": snippet,\n                \"position\": mention.position,\n                \"chapter\": mention.chapter_index\n            })\n            mention_positions.append(mention.position)\n\n        if not contexts:\n            logger.warning(f\"No context available for {character.canonical_name}\")\n            return \"\", [], 0.0, None, None, None\n\n        context_text = \"\\n\\n\".join([\n            f\"[Context {i+1}, Chapter {c['chapter']}, Position {c['position']}]:\\n{c['text']}\"\n            for i, c in enumerate(contexts)\n        ])\n\n        # Check if this character is the narrator\n        narrator_note = \"\"\n        if hasattr(character, 'is_narrator') and character.is_narrator:\n            narrator_note = f\"\\n\\nNOTE: This character is the NARRATOR of the story ({character.narrative_role or 'First-person narrator'}). Your description should mention their role as the narrator/storyteller.\"\n\n        # F2: Build summary evidence section if available\n        summary_evidence_text = \"\"\n        if summary_evidence and summary_evidence.evidence:\n            evidence_lines = []\n            for ev in summary_evidence.evidence[:5]:  # Limit to top 5 items\n                evidence_lines.append(f\"- Chapter {ev.chapter_index}: \\\"{ev.statement}\\\"\")\n            if evidence_lines:\n                summary_evidence_text = f\"\"\"\n\nADDITIONAL CONTEXT FROM CHAPTER SUMMARIES (Feature F2):\nThe following information about this character was extracted from chapter summaries:\n{chr(10).join(evidence_lines)}\n\nUse this summary evidence to enrich your profile, but prioritize direct text quotes as primary evidence.\"\"\"\n\n        # F3: Build moral valence constraint if available\n        moral_valence_constraint = \"\"\n        if moral_valence and moral_valence.valence:\n            constraint = MORAL_VALENCE_CONSTRAINTS.get(moral_valence.valence, \"\")\n            if constraint:\n                moral_valence_constraint = f\"\"\"\n\nMORAL VALENCE CONSTRAINT (Feature F3):\nThis character has been classified as {moral_valence.valence.value} (confidence: {moral_valence.confidence:.0%}).\n{constraint}\n\nThis is a HARD CONSTRAINT - your profile MUST respect this classification.\"\"\"\n\n        prompt = f\"\"\"Analyze the character \"{character.canonical_name}\" using ONLY the provided text evidence.\n\nThe evidence below is sampled from throughout the entire narrative (early, middle, and late chapters).\nYour analysis should reflect the character's full arc, not just their initial appearance.{narrator_note}{summary_evidence_text}{moral_valence_constraint}\n\nText Evidence:\n{context_text}\n\nCRITICAL REQUIREMENTS:\n1. Make ONLY claims that are directly supported by the provided text\n2. For each claim, provide the exact quote that supports it\n3. Consider how the character develops or changes throughout the narrative (if evident from the samples)\n4. If the text doesn't provide enough information about a trait or relationship, DO NOT invent it\n5. Distinguish between what the text explicitly states vs. what might be inferred\n\nReturn a JSON response matching this example format exactly:\n\n```json\n{{\n  \"profile\": \"A brief 2-3 sentence overview based on provided evidence.\",\n  \"appearance\": {{\n    \"summary\": \"Brief physical description if available from text\",\n    \"age_indication\": \"young/middle-aged/elderly/unknown\",\n    \"distinguishing_features\": [\"feature1\", \"feature2\"]\n  }},\n  \"personality\": {{\n    \"summary\": \"Brief personality summary\",\n    \"traits\": [\"trait1\", \"trait2\"],\n    \"temperament\": \"calm/volatile/melancholic/cheerful/etc or unknown\",\n    \"emotional_range\": \"Brief note on emotional expression\"\n  }},\n  \"voice_guidance\": {{\n    \"suggested_tone\": \"authoritative/gentle/aggressive/etc based on dialogue\",\n    \"dialect_notes\": \"Any accent, regional speech, or class markers\",\n    \"verbal_tics\": [\"repeated phrase\", \"speech pattern\"],\n    \"formality_level\": \"formal/informal/moderate\",\n    \"example_quotes