{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012hWZY9ZLCe6vTbAwBpiLiN","type":"tool_result","content":"     1→\"\"\"\n     2→Main analyzer orchestrator.\n     3→Coordinates ingestion and analysis pipeline.\n     4→\"\"\"\n     5→\n     6→from pathlib import Path\n     7→from typing import Optional, Callable, Tuple\n     8→from concurrent.futures import ThreadPoolExecutor\n     9→import json\n    10→import time\n    11→from datetime import datetime\n    12→import logging\n    13→\n    14→from .models import (\n    15→    AnalysisResult,\n    16→    BookMetadata,\n    17→    StructuralElement,\n    18→    StructureType,\n    19→    Character,\n    20→    CharacterDescription,\n    21→    PronunciationEntry,\n    22→    PronunciationFlag as ModelPronunciationFlag,\n    23→    ConfidenceLevel,\n    24→    GlossaryEntry as ModelGlossaryEntry,\n    25→    GlossaryMap,\n    26→)\n    27→from .ingestion import get_ingester, ExtractedDocument\n    28→from .ingestion.refine import refine_extracted_document, to_canonical_markdown\n    29→\n    30→# Import new pipeline\n    31→from .pipeline import (\n    32→    ChapterDetectionPipeline,\n    33→    ChapterMap,\n    34→)\n    35→from .pipeline.character_extraction import (\n    36→    CharacterExtractionPipeline,\n    37→    CharacterMap as PipelineCharacterMap,\n    38→)\n    39→from .pipeline.chapter_summary import (\n    40→    ChapterSummaryPipeline,\n    41→    ChapterSummaryMap,\n    42→)\n    43→from .pipeline.pronunciation_guide import (\n    44→    PronunciationGuidePipeline,\n    45→    PronunciationMap,\n    46→    PronunciationFlag as PipelinePronunciationFlag,\n    47→)\n    48→from .pipeline.llm import LLMClient, LLMConfig\n    49→from .pipeline.metrics import MetricsCollector, ProfilingReport\n    50→from .pipeline.overview import OverviewGenerator\n    51→\n    52→# Character profiling pipeline components (F1-F5)\n    53→from .pipeline.character_profiling import (\n    54→    # F1: Su