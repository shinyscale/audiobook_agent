{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017dNyaVJdkaN7oQQbzXVkeL","type":"tool_result","content":"     0→\"\"\"\n     1→Configuration for the agent architecture.\n     2→\n     3→Provides per-agent configuration (model selection, parameters) and\n     4→orchestrator-level settings (quality gates, parallel execution).\n     5→\"\"\"\n     6→\n     7→from dataclasses import dataclass, field\n     8→from typing import Optional, Union\n     9→import os\n    10→\n    11→\n    12→@dataclass\n    13→class AgentConfig:\n    14→    \"\"\"\n    15→    Configuration for a specific agent.\n    16→\n    17→    Each agent can have its own model, temperature, and behavior settings.\n    18→    This allows optimizing each agent for its specific task.\n    19→    \"\"\"\n    20→    # Model selection\n    21→    model: Optional[str] = None  # None = use orchestrator default\n    22→    provider: str = \"ollama\"\n    23→    base_url: str = \"http://localhost:11434\"\n    24→    api_key: Optional[str] = None\n    25→\n    26→    # Model parameters\n    27→    temperature: float = 0.3\n    28→    max_tokens: int = 4096\n    29→    context_length: int = 32768  # Context window size (num_ctx for Ollama)\n    30→\n    31→    # Behavior\n    32→    enable_verification: bool = True\n    33→    max_refinement_passes: int = 3\n    34→    retry_on_low_confidence: bool = True\n    35→\n    36→    # Quality thresholds\n    37→    min_acceptable_confidence: float = 0.4\n    38→    target_high_confidence_ratio: float = 0.8  # Target 80% high confidence\n    39→\n    40→    # Reasoning control (for Qwen3, GPT-OSS, Nemotron)\n    41→    think_mode: Optional[Union[bool, str]] = False  # False, True, \"low\", \"medium\", \"high\"\n    42→    system_prompt: Optional[str] = None  # Agent-specific system prompt override\n    43→\n    44→    def get_api_key(self) -> Optional[str]:\n    45→        \"\"\"Get API key from config or environment.\"\"\"\n    46→        if self.api_key:\n    47→            return self.api_key\n    48→        if self.provider == \"openai\":\n    49→            return os.environ.get(\"OPENAI_API_KEY\")\n    50→        if self.provider == \"anthropic\":\n    51→            return os.environ.get(\"ANTHROPIC_API_KEY\")\n    52→        return None\n    53→\n    54→\n    55→@dataclass\n    56→class PipelineTuningConfig:\n    57→    \"\"\"\n    58→    User-tunable knobs for chunking and local context windows.\n    59→\n    60→    These are deliberately independent of model context length: the goal is to let\n    61→    users empirically find a \"sweet spot\" for speed vs quality on their hardware/model.\n    62→    \"\"\"\n    63→    # Chapter detection (LLM proposers) - character counts\n    64→    chapter_marker_chunk_chars: int = 15000\n    65→    chapter_marker_chunk_overlap_chars: int = 1000\n    66→    chapter_narrative_chunk_chars: int = 20000\n    67→    chapter_narrative_chunk_overlap_chars: int = 2000\n    68→\n    69→    # Character extraction - LLM chunk size and mention context window (characters)\n    70→    character_llm_chunk_chars: int = 8000\n    71→    character_mention_context_chars: int = 250  # Increased from 200 to 250 to capture death scenes where both entities appear (e.g., \"fell prostrate in death the Prince Prospero... seizing the mummer\" = 221 chars)\n    72→\n    73→    # Chapter summaries - chunk sizes in words\n    74→    summary_chunk_words: int = 2500\n    75→    summary_chunk_overlap_words: int = 200\n    76→\n    77→\n    78→@dataclass\n    79→class OrchestratorConfig:\n    80→    \"\"\"\n    81→    Configuration for the agent orchestrator.\n    82→\n    83→    Controls global behavior like parallel execution, quality gates,\n    84→    and default model settings.\n    85→    \"\"\"\n    86→    # Default model (used when agent doesn't specify one)\n    87→    default_model: str = \"llama3.2\"\n    88→    default_provider: str = \"ollama\"\n    89→    default_base_url: str = \"http://localhost:11434\"\n    90→    context_length: int = 32768  # Default context window size\n    91→\n    92→    # Per-agent configs (keyed by agent name)\n    93→    agent_configs: dict[str, AgentConfig] = field(default_factory=dict)\n    94→\n    95→    # Experimental tuning knobs (chunk sizes, context windows)\n    96→    tuning: PipelineTuningConfig = field(default_factory=PipelineTuningConfig)\n    97→\n    98→    # Execution settings\n    99→    parallel_execution: bool = False  # Enable parallel agent execution\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5e3a022d-ab51-4b5c-9cef-c487dd59220c","uuid":"a22f0176-4784-44e3-845c-3970ccf136a4","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/agents/config.py","content":"\"\"\"\nConfiguration for the agent architecture.\n\nProvides per-agent configuration (model selection, parameters) and\norchestrator-level settings (quality gates, parallel execution).\n\"\"\"\n\nfrom dataclasses import dataclass, field\nfrom typing import Optional, Union\nimport os\n\n\n@dataclass\nclass AgentConfig:\n    \"\"\"\n    Configuration for a specific agent.\n\n    Each agent can have its own model, temperature, and behavior settings.\n    This allows optimizing each agent for its specific task.\n    \"\"\"\n    # Model selection\n    model: Optional[str] = None  # None = use orchestrator default\n    provider: str = \"ollama\"\n    base_url: str = \"http://localhost:11434\"\n    api_key: Optional[str] = None\n\n    # Model parameters\n    temperature: float = 0.3\n    max_tokens: int = 4096\n    context_length: int = 32768  # Context window size (num_ctx for Ollama)\n\n    # Behavior\n    enable_verification: bool = True\n    max_refinement_passes: int = 3\n    retry_on_low_confidence: bool = True\n\n    # Quality thresholds\n    min_acceptable_confidence: float = 0.4\n    target_high_confidence_ratio: float = 0.8  # Target 80% high confidence\n\n    # Reasoning control (for Qwen3, GPT-OSS, Nemotron)\n    think_mode: Optional[Union[bool, str]] = False  # False, True, \"low\", \"medium\", \"high\"\n    system_prompt: Optional[str] = None  # Agent-specific system prompt override\n\n    def get_api_key(self) -> Optional[str]:\n        \"\"\"Get API key from config or environment.\"\"\"\n        if self.api_key:\n            return self.api_key\n        if self.provider == \"openai\":\n            return os.environ.get(\"OPENAI_API_KEY\")\n        if self.provider == \"anthropic\":\n            return os.environ.get(\"ANTHROPIC_API_KEY\")\n        return None\n\n\n@dataclass\nclass PipelineTuningConfig:\n    \"\"\"\n    User-tunable knobs for chunking and local context windows.\n\n    These are deliberately independent of model context length: the goal is to let\n    users empirically find a \"sweet spot\" for speed vs quality on their hardware/model.\n    \"\"\"\n    # Chapter detection (LLM proposers) - character counts\n    chapter_marker_chunk_chars: int = 15000\n    chapter_marker_chunk_overlap_chars: int = 1000\n    chapter_narrative_chunk_chars: int = 20000\n    chapter_narrative_chunk_overlap_chars: int = 2000\n\n    # Character extraction - LLM chunk size and mention context window (characters)\n    character_llm_chunk_chars: int = 8000\n    character_mention_context_chars: int = 250  # Increased from 200 to 250 to capture death scenes where both entities appear (e.g., \"fell prostrate in death the Prince Prospero... seizing the mummer\" = 221 chars)\n\n    # Chapter summaries - chunk sizes in words\n    summary_chunk_words: int = 2500\n    summary_chunk_overlap_words: int = 200\n\n\n@dataclass\nclass OrchestratorConfig:\n    \"\"\"\n    Configuration for the agent orchestrator.\n\n    Controls global behavior like parallel execution, quality gates,\n    and default model settings.\n    \"\"\"\n    # Default model (used when agent doesn't specify one)\n    default_model: str = \"llama3.2\"\n    default_provider: str = \"ollama\"\n    default_base_url: str = \"http://localhost:11434\"\n    context_length: int = 32768  # Default context window size\n\n    # Per-agent configs (keyed by agent name)\n    agent_configs: dict[str, AgentConfig] = field(default_factory=dict)\n\n    # Experimental tuning knobs (chunk sizes, context windows)\n    tuning: PipelineTuningConfig = field(default_factory=PipelineTuningConfig)\n\n    # Execution settings\n    parallel_execution: bool = False  # Enable parallel agent execution","numLines":100,"startLine":0,"totalLines":247}}}
