{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0124MSYm5ow9ohRhiZkmDW7e","type":"tool_result","content":"     0→\"\"\"\n     1→Cross-chapter character consensus builder.\n     2→\n     3→Merges character proposals across chapters, resolves aliases,\n     4→and produces the final CharacterMap.\n     5→\"\"\"\n     6→\n     7→import re\n     8→import hashlib\n     9→import time\n    10→from typing import Optional, Iterable\n    11→from collections import defaultdict\n    12→from difflib import SequenceMatcher\n    13→import logging\n    14→\n    15→from .models import (\n    16→    CharacterProposal,\n    17→    CharacterValidationResult,\n    18→    Character,\n    19→    CharacterMap,\n    20→    CharacterMention,\n    21→    CharacterType,\n    22→)\n    23→from .constants import are_potential_nicknames, get_nickname_variants\n    24→from ..llm import LLMClient\n    25→\n    26→logger = logging.getLogger(__name__)\n    27→\n    28→# Character classification prompts\n    29→CHARACTER_TYPE_SYSTEM = \"\"\"You are a literary analyst classifying character types.\n    30→\n    31→Classify each character as one of:\n    32→- STORY: An active participant in the narrative who appears in scenes, speaks dialogue, or takes actions\n    33→- HISTORICAL: A real historical figure mentioned in passing (e.g., Napoleon, Einstein)\n    34→- REFERENCED: A fictional character from other works mentioned in passing (e.g., Hamlet, Sherlock Holmes)\n    35→\n    36→Return ONLY valid JSON. No other text.\"\"\"\n    37→\n    38→CHARACTER_TYPE_PROMPT = \"\"\"Classify this character's role in the narrative.\n    39→\n    40→CHARACTER: {name}\n    41→MENTION COUNT: {mention_count}\n    42→CHAPTERS PRESENT: {chapters}\n    43→SAMPLE CONTEXTS:\n    44→{contexts}\n    45→\n    46→Based on the contexts, determine if this character:\n    47→1. Actively participates (speaks, acts, appears in scenes) → STORY\n    48→2. Is a real historical figure mentioned in passing → HISTORICAL\n    49→3. Is a fictional character from other works → REFERENCED\n    50→\n    51→Return JSON:\n    52→{{\n    53→  \"character_type\": \"story\" | \"historical\" | \"referenced\",\n    54→  \"confidence\": 0.0-1.0,\n    55→  \"reason\": \"brief justification\"\n    56→}}\"\"\"\n    57→\n    58→# Common titles that should be ignored when comparing character names\n    59→# These are not part of the actual name but indicate social status or role\n    60→TITLES = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord', 'professor', 'captain', 'major'}\n    61→\n    62→# Epithet alias resolution prompt\n    63→EPITHET_ALIAS_SYSTEM = \"\"\"You are a literary analyst identifying whether different descriptive handles (epithets) refer to the SAME unnamed character.\n    64→\n    65→Descriptive handles are phrases like \"the creature\", \"the monster\", \"the old man\", \"the detective\".\n    66→\n    67→CRITICAL RULES:\n    68→1. Only merge epithets that CLEARLY refer to the same entity with HIGH CONFIDENCE\n    69→2. Use chapter appearances and context clues to verify they're the same character\n    70→3. Different descriptive characters (e.g., \"the old man\" in cottage vs \"the old man\" at inn) should NOT be merged\n    71→4. Generic phrases that could refer to anyone should NOT be merged together\n    72→\n    73→Return ONLY valid JSON. No other text.\"\"\"\n    74→\n    75→EPITHET_ALIAS_PROMPT = \"\"\"Identify which descriptive handles refer to the SAME unnamed character.\n    76→\n    77→DESCRIPTIVE HANDLES (with chapter info and sample contexts):\n    78→{epithets}\n    79→\n    80→For each group of handles that refer to the SAME entity:\n    81→1. Pick the most specific/unique handle as canonical (e.g., \"the creature\" over \"the monster\")\n    82→2. List all other handles as aliases\n    83→\n    84→Return JSON array:\n    85→```json\n    86→[\n    87→  {{\"canonical\": \"the creature\", \"aliases\": [\"the monster\", \"the wretch\", \"the fiend\"]}},\n    88→  {{\"canonical\": \"the old man\", \"aliases\": []}}\n    89→]\n    90→```\n    91→\n    92→Return ONLY the JSON array. Include only handles you're confident about - omit uncertain ones.\"\"\"\n    93→\n    94→# Cross-group (epithet-to-proper-name) resolution prompt\n    95→CROSS_GROUP_SYSTEM = \"\"\"You are a literary analyst identifying whether descriptive handles (epithets) refer to named characters.\n    96→\n    97→Examples:\n    98→- \"the prince\" might refer to \"Prince Prospero\"\n    99→- \"the duke\" might refer to \"Prince Prospero\" (if the story mentions he's also a duke)\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5e3a022d-ab51-4b5c-9cef-c487dd59220c","uuid":"72f9a0f0-6e76-45e5-b418-902fd7fdd6d6","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/consensus.py","content":"\"\"\"\nCross-chapter character consensus builder.\n\nMerges character proposals across chapters, resolves aliases,\nand produces the final CharacterMap.\n\"\"\"\n\nimport re\nimport hashlib\nimport time\nfrom typing import Optional, Iterable\nfrom collections import defaultdict\nfrom difflib import SequenceMatcher\nimport logging\n\nfrom .models import (\n    CharacterProposal,\n    CharacterValidationResult,\n    Character,\n    CharacterMap,\n    CharacterMention,\n    CharacterType,\n)\nfrom .constants import are_potential_nicknames, get_nickname_variants\nfrom ..llm import LLMClient\n\nlogger = logging.getLogger(__name__)\n\n# Character classification prompts\nCHARACTER_TYPE_SYSTEM = \"\"\"You are a literary analyst classifying character types.\n\nClassify each character as one of:\n- STORY: An active participant in the narrative who appears in scenes, speaks dialogue, or takes actions\n- HISTORICAL: A real historical figure mentioned in passing (e.g., Napoleon, Einstein)\n- REFERENCED: A fictional character from other works mentioned in passing (e.g., Hamlet, Sherlock Holmes)\n\nReturn ONLY valid JSON. No other text.\"\"\"\n\nCHARACTER_TYPE_PROMPT = \"\"\"Classify this character's role in the narrative.\n\nCHARACTER: {name}\nMENTION COUNT: {mention_count}\nCHAPTERS PRESENT: {chapters}\nSAMPLE CONTEXTS:\n{contexts}\n\nBased on the contexts, determine if this character:\n1. Actively participates (speaks, acts, appears in scenes) → STORY\n2. Is a real historical figure mentioned in passing → HISTORICAL\n3. Is a fictional character from other works → REFERENCED\n\nReturn JSON:\n{{\n  \"character_type\": \"story\" | \"historical\" | \"referenced\",\n  \"confidence\": 0.0-1.0,\n  \"reason\": \"brief justification\"\n}}\"\"\"\n\n# Common titles that should be ignored when comparing character names\n# These are not part of the actual name but indicate social status or role\nTITLES = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord', 'professor', 'captain', 'major'}\n\n# Epithet alias resolution prompt\nEPITHET_ALIAS_SYSTEM = \"\"\"You are a literary analyst identifying whether different descriptive handles (epithets) refer to the SAME unnamed character.\n\nDescriptive handles are phrases like \"the creature\", \"the monster\", \"the old man\", \"the detective\".\n\nCRITICAL RULES:\n1. Only merge epithets that CLEARLY refer to the same entity with HIGH CONFIDENCE\n2. Use chapter appearances and context clues to verify they're the same character\n3. Different descriptive characters (e.g., \"the old man\" in cottage vs \"the old man\" at inn) should NOT be merged\n4. Generic phrases that could refer to anyone should NOT be merged together\n\nReturn ONLY valid JSON. No other text.\"\"\"\n\nEPITHET_ALIAS_PROMPT = \"\"\"Identify which descriptive handles refer to the SAME unnamed character.\n\nDESCRIPTIVE HANDLES (with chapter info and sample contexts):\n{epithets}\n\nFor each group of handles that refer to the SAME entity:\n1. Pick the most specific/unique handle as canonical (e.g., \"the creature\" over \"the monster\")\n2. List all other handles as aliases\n\nReturn JSON array:\n```json\n[\n  {{\"canonical\": \"the creature\", \"aliases\": [\"the monster\", \"the wretch\", \"the fiend\"]}},\n  {{\"canonical\": \"the old man\", \"aliases\": []}}\n]\n```\n\nReturn ONLY the JSON array. Include only handles you're confident about - omit uncertain ones.\"\"\"\n\n# Cross-group (epithet-to-proper-name) resolution prompt\nCROSS_GROUP_SYSTEM = \"\"\"You are a literary analyst identifying whether descriptive handles (epithets) refer to named characters.\n\nExamples:\n- \"the prince\" might refer to \"Prince Prospero\"\n- \"the duke\" might refer to \"Prince Prospero\" (if the story mentions he's also a duke)","numLines":100,"startLine":0,"totalLines":2340}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DkxtSBSc64F44dR5NtqoV5","type":"tool_result","content":"     1→\"\"\"\n     2→CharacterAgent - Specialized agent for character extraction.\n     3→\n     4→Wraps CharacterExtractionPipeline with self-verification to ensure:\n     5→- No duplicate characters (same person under different names)\n     6→- Consistent alias resolution\n     7→- Proper mention distribution\n     8→\"\"\"\n     9→\n    10→from typing import Optional\n    11→import logging\n    12→import re\n    13→import time\n    14→\n    15→from .base import Agent, AgentContext, AgentResult, VerificationResult, VerificationIssue, VerificationLevel\n    16→from .config import AgentConfig, PipelineTuningConfig\n    17→from ..pipeline.character_extraction.pipeline import CharacterExtractionPipeline\n    18→from ..pipeline.character_extraction.models import CharacterMap, Character\n    19→from ..pipeline.chapter_detection.models import ChapterMap as ChapterDetectionMap\n    20→from ..pipeline.llm import LLMClient\n    21→\n    22→logger = logging.getLogger(__name__)\n    23→\n    24→\n    25→# Pronoun/determiner stopwords - characters with these names should be flagged/removed\n    26→PRONOUN_STOPWORDS = {\n    27→    'he', 'she', 'it', 'they', 'we', 'i', 'you',\n    28→    'him', 'her', 'them', 'us', 'me',\n    29→    'his', 'hers', 'its', 'their', 'our', 'my', 'your',\n    30→    'this', 'that', 'these', 'those', 'the', 'a', 'an',\n    31→}\n    32→\n    33→# Agentive verb patterns for detecting unnamed characters\n    34→AGENTIVE_VERBS = [\n    35→    r'\\b(said|asked|replied|whispered|shouted|called|cried|muttered|exclaimed)\\b',\n    36→    r'\\b(walked|ran|stood|turned|looked|smiled|laughed|nodded|frowned)\\b',\n    37→    r'\\b(grabbed|took|held|threw|placed|opened|closed|pushed|pulled)\\b',\n    38→    r'\\b(sat|came|went|entered|left|arrived|departed|approached|retreated)\\b',\n    39→]\n    40→\n    41→\n    42→DUPLICATE_CHECK_SYSTEM = \"\"\"You are a literary analyst checking for duplicate characters.\n    43→\n    44→Your task is to identify characters that may be the SAME PERSON listed separately.\n    45→\n    46→Look for:\n    47→1. Names that share components (same first name, same last name)\n    48→2. Characters that appear in similar chapters\n    49→3. Names that could be nicknames/aliases for each other\n    50→\n    51→Only flag pairs you are CONFIDENT are duplicates.\"\"\"\n    52→\n    53→\n    54→DUPLICATE_CHECK_PROMPT = \"\"\"Review these characters for potential duplicates (same person listed twice):\n    55→\n    56→{character_list}\n    57→\n    58→For each potential duplicate pair, check:\n    59→- Do the names share significant components?\n    60→- Do they appear in overlapping chapters?\n    61→- Could one be a nickname/title for the other?\n    62→\n    63→Return JSON:\n    64→{{\n    65→  \"duplicates\": [\n    66→    {{\"name1\": \"...\", \"name2\": \"...\", \"reason\": \"...\", \"confidence\": 0.0-1.0}}\n    67→  ],\n    68→  \"analysis\": \"Brief summary\"\n    69→}}\n    70→\n    71→If no duplicates found, return: {{\"duplicates\": [], \"analysis\": \"No duplicates detected\"}}\n    72→\n    73→Return ONLY valid JSON.\"\"\"\n    74→\n    75→\n    76→class CharacterAgent(Agent):\n    77→    \"\"\"\n    78→    Specialized agent for character extraction with self-verification.\n    79→\n    80→    Wraps the existing CharacterExtractionPipeline and adds verification:\n    81→    - Checks for duplicate characters that slipped through alias resolution\n    82→    - Validates mention distribution (major characters across chapters)\n    83→    - Verifies alias consistency\n    84→    \"\"\"\n    85→\n    86→    def __init__(\n    87→        self,\n    88→        llm_client: Optional[LLMClient] = None,\n    89→        config: Optional[AgentConfig] = None,\n    90→        tuning: Optional[PipelineTuningConfig] = None,\n    91→    ):\n    92→        self.llm = llm_client\n    93→        self.config = config or AgentConfig()\n    94→        self._tuning = tuning\n    95→\n    96→    @property\n    97→    def name(self) -> str:\n    98→        return \"character_agent\"\n    99→\n   100→    @property\n   101→    def recommended_models(self) -> list[str]:\n   102→        return [\n   103→            \"gpt-4o\",  # Strong narrative understanding\n   104→            \"claude-3-5-sonnet\",  # Good at character relationships\n   105→            \"llama3.2\",  # Local alternative\n   106→        ]\n   107→\n   108→    def run(self, context: AgentContext) -> AgentResult[CharacterMap]:\n   109→        \"\"\"Run character extraction pipeline.\"\"\"\n   110→        start_time = time.perf_counter()\n   111→\n   112→        # We need chapter_map from context\n   113→        if not context.chapter_map:\n   114→            # Get model info for error case\n   115→            model_used = self.config.model if self.config else None\n   116→            provider_used = self.config.provider if self.config else None\n   117→\n   118→            return AgentResult(\n   119→                data=CharacterMap(\n   120→                    characters=[],\n   121→                    low_confidence_characters=[],\n   122→                    total_mentions=0,\n   123→                    total_chapters=0,\n   124→                    pipeline_metadata={\"error\": \"No chapter map provided\"},\n   125→                ),\n   126→                high_confidence_count=0,\n   127→                medium_confidence_count=0,\n   128→                low_confidence_count=0,\n   129→                issues=[\"No chapter map provided - cannot extract characters\"],\n   130→                model_used=model_used,\n   131→                provider_used=provider_used,\n   132→            )\n   133→\n   134→        pipeline = self._get_pipeline()\n   135→        character_map, _ = pipeline.run(\n   136→            full_text=context.text,\n   137→            chapter_map=context.chapter_map,\n   138→            source_file=context.source_file,\n   139→        )\n   140→\n   141→        # Calculate confidence breakdown\n   142→        high = sum(1 for c in character_map.characters if c.confidence >= 0.7)\n   143→        medium = sum(1 for c in character_map.characters if 0.4 <= c.confidence < 0.7)\n   144→        low = sum(1 for c in character_map.characters if c.confidence < 0.4)\n   145→        low += len(character_map.low_confidence_characters)\n   146→\n   147→        # Collect issues\n   148→        issues = []\n   149→        if character_map.low_confidence_characters:\n   150→            issues.append(\n   151→                f\"{len(character_map.low_confidence_characters)} low-confidence characters flagged\"\n   152→            )\n   153→\n   154→        elapsed = time.perf_counter() - start_time\n   155→\n   156→        # Get model info from config or client\n   157→        model_used = None\n   158→        provider_used = None\n   159→        if self.config and self.config.model:\n   160→            model_used = self.config.model\n   161→            provider_used = self.config.provider\n   162→        elif self.llm and self.llm.config:\n   163→            model_used = self.llm.config.model\n   164→            provider_used = self.llm.config.provider\n   165→\n   166→        return AgentResult(\n   167→            data=character_map,\n   168→            confidence_scores=[c.confidence for c in character_map.characters],\n   169→            high_confidence_count=high,\n   170→            medium_confidence_count=medium,\n   171→            low_confidence_count=low,\n   172→            issues=issues,\n   173→            processing_time_seconds=elapsed,\n   174→            model_used=model_used,\n   175→            provider_used=provider_used,\n   176→        )\n   177→\n   178→    def verify(\n   179→        self,\n   180→        result: AgentResult[CharacterMap],\n   181→        level: VerificationLevel = VerificationLevel.SELF_CHECK,\n   182→        context: Optional[AgentContext] = None,\n   183→    ) -> VerificationResult:\n   184→        \"\"\"\n   185→        Verify character extraction quality.\n   186→\n   187→        Checks:\n   188→        1. Low-confidence characters\n   189→        2. Duplicate detection (same character under different names)\n   190→        3. Mention distribution (major characters across chapters)\n   191→        4. Alias consistency\n   192→        \"\"\"\n   193→        issues = []\n   194→        suggestions = []\n   195→        character_map = result.data\n   196→\n   197→        if not character_map.characters:\n   198→            return VerificationResult(\n   199→                passed=True,\n   200→                issues=[],\n   201→                suggestions=[],\n   202→            )\n   203→\n   204→        # Check 1: Low confidence items\n   205→        if result.low_confidence_count > 0:\n   206→            issues.append(VerificationIssue(\n   207→                description=f\"{result.low_confidence_count} characters have low confidence\",\n   208→                severity=\"warning\",\n   209→            ))\n   210→\n   211→        # Check 2: Pronoun entries (should be auto-removed)\n   212→        pronoun_issues = self._check_pronoun_entries(character_map.characters)\n   213→        issues.extend(pronoun_issues)\n   214→\n   215→        # Check 3: Look for potential duplicates using heuristics\n   216→        duplicate_issues = self._check_duplicates_heuristic(character_map.characters)\n   217→        issues.extend(duplicate_issues)\n   218→\n   219→        # Check 4: Verify mention distribution\n   220→        distribution_issues = self._check_mention_distribution(character_map)\n   221→        issues.extend(distribution_issues)\n   222→\n   223→        # Check 5: Verify alias consistency\n   224→        alias_issues = self._check_alias_consistency(character_map.characters)\n   225→        issues.extend(alias_issues)\n   226→\n   227→        # Check 6: Disjoint chapter distributions (potential name changes)\n   228→        disjoint_issues = self._check_disjoint_distributions(\n   229→            character_map.characters, character_map.total_chapters\n   230→        )\n   231→        issues.extend(disjoint_issues)\n   232→\n   233→        # Check 7: Missing agentive descriptions (if context available)\n   234→        if context and context.text:\n   235→            agentive_issues = self._check_missing_agentive_descriptions(\n   236→                context.text, character_map.characters\n   237→            )\n   238→            issues.extend(agentive_issues)\n   239→\n   240→        # Check 8: LLM duplicate check for high-value verification\n   241→        if self.config.enable_verification and self.llm and len(character_map.characters) > 1:\n   242→            llm_issues = self._llm_duplicate_check(character_map.characters)\n   243→            issues.extend(llm_issues)\n   244→\n   245→        # Determine if passed\n   246→        error_count = sum(1 for i in issues if i.severity == \"error\")\n   247→        passed = error_count == 0\n   248→\n   249→        return VerificationResult(\n   250→            passed=passed,\n   251→            issues=issues,\n   252→            suggestions=suggestions,\n   253→        )\n   254→\n   255→    def refine(\n   256→        self,\n   257→        result: AgentResult[CharacterMap],\n   258→        issues: list[VerificationIssue],\n   259→    ) -> AgentResult[CharacterMap]:\n   260→        \"\"\"\n   261→        Refine character map based on verification issues.\n   262→\n   263→        Automatically removes pronoun entries (error severity).\n   264→        Other issues are flagged for manual review.\n   265→        \"\"\"\n   266→        character_map = result.data\n   267→\n   268→        # Auto-remove pronoun entries (error severity issues)\n   269→        pronoun_issues = [i for i in issues if \"pronoun/determiner\" in i.description.lower()]\n   270→        if pronoun_issues:\n   271→            # Get the names to remove from issue descriptions\n   272→            pronoun_names = set()\n   273→            for issue in pronoun_issues:\n   274→                # Extract name from description like \"Character 'he' is a pronoun/determiner\"\n   275→                match = re.search(r\"Character '([^']+)' is a pronoun/determiner\", issue.description)\n   276→                if match:\n   277→                    pronoun_names.add(match.group(1).lower())\n   278→\n   279→            # Filter out pronoun characters\n   280→            original_count = len(character_map.characters)\n   281→            character_map.characters = [\n   282→                c for c in character_map.characters\n   283→                if c.canonical_name.lower() not in pronoun_names\n   284→            ]\n   285→            character_map.low_confidence_characters = [\n   286→                c for c in character_map.low_confidence_characters\n   287→                if c.canonical_name.lower() not in pronoun_names\n   288→            ]\n   289→\n   290→            removed_count = original_count - len(character_map.characters)\n   291→            if removed_count > 0:\n   292→                logger.info(f\"CharacterAgent: Auto-removed {removed_count} pronoun entries\")\n   293→                character_map.pipeline_metadata[\"pronoun_entries_removed\"] = removed_count\n   294→\n   295→        # Add issues to pipeline metadata for review\n   296→        issue_descriptions = [i.description for i in issues]\n   297→        if issue_descriptions:\n   298→            character_map.pipeline_metadata[\"verification_issues\"] = issue_descriptions\n   299→            character_map.pipeline_metadata[\"needs_review\"] = True\n   300→\n   301→        # Log remaining errors (non-pronoun)\n   302→        remaining_errors = [i for i in issues if i.severity == \"error\" and \"pronoun/determiner\" not in i.description.lower()]\n   303→        if remaining_errors:\n   304→            logger.warning(\n   305→                f\"CharacterAgent: {len(remaining_errors)} errors remain after refinement\"\n   306→            )\n   307→\n   308→        return AgentResult(\n   309→            data=character_map,\n   310→            confidence_scores=result.confidence_scores,\n   311→            high_confidence_count=result.high_confidence_count,\n   312→            medium_confidence_count=result.medium_confidence_count,\n   313→            low_confidence_count=result.low_confidence_count,\n   314→            issues=issue_descriptions,\n   315→            processing_time_seconds=result.processing_time_seconds,\n   316→            model_used=result.model_used,\n   317→            provider_used=result.provider_used,\n   318→        )\n   319→\n   320→    def _get_pipeline(self) -> CharacterExtractionPipeline:\n   321→        \"\"\"Get or create the character extraction pipeline.\"\"\"\n   322→        t = self._tuning or PipelineTuningConfig()\n   323→        return CharacterExtractionPipeline(\n   324→            llm_client=self.llm,\n   325→            llm_chunk_size=t.character_llm_chunk_chars,\n   326→            mention_context_window=t.character_mention_context_chars,\n   327→        )\n   328→\n   329→    def _check_duplicates_heuristic(self, characters: list[Character]) -> list[VerificationIssue]:\n   330→        \"\"\"Check for potential duplicates using name matching heuristics.\"\"\"\n   331→        issues = []\n   332→\n   333→        for i, char1 in enumerate(characters):\n   334→            for char2 in characters[i + 1:]:\n   335→                # Skip if already aliases of each other\n   336→                if char2.canonical_name in char1.aliases or char1.canonical_name in char2.aliases:\n   337→                    continue\n   338→\n   339→                # Check for shared significant name components\n   340→                words1 = set(self._extract_name_words(char1.canonical_name))\n   341→                words2 = set(self._extract_name_words(char2.canonical_name))\n   342→\n   343→                # Also check aliases\n   344→                for alias in char1.aliases:\n   345→                    words1.update(self._extract_name_words(alias))\n   346→                for alias in char2.aliases:\n   347→                    words2.update(self._extract_name_words(alias))\n   348→\n   349→                shared = words1 & words2\n   350→                if shared:\n   351→                    # Check chapter overlap\n   352→                    chapters1 = set(char1.chapters_present)\n   353→                    chapters2 = set(char2.chapters_present)\n   354→                    overlap = chapters1 & chapters2\n   355→\n   356→                    if overlap:\n   357→                        issues.append(VerificationIssue(\n   358→                            description=(\n   359→                                f\"Potential duplicate: '{char1.canonical_name}' and \"\n   360→                                f\"'{char2.canonical_name}' share name component(s) {shared} \"\n   361→                                f\"and appear in same chapters\"\n   362→                            ),\n   363→                            severity=\"warning\",\n   364→                            suggested_fix=\"Consider merging these characters\",\n   365→                        ))\n   366→\n   367→        return issues\n   368→\n   369→    def _extract_name_words(self, name: str) -> list[str]:\n   370→        \"\"\"Extract significant words from a name (3+ chars, not titles).\"\"\"\n   371→        # Remove common titles\n   372→        name = re.sub(\n   373→            r'\\b(mr|mrs|ms|miss|dr|sir|lady|lord|captain|colonel|major|general|sergeant|professor)\\b\\.?',\n   374→            '',\n   375→            name,\n   376→            flags=re.IGNORECASE\n   377→        )\n   378→\n   379→        words = re.findall(r'[a-zA-Z]+', name.lower())\n   380→        return [w for w in words if len(w) >= 3]\n   381→\n   382→    def _check_mention_distribution(self, character_map: CharacterMap) -> list[VerificationIssue]:\n   383→        \"\"\"Check for unusual mention distributions.\"\"\"\n   384→        issues = []\n   385→        total_chapters = character_map.total_chapters\n   386→\n   387→        if total_chapters <= 1:\n   388→            return issues\n   389→\n   390→        for char in character_map.characters[:10]:  # Check top 10 characters\n   391→            chapters_present = len(char.chapters_present)\n   392→            mention_count = char.mention_count\n   393→\n   394→            # High mention count but few chapters = suspicious\n   395→            if mention_count > 50 and chapters_present == 1:\n   396→                issues.append(VerificationIssue(\n   397→                    description=(\n   398→                        f\"Character '{char.canonical_name}' has {mention_count} mentions \"\n   399→                        f\"but only appears in 1 chapter - may be a non-character entity\"\n   400→                    ),\n   401→                    severity=\"warning\",\n   402→                ))\n   403→\n   404→            # Major character (>100 mentions) should appear in multiple chapters\n   405→            if mention_count > 100 and chapters_present < total_chapters * 0.3:\n   406→                issues.append(VerificationIssue(\n   407→                    description=(\n   408→                        f\"Major character '{char.canonical_name}' ({mention_count} mentions) \"\n   409→                        f\"only appears in {chapters_present}/{total_chapters} chapters\"\n   410→                    ),\n   411→                    severity=\"info\",\n   412→                ))\n   413→\n   414→        return issues\n   415→\n   416→    def _check_alias_consistency(self, characters: list[Character]) -> list[VerificationIssue]:\n   417→        \"\"\"Check that aliases are consistent with canonical names.\"\"\"\n   418→        issues = []\n   419→\n   420→        for char in characters:\n   421→            if not char.aliases:\n   422→                continue\n   423→\n   424→            canonical_words = set(self._extract_name_words(char.canonical_name))\n   425→\n   426→            for alias in char.aliases:\n   427→                alias_words = set(self._extract_name_words(alias))\n   428→\n   429→                # Aliases should share at least one word with canonical name\n   430→                if not canonical_words & alias_words:\n   431→                    # Exception: single word aliases might be nicknames\n   432→                    if len(alias_words) > 1:\n   433→                        issues.append(VerificationIssue(\n   434→                            description=(\n   435→                                f\"Alias '{alias}' for '{char.canonical_name}' \"\n   436→                                f\"shares no name components - verify correct\"\n   437→                            ),\n   438→                            severity=\"info\",\n   439→                        ))\n   440→\n   441→        return issues\n   442→\n   443→    def _llm_duplicate_check(self, characters: list[Character]) -> list[VerificationIssue]:\n   444→        \"\"\"Use LLM to check for duplicates that heuristics might miss.\"\"\"\n   445→        issues = []\n   446→\n   447→        # Build character list for LLM\n   448→        char_lines = []\n   449→        for char in characters[:30]:  # Limit to top 30 for prompt size\n   450→            aliases_str = f\" (aliases: {', '.join(char.aliases[:3])})\" if char.aliases else \"\"\n   451→            chapters_str = \", \".join(str(c) for c in char.chapters_present[:5])\n   452→            if len(char.chapters_present) > 5:\n   453→                chapters_str += f\"... ({len(char.chapters_present)} total)\"\n   454→\n   455→            char_lines.append(\n   456→                f\"- {char.canonical_name}{aliases_str}: \"\n   457→                f\"{char.mention_count} mentions, chapters {chapters_str}\"\n   458→            )\n   459→\n   460→        character_list = \"\\n\".join(char_lines)\n   461→        prompt = DUPLICATE_CHECK_PROMPT.format(character_list=character_list)\n   462→\n   463→        try:\n   464→            result, _ = self.llm.query_json(prompt, system=DUPLICATE_CHECK_SYSTEM)\n   465→\n   466→            if result and isinstance(result.get(\"duplicates\"), list):\n   467→                for dup in result[\"duplicates\"]:\n   468→                    if dup.get(\"confidence\", 0) >= 0.7:\n   469→                        issues.append(VerificationIssue(\n   470→                            description=(\n   471→                                f\"LLM detected potential duplicate: '{dup.get('name1')}' and \"\n   472→                                f\"'{dup.get('name2')}' - {dup.get('reason', 'no reason given')}\"\n   473→                            ),\n   474→                            severity=\"warning\",\n   475→                            suggested_fix=\"Consider merging these characters\",\n   476→                        ))\n   477→        except Exception as e:\n   478→            logger.error(f\"LLM duplicate check failed: {e}\")\n   479→            # Re-raise to fail fast instead of silently continuing\n   480→            raise\n   481→\n   482→        return issues\n   483→\n   484→    def _check_pronoun_entries(self, characters: list[Character]) -> list[VerificationIssue]:\n   485→        \"\"\"\n   486→        Check for pronoun/determiner entries that should not be characters.\n   487→\n   488→        These entries indicate bugs in upstream extraction and should be\n   489→        flagged as errors for auto-removal.\n   490→        \"\"\"\n   491→        issues = []\n   492→\n   493→        for char in characters:\n   494→            name_lower = char.canonical_name.lower()\n   495→            if name_lower in PRONOUN_STOPWORDS:\n   496→                issues.append(VerificationIssue(\n   497→                    description=f\"Character '{char.canonical_name}' is a pronoun/determiner and should not be a character\",\n   498→                    severity=\"error\",\n   499→                    suggested_fix=\"Remove this entry - it is not a character\",\n   500→                ))\n   501→\n   502→        return issues\n   503→\n   504→    def _check_disjoint_distributions(\n   505→        self,\n   506→        characters: list[Character],\n   507→        total_chapters: int,\n   508→    ) -> list[VerificationIssue]:\n   509→        \"\"\"\n   510→        Check for character pairs with disjoint but sequential chapter distributions.\n   511→\n   512→        This pattern may indicate a character name change mid-book (e.g., marriage,\n   513→        alias adoption, identity reveal).\n   514→\n   515→        Feature F4: Relaxed Disjoint Distribution Heuristic\n   516→        Uses 80% dominant chapter ranges instead of strict separation. This catches cases\n   517→        where a character is discussed by their old name in later chapters (e.g., flashbacks,\n   518→        other characters reminiscing).\n   519→\n   520→        A dominant range is defined as the contiguous span containing 80%+ of the character's\n   521→        appearances. If the dominant ranges of two characters are disjoint/sequential,\n   522→        they may be the same person.\n   523→        \"\"\"\n   524→        issues = []\n   525→        MIN_MENTIONS = 10\n   526→        DOMINANT_THRESHOLD = 0.80  # 80% of appearances must be in dominant range\n   527→\n   528→        # Only check characters with significant mentions\n   529→        significant = [c for c in characters if c.mention_count >= MIN_MENTIONS]\n   530→\n   531→        for i, char1 in enumerate(significant):\n   532→            for char2 in significant[i + 1:]:\n   533→                # Skip if already aliases of each other\n   534→                if char2.canonical_name in char1.aliases or char1.canonical_name in char2.aliases:\n   535→                    continue\n   536→\n   537→                set1, set2 = set(char1.chapters_present), set(char2.chapters_present)\n   538→                if not set1 or not set2:\n   539→                    continue\n   540→\n   541→                # Feature F4: Calculate dominant chapter ranges\n   542→                dominant1 = self._get_dominant_range(set1, DOMINANT_THRESHOLD)\n   543→                dominant2 = self._get_dominant_range(set2, DOMINANT_THRESHOLD)\n   544→\n   545→                if not dominant1 or not dominant2:\n   546→                    continue\n   547→\n   548→                # Check if dominant ranges are disjoint/sequential\n   549→                dom_set1 = set(range(dominant1[0], dominant1[1] + 1))\n   550→                dom_set2 = set(range(dominant2[0], dominant2[1] + 1))\n   551→\n   552→                overlap = dom_set1 & dom_set2\n   553→                if not overlap:  # Dominant ranges are disjoint\n   554→                    # Check if sequential\n   555→                    is_sequential = dominant1[1] < dominant2[0] or dominant2[1] < dominant1[0]\n   556→\n   557→                    if is_sequential:\n   558→                        # Determine which character comes first\n   559→                        if dominant1[1] < dominant2[0]:\n   560→                            early_char, late_char = char1.canonical_name, char2.canonical_name\n   561→                            early_range, late_range = dominant1, dominant2\n   562→                        else:\n   563→                            early_char, late_char = char2.canonical_name, char1.canonical_name\n   564→                            early_range, late_range = dominant2, dominant1\n   565→\n   566→                        issues.append(VerificationIssue(\n   567→                            description=(\n   568→                                f\"Disjoint dominant ranges: '{early_char}' (dominant chapters {early_range[0]}-{early_range[1]}) \"\n   569→                                f\"and '{late_char}' (dominant chapters {late_range[0]}-{late_range[1]}) - \"\n   570→                                f\"could be same character under different name\"\n   571→                            ),\n   572→                            severity=\"warning\",\n   573→                            suggested_fix=\"Review if these are the same character with a name change\",\n   574→                        ))\n   575→\n   576→        return issues\n   577→\n   578→    def _get_dominant_range(\n   579→        self,\n   580→        chapters: set[int],\n   581→        threshold: float = 0.80,\n   582→    ) -> Optional[tuple[int, int]]:\n   583→        \"\"\"\n   584→        Find the smallest contiguous range containing at least `threshold` of appearances.\n   585→\n   586→        Feature F4: Relaxed Disjoint Distribution Heuristic\n   587→        Uses a sliding window to find the smallest range that contains 80%+ of\n   588→        the character's chapter appearances.\n   589→\n   590→        Args:\n   591→            chapters: Set of chapter indices where character appears\n   592→            threshold: Minimum fraction of appearances required in range (default 0.80)\n   593→\n   594→        Returns:\n   595→            Tuple of (start, end) chapter indices, or None if insufficient data\n   596→        \"\"\"\n   597→        if not chapters or len(chapters) < 3:\n   598→            return None\n   599→\n   600→        sorted_chapters = sorted(chapters)\n   601→        n = len(sorted_chapters)\n   602→        required = int(n * threshold)\n   603→\n   604→        if required < 1:\n   605→            required = 1\n   606→\n   607→        # Find smallest window containing 'required' chapters\n   608→        best_range = None\n   609→        best_span = float('inf')\n   610→\n   611→        for start_idx in range(n - required + 1):\n   612→            end_idx = start_idx + required - 1\n   613→            start_ch = sorted_chapters[start_idx]\n   614→            end_ch = sorted_chapters[end_idx]\n   615→            span = end_ch - start_ch\n   616→\n   617→            if span < best_span:\n   618→                best_span = span\n   619→                best_range = (start_ch, end_ch)\n   620→\n   621→        return best_range\n   622→\n   623→    def _check_missing_agentive_descriptions(\n   624→        self,\n   625→        text: str,\n   626→        characters: list[Character],\n   627→    ) -> list[VerificationIssue]:\n   628→        \"\"\"\n   629→        Check for high-frequency agentive descriptions missing from character list.\n   630→\n   631→        Scans for patterns like \"the creature said\", \"the monster walked\" that\n   632→        appear 10+ times but are not in the character list.\n   633→        \"\"\"\n   634→        issues = []\n   635→\n   636→        # Build set of existing character names for quick lookup\n   637→        existing_names = set()\n   638→        for char in characters:\n   639→            existing_names.add(char.canonical_name.lower())\n   640→            for alias in char.aliases:\n   641→                existing_names.add(alias.lower())\n   642→\n   643→        # Pattern to find \"the X <agentive_verb>\" constructions\n   644→        # We look for \"the <noun>\" followed by an agentive verb\n   645→        descriptive_pattern = r'\\bthe\\s+([a-z]+(?:\\s+[a-z]+)?)\\s+'\n   646→\n   647→        # Count occurrences of each descriptive handle followed by agentive verbs\n   648→        descriptive_counts = {}\n   649→\n   650→        for verb_pattern in AGENTIVE_VERBS:\n   651→            # Build combined pattern: \"the X <verb>\"\n   652→            combined_pattern = descriptive_pattern + verb_pattern[2:]  # Remove leading \\b from verb\n   653→            for match in re.finditer(combined_pattern, text, re.IGNORECASE):\n   654→                handle = \"the \" + match.group(1).lower()\n   655→                # Skip common non-character phrases\n   656→                if handle in {'the man', 'the woman', 'the door', 'the room', 'the house',\n   657→                              'the time', 'the day', 'the way', 'the end', 'the same',\n   658→                              'the first', 'the last', 'the other', 'the next'}:\n   659→                    continue\n   660→                descriptive_counts[handle] = descriptive_counts.get(handle, 0) + 1\n   661→\n   662→        # Flag handles with 10+ agentive occurrences that aren't in character list\n   663→        for handle, count in descriptive_counts.items():\n   664→            if count >= 10 and handle.lower() not in existing_names:\n   665→                issues.append(VerificationIssue(\n   666→                    description=(\n   667→                        f\"Potential unnamed character: '{handle}' appears {count} times with \"\n   668→                        f\"agentive verbs but is not in the character list\"\n   669→                    ),\n   670→                    severity=\"warning\",\n   671→                    suggested_fix=f\"Consider adding '{handle}' as a character or alias\",\n   672→                ))\n   673→\n   674→        return issues\n   675→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5e3a022d-ab51-4b5c-9cef-c487dd59220c","uuid":"e847644e-f04e-4fff-8e65-57cd3864c4a8","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/agents/characters.py","content":"\"\"\"\nCharacterAgent - Specialized agent for character extraction.\n\nWraps CharacterExtractionPipeline with self-verification to ensure:\n- No duplicate characters (same person under different names)\n- Consistent alias resolution\n- Proper mention distribution\n\"\"\"\n\nfrom typing import Optional\nimport logging\nimport re\nimport time\n\nfrom .base import Agent, AgentContext, AgentResult, VerificationResult, VerificationIssue, VerificationLevel\nfrom .config import AgentConfig, PipelineTuningConfig\nfrom ..pipeline.character_extraction.pipeline import CharacterExtractionPipeline\nfrom ..pipeline.character_extraction.models import CharacterMap, Character\nfrom ..pipeline.chapter_detection.models import ChapterMap as ChapterDetectionMap\nfrom ..pipeline.llm import LLMClient\n\nlogger = logging.getLogger(__name__)\n\n\n# Pronoun/determiner stopwords - characters with these names should be flagged/removed\nPRONOUN_STOPWORDS = {\n    'he', 'she', 'it', 'they', 'we', 'i', 'you',\n    'him', 'her', 'them', 'us', 'me',\n    'his', 'hers', 'its', 'their', 'our', 'my', 'your',\n    'this', 'that', 'these', 'those', 'the', 'a', 'an',\n}\n\n# Agentive verb patterns for detecting unnamed characters\nAGENTIVE_VERBS = [\n    r'\\b(said|asked|replied|whispered|shouted|called|cried|muttered|exclaimed)\\b',\n    r'\\b(walked|ran|stood|turned|looked|smiled|laughed|nodded|frowned)\\b',\n    r'\\b(grabbed|took|held|threw|placed|opened|closed|pushed|pulled)\\b',\n    r'\\b(sat|came|went|entered|left|arrived|departed|approached|retreated)\\b',\n]\n\n\nDUPLICATE_CHECK_SYSTEM = \"\"\"You are a literary analyst checking for duplicate characters.\n\nYour task is to identify characters that may be the SAME PERSON listed separately.\n\nLook for:\n1. Names that share components (same first name, same last name)\n2. Characters that appear in similar chapters\n3. Names that could be nicknames/aliases for each other\n\nOnly flag pairs you are CONFIDENT are duplicates.\"\"\"\n\n\nDUPLICATE_CHECK_PROMPT = \"\"\"Review these characters for potential duplicates (same person listed twice):\n\n{character_list}\n\nFor each potential duplicate pair, check:\n- Do the names share significant components?\n- Do they appear in overlapping chapters?\n- Could one be a nickname/title for the other?\n\nReturn JSON:\n{{\n  \"duplicates\": [\n    {{\"name1\": \"...\", \"name2\": \"...\", \"reason\": \"...\", \"confidence\": 0.0-1.0}}\n  ],\n  \"analysis\": \"Brief summary\"\n}}\n\nIf no duplicates found, return: {{\"duplicates\": [], \"analysis\": \"No duplicates detected\"}}\n\nReturn ONLY valid JSON.\"\"\"\n\n\nclass CharacterAgent(Agent):\n    \"\"\"\n    Specialized agent for character extraction with self-verification.\n\n    Wraps the existing CharacterExtractionPipeline and adds verification:\n    - Checks for duplicate characters that slipped through alias resolution\n    - Validates mention distribution (major characters across chapters)\n    - Verifies alias consistency\n    \"\"\"\n\n    def __init__(\n        self,\n        llm_client: Optional[LLMClient] = None,\n        config: Optional[AgentConfig] = None,\n        tuning: Optional[PipelineTuningConfig] = None,\n    ):\n        self.llm = llm_client\n        self.config = config or AgentConfig()\n        self._tuning = tuning\n\n    @property\n    def name(self) -> str:\n        return \"character_agent\"\n\n    @property\n    def recommended_models(self) -> list[str]:\n        return [\n            \"gpt-4o\",  # Strong narrative understanding\n            \"claude-3-5-sonnet\",  # Good at character relationships\n            \"llama3.2\",  # Local alternative\n        ]\n\n    def run(self, context: AgentContext) -> AgentResult[CharacterMap]:\n        \"\"\"Run character extraction pipeline.\"\"\"\n        start_time = time.perf_counter()\n\n        # We need chapter_map from context\n        if not context.chapter_map:\n            # Get model info for error case\n            model_used = self.config.model if self.config else None\n            provider_used = self.config.provider if self.config else None\n\n            return AgentResult(\n                data=CharacterMap(\n                    characters=[],\n                    low_confidence_characters=[],\n                    total_mentions=0,\n                    total_chapters=0,\n                    pipeline_metadata={\"error\": \"No chapter map provided\"},\n                ),\n                high_confidence_count=0,\n                medium_confidence_count=0,\n                low_confidence_count=0,\n                issues=[\"No chapter map provided - cannot extract characters\"],\n                model_used=model_used,\n                provider_used=provider_used,\n            )\n\n        pipeline = self._get_pipeline()\n        character_map, _ = pipeline.run(\n            full_text=context.text,\n            chapter_map=context.chapter_map,\n            source_file=context.source_file,\n        )\n\n        # Calculate confidence breakdown\n        high = sum(1 for c in character_map.characters if c.confidence >= 0.7)\n        medium = sum(1 for c in character_map.characters if 0.4 <= c.confidence < 0.7)\n        low = sum(1 for c in character_map.characters if c.confidence < 0.4)\n        low += len(character_map.low_confidence_characters)\n\n        # Collect issues\n        issues = []\n        if character_map.low_confidence_characters:\n            issues.append(\n                f\"{len(character_map.low_confidence_characters)} low-confidence characters flagged\"\n            )\n\n        elapsed = time.perf_counter() - start_time\n\n        # Get model info from config or client\n        model_used = None\n        provider_used = None\n        if self.config and self.config.model:\n            model_used = self.config.model\n            provider_used = self.config.provider\n        elif self.llm and self.llm.config:\n            model_used = self.llm.config.model\n            provider_used = self.llm.config.provider\n\n        return AgentResult(\n            data=character_map,\n            confidence_scores=[c.confidence for c in character_map.characters],\n            high_confidence_count=high,\n            medium_confidence_count=medium,\n            low_confidence_count=low,\n            issues=issues,\n            processing_time_seconds=elapsed,\n            model_used=model_used,\n            provider_used=provider_used,\n        )\n\n    def verify(\n        self,\n        result: AgentResult[CharacterMap],\n        level: VerificationLevel = VerificationLevel.SELF_CHECK,\n        context: Optional[AgentContext] = None,\n    ) -> VerificationResult:\n        \"\"\"\n        Verify character extraction quality.\n\n        Checks:\n        1. Low-confidence characters\n        2. Duplicate detection (same character under different names)\n        3. Mention distribution (major characters across chapters)\n        4. Alias consistency\n        \"\"\"\n        issues = []\n        suggestions = []\n        character_map = result.data\n\n        if not character_map.characters:\n            return VerificationResult(\n                passed=True,\n                issues=[],\n                suggestions=[],\n            )\n\n        # Check 1: Low confidence items\n        if result.low_confidence_count > 0:\n            issues.append(VerificationIssue(\n                description=f\"{result.low_confidence_count} characters have low confidence\",\n                severity=\"warning\",\n            ))\n\n        # Check 2: Pronoun entries (should be auto-removed)\n        pronoun_issues = self._check_pronoun_entries(character_map.characters)\n        issues.extend(pronoun_issues)\n\n        # Check 3: Look for potential duplicates using heuristics\n        duplicate_issues = self._check_duplicates_heuristic(character_map.characters)\n        issues.extend(duplicate_issues)\n\n        # Check 4: Verify mention distribution\n        distribution_issues = self._check_mention_distribution(character_map)\n        issues.extend(distribution_issues)\n\n        # Check 5: Verify alias consistency\n        alias_issues = self._check_alias_consistency(character_map.characters)\n        issues.extend(alias_issues)\n\n        # Check 6: Disjoint chapter distributions (potential name changes)\n        disjoint_issues = self._check_disjoint_distributions(\n            character_map.characters, character_map.total_chapters\n        )\n        issues.extend(disjoint_issues)\n\n        # Check 7: Missing agentive descriptions (if context available)\n        if context and context.text:\n            agentive_issues = self._check_missing_agentive_descriptions(\n                context.text, character_map.characters\n            )\n            issues.extend(agentive_issues)\n\n        # Check 8: LLM duplicate check for high-value verification\n        if self.config.enable_verification and self.llm and len(character_map.characters) > 1:\n            llm_issues = self._llm_duplicate_check(character_map.characters)\n            issues.extend(llm_issues)\n\n        # Determine if passed\n        error_count = sum(1 for i in issues if i.severity == \"error\")\n        passed = error_count == 0\n\n        return VerificationResult(\n            passed=passed,\n            issues=issues,\n            suggestions=suggestions,\n        )\n\n    def refine(\n        self,\n        result: AgentResult[CharacterMap],\n        issues: list[VerificationIssue],\n    ) -> AgentResult[CharacterMap]:\n        \"\"\"\n        Refine character map based on verification issues.\n\n        Automatically removes pronoun entries (error severity).\n        Other issues are flagged for manual review.\n        \"\"\"\n        character_map = result.data\n\n        # Auto-remove pronoun entries (error severity issues)\n        pronoun_issues = [i for i in issues if \"pronoun/determiner\" in i.description.lower()]\n        if pronoun_issues:\n            # Get the names to remove from issue descriptions\n            pronoun_names = set()\n            for issue in pronoun_issues:\n                # Extract name from description like \"Character 'he' is a pronoun/determiner\"\n                match = re.search(r\"Character '([^']+)' is a pronoun/determiner\", issue.description)\n                if match:\n                    pronoun_names.add(match.group(1).lower())\n\n            # Filter out pronoun characters\n            original_count = len(character_map.characters)\n            character_map.characters = [\n                c for c in character_map.characters\n                if c.canonical_name.lower() not in pronoun_names\n            ]\n            character_map.low_confidence_characters = [\n                c for c in character_map.low_confidence_characters\n                if c.canonical_name.lower() not in pronoun_names\n            ]\n\n            removed_count = original_count - len(character_map.characters)\n            if removed_count > 0:\n                logger.info(f\"CharacterAgent: Auto-removed {removed_count} pronoun entries\")\n                character_map.pipeline_metadata[\"pronoun_entries_removed\"] = removed_count\n\n        # Add issues to pipeline metadata for review\n        issue_descriptions = [i.description for i in issues]\n        if issue_descriptions:\n            character_map.pipeline_metadata[\"verification_issues\"] = issue_descriptions\n            character_map.pipeline_metadata[\"needs_review\"] = True\n\n        # Log remaining errors (non-pronoun)\n        remaining_errors = [i for i in issues if i.severity == \"error\" and \"pronoun/determiner\" not in i.description.lower()]\n        if remaining_errors:\n            logger.warning(\n                f\"CharacterAgent: {len(remaining_errors)} errors remain after refinement\"\n            )\n\n        return AgentResult(\n            data=character_map,\n            confidence_scores=result.confidence_scores,\n            high_confidence_count=result.high_confidence_count,\n            medium_confidence_count=result.medium_confidence_count,\n            low_confidence_count=result.low_confidence_count,\n            issues=issue_descriptions,\n            processing_time_seconds=result.processing_time_seconds,\n            model_used=result.model_used,\n            provider_used=result.provider_used,\n        )\n\n    def _get_pipeline(self) -> CharacterExtractionPipeline:\n        \"\"\"Get or create the character extraction pipeline.\"\"\"\n        t = self._tuning or PipelineTuningConfig()\n        return CharacterExtractionPipeline(\n            llm_client=self.llm,\n            llm_chunk_size=t.character_llm_chunk_chars,\n            mention_context_window=t.character_mention_context_chars,\n        )\n\n    def _check_duplicates_heuristic(self, characters: list[Character]) -> list[VerificationIssue]:\n        \"\"\"Check for potential duplicates using name matching heuristics.\"\"\"\n        issues = []\n\n        for i, char1 in enumerate(characters):\n            for char2 in characters[i + 1:]:\n                # Skip if already aliases of each other\n                if char2.canonical_name in char1.aliases or char1.canonical_name in char2.aliases:\n                    continue\n\n                # Check for shared significant name components\n                words1 = set(self._extract_name_words(char1.canonical_name))\n                words2 = set(self._extract_name_words(char2.canonical_name))\n\n                # Also check aliases\n                for alias in char1.aliases:\n                    words1.update(self._extract_name_words(alias))\n                for alias in char2.aliases:\n                    words2.update(self._extract_name_words(alias))\n\n                shared = words1 & words2\n                if shared:\n                    # Check chapter overlap\n                    chapters1 = set(char1.chapters_present)\n                    chapters2 = set(char2.chapters_present)\n                    overlap = chapters1 & chapters2\n\n                    if overlap:\n                        issues.append(VerificationIssue(\n                            description=(\n                                f\"Potential duplicate: '{char1.canonical_name}' and \"\n                                f\"'{char2.canonical_name}' share name component(s) {shared} \"\n                                f\"and appear in same chapters\"\n                            ),\n                            severity=\"warning\",\n                            suggested_fix=\"Consider merging these characters\",\n                        ))\n\n        return issues\n\n    def _extract_name_words(self, name: str) -> list[str]:\n        \"\"\"Extract significant words from a name (3+ chars, not titles).\"\"\"\n        # Remove common titles\n        name = re.sub(\n            r'\\b(mr|mrs|ms|miss|dr|sir|lady|lord|captain|colonel|major|general|sergeant|professor)\\b\\.?',\n            '',\n            name,\n            flags=re.IGNORECASE\n        )\n\n        words = re.findall(r'[a-zA-Z]+', name.lower())\n        return [w for w in words if len(w) >= 3]\n\n    def _check_mention_distribution(self, character_map: CharacterMap) -> list[VerificationIssue]:\n        \"\"\"Check for unusual mention distributions.\"\"\"\n        issues = []\n        total_chapters = character_map.total_chapters\n\n        if total_chapters <= 1:\n            return issues\n\n        for char in character_map.characters[:10]:  # Check top 10 characters\n            chapters_present = len(char.chapters_present)\n            mention_count = char.mention_count\n\n            # High mention count but few chapters = suspicious\n            if mention_count > 50 and chapters_present == 1:\n                issues.append(VerificationIssue(\n                    description=(\n                        f\"Character '{char.canonical_name}' has {mention_count} mentions \"\n                        f\"but only appears in 1 chapter - may be a non-character entity\"\n                    ),\n                    severity=\"warning\",\n                ))\n\n            # Major character (>100 mentions) should appear in multiple chapters\n            if mention_count > 100 and chapters_present < total_chapters * 0.3:\n                issues.append(VerificationIssue(\n                    description=(\n                        f\"Major character '{char.canonical_name}' ({mention_count} mentions) \"\n                        f\"only appears in {chapters_present}/{total_chapters} chapters\"\n                    ),\n                    severity=\"info\",\n                ))\n\n        return issues\n\n    def _check_alias_consistency(self, characters: list[Character]) -> list[VerificationIssue]:\n        \"\"\"Check that aliases are consistent with canonical names.\"\"\"\n        issues = []\n\n        for char in characters:\n            if not char.aliases:\n                continue\n\n            canonical_words = set(self._extract_name_words(char.canonical_name))\n\n            for alias in char.aliases:\n                alias_words = set(self._extract_name_words(alias))\n\n                # Aliases should share at least one word with canonical name\n                if not canonical_words & alias_words:\n                    # Exception: single word aliases might be nicknames\n                    if len(alias_words) > 1:\n                        issues.append(VerificationIssue(\n                            description=(\n                                f\"Alias '{alias}' for '{char.canonical_name}' \"\n                                f\"shares no name components - verify correct\"\n                            ),\n                            severity=\"info\",\n                        ))\n\n        return issues\n\n    def _llm_duplicate_check(self, characters: list[Character]) -> list[VerificationIssue]:\n        \"\"\"Use LLM to check for duplicates that heuristics might miss.\"\"\"\n        issues = []\n\n        # Build character list for LLM\n        char_lines = []\n        for char in characters[:30]:  # Limit to top 30 for prompt size\n            aliases_str = f\" (aliases: {', '.join(char.aliases[:3])})\" if char.aliases else \"\"\n            chapters_str = \", \".join(str(c) for c in char.chapters_present[:5])\n            if len(char.chapters_present) > 5:\n                chapters_str += f\"... ({len(char.chapters_present)} total)\"\n\n            char_lines.append(\n                f\"- {char.canonical_name}{aliases_str}: \"\n                f\"{char.mention_count} mentions, chapters {chapters_str}\"\n            )\n\n        character_list = \"\\n\".join(char_lines)\n        prompt = DUPLICATE_CHECK_PROMPT.format(character_list=character_list)\n\n        try:\n            result, _ = self.llm.query_json(prompt, system=DUPLICATE_CHECK_SYSTEM)\n\n            if result and isinstance(result.get(\"duplicates\"), list):\n                for dup in result[\"duplicates\"]:\n                    if dup.get(\"confidence\", 0) >= 0.7:\n                        issues.append(VerificationIssue(\n                            description=(\n                                f\"LLM detected potential duplicate: '{dup.get('name1')}' and \"\n                                f\"'{dup.get('name2')}' - {dup.get('reason', 'no reason given')}\"\n                            ),\n                            severity=\"warning\",\n                            suggested_fix=\"Consider merging these characters\",\n                        ))\n        except Exception as e:\n            logger.error(f\"LLM duplicate check failed: {e}\")\n            # Re-raise to fail fast instead of silently continuing\n            raise\n\n        return issues\n\n    def _check_pronoun_entries(self, characters: list[Character]) -> list[VerificationIssue]:\n        \"\"\"\n        Check for pronoun/determiner entries that should not be characters.\n\n        These entries indicate bugs in upstream extraction and should be\n        flagged as errors for auto-removal.\n        \"\"\"\n        issues = []\n\n        for char in characters:\n            name_lower = char.canonical_name.lower()\n            if name_lower in PRONOUN_STOPWORDS:\n                issues.append(VerificationIssue(\n                    description=f\"Character '{char.canonical_name}' is a pronoun/determiner and should not be a character\",\n                    severity=\"error\",\n                    suggested_fix=\"Remove this entry - it is not a character\",\n                ))\n\n        return issues\n\n    def _check_disjoint_distributions(\n        self,\n        characters: list[Character],\n        total_chapters: int,\n    ) -> list[VerificationIssue]:\n        \"\"\"\n        Check for character pairs with disjoint but sequential chapter distributions.\n\n        This pattern may indicate a character name change mid-book (e.g., marriage,\n        alias adoption, identity reveal).\n\n        Feature F4: Relaxed Disjoint Distribution Heuristic\n        Uses 80% dominant chapter ranges instead of strict separation. This catches cases\n        where a character is discussed by their old name in later chapters (e.g., flashbacks,\n        other characters reminiscing).\n\n        A dominant range is defined as the contiguous span containing 80%+ of the character's\n        appearances. If the dominant ranges of two characters are disjoint/sequential,\n        they may be the same person.\n        \"\"\"\n        issues = []\n        MIN_MENTIONS = 10\n        DOMINANT_THRESHOLD = 0.80  # 80% of appearances must be in dominant range\n\n        # Only check characters with significant mentions\n        significant = [c for c in characters if c.mention_count >= MIN_MENTIONS]\n\n        for i, char1 in enumerate(significant):\n            for char2 in significant[i + 1:]:\n                # Skip if already aliases of each other\n                if char2.canonical_name in char1.aliases or char1.canonical_name in char2.aliases:\n                    continue\n\n                set1, set2 = set(char1.chapters_present), set(char2.chapters_present)\n                if not set1 or not set2:\n                    continue\n\n                # Feature F4: Calculate dominant chapter ranges\n                dominant1 = self._get_dominant_range(set1, DOMINANT_THRESHOLD)\n                dominant2 = self._get_dominant_range(set2, DOMINANT_THRESHOLD)\n\n                if not dominant1 or not dominant2:\n                    continue\n\n                # Check if dominant ranges are disjoint/sequential\n                dom_set1 = set(range(dominant1[0], dominant1[1] + 1))\n                dom_set2 = set(range(dominant2[0], dominant2[1] + 1))\n\n                overlap = dom_set1 & dom_set2\n                if not overlap:  # Dominant ranges are disjoint\n                    # Check if sequential\n                    is_sequential = dominant1[1] < dominant2[0] or dominant2[1] < dominant1[0]\n\n                    if is_sequential:\n                        # Determine which character comes first\n                        if dominant1[1] < dominant2[0]:\n                            early_char, late_char = char1.canonical_name, char2.canonical_name\n                            early_range, late_range = dominant1, dominant2\n                        else:\n                            early_char, late_char = char2.canonical_name, char1.canonical_name\n                            early_range, late_range = dominant2, dominant1\n\n                        issues.append(VerificationIssue(\n                            description=(\n                                f\"Disjoint dominant ranges: '{early_char}' (dominant chapters {early_range[0]}-{early_range[1]}) \"\n                                f\"and '{late_char}' (dominant chapters {late_range[0]}-{late_range[1]}) - \"\n                                f\"could be same character under different name\"\n                            ),\n                            severity=\"warning\",\n                            suggested_fix=\"Review if these are the same character with a name change\",\n                        ))\n\n        return issues\n\n    def _get_dominant_range(\n        self,\n        chapters: set[int],\n        threshold: float = 0.80,\n    ) -> Optional[tuple[int, int]]:\n        \"\"\"\n        Find the smallest contiguous range containing at least `threshold` of appearances.\n\n        Feature F4: Relaxed Disjoint Distribution Heuristic\n        Uses a sliding window to find the smallest range that contains 80%+ of\n        the character's chapter appearances.\n\n        Args:\n            chapters: Set of chapter indices where character appears\n            threshold: Minimum fraction of appearances required in range (default 0.80)\n\n        Returns:\n            Tuple of (start, end) chapter indices, or None if insufficient data\n        \"\"\"\n        if not chapters or len(chapters) < 3:\n            return None\n\n        sorted_chapters = sorted(chapters)\n        n = len(sorted_chapters)\n        required = int(n * threshold)\n\n        if required < 1:\n            required = 1\n\n        # Find smallest window containing 'required' chapters\n        best_range = None\n        best_span = float('inf')\n\n        for start_idx in range(n - required + 1):\n            end_idx = start_idx + required - 1\n            start_ch = sorted_chapters[start_idx]\n            end_ch = sorted_chapters[end_idx]\n            span = end_ch - start_ch\n\n            if span < best_span:\n                best_span = span\n                best_range = (start_ch, end_ch)\n\n        return best_range\n\n    def _check_missing_agentive_descriptions(\n        self,\n        text: str,\n        characters: list[Character],\n    ) -> list[VerificationIssue]:\n        \"\"\"\n        Check for high-frequency agentive descriptions missing from character list.\n\n        Scans for patterns like \"the creature said\", \"the monster walked\" that\n        appear 10+ times but are not in the character list.\n        \"\"\"\n        issues = []\n\n        # Build set of existing character names for quick lookup\n        existing_names = set()\n        for char in characters:\n            existing_names.add(char.canonical_name.lower())\n            for alias in char.aliases:\n                existing_names.add(alias.lower())\n\n        # Pattern to find \"the X <agentive_verb>\" constructions\n        # We look for \"the <noun>\" followed by an agentive verb\n        descriptive_pattern = r'\\bthe\\s+([a-z]+(?:\\s+[a-z]+)?)\\s+'\n\n        # Count occurrences of each descriptive handle followed by agentive verbs\n        descriptive_counts = {}\n\n        for verb_pattern in AGENTIVE_VERBS:\n            # Build combined pattern: \"the X <verb>\"\n            combined_pattern = descriptive_pattern + verb_pattern[2:]  # Remove leading \\b from verb\n            for match in re.finditer(combined_pattern, text, re.IGNORECASE):\n                handle = \"the \" + match.group(1).lower()\n                # Skip common non-character phrases\n                if handle in {'the man', 'the woman', 'the door', 'the room', 'the house',\n                              'the time', 'the day', 'the way', 'the end', 'the same',\n                              'the first', 'the last', 'the other', 'the next'}:\n                    continue\n                descriptive_counts[handle] = descriptive_counts.get(handle, 0) + 1\n\n        # Flag handles with 10+ agentive occurrences that aren't in character list\n        for handle, count in descriptive_counts.items():\n            if count >= 10 and handle.lower() not in existing_names:\n                issues.append(VerificationIssue(\n                    description=(\n                        f\"Potential unnamed character: '{handle}' appears {count} times with \"\n                        f\"agentive verbs but is not in the character list\"\n                    ),\n                    severity=\"warning\",\n                    suggested_fix=f\"Consider adding '{handle}' as a character or alias\",\n                ))\n\n        return issues\n","numLines":675,"startLine":1,"totalLines":675}}}
