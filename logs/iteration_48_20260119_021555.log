source_file\": \"Test_Texts/Masque of the Red Death - Poe.txt\",\n    \"source_format\": \"txt\",\n    \"total_word_count\": 2449,\n    \"total_character_count\": 13811,\n    \"estimated_total_duration_minutes\": 16.286666666666665,\n    \"words_per_minute\": 150\n  },\n  \"structure\": [\n    {\n      \"type\": \"chapter\",\n      \"title\": null,\n      \"index\": 1,\n      \"start_position\": 28,\n      \"end_position\": 13811,\n      \"word_count\": 2443,\n      \"estimated_duration_minutes\": 16.286666666666665,\n      \"confidence\": \"medium\",\n      \"children\": [],\n      \"characters_present\": [\n        \"Prince Prospero\",\n        \"The masked figure (Red Death)\"\n      ],\n      \"summary\": \"The chapter opens with the devastating spread of the 'Red Death,' a gruesome plague marked by bleeding pores and rapid death, prompting Prince Prospero to seal himself and a thousand courtiers within a fortified, elaborately designed abbey to escape the contagion. Inside, seven uniquely colored rooms—each with stained-glass windows matching their hue, except the western chamber, which is shrouded in black velvet and blood-red glass—host a lavish masked ball filled with grotesque revelers, music, and wine. As the night progresses, the ominous ebony clock in the black room chimes hourly, halting the festivities and instilling dread, until at midnight, a mysterious figure dressed as the Red Death, drenched in blood and wearing a corpse-like mask, appears and stalks through the rooms. Enraged, Prince Prospero pursues the figure with a dagger, but the intruder turns in the black chamber, and the prince collapses dead; the revelers rush in only to find the mask empty, realizing the Red Death itself has infiltrated their sanctuary, and one by one, all die as the clock stops and darkness claims the abbey.\"\n    }\n  ],\n  \"characters\": [\n    {\n      \"id\": \"char_the_prince_prospero_d85685e9\",\n      \"canonical_name\": \"the Prince Prospero\",\n      \"aliases\": [\n        \"the mummer\"\n      ],\n      \"role\": null,\n      \"appearance\": null,\n      \"personality\": null,\n      \"voice_guidance\": null,\n      \"descriptions\": [\n        {\n          \"text\": \"Prince Prospero is a bold and robust man who presides over a lavish, isolated gathering of revellers. He initially reacts with rage and indignation to the intrusion of a masked figure dressed as the Red Death, but later pursues the intruder with fury before being fatally struck and killed in the black chamber.\",\n          \"source_position\": 10339,\n          \"chapter_index\": null,\n          \"confidence\": \"llm_refined\"\n        }\n      ],\n      \"relationships\": {},\n      \"evidence\": [\n        {\n          \"statement\": \"Prince Prospero is described as bold and robust\",\n          \"quote\": \"the prince was a bold and robust man\",\n          \"position\": 11148,\n          \"confidence\": \"high\"\n        },\n        {\n          \"statement\": \"He reacts with anger and demands the intruder be seized\",\n          \"quote\": \"insult us with this blasphemous mockery? Seize him and unmask him -- that we may know whom we have to hang at sunrise, from the battlements!\",\n          \"position\": 11148,\n          \"confidence\": \"high\"\n        },\n        {\n          \"statement\": \"He pursues the intruder through the chambers in a state of rage\",\n          \"quote\": \"the Prince Prospero, maddening with rage and the shame of his own momentary cowardice, rushed hurriedly through the six chambers\",\n          \"position\": 12389,\n          \"confidence\": \"high\"\n        },\n        {\n          \"statement\": \"He is fatally stabbed by the intruder in the black chamber\",\n          \"quote\": \"There was a sharp cry -- and the dagger dropped gleaming upon the sable carpet, upon which, instantly afterwards, fell prostrate in death the Prince Prospero\",\n          \"position\": 12980,\n          \"confidence\": \"high\"\