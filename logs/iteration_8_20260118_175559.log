{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AfkzEC4Nnjf9yPkkqZ7dtz","type":"tool_result","content":"     0→\"\"\"\n     1→Simple LLM interface for the pipeline.\n     2→\n     3→This provides a clean, focused interface for LLM calls without the complexity\n     4→of the original refiner.py. Supports Ollama, OpenAI, and Anthropic.\n     5→\"\"\"\n     6→\n     7→import json\n     8→import re\n     9→import os\n    10→import time\n    11→from dataclasses import dataclass\n    12→from typing import Optional, Literal, Union, TYPE_CHECKING\n    13→import logging\n    14→\n    15→if TYPE_CHECKING:\n    16→    from ..pipeline.metrics import MetricsCollector\n    17→\n    18→logger = logging.getLogger(__name__)\n    19→\n    20→\n    21→@dataclass\n    22→class LLMConfig:\n    23→    \"\"\"Configuration for LLM provider.\"\"\"\n    24→    provider: Literal[\"ollama\", \"openai\", \"anthropic\"]\n    25→    model: str\n    26→    base_url: Optional[str] = None  # For Ollama/LM Studio\n    27→    api_key: Optional[str] = None\n    28→    temperature: float = 0.3\n    29→    max_tokens: int = 4096\n    30→    context_length: int = 32768  # Context window size (num_ctx for Ollama)\n    31→    think: Optional[Union[bool, str]] = None  # Reasoning control: False, True, \"low\", \"medium\", \"high\"\n    32→\n    33→    @classmethod\n    34→    def ollama(cls, model: str = \"llama3.2\", base_url: str = \"http://localhost:11434\") -> \"LLMConfig\":\n    35→        return cls(provider=\"ollama\", model=model, base_url=base_url)\n    36→\n    37→    @classmethod\n    38→    def openai(cls, model: str = \"gpt-4o-mini\", api_key: Optional[str] = None) -> \"LLMConfig\":\n    39→        return cls(\n    40→            provider=\"openai\",\n    41→            model=model,\n    42→            api_key=api_key or os.environ.get(\"OPENAI_API_KEY\"),\n    43→        )\n    44→\n    45→    @classmethod\n    46→    def anthropic(cls, model: str = \"claude-3-5-sonnet-20241022\", api_key: Optional[str] = None) -> \"LLMConfig\":\n    47→        return cls(\n    48→            provider=\"anthropic\",\n    49→            model=model,\n    50→            api_key=api_key or os.environ.get(\"ANTHROPIC_API_KEY\"),\n    51→        )\n    52→\n    53→\n    54→@dataclass\n    55→class LLMResponse:\n    56→    \"\"\"Response from an LLM call.\"\"\"\n    57→    content: str\n    58→    model: str\n    59→    usage: Optional[dict] = None  # Token usage if available\n    60→    error: Optional[str] = None\n    61→    latency_ms: Optional[float] = None  # Time to complete the call in milliseconds\n    62→\n    63→    @property\n    64→    def success(self) -> bool:\n    65→        return self.error is None\n    66→\n    67→    @property\n    68→    def total_tokens(self) -> int:\n    69→        \"\"\"Total tokens used (prompt + completion).\"\"\"\n    70→        if not self.usage:\n    71→            return 0\n    72→        return self.usage.get(\"prompt_tokens\", 0) + self.usage.get(\"completion_tokens\", 0)\n    73→\n    74→\n    75→class LLMClient:\n    76→    \"\"\"Simple, synchronous LLM client.\"\"\"\n    77→\n    78→    def __init__(self, config: LLMConfig, metrics: Optional[\"MetricsCollector\"] = None):\n    79→        self.config = config\n    80→        self.metrics = metrics\n    81→        self._client = None\n    82→\n    83→    def _get_client(self):\n    84→        \"\"\"Lazy initialization of the appropriate client.\"\"\"\n    85→        if self._client is not None:\n    86→            return self._client\n    87→\n    88→        if self.config.provider == \"ollama\":\n    89→            import httpx\n    90→            self._client = httpx.Client(base_url=self.config.base_url, timeout=1200.0)\n    91→            self._httpx = httpx  # Store for error handling\n    92→\n    93→        elif self.config.provider == \"openai\":\n    94→            from openai import OpenAI\n    95→            self._client = OpenAI(\n    96→                api_key=self.config.api_key,\n    97→                base_url=self.config.base_url,  # Needed for LM Studio compatibility\n    98→            )\n    99→\n   100→        elif self.config.provider == \"anthropic\":\n   101→            from anthropic import Anthropic\n   102→            self._client = Anthropic(api_key=self.config.api_key)\n   103→\n   104→        return self._client\n   105→\n   106→    def query(self, prompt: str, system: Optional[str] = None) -> LLMResponse:\n   107→        \"\"\"Send a query to the LLM and get a response.\"\"\"\n   108→        start_time = time.perf_counter()\n   109→        try:\n   110→            if self.config.provider == \"ollama\":\n   111→                response = self._query_ollama(prompt, system)\n   112→            elif self.config.provider == \"openai\":\n   113→                response = self._query_openai(prompt, system)\n   114→            elif self.config.provider == \"anthropic\":\n   115→                response = self._query_anthropic(prompt, system)\n   116→            else:\n   117→                response = LLMResponse(content=\"\", model=self.config.model, error=f\"Unknown provider: {self.config.provider}\")\n   118→\n   119→            # Clean thinking tags from response (for reasoning models like DeepSeek-R1, QwQ)\n   120→            if response.content:\n   121→                response.content = self._clean_thinking_tags(response.content)\n   122→\n   123→            # Add timing to response\n   124→            elapsed_ms = (time.perf_counter() - start_time) * 1000\n   125→            response.latency_ms = round(elapsed_ms, 2)\n   126→\n   127→            # Auto-record token usage if metrics collector provided\n   128→            if self.metrics:\n   129→                self.metrics.record_llm_call(response)\n   130→\n   131→            return response\n   132→        except Exception as e:\n   133→            elapsed_ms = (time.perf_counter() - start_time) * 1000\n   134→            # Extract more detailed error information for HTTP errors\n   135→            error_msg = str(e)\n   136→            if hasattr(e, 'response') and hasattr(e.response, 'status_code'):\n   137→                # httpx.HTTPStatusError\n   138→                status_code = e.response.status_code\n   139→                try:\n   140→                    error_detail = e.response.text[:200] if hasattr(e.response, 'text') else \"\"\n   141→                    if error_detail:\n   142→                        error_msg = f\"Server error '{status_code}' for url '{getattr(e.response, 'url', 'unknown')}': {error_detail}\"\n   143→                    else:\n   144→                        error_msg = f\"Server error '{status_code}' for url '{getattr(e.response, 'url', 'unknown')}'\"\n   145→                except Exception:\n   146→                    error_msg = f\"Server error '{status_code}' for url '{getattr(e.response, 'url', 'unknown')}'\"\n   147→\n   148→            # Only log at warning level to reduce noise - individual components will handle their own error messages\n   149→            logger.debug(f\"LLM query failed: {error_msg}\")\n   150→            return LLMResponse(content=\"\", model=self.config.model, error=error_msg, latency_ms=round(elapsed_ms, 2))\n   151→\n   152→    def _query_ollama(self, prompt: str, system: Optional[str]) -> LLMResponse:\n   153→        \"\"\"Query Ollama API.\"\"\"\n   154→        from ..logging_config import get_llm_logger\n   155→        llm_logger = get_llm_logger()\n   156→\n   157→        client = self._get_client()\n   158→\n   159→        messages = []\n   160→        if system:\n   161→            messages.append({\"role\": \"system\", \"content\": system})\n   162→        messages.append({\"role\": \"user\", \"content\": prompt})\n   163→\n   164→        url = f\"{self.config.base_url}/api/chat\"\n   165→        body = {\n   166→            \"model\": self.config.model,\n   167→            \"messages\": messages,\n   168→            \"stream\": False,\n   169→            \"options\": {\n   170→                \"temperature\": self.config.temperature,\n   171→                \"num_predict\": self.config.max_tokens,\n   172→                \"num_ctx\": self.config.context_length,\n   173→            },\n   174→        }\n   175→\n   176→        # Add think parameter if specified (Ollama API expects it at top level)\n   177→        if self.config.think is not None:\n   178→            body[\"think\"] = self.config.think\n   179→\n   180→        llm_logger.log_request(\n   181→            url=url,\n   182→            method=\"POST\",\n   183→            headers={\"Content-Type\": \"application/json\"},\n   184→            body=body,\n   185→            provider=\"ollama\",\n   186→            model=self.config.model,\n   187→        )\n   188→\n   189→        start_time = time.perf_counter()\n   190→        response = client.post(\"/api/chat\", json=body)\n   191→        latency_ms = (time.perf_counter() - start_time) * 1000\n   192→\n   193→        # Check for HTTP errors and provide detailed error information\n   194→        if response.is_error:\n   195→            error_body = \"\"\n   196→            try:\n   197→                error_body = response.text[:500]  # Limit error body size\n   198→            except Exception:\n   199→                pass\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3fbbbcfe-92eb-42d2-9bde-46d757904d2a","uuid":"8a23343f-0e6a-4f37-b8cd-255bb06ef02e","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/llm/client.py","content":"\"\"\"\nSimple LLM interface for the pipeline.\n\nThis provides a clean, focused interface for LLM calls without the complexity\nof the original refiner.py. Supports Ollama, OpenAI, and Anthropic.\n\"\"\"\n\nimport json\nimport re\nimport os\nimport time\nfrom dataclasses import dataclass\nfrom typing import Optional, Literal, Union, TYPE_CHECKING\nimport logging\n\nif TYPE_CHECKING:\n    from ..pipeline.metrics import MetricsCollector\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass LLMConfig:\n    \"\"\"Configuration for LLM provider.\"\"\"\n    provider: Literal[\"ollama\", \"openai\", \"anthropic\"]\n    model: str\n    base_url: Optional[str] = None  # For Ollama/LM Studio\n    api_key: Optional[str] = None\n    temperature: float = 0.3\n    max_tokens: int = 4096\n    context_length: int = 32768  # Context window size (num_ctx for Ollama)\n    think: Optional[Union[bool, str]] = None  # Reasoning control: False, True, \"low\", \"medium\", \"high\"\n\n    @classmethod\n    def ollama(cls, model: str = \"llama3.2\", base_url: str = \"http://localhost:11434\") -> \"LLMConfig\":\n        return cls(provider=\"ollama\", model=model, base_url=base_url)\n\n    @classmethod\n    def openai(cls, model: str = \"gpt-4o-mini\", api_key: Optional[str] = None) -> \"LLMConfig\":\n        return cls(\n            provider=\"openai\",\n            model=model,\n            api_key=api_key or os.environ.get(\"OPENAI_API_KEY\"),\n        )\n\n    @classmethod\n    def anthropic(cls, model: str = \"claude-3-5-sonnet-20241022\", api_key: Optional[str] = None) -> \"LLMConfig\":\n        return cls(\n            provider=\"anthropic\",\n            model=model,\n            api_key=api_key or os.environ.get(\"ANTHROPIC_API_KEY\"),\n        )\n\n\n@dataclass\nclass LLMResponse:\n    \"\"\"Response from an LLM call.\"\"\"\n    content: str\n    model: str\n    usage: Optional[dict] = None  # Token usage if available\n    error: Optional[str] = None\n    latency_ms: Optional[float] = None  # Time to complete the call in milliseconds\n\n    @property\n    def success(self) -> bool:\n        return self.error is None\n\n    @property\n    def total_tokens(self) -> int:\n        \"\"\"Total tokens used (prompt + completion).\"\"\"\n        if not self.usage:\n            return 0\n        return self.usage.get(\"prompt_tokens\", 0) + self.usage.get(\"completion_tokens\", 0)\n\n\nclass LLMClient:\n    \"\"\"Simple, synchronous LLM client.\"\"\"\n\n    def __init__(self, config: LLMConfig, metrics: Optional[\"MetricsCollector\"] = None):\n        self.config = config\n        self.metrics = metrics\n        self._client = None\n\n    def _get_client(self):\n        \"\"\"Lazy initialization of the appropriate client.\"\"\"\n        if self._client is not None:\n            return self._client\n\n        if self.config.provider == \"ollama\":\n            import httpx\n            self._client = httpx.Client(base_url=self.config.base_url, timeout=1200.0)\n            self._httpx = httpx  # Store for error handling\n\n        elif self.config.provider == \"openai\":\n            from openai import OpenAI\n            self._client = OpenAI(\n                api_key=self.config.api_key,\n                base_url=self.config.base_url,  # Needed for LM Studio compatibility\n            )\n\n        elif self.config.provider == \"anthropic\":\n            from anthropic import Anthropic\n            self._client = Anthropic(api_key=self.config.api_key)\n\n        return self._client\n\n    def query(self, prompt: str, system: Optional[str] = None) -> LLMResponse:\n        \"\"\"Send a query to the LLM and get a response.\"\"\"\n        start_time = time.perf_counter()\n        try:\n            if self.config.provider == \"ollama\":\n                response = self._query_ollama(prompt, system)\n            elif self.config.provider == \"openai\":\n                response = self._query_openai(prompt, system)\n            elif self.config.provider == \"anthropic\":\n                response = self._query_anthropic(prompt, system)\n            else:\n                response = LLMResponse(content=\"\", model=self.config.model, error=f\"Unknown provider: {self.config.provider}\")\n\n            # Clean thinking tags from response (for reasoning models like DeepSeek-R1, QwQ)\n            if response.content:\n                response.content = self._clean_thinking_tags(response.content)\n\n            # Add timing to response\n            elapsed_ms = (time.perf_counter() - start_time) * 1000\n            response.latency_ms = round(elapsed_ms, 2)\n\n            # Auto-record token usage if metrics collector provided\n            if self.metrics:\n                self.metrics.record_llm_call(response)\n\n            return response\n        except Exception as e:\n            elapsed_ms = (time.perf_counter() - start_time) * 1000\n            # Extract more detailed error information for HTTP errors\n            error_msg = str(e)\n            if hasattr(e, 'response') and hasattr(e.response, 'status_code'):\n                # httpx.HTTPStatusError\n                status_code = e.response.status_code\n                try:\n                    error_detail = e.response.text[:200] if hasattr(e.response, 'text') else \"\"\n                    if error_detail:\n                        error_msg = f\"Server error '{status_code}' for url '{getattr(e.response, 'url', 'unknown')}': {error_detail}\"\n                    else:\n                        error_msg = f\"Server error '{status_code}' for url '{getattr(e.response, 'url', 'unknown')}'\"\n                except Exception:\n                    error_msg = f\"Server error '{status_code}' for url '{getattr(e.response, 'url', 'unknown')}'\"\n\n            # Only log at warning level to reduce noise - individual components will handle their own error messages\n            logger.debug(f\"LLM query failed: {error_msg}\")\n            return LLMResponse(content=\"\", model=self.config.model, error=error_msg, latency_ms=round(elapsed_ms, 2))\n\n    def _query_ollama(self, prompt: str, system: Optional[str]) -> LLMResponse:\n        \"\"\"Query Ollama API.\"\"\"\n        from ..logging_config import get_llm_logger\n        llm_logger = get_llm_logger()\n\n        client = self._get_client()\n\n        messages = []\n        if system:\n            messages.append({\"role\": \"system\", \"content\": system})\n        messages.append({\"role\": \"user\", \"content\": prompt})\n\n        url = f\"{self.config.base_url}/api/chat\"\n        body = {\n            \"model\": self.config.model,\n            \"messages\": messages,\n            \"stream\": False,\n            \"options\": {\n                \"temperature\": self.config.temperature,\n                \"num_predict\": self.config.max_tokens,\n                \"num_ctx\": self.config.context_length,\n            },\n        }\n\n        # Add think parameter if specified (Ollama API expects it at top level)\n        if self.config.think is not None:\n            body[\"think\"] = self.config.think\n\n        llm_logger.log_request(\n            url=url,\n            method=\"POST\",\n            headers={\"Content-Type\": \"application/json\"},\n            body=body,\n            provider=\"ollama\",\n            model=self.config.model,\n        )\n\n        start_time = time.perf_counter()\n        response = client.post(\"/api/chat\", json=body)\n        latency_ms = (time.perf_counter() - start_time) * 1000\n\n        # Check for HTTP errors and provide detailed error information\n        if response.is_error:\n            error_body = \"\"\n            try:\n                error_body = response.text[:500]  # Limit error body size\n            except Exception:\n                pass","numLines":200,"startLine":0,"totalLines":524}}}
