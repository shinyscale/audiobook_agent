ow_confidence),\\\\n   534→                \\\\\\\"confidence_threshold\\\\\\\": self.confidence_threshold,\\\\n   535→                \\\\\\\"used_llm_aliases\\\\\\\": self.use_llm_alias_resolution,\\\\n   536→            },\\\\n   537→        )\\\\n   538→\\\\n   539→    def _group_by_name(\\\\n   540→        self,\\\\n   541→        results: list[CharacterValidationResult],\\\\n   542→    ) -> dict[str, list[CharacterValidationResult]]:\\\\n   543→        \\\\\\\"\\\\\\\"\\\\\\\"Group validation results by character name.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n   544→        groups = defaultdict(list)\\\\n   545→        for result in results:\\\\n   546→            groups[result.proposal.name].append(result)\\\\n   547→        return dict(groups)\\\\n   548→\\\\n   549→    def _heuristic_alias_resolution(\\\\n   550→        self,\\\\n   551→        name_groups: dict[str, list[CharacterValidationResult]],\\\\n   552→        all_results: list[CharacterValidationResult],\\\\n   553→    ) -> dict[str, list[str]]:\\\\n   554→        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n   555→        Resolve aliases using heuristics.\\\\n   556→\\\\n   557→        Returns dict mapping canonical name to list of aliases.\\\\n   558→        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n   559→        # Start with each name as its own group\\\\n   560→        alias_map = {name: set() for name in name_groups.keys()}\\\\n   561→\\\\n   562→        # Collect alias candidates from validation\\\\n   563→        alias_candidates = defaultdict(set)\\\\n   564→        for result in all_results:\\\\n   565→            name = result.proposal.name\\\\n   566→            for candidate in result.alias_candidates:\\\\n   567→                alias_candidates[name].add(candidate)\\\\n   568→\\\\n   569→        names = list(name_groups.keys())\\\\n   570→\\\\n   571→        # Find matches based on name components\\\\n   572→        for i, name1 in enumerate(names):\\\\n   573→            for name2 in names[i + 1:]:\\\\n   574→              