          if not response.success:\n   241→                last_error = f\"LLM query failed: {response.error}\"\n   242→                logger.warning(f\"LLM validation attempt {attempt + 1} for '{proposal.name}' failed: {last_error}\")\n   243→                if attempt < max_retries:\n   244→                    time.sleep(2 ** attempt)  # Exponential backoff: 1s, 2s, 4s\n   245→                    continue\n   246→                else:\n   247→                    raise ValueError(f\"LLM validation failed for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\")\n   248→\n   249→            if result is None or not isinstance(result, dict):\n   250→                error_detail = f\"got {type(result).__name__}\" if result is not None else \"failed to parse JSON\"\n   251→                last_error = f\"Invalid JSON: {error_detail}\"\n   252→                logger.warning(f\"LLM validation attempt {attempt + 1} for '{proposal.name}' returned invalid JSON: {error_detail}\")\n   253→                if attempt < max_retries:\n   254→                    time.sleep(2 ** attempt)\n   255→                    continue\n   256→                else:\n   257→                    raise ValueError(f\"LLM validation returned invalid JSON for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\")\n   258→\n   259→            # Success - parse LLM response\n   260→            break\n   261→\n   262→        # Parse LLM response\n   263→        is_person = result.get(\"is_person\", True)\n   264→        is_person_score = 0.9 if is_person else 0.1\n   265→        # F14: Warn when LLM doesn't return context_supports score\n   266→        context_supports_raw = result.get(\"context_supports\")\n   267→        if context_supports_raw is None:\n   268→            logger.warning(\n   269→                f\"LLM validation for '{proposal.name}' did not return context_supports - \"\n   270→                \"using neutral default 0.5\"\n   271→            )\n   272→   