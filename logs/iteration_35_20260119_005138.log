e[[str, int, int], None]] = None,\n   143→        orchestrator_config: Optional[OrchestratorConfig] = None,\n   144→    ):\n   145→        self.words_per_minute = words_per_minute\n   146→        self.min_character_mentions = min_character_mentions\n   147→        self.llm_refine = llm_refine\n   148→        self.llm_model = llm_model\n   149→        self.llm_base_url = llm_base_url or \"http://localhost:11434\"\n   150→        self.llm_provider = llm_provider\n   151→        self.llm_api_key = llm_api_key\n   152→        self.llm_context_length = llm_context_length\n   153→        self.llm_prompts = llm_prompts\n   154→        self.ocr_fallback = ocr_fallback\n   155→        self.write_canonical_md = write_canonical_md\n   156→        self.output_dir = Path(output_dir) if output_dir else None\n   157→        self.progress_callback = progress_callback\n   158→        self.orchestrator_config = orchestrator_config\n   159→\n   160→        # LLM client (created on first use)\n   161→        self._llm_client: Optional[LLMClient] = None\n   162→        # Agent-specific LLM clients cache\n   163→        self._agent_llm_clients: dict[str, LLMClient] = {}\n   164→\n   165→        # Analysis timing (set after each analyze() call)\n   166→        self._last_analysis_duration: Optional[float] = None\n   167→\n   168→        # Metrics collector for profiling\n   169→        self._metrics = MetricsCollector()\n   170→        self._last_profiling_report: Optional[ProfilingReport] = None\n   171→\n   172→        # Halt report (set if pipeline halted due to validation failure)\n   173→        self._last_halt_report: Optional[PipelineHaltReport] = None\n   174→\n   175→        # Quality report and per-run output directory\n   176→        self._last_quality_report: Optional[QualityReport] = None\n   177→        self._last_run_dir: Optional[Path] = None\n   178→\n   179→    def _get_llm_client(self) -> Optional[LLMClient]:\n   180→        \"\"\"Get or create LLM client.\"\"\"\n   181