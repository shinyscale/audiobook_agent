05.log\",\"logs/iteration_31_20260118_185639.log\",\"logs/iteration_30_20260118_185614.log\",\"logs/iteration_29_20260118_185547.log\",\"logs/iteration_28_20260118_185529.log\",\"logs/iteration_27_20260118_185505.log\",\"logs/iteration_26_20260118_185442.log\",\"logs/iteration_25_20260118_185419.log\",\"logs/iteration_24_20260118_185355.log\",\"logs/iteration_23_20260118_185326.log\",\"logs/iteration_22_20260118_185303.log\",\"logs/iteration_21_20260118_185237.log\",\"logs/iteration_20_20260118_185158.log\",\"logs/iteration_19_20260118_185128.log\",\"logs/iteration_18_20260118_185107.log\",\"logs/iteration_17_20260118_185044.log\",\"logs/iteration_16_20260118_185013.log\",\"logs/iteration_15_20260118_184948.log\",\"logs/iteration_14_20260118_184921.log\",\"logs/iteration_13_20260118_183042.log\",\"logs/iteration_12_20260118_181823.log\",\"logs/iteration_11_20260118_181749.log\",\"logs/iteration_10_20260118_181125.log\",\"logs/iteration_9_20260118_175841.log\",\"logs/iteration_8_20260118_175559.log\",\"logs/iteration_7_20260118_174945.log\",\"logs/iteration_6_20260118_174441.log\",\"logs/iteration_3_20260118_171458.log\"],\"numFiles\":71}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-4-5-20250929\",\"id\":\"msg_01QP9xLjo3wzk5X7BXy3jD8r\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Let me read the validator code:\"}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":848,\"cache_creation_input_tokens\":1337,\"cache_read_input_tokens\":34676,\"cache_creation\":{\"ephemeral_5m_input_tokens\":1337,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":1,\"service_tier\":\"standard\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"aa5f2c10-d3e6-4a5e-b1a9-e6f755891dd5\",\"uuid\":\"5fbc930f-3476-4a1b-bc91-cb7e9e7c104b\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-4-5-20250929\",\"id\":\"msg_01QP9xLjo3wzk5X7BXy3jD8r\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01Wpz1MnUivC4qMyc3D84X9q\",\"name\":\"Read\",\"input\":{\"file_path\":\"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/validator.py\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":848,\"cache_creation_input_tokens\":1337,\"cache_read_input_tokens\":34676,\"cache_creation\":{\"ephemeral_5m_input_tokens\":1337,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":1,\"service_tier\":\"standard\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"aa5f2c10-d3e6-4a5e-b1a9-e6f755891dd5\",\"uuid\":\"0c36121e-f1c6-403e-ae43-27f8194cee14\"}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Wpz1MnUivC4qMyc3D84X9q\",\"type\":\"tool_result\",\"content\":\"     1→\\\"\\\"\\\"\\n     2→Character proposal validator.\\n     3→\\n     4→Validates character proposals and identifies potential aliases.\\n     5→\\\"\\\"\\\"\\n     6→\\n     7→import re\\n     8→import time\\n     9→from typing import Optional\\n    10→import logging\\n    11→\\n    12→from .models import CharacterProposal, CharacterValidationResult\\n    13→from .constants import NICKNAME_MAP\\n    14→from ..llm import LLMClient\\n    15→\\n    16→logger = logging.getLogger(__name__)\\n    17→\\n    18→\\n    19→# Known non-person entities that might be detected as characters\\n    20→PLACE_NAMES = {\\n    21→    'london', 'paris', 'new york', 'england', 'america', 'france', 'germany',\\n    22→    'broadway', 'manhattan',\\n    23→}\\n    24→\\n    25→# Common food/beverage names that NER might misidentify as characters\\n    26→FOOD_BEVERAGE_NAMES = {\\n    27→    'amontillado', 'sherry', 'wine', 'champagne', 'brandy', 'whiskey', 'bourbon',\\n    28→    'tea', 'coffee', 'water', 'milk', 'beer', 'ale', 'porter', 'rum', 'gin',\\n    29→    'bread', 'cheese', 'meat', 'fish', 'cake', 'pie', 'soup', 'stew',\\n    30→}\\n    31→\\n    32→TITLE_ONLY_PATTERN = re.compile(\\n    33→    r'^(mr|mrs|ms|miss|dr|sir|lady|lord|captain|colonel|general|'\\n    34→    r'professor|doctor|king|queen|prince|princess|duke|duchess)\\\\.?$',\\n    35→    re.IGNORECASE\\n    36→)\\n    37→\\n    38→# Words that indicate character context\\n    39→CHARACTER_VERBS = {\\n    40→    'said', 'asked', 'replied', 'whispered', 'shouted', 'muttered',\\n    41→    'thought', 'wondered', 'felt', 'looked', 'smiled', 'laughed',\\n    42→    'walked', 'ran', 'stood', 'sat', 'turned', 'nodded',\\n    43→}\\n    44→\\n    45→\\n    46→VALIDATION_SYSTEM_PROMPT = \\\"\\\"\\\"You are a literary analyst validating character names.\\n    47→\\n    48→Your task is to determine if a proposed name refers to a real character (person) in the story,\\n    49→and identify other names that might refer to the same person.\\n    50→\\n    51→Consider:\\n    52→- Is this a person's name (not a place, title alone, object, food/drink, or abstract concept)?\\n    53→- Does the context suggest this is a character who acts, speaks, or is spoken about?\\n    54→- What other names/titles might refer to the same person?\\n    55→\\n    56→CRITICAL: Reject names that refer to:\\n    57→- Objects, items, or things (e.g., wine, books, weapons, artifacts)\\n    58→- Food or beverages\\n    59→- Places or locations\\n    60→- Abstract concepts or ideas\\n    61→- Titles without names\\\"\\\"\\\"\\n    62→\\n    63→\\n    64→VALIDATION_PROMPT_TEMPLATE = \\\"\\\"\\\"Validate this character proposal from a novel:\\n    65→\\n    66→PROPOSED NAME: {name}\\n    67→STRATEGY: {strategy}\\n    68→MENTION COUNT: {mention_count}\\n    69→\\n    70→SAMPLE CONTEXTS (where this name appears):\\n    71→{contexts}\\n    72→\\n    73→Analyze the contexts carefully. Ask yourself:\\n    74→1. Is \\\"{name}\\\" a PERSON's name, or is it an object/item/place/concept?\\n    75→2. If people are talking ABOUT \\\"{name}\\\" (e.g., \\\"the Amontillado\\\", \\\"some Amontillado\\\"), is it something they're discussing rather than someone they're addressing?\\n    76→3. Do the contexts show \\\"{name}\\\" performing human actions (speaking, thinking, moving) or being acted upon as an object?\\n    77→\\n    78→Please return JSON with:\\n    79→- \\\"is_person\\\": true/false - Is this a real person/character name (NOT an object, food, drink, place, or concept)?\\n    80→- \\\"is_person_reasoning\\\": Brief explanation of why this is or isn't a person\\n    81→- \\\"context_supports\\\": 0.0-1.0 - How strongly does the context support this being a character?\\n    82→- \\\"alias_candidates\\\": List of other names that might refer to the same person (e.g., \\\"Elizabeth\\\" -> [\\\"Lizzy\\\", \\\"Miss Bennet\\\"])\\n    83→- \\\"overall_valid\\\": true/false - Should we include this as a character?\\n    84→\\n    85→Return ONLY valid JSON.\\\"\\\"\\\"\\n    86→\\n    87→\\n    88→class CharacterValidator:\\n    89→    \\\"\\\"\\\"\\n    90→    Validates character proposals using heuristics and LLM.\\n    91→\\n    92→    Uses fast heuristics for clear cases, LLM for ambiguous ones.\\n    93→    \\\"\\\"\\\"\\n    94→\\n    95→    def __init__(\\n    96→        self,\\n    97→        llm_client: Optional[LLMClient] = None,\\n    98→        min_confidence: float = 0.5,\\n    99→        use_llm_validation: bool = True,\\n   100→    ):\\n   101→        \\\"\\\"\\\"\\n   102→        Args:\\n   103→            llm_client: LLM client for ambiguous cases\\n   104→            min_confidence: Minimum score to consider valid\\n   105→            use_llm_validation: Whether to use LLM for validation\\n   106→        \\\"\\\"\\\"\\n   107→        self.llm = llm_client\\n   108→        self.min_confidence = min_confidence\\n   109→        self.use_llm_validation = use_llm_validation and llm_client is not None\\n   110→\\n   111→    def validate(self, proposal: CharacterProposal) -> CharacterValidationResult:\\n   112→        \\\"\\\"\\\"Validate a single character proposal.\\\"\\\"\\\"\\n   113→        # Quick heuristic checks\\n   114→        heuristic_result = self._heuristic_validation(proposal)\\n   115→\\n   116→        if heuristic_result is not None:\\n   117→            return heuristic_result\\n   118→\\n   119→        # Use LLM for ambiguous cases\\n   120→        if self.use_llm_validation:\\n   121→            return self._llm_validation(proposal)\\n   122→\\n   123→        # No LLM validation available - fail fast instead of using fallback confidence\\n   124→        error_msg = f\\\"LLM validation is required but not enabled for proposal '{proposal.name}'\\\"\\n   125→        logger.error(error_msg)\\n   126→        raise ValueError(error_msg)\\n   127→\\n   128→    def validate_batch(\\n   129→        self,\\n   130→        proposals: list[CharacterProposal],\\n   131→    ) -> list[CharacterValidationResult]:\\n   132→        \\\"\\\"\\\"Validate multiple proposals.\\\"\\\"\\\"\\n   133→        return [self.validate(p) for p in proposals]\\n   134→\\n   135→    def _heuristic_validation(\\n   136→        self,\\n   137→        proposal: CharacterProposal,\\n   138→    ) -> Optional[CharacterValidationResult]:\\n   139→        \\\"\\\"\\\"\\n   140→        Apply fast heuristic checks.\\n   141→\\n   142→        Returns ValidationResult if we can determine validity,\\n   143→        None if LLM validation is needed.\\n   144→        \\\"\\\"\\\"\\n   145→        name = proposal.name\\n   146→        name_lower = name.lower()\\n   147→\\n   148→        # Reject: known places\\n   149→        if name_lower in PLACE_NAMES:\\n   150→            return CharacterValidationResult(\\n   151→                proposal=proposal,\\n   152→                is_person_score=0.0,\\n   153→                context_score=0.0,\\n   154→                alias_candidates=[],\\n   155→                overall_score=0.0,\\n   156→                is_valid=False,\\n   157→                reasoning=f\\\"'{name}' is a known place name\\\",\\n   158→            )\\n   159→\\n   160→        # Reject: known food/beverage names\\n   161→        if name_lower in FOOD_BEVERAGE_NAMES:\\n   162→            return CharacterValidationResult(\\n   163→                proposal=proposal,\\n   164→                is_person_score=0.0,\\n   165→                context_score=0.0,\\n   166→                alias_candidates=[],\\n   167→                overall_score=0.0,\\n   168→                is_valid=False,\\n   169→                reasoning=f\\\"'{name}' is a food or beverage, not a character\\\",\\n   170→            )\\n   171→\\n   172→        # Reject: title only (no actual name)\\n   173→        if TITLE_ONLY_PATTERN.match(name):\\n   174→            return CharacterValidationResult(\\n   175→                proposal=proposal,\\n   176→                is_person_score=0.0,\\n   177→                context_score=0.0,\\n   178→                alias_candidates=[],\\n   179→                overall_score=0.0,\\n   180→                is_valid=False,\\n   181→                reasoning=f\\\"'{name}' is a title without a name\\\",\\n   182→            )\\n   183→\\n   184→        # Removed overly aggressive heuristic - high mention count alone doesn't guarantee character\\n   185→        # Objects, food, drinks can also be mentioned frequently in dialogue\\n   186→        # Let LLM validation handle these ambiguous cases\\n   187→\\n   188→        dialogue_mentions = sum(1 for m in proposal.mentions if m.in_dialogue)\\n   189→\\n   190→        # Accept: appears in dialogue tags (said X, asked X)\\n   191→        dialogue_tag_count = self._count_dialogue_tags(proposal)\\n   192→        if dialogue_tag_count >= 2:\\n   193→            alias_candidates = self._find_obvious_aliases(proposal)\\n   194→            return CharacterValidationResult(\\n   195→                proposal=proposal,\\n   196→                is_person_score=0.9,\\n   197→                context_score=0.85,\\n   198→                alias_candidates=alias_candidates,\\n   199→                overall_score=0.87,\\n   200→                is_valid=True,\\n   201→                reasoning=f\\\"Appears in {dialogue_tag_count} dialogue tags (said/asked/replied)\\\",\\n   202→            )\\n   203→\\n   204→        # Accept: titled name (Mr. Smith, Mrs. Jones)\\n   205→        if re.match(r'^(Mr|Mrs|Ms|Miss|Dr|Sir|Lady|Lord)\\\\.?\\\\s+\\\\w+', name):\\n   206→            alias_candidates = self._find_obvious_aliases(proposal)\\n   207→            return CharacterValidationResult(\\n   208→                proposal=proposal,\\n   209→                is_person_score=0.85,\\n   210→                context_score=0.8,\\n   211→                alias_candidates=alias_candidates,\\n   212→                overall_score=0.82,\\n   213→                is_valid=True,\\n   214→                reasoning=f\\\"Titled name pattern suggests person\\\",\\n   215→            )\\n   216→\\n   217→        # Reject: single mention, no dialogue\\n   218→        if proposal.mention_count == 1 and dialogue_mentions == 0:\\n   219→            # Check context for character verbs\\n   220→            context = proposal.mentions[0].context.lower() if proposal.mentions else \\\"\\\"\\n   221→            has_character_verb = any(verb in context for verb in CHARACTER_VERBS)\\n   222→\\n   223→            if not has_character_verb:\\n   224→                return CharacterValidationResult(\\n   225→                    proposal=proposal,\\n   226→                    is_person_score=0.3,\\n   227→                    context_score=0.2,\\n   228→                    alias_candidates=[],\\n   229→                    overall_score=0.25,\\n   230→                    is_valid=False,\\n   231→                    reasoning=\\\"Single mention without dialogue or character verbs\\\",\\n   232→                )\\n   233→\\n   234→        # Ambiguous: need LLM validation\\n   235→        return None\\n   236→\\n   237→    def _llm_validation(self, proposal: CharacterProposal) -> CharacterValidationResult:\\n   238→        \\\"\\\"\\\"Use LLM to validate ambiguous cases.\\\"\\\"\\\"\\n   239→        # Prepare sample contexts\\n   240→        contexts = []\\n   241→        for mention in proposal.mentions[:5]:  # Up to 5 examples\\n   242→            context_preview = mention.context[:200] if len(mention.context) > 200 else mention.context\\n   243→            dialogue_marker = \\\"[in dialogue]\\\" if mention.in_dialogue else \\\"[narrative]\\\"\\n   244→            contexts.append(f\\\"  {dialogue_marker} ...{context_preview}...\\\")\\n   245→\\n   246→        contexts_str = \\\"\\\\n\\\".join(contexts)\\n   247→\\n   248→        prompt = VALIDATION_PROMPT_TEMPLATE.format(\\n   249→            name=proposal.name,\\n   250→            strategy=proposal.strategy,\\n   251→            mention_count=proposal.mention_count,\\n   252→            contexts=contexts_str,\\n   253→        )\\n   254→\\n   255→        # Retry logic with exponential backoff\\n   256→        max_retries = 2\\n   257→        last_error = None\\n   258→\\n   259→        for attempt in range(max_retries + 1):\\n   260→            result, response = self.llm.query_json(prompt, system=VALIDATION_SYSTEM_PROMPT)\\n   261→\\n   262→            if not response.success:\\n   263→                last_error = f\\\"LLM query failed: {response.error}\\\"\\n   264→                logger.warning(f\\\"LLM validation attempt {attempt + 1} for '{proposal.name}' failed: {last_error}\\\")\\n   265→                if attempt < max_retries:\\n   266→                    time.sleep(2 ** attempt)  # Exponential backoff: 1s, 2s, 4s\\n   267→                    continue\\n   268→                else:\\n   269→                    raise ValueError(f\\\"LLM validation failed for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\\\")\\n   270→\\n   271→            if result is None or not isinstance(result, dict):\\n   272→                error_detail = f\\\"got {type(result).__name__}\\\" if result is not None else \\\"failed to parse JSON\\\"\\n   273→                last_error = f\\\"Invalid JSON: {error_detail}\\\"\\n   274→                logger.warning(f\\\"LLM validation attempt {attempt + 1} for '{proposal.name}' returned invalid JSON: {error_detail}\\\")\\n   275→                if attempt < max_retries:\\n   276→                    time.sleep(2 ** attempt)\\n   277→                    continue\\n   278→                else:\\n   279→                    raise ValueError(f\\\"LLM validation returned invalid JSON for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\\\")\\n   280→\\n   281→            # Success - parse LLM response\\n   282→            break\\n   283→\\n   284→        # Parse LLM response\\n   285→        is_person = result.get(\\\"is_person\\\", True)\\n   286→        is_person_score = 0.9 if is_person else 0.1\\n   287→        # F14: Warn when LLM doesn't return context_supports score\\n   288→        context_supports_raw = result.get(\\\"context_supports\\\")\\n   289→        if context_supports_raw is None:\\n   290→            logger.warning(\\n   291→                f\\\"LLM validation for '{proposal.name}' did not return context_supports - \\\"\\n   292→                \\\"using neutral default 0.5\\\"\\n   293→            )\\n   294→            context_score = 0.5\\n   295→        else:\\n   296→            context_score = float(context_supports_raw)\\n   297→        alias_candidates = result.get(\\\"alias_candidates\\\", [])\\n   298→        overall_valid = result.get(\\\"overall_valid\\\", is_person)\\n   299→        reasoning = result.get(\\\"is_person_reasoning\\\", \\\"LLM validation\\\")\\n   300→\\n   301→        # F16: Include mention count in overall_score calculation\\n   302→        # High-mention characters should get higher confidence scores\\n   303→        base_score = (is_person_score + context_score) / 2\\n   304→\\n   305→        # Mention count boost: characters with many mentions are more likely real\\n   306→        mention_count = proposal.mention_count\\n   307→        if mention_count >= 100:\\n   308→            mention_boost = 0.15\\n   309→        elif mention_count >= 50:\\n   310→            mention_boost = 0.10\\n   311→        elif mention_count >= 20:\\n   312→            mention_boost = 0.05\\n   313→        elif mention_count >= 10:\\n   314→            mention_boost = 0.02\\n   315→        else:\\n   316→            mention_boost = 0.0\\n   317→\\n   318→        overall_score = min(1.0, base_score + mention_boost)\\n   319→\\n   320→        logger.debug(\\n   321→            f\\\"Validation score for '{proposal.name}': base={base_score:.2f}, \\\"\\n   322→            f\\\"mention_boost={mention_boost:.2f} ({mention_count} mentions), \\\"\\n   323→            f\\\"final={overall_score:.2f}\\\"\\n   324→        )\\n   325→\\n   326→        return CharacterValidationResult(\\n   327→            proposal=proposal,\\n   328→            is_person_score=is_person_score,\\n   329→            context_score=context_score,\\n   330→            alias_candidates=alias_candidates,\\n   331→            overall_score=overall_score,\\n   332→            is_valid=overall_valid and overall_score >= self.min_confidence,\\n   333→            reasoning=reasoning,\\n   334→        )\\n   335→\\n   336→    def _count_dialogue_tags(self, proposal: CharacterProposal) -> int:\\n   337→        \\\"\\\"\\\"Count how often the name appears in dialogue tags.\\\"\\\"\\\"\\n   338→        count = 0\\n   339→        name_pattern = re.escape(proposal.name)\\n   340→\\n   341→        # Patterns like: said Nick, asked Gatsby, replied Jordan\\n   342→        tag_patterns = [\\n   343→            rf'said\\\\s+{name_pattern}',\\n   344→            rf'asked\\\\s+{name_pattern}',\\n   345→            rf'replied\\\\s+{name_pattern}',\\n   346→            rf'whispered\\\\s+{name_pattern}',\\n   347→            rf'shouted\\\\s+{name_pattern}',\\n   348→            rf'{name_pattern}\\\\s+said',\\n   349→            rf'{name_pattern}\\\\s+asked',\\n   350→            rf'{name_pattern}\\\\s+replied',\\n   351→        ]\\n   352→\\n   353→        for mention in proposal.mentions:\\n   354→            context = mention.context\\n   355→            for pattern in tag_patterns:\\n   356→                if re.search(pattern, context, re.IGNORECASE):\\n   357→                    count += 1\\n   358→                    break  # Count each mention only once\\n   359→\\n   360→        return count\\n   361→\\n   362→    def _find_obvious_aliases(self, proposal: CharacterProposal) -> list[str]:\\n   363→        \\\"\\\"\\\"Find obvious alias candidates based on the name.\\\"\\\"\\\"\\n   364→        aliases = []\\n   365→        name = proposal.name\\n   366→\\n   367→        # Extract first and last name\\n   368→        parts = name.split()\\n   369→\\n   370→        if len(parts) >= 2:\\n   371→            first_name = parts[0]\\n   372→            last_name = parts[-1]\\n   373→\\n   374→            # Handle titles\\n   375→            if first_name.lower().rstrip('.') in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\\n   376→                if len(parts) >= 3:\\n   377→                    first_name = parts[1]\\n   378→                    last_name = parts[-1]\\n   379→                else:\\n   380→                    first_name = None\\n   381→                    last_name = parts[-1]\\n   382→\\n   383→            if first_name:\\n   384→                aliases.append(first_name)\\n   385→\\n   386→            # NOTE: We do NOT generate phantom titled versions here (e.g., \\\"Mr. LastName\\\")\\n   387→            # because they may not exist in the text. The consensus stage, which has access\\n   388→            # to all character names, will handle alias detection with the LLM's help.\\n   389→            # Generating phantom aliases pollutes the system and wastes LLM tokens.\\n   390→\\n   391→        # Use shared nickname map from constants module\\n   392→        name_lower = name.lower()\\n   393→        for full_name, nicknames in NICKNAME_MAP.items():\\n   394→            if full_name in name_lower:\\n   395→                aliases.extend([n.title() for n in nicknames])\\n   396→            elif any(nick in name_lower for nick in nicknames):\\n   397→                aliases.append(full_name.title())\\n   398→\\n   399→        return list(set(aliases))\\n   400→\\n\\n<system-reminder>\\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\\n</system-reminder>\\n\"}]},\"parent_tool_use_id\":null,\"session_id\":\"aa5f2c10-d3e6-4a5e-b1a9-e6f755891dd5\",\"uuid\":\"4aa9902b-fd7a-4694-96b9-ae4d43313980\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/validator.py\",\"content\":\"\\\"\\\"\\\"\\nCharacter proposal validator.\\n\\nValidates character proposals and identifies potential aliases.\\n\\\"\\\"\\\"\\n\\nimport re\\nimport time\\nfrom typing import Optional\\nimport logging\\n\\nfrom .models import CharacterProposal, CharacterValidationResult\\nfrom .constants import NICKNAME_MAP\\nfrom ..llm import LLMClient\\n\\nlogger = logging.getLogger(__name__)\\n\\n\\n# Known non-person entities that might be detected as characters\\nPLACE_NAMES = {\\n    'london', 'paris', 'new york', 'england', 'america', 'france', 'germany',\\n    'broadway', 'manhattan',\\n}\\n\\n# Common food/beverage names that NER might misidentify as characters\\nFOOD_BEVERAGE_NAMES = {\\n    'amontillado', 'sherry', 'wine', 'champagne', 'brandy', 'whiskey', 'bourbon',\\n    'tea', 'coffee', 'water', 'milk', 'beer', 'ale', 'porter', 'rum', 'gin',\\n    'bread', 'cheese', 'meat', 'fish', 'cake', 'pie', 'soup', 'stew',\\n}\\n\\nTITLE_ONLY_PATTERN = re.compile(\\n    r'^(mr|mrs|ms|miss|dr|sir|lady|lord|captain|colonel|general|'\\n    r'professor|doctor|king|queen|prince|princess|duke|duchess)\\\\.?$',\\n    re.IGNORECASE\\n)\\n\\n# Words that indicate character context\\nCHARACTER_VERBS = {\\n    'said', 'asked', 'replied', 'whispered', 'shouted', 'muttered',\\n    'thought', 'wondered', 'felt', 'looked', 'smiled', 'laughed',\\n    'walked', 'ran', 'stood', 'sat', 'turned', 'nodded',\\n}\\n\\n\\nVALIDATION_SYSTEM_PROMPT = \\\"\\\"\\\"You are a literary analyst validating character names.\\n\\nYour task is to determine if a proposed name refers to a real character (person) in the story,\\nand identify other names that might refer to the same person.\\n\\nConsider:\\n- Is this a person's name (not a place, title alone, object, food/drink, or abstract concept)?\\n- Does the context suggest this is a character who acts, speaks, or is spoken about?\\n- What other names/titles might refer to the same person?\\n\\nCRITICAL: Reject names that refer to:\\n- Objects, items, or things (e.g., wine, books, weapons, artifacts)\\n- Food or beverages\\n- Places or locations\\n- Abstract concepts or ideas\\n- Titles without names\\\"\\\"\\\"\\n\\n\\nVALIDATION_PROMPT_TEMPLATE = \\\"\\\"\\\"Validate this character proposal from a novel:\\n\\nPROPOSED NAME: {name}\\nSTRATEGY: {strategy}\\nMENTION COUNT: {mention_count}\\n\\nSAMPLE CONTEXTS (where this name appears):\\n{contexts}\\n\\nAnalyze the contexts carefully. Ask yourself:\\n1. Is \\\"{name}\\\" a PERSON's name, or is it an object/item/place/concept?\\n2. If people are talking ABOUT \\\"{name}\\\" (e.g., \\\"the Amontillado\\\", \\\"some Amontillado\\\"), is it something they're discussing rather than someone they're addressing?\\n3. Do the contexts show \\\"{name}\\\" performing human actions (speaking, thinking, moving) or being acted upon as an object?\\n\\nPlease return JSON with:\\n- \\\"is_person\\\": true/false - Is this a real person/character name (NOT an object, food, drink, place, or concept)?\\n- \\\"is_person_reasoning\\\": Brief explanation of why this is or isn't a person\\n- \\\"context_supports\\\": 0.0-1.0 - How strongly does the context support this being a character?\\n- \\\"alias_candidates\\\": List of other names that might refer to the same person (e.g., \\\"Elizabeth\\\" -> [\\\"Lizzy\\\", \\\"Miss Bennet\\\"])\\n- \\\"overall_valid\\\": true/false - Should we include this as a character?\\n\\nReturn ONLY valid JSON.\\\"\\\"\\\"\\n\\n\\nclass CharacterValidator:\\n    \\\"\\\"\\\"\\n    Validates character proposals using heuristics and LLM.\\n\\n    Uses fast heuristics for clear cases, LLM for ambiguous ones.\\n    \\\"\\\"\\\"\\n\\n    def __init__(\\n        self,\\n        llm_client: Optional[LLMClient] = None,\\n        min_confidence: float = 0.5,\\n        use_llm_validation: bool = True,\\n    ):\\n        \\\"\\\"\\\"\\n        Args:\\n            llm_client: LLM client for ambiguous cases\\n            min_confidence: Minimum score to consider valid\\n            use_llm_validation: Whether to use LLM for validation\\n        \\\"\\\"\\\"\\n        self.llm = llm_client\\n        self.min_confidence = min_confidence\\n        self.use_llm_validation = use_llm_validation and llm_client is not None\\n\\n    def validate(self, proposal: CharacterProposal) -> CharacterValidationResult:\\n        \\\"\\\"\\\"Validate a single character proposal.\\\"\\\"\\\"\\n        # Quick heuristic checks\\n        heuristic_result = self._heuristic_validation(proposal)\\n\\n        if heuristic_result is not None:\\n            return heuristic_result\\n\\n        # Use LLM for ambiguous cases\\n        if self.use_llm_validation:\\n            return self._llm_validation(proposal)\\n\\n        # No LLM validation available - fail fast instead of using fallback confidence\\n        error_msg = f\\\"LLM validation is required but not enabled for proposal '{proposal.name}'\\\"\\n        logger.error(error_msg)\\n        raise ValueError(error_msg)\\n\\n    def validate_batch(\\n        self,\\n        proposals: list[CharacterProposal],\\n    ) -> list[CharacterValidationResult]:\\n        \\\"\\\"\\\"Validate multiple proposals.\\\"\\\"\\\"\\n        return [self.validate(p) for p in proposals]\\n\\n    def _heuristic_validation(\\n        self,\\n        proposal: CharacterProposal,\\n    ) -> Optional[CharacterValidationResult]:\\n        \\\"\\\"\\\"\\n        Apply fast heuristic checks.\\n\\n        Returns ValidationResult if we can determine validity,\\n        None if LLM validation is needed.\\n        \\\"\\\"\\\"\\n        name = proposal.name\\n        name_lower = name.lower()\\n\\n        # Reject: known places\\n        if name_lower in PLACE_NAMES:\\n            return CharacterValidationResult(\\n                proposal=proposal,\\n                is_person_score=0.0,\\n                context_score=0.0,\\n                alias_candidates=[],\\n                overall_score=0.0,\\n                is_valid=False,\\n                reasoning=f\\\"'{name}' is a known place name\\\",\\n            )\\n\\n        # Reject: known food/beverage names\\n        if name_lower in FOOD_BEVERAGE_NAMES:\\n            return CharacterValidationResult(\\n                proposal=proposal,\\n                is_person_score=0.0,\\n                context_score=0.0,\\n                alias_candidates=[],\\n                overall_score=0.0,\\n                is_valid=False,\\n                reasoning=f\\\"'{name}' is a food or beverage, not a character\\\",\\n            )\\n\\n        # Reject: title only (no actual name)\\n        if TITLE_ONLY_PATTERN.match(name):\\n            return CharacterValidationResult(\\n                proposal=proposal,\\n                is_person_score=0.0,\\n                context_score=0.0,\\n                alias_candidates=[],\\n                overall_score=0.0,\\n                is_valid=False,\\n                reasoning=f\\\"'{name}' is a title without a name\\\",\\n            )\\n\\n        # Removed overly aggressive heuristic - high mention count alone doesn't guarantee character\\n        # Objects, food, drinks can also be mentioned frequently in dialogue\\n        # Let LLM validation handle these ambiguous cases\\n\\n        dialogue_mentions = sum(1 for m in proposal.mentions if m.in_dialogue)\\n\\n        # Accept: appears in dialogue tags (said X, asked X)\\n        dialogue_tag_count = self._count_dialogue_tags(proposal)\\n        if dialogue_tag_count >= 2:\\n            alias_candidates = self._find_obvious_aliases(proposal)\\n            return CharacterValidationResult(\\n                proposal=proposal,\\n                is_person_score=0.9,\\n                context_score=0.85,\\n                alias_candidates=alias_candidates,\\n                overall_score=0.87,\\n                is_valid=True,\\n                reasoning=f\\\"Appears in {dialogue_tag_count} dialogue tags (said/asked/replied)\\\",\\n            )\\n\\n        # Accept: titled name (Mr. Smith, Mrs. Jones)\\n        if re.match(r'^(Mr|Mrs|Ms|Miss|Dr|Sir|Lady|Lord)\\\\.?\\\\s+\\\\w+', name):\\n            alias_candidates = self._find_obvious_aliases(proposal)\\n            return CharacterValidationResult(\\n                proposal=proposal,\\n                is_person_score=0.85,\\n                context_score=0.8,\\n                alias_candidates=alias_candidates,\\n                overall_score=0.82,\\n                is_valid=True,\\n                reasoning=f\\\"Titled name pattern suggests person\\\",\\n            )\\n\\n        # Reject: single mention, no dialogue\\n        if proposal.mention_count == 1 and dialogue_mentions == 0:\\n            # Check context for character verbs\\n            context = proposal.mentions[0].context.lower() if proposal.mentions else \\\"\\\"\\n            has_character_verb = any(verb in context for verb in CHARACTER_VERBS)\\n\\n            if not has_character_verb:\\n                return CharacterValidationResult(\\n                    proposal=proposal,\\n                    is_person_score=0.3,\\n                    context_score=0.2,\\n                    alias_candidates=[],\\n                    overall_score=0.25,\\n                    is_valid=False,\\n                    reasoning=\\\"Single mention without dialogue or character verbs\\\",\\n                )\\n\\n        # Ambiguous: need LLM validation\\n        return None\\n\\n    def _llm_validation(self, proposal: CharacterProposal) -> CharacterValidationResult:\\n        \\\"\\\"\\\"Use LLM to validate ambiguous cases.\\\"\\\"\\\"\\n        # Prepare sample contexts\\n        contexts = []\\n        for mention in proposal.mentions[:5]:  # Up to 5 examples\\n            context_preview = mention.context[:200] if len(mention.context) > 200 else mention.context\\n            dialogue_marker = \\\"[in dialogue]\\\" if mention.in_dialogue else \\\"[narrative]\\\"\\n            contexts.append(f\\\"  {dialogue_marker} ...{context_preview}...\\\")\\n\\n        contexts_str = \\\"\\\\n\\\".join(contexts)\\n\\n        prompt = VALIDATION_PROMPT_TEMPLATE.format(\\n            name=proposal.name,\\n            strategy=proposal.strategy,\\n            mention_count=proposal.mention_count,\\n            contexts=contexts_str,\\n        )\\n\\n        # Retry logic with exponential backoff\\n        max_retries = 2\\n        last_error = None\\n\\n        for attempt in range(max_retries + 1):\\n            result, response = self.llm.query_json(prompt, system=VALIDATION_SYSTEM_PROMPT)\\n\\n            if not response.success:\\n                last_error = f\\\"LLM query failed: {response.error}\\\"\\n                logger.warning(f\\\"LLM validation attempt {attempt + 1} for '{proposal.name}' failed: {last_error}\\\")\\n                if attempt < max_retries:\\n                    time.sleep(2 ** attempt)  # Exponential backoff: 1s, 2s, 4s\\n                    continue\\n                else:\\n                    raise ValueError(f\\\"LLM validation failed for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\\\")\\n\\n            if result is None or not isinstance(result, dict):\\n                error_detail = f\\\"got {type(result).__name__}\\\" if result is not None else \\\"failed to parse JSON\\\"\\n                last_error = f\\\"Invalid JSON: {error_detail}\\\"\\n                logger.warning(f\\\"LLM validation attempt {attempt + 1} for '{proposal.name}' returned invalid JSON: {error_detail}\\\")\\n                if attempt < max_retries:\\n                    time.sleep(2 ** attempt)\\n                    continue\\n                else:\\n                    raise ValueError(f\\\"LLM validation returned invalid JSON for '{proposal.name}' after {max_retries + 1} attempts: {last_error}\\\")\\n\\n            # Success - parse LLM response\\n            break\\n\\n        # Parse LLM response\\n        is_person = result.get(\\\"is_person\\\", True)\\n        is_person_score = 0.9 if is_person else 0.1\\n        # F14: Warn when LLM doesn't return context_supports score\\n        context_supports_raw = result.get(\\\"context_supports\\\")\\n        if context_supports_raw is None:\\n            logger.warning(\\n                f\\\"LLM validation for '{proposal.name}' did not return context_supports - \\\"\\n                \\\"using neutral default 0.5\\\"\\n            )\\n            context_score = 0.5\\n        else:\\n            context_score = float(context_supports_raw)\\n        alias_candidates = result.get(\\\"alias_candidates\\\", [])\\n        overall_valid = result.get(\\\"overall_valid\\\", is_person)\\n        reasoning = result.get(\\\"is_person_reasoning\\\", \\\"LLM validation\\\")\\n\\n        # F16: Include mention count in overall_score calculation\\n        # High-mention characters should get higher confidence scores\\n        base_score = (is_person_score + context_score) / 2\\n\\n        # Mention count boost: characters with many mentions are more likely real\\n        mention_count = proposal.mention_count\\n        if mention_count >= 100:\\n            mention_boost = 0.15\\n        elif mention_count >= 50:\\n            mention_boost = 0.10\\n        elif mention_count >= 20:\\n            mention_boost = 0.05\\n        elif mention_count >= 10:\\n            mention_boost = 0.02\\n        else:\\n            mention_boost = 0.0\\n\\n        overall_score = min(1.0, base_score + mention_boost)\\n\\n        logger.debug(\\n            f\\\"Validation score for '{proposal.name}': base={base_score:.2f}, \\\"\\n            f\\\"mention_boost={mention_boost:.2f} ({mention_count} mentions), \\\"\\n            f\\\"final={overall_score:.2f}\\\"\\n        )\\n\\n        return CharacterValidationResult(\\n            proposal=proposal,\\n            is_person_score=is_person_score,\\n            context_score=context_score,\\n            alias_candidates=alias_candidates,\\n            overall_score=overall_score,\\n            is_valid=overall_valid and overall_score >= self.min_confidence,\\n            reasoning=reasoning,\\n        )\\n\\n    def _count_dialogue_tags(self, proposal: CharacterProposal) -> int:\\n        \\\"\\\"\\\"Count how often the name appears in dialogue tags.\\\"\\\"\\\"\\n        count = 0\\n        name_pattern = re.escape(proposal.name)\\n\\n        # Patterns like: said Nick, asked Gatsby, replied Jordan\\n        tag_patterns = [\\n            rf'said\\\\s+{name_pattern}',\\n            rf'asked\\\\s+{name_pattern}',\\n            rf'replied\\\\s+{name_pattern}',\\n            rf'whispered\\\\s+{name_pattern}',\\n            rf'shouted\\\\s+{name_pattern}',\\n            rf'{name_pattern}\\\\s+said',\\n            rf'{name_pattern}\\\\s+asked',\\n            rf'{name_pattern}\\\\s+replied',\\n        ]\\n\\n        for mention in proposal.mentions:\\n            context = mention.context\\n            for pattern in tag_patterns:\\n                if re.search(pattern, context, re.IGNORECASE):\\n                    count += 1\\n                    break  # Count each mention only once\\n\\n        return count\\n\\n    def _find_obvious_aliases(self, proposal: CharacterProposal) -> list[str]:\\n        \\\"\\\"\\\"Find obvious alias candidates based on the name.\\\"\\\"\\\"\\n        aliases = []\\n        name = proposal.name\\n\\n        # Extract first and last name\\n        parts = name.split()\\n\\n        if len(parts) >= 2:\\n            first_name = parts[0]\\n            last_name = parts[-1]\\n\\n            # Handle titles\\n            if first_name.lower().rstrip('.') in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\\n                if len(parts) >= 3:\\n                    first_name = parts[1]\\n                    last_name = parts[-1]\\n                else:\\n                    first_name = None\\n                    last_name = parts[-1]\\n\\n            if first_name:\\n                aliases.append(first_name)\\n\\n            # NOTE: We do NOT generate phantom titled versions here (e.g., \\\"Mr. LastName\\\")\\n            # because they may not exist in the text. The consensus stage, which has access\\n            # to all character names, will handle alias detection with the LLM's help.\\n            # Generating phantom aliases pollutes the system and wastes LLM tokens.\\n\\n        # Use shared nickname map from constants module\\n        name_lower = name.lower()\\n        for full_name, nicknames in NICKNAME_MAP.items():\\n            if full_name in name_lower:\\n                aliases.extend([n.title() for n in nicknames])\\n            elif any(nick in name_lower for nick in nicknames):\\n                aliases.append(full_name.title())\\n\\n        return list(set(aliases))\\n\",\"numLines\":400,\"startLine\":1,\"totalLines\":400}}}\n