{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TBpZmoQwHhQfLbKVPdKA3J","type":"tool_result","content":"     1→\"\"\"\n     2→Character proposal validator.\n     3→\n     4→Validates character proposals and identifies potential aliases.\n     5→\"\"\"\n     6→\n     7→import re\n     8→import time\n     9→from typing import Optional\n    10→import logging\n    11→\n    12→from .models import CharacterProposal, CharacterValidationResult\n    13→from .constants import NICKNAME_MAP\n    14→from ..llm import LLMClient\n    15→\n    16→logger = logging.getLogger(__name__)\n    17→\n    18→\n    19→# Known non-person entities that might be detected as characters\n    20→PLACE_NAMES = {\n    21→    'london', 'paris', 'new york', 'england', 'america', 'france', 'germany',\n    22→    'broadway', 'manhattan',\n    23→}\n    24→\n    25→TITLE_ONLY_PATTERN = re.compile(\n    26→    r'^(mr|mrs|ms|miss|dr|sir|lady|lord|captain|colonel|general|'\n    27→    r'professor|doctor|king|queen|prince|princess|duke|duchess)\\.?$',\n    28→    re.IGNORECASE\n    29→)\n    30→\n    31→# Words that indicate character context\n    32→CHARACTER_VERBS = {\n    33→    'said', 'asked', 'replied', 'whispered', 'shouted', 'muttered',\n    34→    'thought', 'wondered', 'felt', 'looked', 'smiled', 'laughed',\n    35→    'walked', 'ran', 'stood', 'sat', 'turned', 'nodded',\n    36→}\n    37→\n    38→\n    39→VALIDATION_SYSTEM_PROMPT = \"\"\"You are a literary analyst validating character names.\n    40→\n    41→Your task is to determine if a proposed name refers to a real character (person) in the story,\n    42→and identify other names that might refer to the same person.\n    43→\n    44→Consider:\n    45→- Is this a person's name (not a place, title alone, or abstract concept)?\n    46→- Does the context suggest this is a character who acts, speaks, or is spoken about?\n    47→- What other names/titles might refer to the same person?\"\"\"\n    48→\n    49→\n    50→VALIDATION_PROMPT_TEMPLATE = \"\"\"Validate this character proposal from a novel:\n    51→\n    52→PROPOSED NAME: {name}\n    53→STRATEGY: {strategy}\n    54→MENTION COUNT: {mention_count}\n    55→\n    56→SAMPLE CONTEXTS (where this name appears):\n    57→{contexts}\n    58→\n    59→Please analyze and return JSON with:\n    60→- \"is_person\": true/false - Is this a real person/character name (not a place, title, or concept)?\n    61→- \"is_person_reasoning\": Brief explanation\n    62→- \"context_supports\": 0.0-1.0 - How strongly does the context support this being a character?\n    63→- \"alias_candidates\": List of other names that might refer to the same person (e.g., \"Elizabeth\" -> [\"Lizzy\", \"Miss Bennet\"])\n    64→- \"overall_valid\": true/false - Should we include this as a character?\n    65→\n    66→Return ONLY valid JSON.\"\"\"\n    67→\n    68→\n    69→class CharacterValidator:\n    70→    \"\"\"\n    71→    Validates character proposals using heuristics and LLM.\n    72→\n    73→    Uses fast heuristics for clear cases, LLM for ambiguous ones.\n    74→    \"\"\"\n    75→\n    76→    def __init__(\n    77→        self,\n    78→        llm_client: Optional[LLMClient] = None,\n    79→        min_confidence: float = 0.5,\n    80→        use_llm_validation: bool = True,\n    81→    ):\n    82→        \"\"\"\n    83→        Args:\n    84→            llm_client: LLM client for ambiguous cases\n    85→            min_confidence: Minimum score to consider valid\n    86→            use_llm_validation: Whether to use LLM for validation\n    87→        \"\"\"\n    88→        self.llm = llm_client\n    89→        self.min_confidence = min_confidence\n    90→        self.use_llm_validation = use_llm_validation and llm_client is not None\n    91→\n    92→    def validate(self, proposal: CharacterProposal) -> CharacterValidationResult:\n    93→        \"\"\"Validate a single character proposal.\"\"\"\n    94→        # Quick heuristic checks\n    95→        heuristic_result = self._heuristic_validation(proposal)\n    96→\n    97→        if heuristic_result is not None:\n    98→            return heuristic_result\n    99→\n   100→        # Use LLM for ambiguous cases\n   101→        if self.use_llm_validation:\n   102→            return self._llm_validation(proposal)\n   103→\n   104→        # No LLM validation available - fail fast instead of using fallback confidence\n   105→        error_msg = f\"LLM validation is required but not enabled for proposal '{proposal.name}'\"\n   106→        logger.error(error_msg)\n   107→        raise ValueError(error_msg)\n   108→\n   109→    def validate_batch(\n   110→        self,\n   111→        proposals: list[CharacterProposal],\n   112→    ) -> list[CharacterValidationResult]:\n   113→        \"\"\"Validate multiple proposals.\"\"\"\n   114→        return [self.validate(p) for p in proposals]\n   115→\n   116→    def _heuristic_validation(\n   117→        self,\n   118→        proposal: CharacterProposal,\n   119→    ) -> Optional[CharacterValidationResult]:\n   120→        \"\"\"\n   121→        Apply fast heuristic checks.\n   122→\n   123→        Returns ValidationResult if we can determine validity,\n   124→        None if LLM validation is needed.\n   125→        \"\"\"\n   126→        name = proposal.name\n   127→        name_lower = name.lower()\n   128→\n   129→        # Reject: known places\n   130→        if name_lower in PLACE_NAMES:\n   131→            return CharacterValidationResult(\n   132→                proposal=proposal,\n   133→                is_person_score=0.0,\n   134→                context_score=0.0,\n   135→                alias_candidates=[],\n   136→                overall_score=0.0,\n   137→                is_valid=False,\n   138→                reasoning=f\"'{name}' is a known place name\",\n   139→            )\n   140→\n   141→        # Reject: title only (no actual name)\n   142→        if TITLE_ONLY_PATTERN.match(name):\n   143→            return CharacterValidationResult(\n   144→                proposal=proposal,\n   145→                is_person_score=0.0,\n   146→                context_score=0.0,\n   147→                alias_candidates=[],\n   148→                overall_score=0.0,\n   149→                is_valid=False,\n   150→                reasoning=f\"'{name}' is a title without a name\",\n   151→            )\n   152→\n   153→        # Accept: high mention count with dialogue\n   154→        dialogue_mentions = sum(1 for m in proposal.mentions if m.in_dialogue)\n   155→        if proposal.mention_count >= 10 and dialogue_mentions >= 3:\n   156→            # Strong signal: mentioned often and speaks\n   157→            alias_candidates = self._find_obvious_aliases(proposal)\n   158→            return CharacterValidationResult(\n   159→                proposal=proposal,\n   160→                is_person_score=0.95,\n   161→                context_score=0.9,\n   162→                alias_candidates=alias_candidates,\n   163→                overall_score=0.92,\n   164→                is_valid=True,\n   165→                reasoning=f\"High mention count ({proposal.mention_count}) with dialogue ({dialogue_mentions} in speech)\",\n   166→            )\n   167→\n   168→        # Accept: appears in dialogue tags (said X, asked X)\n   169→        dialogue_tag_count = self._count_dialogue_tags(proposal)\n   170→        if dialogue_tag_count >= 2:\n   171→            alias_candidates = self._find_obvious_aliases(proposal)\n   172→            return CharacterValidationResult(\n   173→                proposal=proposal,\n   174→                is_person_score=0.9,\n   175→                context_score=0.85,\n   176→                alias_candidates=alias_candidates,\n   177→                overall_score=0.87,\n   178→                is_valid=True,\n   179→                reasoning=f\"Appears in {dialogue_tag_count} dialogue tags (said/asked/replied)\",\n   180→            )\n   181→\n   182→        # Accept: titled name (Mr. Smith, Mrs. Jones)\n   183→        if re.match(r'^(Mr|Mrs|Ms|Miss|Dr|Sir|Lady|Lord)\\.?\\s+\\w+', name):\n   184→            alias_candidates = self._find_obvious_aliases(proposal)\n   185→            return CharacterValidationResult(\n   186→                proposal=proposal,\n   187→                is_person_score=0.85,\n   188→                context_score=0.8,\n   189→                alias_candidates=alias_candidates,\n   190→                overall_score=0.82,\n   191→                is_valid=True,\n   192→                reasoning=f\"Titled name pattern suggests person\",\n   193→            )\n   194→\n   195→        # Reject: single mention, no dialogue\n   196→        if proposal.mention_count == 1 and dialogue_mentions == 0:\n   197→            # Check context for character verbs\n   198→            context = proposal.mentions[0].context.lower() if proposal.mentions else \"\"\n   199→            has_character_verb = any(verb in context for verb in CHARACTER_VERBS)\n   200→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"2328c887-9860-4905-a9f6-317b02fbfb9a","uuid":"b90be3bf-6903-4a55-8e79-31e9461c8f69","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/validator.py","content":"\"\"\"\nCharacter proposal validator.\n\nValidates character proposals and identifies potential aliases.\n\"\"\"\n\nimport re\nimport time\nfrom typing import Optional\nimport logging\n\nfrom .models import CharacterProposal, CharacterValidationResult\nfrom .constants import NICKNAME_MAP\nfrom ..llm import LLMClient\n\nlogger = logging.getLogger(__name__)\n\n\n# Known non-person entities that might be detected as characters\nPLACE_NAMES = {\n    'london', 'paris', 'new york', 'england', 'america', 'france', 'germany',\n    'broadway', 'manhattan',\n}\n\nTITLE_ONLY_PATTERN = re.compile(\n    r'^(mr|mrs|ms|miss|dr|sir|lady|lord|captain|colonel|general|'\n    r'professor|doctor|king|queen|prince|princess|duke|duchess)\\.?$',\n    re.IGNORECASE\n)\n\n# Words that indicate character context\nCHARACTER_VERBS = {\n    'said', 'asked', 'replied', 'whispered', 'shouted', 'muttered',\n    'thought', 'wondered', 'felt', 'looked', 'smiled', 'laughed',\n    'walked', 'ran', 'stood', 'sat', 'turned', 'nodded',\n}\n\n\nVALIDATION_SYSTEM_PROMPT = \"\"\"You are a literary analyst validating character names.\n\nYour task is to determine if a proposed name refers to a real character (person) in the story,\nand identify other names that might refer to the same person.\n\nConsider:\n- Is this a person's name (not a place, title alone, or abstract concept)?\n- Does the context suggest this is a character who acts, speaks, or is spoken about?\n- What other names/titles might refer to the same person?\"\"\"\n\n\nVALIDATION_PROMPT_TEMPLATE = \"\"\"Validate this character proposal from a novel:\n\nPROPOSED NAME: {name}\nSTRATEGY: {strategy}\nMENTION COUNT: {mention_count}\n\nSAMPLE CONTEXTS (where this name appears):\n{contexts}\n\nPlease analyze and return JSON with:\n- \"is_person\": true/false - Is this a real person/character name (not a place, title, or concept)?\n- \"is_person_reasoning\": Brief explanation\n- \"context_supports\": 0.0-1.0 - How strongly does the context support this being a character?\n- \"alias_candidates\": List of other names that might refer to the same person (e.g., \"Elizabeth\" -> [\"Lizzy\", \"Miss Bennet\"])\n- \"overall_valid\": true/false - Should we include this as a character?\n\nReturn ONLY valid JSON.\"\"\"\n\n\nclass CharacterValidator:\n    \"\"\"\n    Validates character proposals using heuristics and LLM.\n\n    Uses fast heuristics for clear cases, LLM for ambiguous ones.\n    \"\"\"\n\n    def __init__(\n        self,\n        llm_client: Optional[LLMClient] = None,\n        min_confidence: float = 0.5,\n        use_llm_validation: bool = True,\n    ):\n        \"\"\"\n        Args:\n            llm_client: LLM client for ambiguous cases\n            min_confidence: Minimum score to consider valid\n            use_llm_validation: Whether to use LLM for validation\n        \"\"\"\n        self.llm = llm_client\n        self.min_confidence = min_confidence\n        self.use_llm_validation = use_llm_validation and llm_client is not None\n\n    def validate(self, proposal: CharacterProposal) -> CharacterValidationResult:\n        \"\"\"Validate a single character proposal.\"\"\"\n        # Quick heuristic checks\n        heuristic_result = self._heuristic_validation(proposal)\n\n        if heuristic_result is not None:\n            return heuristic_result\n\n        # Use LLM for ambiguous cases\n        if self.use_llm_validation:\n            return self._llm_validation(proposal)\n\n        # No LLM validation available - fail fast instead of using fallback confidence\n        error_msg = f\"LLM validation is required but not enabled for proposal '{proposal.name}'\"\n        logger.error(error_msg)\n        raise ValueError(error_msg)\n\n    def validate_batch(\n        self,\n        proposals: list[CharacterProposal],\n    ) -> list[CharacterValidationResult]:\n        \"\"\"Validate multiple proposals.\"\"\"\n        return [self.validate(p) for p in proposals]\n\n    def _heuristic_validation(\n        self,\n        proposal: CharacterProposal,\n    ) -> Optional[CharacterValidationResult]:\n        \"\"\"\n        Apply fast heuristic checks.\n\n        Returns ValidationResult if we can determine validity,\n        None if LLM validation is needed.\n        \"\"\"\n        name = proposal.name\n        name_lower = name.lower()\n\n        # Reject: known places\n        if name_lower in PLACE_NAMES:\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.0,\n                context_score=0.0,\n                alias_candidates=[],\n                overall_score=0.0,\n                is_valid=False,\n                reasoning=f\"'{name}' is a known place name\",\n            )\n\n        # Reject: title only (no actual name)\n        if TITLE_ONLY_PATTERN.match(name):\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.0,\n                context_score=0.0,\n                alias_candidates=[],\n                overall_score=0.0,\n                is_valid=False,\n                reasoning=f\"'{name}' is a title without a name\",\n            )\n\n        # Accept: high mention count with dialogue\n        dialogue_mentions = sum(1 for m in proposal.mentions if m.in_dialogue)\n        if proposal.mention_count >= 10 and dialogue_mentions >= 3:\n            # Strong signal: mentioned often and speaks\n            alias_candidates = self._find_obvious_aliases(proposal)\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.95,\n                context_score=0.9,\n                alias_candidates=alias_candidates,\n                overall_score=0.92,\n                is_valid=True,\n                reasoning=f\"High mention count ({proposal.mention_count}) with dialogue ({dialogue_mentions} in speech)\",\n            )\n\n        # Accept: appears in dialogue tags (said X, asked X)\n        dialogue_tag_count = self._count_dialogue_tags(proposal)\n        if dialogue_tag_count >= 2:\n            alias_candidates = self._find_obvious_aliases(proposal)\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.9,\n                context_score=0.85,\n                alias_candidates=alias_candidates,\n                overall_score=0.87,\n                is_valid=True,\n                reasoning=f\"Appears in {dialogue_tag_count} dialogue tags (said/asked/replied)\",\n            )\n\n        # Accept: titled name (Mr. Smith, Mrs. Jones)\n        if re.match(r'^(Mr|Mrs|Ms|Miss|Dr|Sir|Lady|Lord)\\.?\\s+\\w+', name):\n            alias_candidates = self._find_obvious_aliases(proposal)\n            return CharacterValidationResult(\n                proposal=proposal,\n                is_person_score=0.85,\n                context_score=0.8,\n                alias_candidates=alias_candidates,\n                overall_score=0.82,\n                is_valid=True,\n                reasoning=f\"Titled name pattern suggests person\",\n            )\n\n        # Reject: single mention, no dialogue\n        if proposal.mention_count == 1 and dialogue_mentions == 0:\n            # Check context for character verbs\n            context = proposal.mentions[0].context.lower() if proposal.mentions else \"\"\n            has_character_verb = any(verb in context for verb in CHARACTER_VERBS)\n","numLines":200,"startLine":1,"totalLines":378}}}
