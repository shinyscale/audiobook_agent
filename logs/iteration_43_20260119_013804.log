)\\\\\\\\\\\\\\\\n            context_str = self._format_contexts(results, max_contexts=3, max_chars=400)\\\\\\\\\\\\\\\\n            proper_name_lines.append(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"- {name} ({total_mentions} mentions, chapters: {chapters_str})\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n            proper_name_lines.append(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"  Context: {context_str}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        epithets_str = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\".join(epithet_lines)\\\\\\\\\\\\\\\\n        proper_names_str = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\".join(proper_name_lines)\\\\\\\\\\\\\\\\n        prompt = CROSS_GROUP_PROMPT.format(epithets=epithets_str, proper_names=proper_names_str)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        try:\\\\\\\\\\\\\\\\n            result, response = self.llm.query_json(prompt, system=CROSS_GROUP_SYSTEM)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            if result is None or not isinstance(result, list):\\\\\\\\\\\\\\\\n                logger.warning(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"LLM cross-group resolution returned invalid response\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n                return {}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # DEBUG: Log LLM recommendations\\\\\\\\\\\\\\\\n            logger.info(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"LLM cross-group recommendations: {result}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Parse response into epithet -> proper_name mapping\\\\\\\\\\\\\\\\n            cross_map = {}\\\\\\\\\\\\\\\\n            for match in result:\\\\\\\\\\\\\\\\n                if not isinstance(match, dict):\\\\\\\\\\\\\\\\n                    continue\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                epithet = match.get(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"epithet\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n                proper_name = match.get(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"proper_name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                if not epithet or not proper_name:\\\\\\\\\\\\\\\\n                    continue\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                # Match to actual names (fuzzy matching to handle LLM variations)\\\\\\\\\\\\\\\\n                matched_epithet = self._find_closest_name(epithet, epithet_groups.keys())\\\\\\\\\\\\\\\\n                matched_proper = self._find_closest_name(proper_name, proper_name_groups.keys())\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                if matched_epithet and matched_proper:\\\\\\\\\\\\\\\\n                    # Pre-filter: Check for absolute merge blockers\\\\\\\\\\\\\\\\n                    epithet_results = epithet_groups.get(matched_epithet, [])\\\\\\\\\\\\\\\\n                    proper_results = proper_name_groups.get(matched_proper, [])\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                    # FIRST: Check for death relationship (absolute blocker)\\\\\\\\\\\\\\\\n                    if self._entities_in_death_relationship(matched_epithet, matched_proper, epithet_results, proper_results):\\\\\\\\\\\\\\\\n                        logger.info(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Skipping cross-group match due to death relationship: '{matched_epithet}' vs '{matched_proper}'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n                        continue\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                    # SECOND: Check for confrontation (strong indicator they're separate)\\\\\\\\\\\\\\\\n                    if self._entities_in_confrontation(matched_epithet, matched_proper, epithet_results, proper_results):\\\\\\\\\\\\\\\\n                        logger.info(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Skipping cross-group match due to confrontation: '{matched_epithet}' vs '{matched_proper}'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n                        continue\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                    cross_map[matched_epithet] = matched_proper\\\\\\\\\\\\\\\\n                    logger.info(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Cross-group match: epithet '{matched_epithet}' -> proper name '{matched_proper}'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            return cross_map\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        except Exception as e:\\\\\\\\\\\\\\\\n            logger.error(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"LLM cross-group resolution failed: {e}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n            return {}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def _pick_canonical_epithet(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        epithets: list[str],\\\\\\\\\\\\\\\\n        epithet_groups: dict[str, list[CharacterValidationResult]],\\\\\\\\\\\\\\\\n    ) -> str:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        Pick the best canonical name from a group of epithet aliases.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        Priority:\\\\\\\\\\\\\\\\n        1. Specificity: more words = more specific (e.g., \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"the blind old man\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" > \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"the old man\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n        2. Uniqueness: less common phrases are more unique\\\\\\\\\\\\\\\\n        3. Frequency: higher mention count indicates more established usage\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        if len(epithets) == 1:\\\\\\\\\\\\\\\\n            return epithets[0]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        def score(epithet: str) -> tuple[int, int, int]:\\\\\\\\\\\\\\\\n            # Word count (more = more specific)\\\\\\\\\\\\\\\\n            words = epithet.lower().split()\\\\\\\\\\\\\\\\n            word_count = len(words)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Uniqueness: inverse of how common each word is\\\\\\\\\\\\\\\\n            # More unique words = better canonical\\\\\\\\\\\\\\\\n            common_words = {'the', 'a', 'an', 'old', 'young', 'man', 'woman', 'person'}\\\\\\\\\\\\\\\\n            unique_words = sum(1 for w in words if w not in common_words)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Mention count\\\\\\\\\\\\\\\\n            results = epithet_groups.get(epithet, [])\\\\\\\\\\\\\\\\n            mention_count = sum(r.proposal.mention_count for r in results)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            return (word_count, unique_words, mention_count)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        return max(epithets, key=score)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def _generate_id(self, name: str) -> str:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Generate a unique ID for a character.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        # Use hash of lowercase name for consistency\\\\\\\\\\\\\\\\n        name_hash = hashlib.md5(name.lower().encode()).hexdigest()[:8]\\\\\\\\\\\\\\\\n        safe_name = re.sub(r'[^a-zA-Z0-9]', '_', name.lower())[:20]\\\\\\\\\\\\\\\\n        return f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"char_{safe_name}_{name_hash}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"numLines\\\\\\\\\\\\\\\":139,\\\\\\\\\\\\\\\"startLine\\\\\\\\\\\\\\\":2171,\\\\\\\\\\\\\\\"totalLines\\\\\\\\\\\\\\\":2309}}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"assistant\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"model\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"claude-sonnet-4-5-20250929\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\