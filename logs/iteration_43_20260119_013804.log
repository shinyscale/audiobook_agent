, str]:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        Use LLM to link epithets to proper names (e.g., \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"the prince\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" -> \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Prince Prospero\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\").\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        Returns:\\\\\\\\\\\\\\\\n            dict mapping epithet_name -> proper_name for confirmed matches\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        if not self.llm or len(epithet_groups) == 0 or len(proper_name_groups) == 0:\\\\\\\\\\\\\\\\n            return {}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        # Build prompt with epithet info\\\\\\\\\\\\\\\\n        epithet_lines = []\\\\\\\\\\\\\\\\n        sorted_epithets = sorted(\\\\\\\\\\\\\\\\n            epithet_groups.items(),\\\\\\\\\\\\\\\\n            key=lambda x: -sum(r.proposal.mention_count for r in x[1]),\\\\\\\\\\\\\\\\n        )[:15]  # Limit to top 15 epithets to keep prompt manageable\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        for name, results in sorted_epithets:\\\\\\\\\\\\\\\\n            total_mentions = sum(r.proposal.mention_count for r in results)\\\\\\\\\\\\\\\\n            chapters_str = self._chapters_for_name(name, epithet_groups, max_chapters=8)\\\\\\\\\\\\\\\\n            # Increased context size to capture long sentences (e.g., Poe's confrontation scenes)\\\\\\\\\\\\\\\\n            context_str = self._format_contexts(results, max_contexts=4, max_chars=400)\\\\\\\\\\\\\\\\n            epithet_lines.append(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"- {name} ({total_mentions} mentions, chapters: {chapters_str})\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n            epithet_lines.append(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"  Context: {context_str}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        # Build prompt with proper name info\\\\\\\\\\\\\\\\n        proper_name_lines = []\\\\\\\\\\\\\\\\n        sorted_proper = sorted(\\\\\\\\\\\\\\\\n            proper_name_groups.items(),\\\\\\\\\\\\\\\\n            key=lambda x: -sum(r.proposal.mention_count for r in x[1]),\\\\\\\\\\\\\\\\n        )[:15]  # Limit to top 15 proper names\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        for name, results in sorted_proper:\\\\\\\\\\\\\\\\n            total_mentions = sum(r.proposal.mention_count for r in results)\\\\\\\\\\\\\\\\n            chapters_str = self._chapters_for_name(name, proper_name_groups, max_chapters=8)\\\\\\\\\\\\\\\\n            # Increased context size to capture long sentences (e.g., Poe's confrontation scenes)\\\\\\\\\\\\\\\\n            context_str = self._format_contexts(results, max_contexts=3, max_chars=400)\\\\\\\\\\\\\\\\n            proper_name_lines.append(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"- {name} ({total_mentions} mentions, chapters: {chapters_str})\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n            proper_name_lines.append(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"  Context: {context_str}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        epithets_str = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\".join(epithet_lines)\\\\\\\\\\\\\\\\n        proper_names_str = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\".join(proper_name_lines)\\\\\\\\\\\\\\\\n        prompt = CROSS_GROUP_PROMPT.format(epithets=epithets_str, proper_names=proper_names_str)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        try:\\\\\\\\\\\\\\\\n            result, response = self.llm.query_json(prompt, system=CROSS_GROUP_SYSTEM)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            if result is None or not isinstance(result, list):\\\\\\\\\\\\\\\\n                logger.warning(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"LLM cross-group resolution returned invalid response\\\\\