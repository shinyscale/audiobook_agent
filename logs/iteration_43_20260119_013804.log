\\n            # Word count (more = more specific)\\\\\\\\\\\\\\\\n            words = epithet.lower().split()\\\\\\\\\\\\\\\\n            word_count = len(words)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Uniqueness: inverse of how common each word is\\\\\\\\\\\\\\\\n            # More unique words = better canonical\\\\\\\\\\\\\\\\n            common_words = {'the', 'a', 'an', 'old', 'young', 'man', 'woman', 'person'}\\\\\\\\\\\\\\\\n            unique_words = sum(1 for w in words if w not in common_words)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Mention count\\\\\\\\\\\\\\\\n            results = epithet_groups.get(epithet, [])\\\\\\\\\\\\\\\\n            mention_count = sum(r.proposal.mention_count for r in results)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            return (word_count, unique_words, mention_count)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        return max(epithets, key=score)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def _generate_id(self, name: str) -> str:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Generate a unique ID for a character.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        # Use hash of lowercase name for consistency\\\\\\\\\\\\\\\\n        name_hash = hashlib.md5(name.lower().encode()).hexdigest()[:8]\\\\\\\\\\\\\\\\n        safe_name = re.sub(r'[^a-zA-Z0-9]', '_', name.lower())[:20]\\\\\\\\\\\\\\\\n        return f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"char_{safe_name}_{name_hash}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"numLines\\\\\\\\\\\\\\\":139,\\\\\\\\\\\\\\\"startLine\\\\\\\\\\\\\\\":2171,\\\\\\\\\\\\\\\"totalLines\\\\\\\\\\\\\\\":2309}}}\\\\\\\\n{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"assistant\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"model\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"claude-sonnet-4-5-20250929\\\\\\\\\\