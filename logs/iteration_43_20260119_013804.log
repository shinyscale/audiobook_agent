mat\\\": \\\"txt\\\",\\n    \\\"total_word_count\\\": 2449,\\n    \\\"total_character_count\\\": 13811,\\n    \\\"estimated_total_duration_minutes\\\": 16.286666666666665,\\n    \\\"words_per_minute\\\": 150\\n  },\\n  \\\"structure\\\": [\\n    {\\n      \\\"type\\\": \\\"chapter\\\",\\n      \\\"title\\\": null,\\n      \\\"index\\\": 1,\\n      \\\"start_position\\\": 28,\\n      \\\"end_position\\\": 13811,\\n      \\\"word_count\\\": 2443,\\n      \\\"estimated_duration_minutes\\\": 16.286666666666665,\\n      \\\"confidence\\\": \\\"medium\\\",\\n      \\\"children\\\": [],\\n      \\\"characters_present\\\": [\\n        \\\"Prince Prospero\\\",\\n        \\\"The masked figure (Red Death)\\\"\\n      ],\\n      \\\"summary\\\": \\\"The chapter opens with the devastating spread of the 'Red Death,' a horrific plague marked by bleeding pores and rapid death, prompting Prince Prospero to retreat with a thousand courtiers into a secluded, fortified abbey to escape contagion. Inside, he constructs seven elaborately themed rooms—each with uniquely colored stained-glass windows and decor—culminating in a black chamber with blood-red panes and a massive ebony clock that chimes hourly, halting all merriment and instilling dread. During a lavish masked ball, a mysterious figure appears dressed as the Red Death itself, shrouded in grave-cloths and drenched in scarlet stains, causing terror and paralysis among the guests. Prince Prospero, enraged by the blasphemy, pursues the figure through all seven rooms with a dagger, only to collapse and die upon confronting it in the black chamber, where the figure is revealed to be an empty shell. As the prince dies, the plague manifests among the revelers, and one by one they perish, extinguishing the lights and silence falling over the abbey as death claims all.\\\"\\n    }\\n  ],\\n  \\\"characters\\\": [\\n    {\\n      \\\"id\\\": \\\"char_the_prince_prospero_d85685e9\\\",\\n      \\\"canonical_name\\\": \\\"the Prince Prospero\