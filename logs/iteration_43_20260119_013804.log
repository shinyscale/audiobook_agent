\\\\\\\\\\\\\n                # Match to actual names (fuzzy matching to handle LLM variations)\\\\\\\\\\\\\\\\n                matched_epithet = self._find_closest_name(epithet, epithet_groups.keys())\\\\\\\\\\\\\\\\n                matched_proper = self._find_closest_name(proper_name, proper_name_groups.keys())\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                if matched_epithet and matched_proper:\\\\\\\\\\\\\\\\n                    # Pre-filter: Check for absolute merge blockers\\\\\\\\\\\\\\\\n                    epithet_results = epithet_groups.get(matched_epithet, [])\\\\\\\\\\\\\\\\n                    proper_results = proper_name_groups.get(matched_proper, [])\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                    # FIRST: Check for death relationship (absolute blocker)\\\\\\\\\\\\\\\\n                    if self._entities_in_death_relationship(matched_epithet, matched_proper, epithet_results, proper_results):\\\\\\\\\\\\\\\\n                        logger.info(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Skipping cross-group match due to death relationship: '{matched_epithet}' vs '{matched_proper}'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n                        continue\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                    # SECOND: Check for confrontation (strong indicator they're separate)\\\\\\\\\\\\\\\\n                    if self._entities_in_confrontation(matched_epithet, matched_proper, epithet_results, proper_results):\\\\\\\\\\\\\\\\n                        logger.info(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Skipping cross-group match due to confrontation: '{matched_epithet}' vs '{matched_proper}'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n                        continue\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n                    cross_map[matched_epithet] = matched_proper\\\\\\\\\\\\\\\\n                    logger.info(f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Cross-group match: epithet '{matched_epithet}' -> proper name '{matched_proper}'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\