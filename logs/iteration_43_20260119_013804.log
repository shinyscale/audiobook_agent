ical name from a group of epithet aliases.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        Priority:\\\\\\\\\\\\\\\\n        1. Specificity: more words = more specific (e.g., \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"the blind old man\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" > \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"the old man\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n        2. Uniqueness: less common phrases are more unique\\\\\\\\\\\\\\\\n        3. Frequency: higher mention count indicates more established usage\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        if len(epithets) == 1:\\\\\\\\\\\\\\\\n            return epithets[0]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        def score(epithet: str) -> tuple[int, int, int]:\\\\\\\\\\\\\\\\n            # Word count (more = more specific)\\\\\\\\\\\\\\\\n            words = epithet.lower().split()\\\\\\\\\\\\\\\\n            word_count = len(words)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Uniqueness: inverse of how common each word is\\\\\\\\\\\\\\\\n            # More unique words = better canonical\\\\\\\\\\\\\\\\n            common_words = {'the', 'a', 'an', 'old', 'young', 'man', 'woman', 'person'}\\\\\\\\\\\\\\\\n            unique_words = sum(1 for w in words if w not in common_words)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Mention count\\\\\\\\\\\\\\\\n            results = epithet_groups.get(epithet, [])\\\\\\\\\\\\\\\\n            mention_count = sum(r.proposal.mention_count for r in results)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            return (word_count, unique_words, mention_count)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        return max(epithets, key=score)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def _generate_id(self, name: str) -> str:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Generate a unique ID for a character.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\