em;\">\n                    <strong style=\"margin-right: 0.5rem; color: var(--muted);\">Characters:</strong>\n                    \n                    <span class=\"tag\">Prince Prospero</span>\n                    \n                    <span class=\"tag\">The masked figure (Red Death)</span>\n                    \n                    <span class=\"tag\">Courtiers</span>\n                    \n                    <span class=\"tag\">Musicians</span>\n                    \n                    <span class=\"tag\">Buffoons</span>\n                    \n                    <span class=\"tag\">Ballet-dancers</span>\n                    \n                    <span class=\"tag\">Improvisatori</span>\n                    \n                    \n                </div>\n                \n            </div>\n            \n        </section>\n        </div>\n\n        <div id=\"characters\" class=\"tab-content\">\n        <section>\n            <h2>👥 Character Guide</h2>\n\n            <!-- Confidence Filter -->\n            <div style=\"margin-bottom: 1.5rem;\">\n                <label style=\"color: var(--muted); margin-right: 0.5rem;\">\n                    <input type=\"checkbox\" id=\"show-low-confidence-only\" onchange=\"filterByConfidence(this.checked)\">\n                    Show only low-confidence items\n                </label>\n            </div>\n\n            \n\n            \n            <div class=\"character-group\">\n                <h3>Supporting Characters <span class=\"count\">2</span></h3>\n                <table>\n                    <thead>\n                        <tr>\n                            <th>Name</th>\n                            <th>Mentions</th>\n                            <th>First Appears</th>\n                            <th>Aliases</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        \n                        <tr>\n                            <td>\n                    