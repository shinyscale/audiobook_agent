l tabs and all pronunciation views */\n   112→        @media print {\n   113→            nav {\n   114→                display: none;\n   115→            }\n   116→            .tab-content {\n   117→                display: block !important;\n   118→                page-break-before: always;\n   119→            }\n   120→            .tab-content:first-of-type {\n   121→                page-break-before: auto;\n   122→            }\n   123→            .view-toggle {\n   124→                display: none !important;\n   125→            }\n   126→            .pron-view {\n   127→                display: block !important;\n   128→                page-break-before: always;\n   129→            }\n   130→            /* Glossary print styles */\n   131→            .alphabet-nav {\n   132→                display: none !important;\n   133→            }\n   134→            #glossary-search, button[onclick=\"clearGlossarySearch()\"] {\n   135→                display: none !important;\n   136→            }\n   137→            #glossary-count {\n   138→                display: none !important;\n   139→            }\n   140→            .glossary-section {\n   141→                page-break-inside: avoid;\n   142→            }\n   143→        }\n   144→\n   145→        /* Mobile responsive tabs */\n   146→        @media (max-width: 768px) {\n   147→            nav {\n   148→                flex-direction: column;\n   149→            }\n   150→            nav a {\n   151→                text-align: center;\n   152→            }\n   153→        }\n   154→\n   155→        header {\n   156→            text-align: center;\n   157→            padding: 2rem;\n   158→            background: var(--surface);\n   159→            border-radius: 8px;\n   160→            margin-bottom: 2rem;\n   161→        }\n   162→\n   163→        header h1 { color: var(--accent); margin-bottom: 0.5rem; font-size: 2.5rem; }\n   164→        header .meta { color: var(--muted); }\n   165→\n   166→        .stats 