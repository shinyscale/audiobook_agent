{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NpQ9fKVSidu81hmwxuHZ1M","type":"tool_result","content":"     1→\"\"\"\n     2→Cross-chapter character consensus builder.\n     3→\n     4→Merges character proposals across chapters, resolves aliases,\n     5→and produces the final CharacterMap.\n     6→\"\"\"\n     7→\n     8→import re\n     9→import hashlib\n    10→import time\n    11→from typing import Optional, Iterable\n    12→from collections import defaultdict\n    13→from difflib import SequenceMatcher\n    14→import logging\n    15→\n    16→from .models import (\n    17→    CharacterProposal,\n    18→    CharacterValidationResult,\n    19→    Character,\n    20→    CharacterMap,\n    21→    CharacterMention,\n    22→    CharacterType,\n    23→)\n    24→from .constants import are_potential_nicknames, get_nickname_variants\n    25→from ..llm import LLMClient\n    26→\n    27→logger = logging.getLogger(__name__)\n    28→\n    29→# Character classification prompts\n    30→CHARACTER_TYPE_SYSTEM = \"\"\"You are a literary analyst classifying character types.\n    31→\n    32→Classify each character as one of:\n    33→- STORY: An active participant in the narrative who appears in scenes, speaks dialogue, or takes actions\n    34→- HISTORICAL: A real historical figure mentioned in passing (e.g., Napoleon, Einstein)\n    35→- REFERENCED: A fictional character from other works mentioned in passing (e.g., Hamlet, Sherlock Holmes)\n    36→\n    37→Return ONLY valid JSON. No other text.\"\"\"\n    38→\n    39→CHARACTER_TYPE_PROMPT = \"\"\"Classify this character's role in the narrative.\n    40→\n    41→CHARACTER: {name}\n    42→MENTION COUNT: {mention_count}\n    43→CHAPTERS PRESENT: {chapters}\n    44→SAMPLE CONTEXTS:\n    45→{contexts}\n    46→\n    47→Based on the contexts, determine if this character:\n    48→1. Actively participates (speaks, acts, appears in scenes) → STORY\n    49→2. Is a real historical figure mentioned in passing → HISTORICAL\n    50→3. Is a fictional character from other works → REFERENCED\n    51→\n    52→Return JSON:\n    53→{{\n    54→  \"character_type\": \"story\" | \"historical\" | \"referenced\",\n    55→  \"confidence\": 0.0-1.0,\n    56→  \"reason\": \"brief justification\"\n    57→}}\"\"\"\n    58→\n    59→# Common titles that should be ignored when comparing character names\n    60→# These are not part of the actual name but indicate social status or role\n    61→TITLES = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord', 'professor', 'captain', 'major'}\n    62→\n    63→# Epithet alias resolution prompt\n    64→EPITHET_ALIAS_SYSTEM = \"\"\"You are a literary analyst identifying whether different descriptive handles (epithets) refer to the SAME unnamed character.\n    65→\n    66→Descriptive handles are phrases like \"the creature\", \"the monster\", \"the old man\", \"the detective\".\n    67→\n    68→CRITICAL RULES:\n    69→1. Only merge epithets that CLEARLY refer to the same entity with HIGH CONFIDENCE\n    70→2. Use chapter appearances and context clues to verify they're the same character\n    71→3. Different descriptive characters (e.g., \"the old man\" in cottage vs \"the old man\" at inn) should NOT be merged\n    72→4. Generic phrases that could refer to anyone should NOT be merged together\n    73→\n    74→Return ONLY valid JSON. No other text.\"\"\"\n    75→\n    76→EPITHET_ALIAS_PROMPT = \"\"\"Identify which descriptive handles refer to the SAME unnamed character.\n    77→\n    78→DESCRIPTIVE HANDLES (with chapter info and sample contexts):\n    79→{epithets}\n    80→\n    81→For each group of handles that refer to the SAME entity:\n    82→1. Pick the most specific/unique handle as canonical (e.g., \"the creature\" over \"the monster\")\n    83→2. List all other handles as aliases\n    84→\n    85→Return JSON array:\n    86→```json\n    87→[\n    88→  {{\"canonical\": \"the creature\", \"aliases\": [\"the monster\", \"the wretch\", \"the fiend\"]}},\n    89→  {{\"canonical\": \"the old man\", \"aliases\": []}}\n    90→]\n    91→```\n    92→\n    93→Return ONLY the JSON array. Include only handles you're confident about - omit uncertain ones.\"\"\"\n    94→\n    95→PAIRWISE_ALIAS_SYSTEM = \"\"\"You are a literary analyst identifying whether two character names refer to the SAME PERSON.\n    96→\n    97→CRITICAL:\n    98→- Use ONLY the evidence provided below (chapter appearances and context snippets).\n    99→- Be conservative: false negatives (missing an alias) are better than false positives (merging different people).\n   100→- Titles (Mr/Mrs/Miss/Dr/etc.) are not part of the name; treat them as address forms.\n   101→\n   102→Return ONLY valid JSON. No other text.\"\"\"\n   103→\n   104→PAIRWISE_ALIAS_PROMPT = \"\"\"Decide whether these two names refer to the SAME PERSON in this novel.\n   105→\n   106→NAME A: {name_a}\n   107→MENTIONS A: {mentions_a}\n   108→CHAPTERS A: {chapters_a}\n   109→CONTEXT A:\n   110→{contexts_a}\n   111→\n   112→NAME B: {name_b}\n   113→MENTIONS B: {mentions_b}\n   114→CHAPTERS B: {chapters_b}\n   115→CONTEXT B:\n   116→{contexts_b}\n   117→\n   118→Rules:\n   119→- Only say same_person=true if there is strong evidence they are the same character (name overlap, title variants, obvious nickname/full-name relationship, or clear contextual cues).\n   120→- If the only overlap is a last name, be VERY cautious (family members/spouses share last names).\n   121→- If they never appear in overlapping chapters, be cautious unless it's clearly a full-name/short-name relationship.\n   122→\n   123→Return JSON:\n   124→{{\n   125→  \"same_person\": true/false,\n   126→  \"confidence\": 0.0-1.0,\n   127→  \"canonical\": \"Which of the two names should be canonical if same_person=true (must be exactly one of the provided names)\",\n   128→  \"alias\": \"The other name if same_person=true (must be exactly one of the provided names)\",\n   129→  \"reason\": \"brief justification\"\n   130→}}\"\"\"\n   131→\n   132→\n   133→ALIAS_RESOLUTION_SYSTEM = \"\"\"You are a literary analyst identifying character aliases.\n   134→\n   135→Your task is to determine which character names refer to the SAME PERSON.\n   136→\n   137→IMPORTANT: Titles, ranks, and honorifics should be IGNORED when matching names.\n   138→The underlying PERSON is what matters, not how they're addressed. Examples:\n   139→- Military: \"SSgt Otto\" = \"Staff Sergeant Mark Otto\" = \"Mark Otto\" (but NOT just \"Otto\" alone)\n   140→- Civilian: \"Mr. Smith\" = \"John Smith\" (but NOT just \"Smith\" alone - could be family member)\n   141→- Religious: \"Father O'Brien\" = \"Patrick O'Brien\" (but NOT just \"O'Brien\" alone)\n   142→- Academic: \"Professor Williams\" = \"Dr. Williams\" = \"Jane Williams\"\n   143→\n   144→CRITICAL RULES - BE CONSERVATIVE:\n   145→1. Only merge names if they CLEARLY refer to the same individual with HIGH CONFIDENCE\n   146→2. Different people with similar names should NEVER be merged\n   147→3. Pay close attention to chapter appearances and context clues\n   148→4. When in doubt, keep names SEPARATE - false negatives are better than false positives\n   149→5. A bare FIRST name can merge with a full name (e.g., \"Mike\" → \"Michael Anderson\")\n   150→6. A bare LAST name is RISKY - only merge if you're absolutely certain (could be family member)\n   151→\n   152→For the canonical name, prefer the FULL CIVILIAN NAME (first + last) over titled versions.\n   153→\n   154→NEVER merge:\n   155→- Different characters who happen to share only a first name (e.g., two characters named Michael)\n   156→- Different characters who share ONLY a last name (family members, spouses, siblings)\n   157→  - \"Mr. Anderson\" (father) ≠ \"Michael\" (son) even if both are Andersons\n   158→  - \"Robert Wilson\" ≠ \"Mrs. Wilson\" (his wife Emma)\n   159→- Characters who appear in completely different parts of the book with no overlap\n   160→- Names that are clearly different major characters (check mention counts - if both have 50+ mentions, they're probably separate people!)\n   161→\n   162→BE EXTREMELY CAUTIOUS WITH:\n   163→- Bare last names (could be family members)\n   164→- Gendered titles (Mr. vs Mrs. vs Miss suggests different people)\n   165→- Characters with similar but different names (e.g., \"Michael\" vs \"Michelle\")\n   166→\n   167→SPECIFIC ANTI-PATTERNS (DO NOT MERGE):\n   168→- Different first names + same last name (likely family members): spouses, siblings, parents/children\n   169→- Single-word names with no overlap: completely different characters with unrelated names\n   170→- Characters who co-occur but have different identities: appearing together ≠ being the same person\n   171→\n   172→ONLY merge when confident:\n   173→1. Full name + partial name: full name contains the partial name as a component\n   174→2. Title variations: titled form and untitled form of the same name\n   175→3. Obvious nickname patterns: common nickname/full name pairs\n   176→\n   177→CRITICAL MERGE PATTERNS:\n   178→\n   179→MERGE these patterns (HIGH CONFIDENCE):\n   180→- Full name variations: \"FirstName LastName\" = \"LastName\" = \"Title LastName\"\n   181→- Nickname patterns: Shortened forms or diminutives of the same character\n   182→- Birth/married names: Known alternate names for the same person (when contextually clear)\n   183→\n   184→DO NOT MERGE these patterns:\n   185→- Title-only matches: Characters sharing only a title but different last names are DIFFERENT people\n   186→- Family members: Different first names + same last name typically indicates spouses, siblings, or family (separate characters)\n   187→- Similar titles: Same professional title (Professor, Doctor, Captain) doesn't indicate same person\n   188→\n   189→CONTEXTUAL CLUES to consider:\n   190→- Relationship descriptors: \"his/her spouse\", \"his/her parent\", \"his/her sibling\" indicate SEPARATE characters\n   191→- Gendered pronouns: Consistent he/she usage helps distinguish characters with ambiguous names\n   192→- First-person narrative: First-person \"I\" may indicate narrator (check for self-references)\n   193→\n   194→MENTION COUNT HEURISTIC:\n   195→- Large disparity (e.g., 200+ vs <10 mentions) often indicates full name vs shortened form\n   196→- Similar counts (both >20 mentions) often indicates distinct characters of comparable importance\n   197→\n   198→When in doubt, keep SEPARATE. False negatives (missing an alias) are better than false positives (merging different characters).\"\"\"\n   199→\n   200→\n   201→ALIAS_RESOLUTION_PROMPT = \"\"\"Identify which character names refer to the SAME PERSON in this novel.\n   202→\n   203→CHARACTER NAMES (with chapter info and sample contexts):\n   204→{characters}\n   205→\n   206→ANALYZE CAREFULLY:\n   207→1. Check if names appear in similar chapters (overlapping chapters = might be same person)\n   208→2. Check if contexts suggest the same person\n   209→3. Look at mention counts - if both names have many mentions (50+), they're likely different major characters\n   210→4. Check for gendered title conflicts (Mr. vs Mrs. suggests different people)\n   211→5. When uncertain, keep names SEPARATE - it's better to have duplicates than to merge different people\n   212→\n   213→EXAMPLES OF CORRECT MERGES:\n   214→- \"Sarah Miller\" + \"Sarah\" → SAME (first name matches full name)\n   215→- \"Robert Chen\" + \"Chen\" + \"Mr. Chen\" → SAME (last name and titled version)\n   216→- \"Michael Anderson\" + \"Mike\" → SAME (nickname matches full name)\n   217→- \"Emma Wilson\" + \"Wilson\" + \"Miss Wilson\" → SAME (last name and titled version)\n   218→- \"Dr. Williams\" + \"James Williams\" → SAME (titled version of full name)\n   219→- \"Elizabeth Harper\" + \"Liz\" → SAME (nickname matches full name)\n   220→\n   221→EXAMPLES OF INCORRECT MERGES (DO NOT DO THIS!):\n   222→- \"Mr. Anderson\" + \"Chen\" → WRONG! (completely different people, no name overlap)\n   223→- \"Mr. Anderson\" + \"Emma\" → WRONG! (completely different people)\n   224→- \"Mr. Roberts\" + \"Mrs. Roberts\" → WRONG! (likely spouses, different people)\n   225→- \"Michael Brown\" + \"Sarah Brown\" → WRONG! (different people with same last name)\n   226→- \"Sarah\" + \"Emma\" → WRONG! (different first names = different people)\n   227→\n   228→Return JSON array:\n   229→```json\n   230→[\n   231→  {{\"canonical\": \"Full Name\", \"aliases\": [\"Nickname\", \"Title LastName\"]}},\n   232→  {{\"canonical\": \"Another Character\", \"aliases\": []}}\n   233→]\n   234→```\n   235→\n   236→Return ONLY the JSON array. Include only names you're confident about - omit uncertain names entirely rather than making bad merges.\"\"\"\n   237→\n   238→\n   239→class CharacterConsensusBuilder:\n   240→    \"\"\"\n   241→    Builds consensus across chapters and resolves aliases.\n   242→\n   243→    Takes validated proposals from all chapters and produces\n   244→    the final character map with merged mentions and aliases.\n   245→    \"\"\"\n   246→\n   247→    def __init__(\n   248→        self,\n   249→        llm_client: Optional[LLMClient] = None,\n   250→        confidence_threshold: float = 0.6,\n   251→        use_llm_alias_resolution: bool = True,\n   252→    ):\n   253→        \"\"\"\n   254→        Args:\n   255→            llm_client: LLM for alias resolution\n   256→            confidence_threshold: Threshold for high-confidence characters\n   257→            use_llm_alias_resolution: Whether to use LLM for alias resolution\n   258→        \"\"\"\n   259→        self.llm = llm_client\n   260→        self.confidence_threshold = confidence_threshold\n   261→        self.use_llm_alias_resolution = use_llm_alias_resolution and llm_client is not None\n   262→\n   263→    def build_consensus(\n   264→        self,\n   265→        validations: list[CharacterValidationResult],\n   266→        total_chapters: int,\n   267→    ) -> CharacterMap:\n   268→        \"\"\"\n   269→        Build the final character map from validated proposals.\n   270→\n   271→        Args:\n   272→            validations: All validation results from all chapters\n   273→            total_chapters: Total number of chapters in document\n   274→\n   275→        Returns:\n   276→            Final CharacterMap with merged characters\n   277→        \"\"\"\n   278→        logger.info(f\"CharacterConsensusBuilder: received {len(validations)} validations\")\n   279→\n   280→        # Filter to valid proposals\n   281→        valid_results = [v for v in validations if v.is_valid]\n   282→        invalid_count = len(validations) - len(valid_results)\n   283→        if invalid_count > 0:\n   284→            logger.info(f\"CharacterConsensusBuilder: filtered {invalid_count} invalid proposals\")\n   285→\n   286→        if not valid_results:\n   287→            return CharacterMap(\n   288→                characters=[],\n   289→                low_confidence_characters=[],\n   290→                total_mentions=0,\n   291→                total_chapters=total_chapters,\n   292→                pipeline_metadata={\"warning\": \"No valid character proposals found\"},\n   293→            )\n   294→\n   295→        # Group by name (exact match first)\n   296→        name_groups = self._group_by_name(valid_results)\n   297→        logger.info(f\"CharacterConsensusBuilder: grouped into {len(name_groups)} unique names\")\n   298→\n   299→        # Log the top names by mention count\n   300→        sorted_names = sorted(\n   301→            name_groups.items(),\n   302→            key=lambda x: sum(r.proposal.mention_count for r in x[1]),\n   303→            reverse=True\n   304→        )\n   305→        for name, results in sorted_names[:20]:\n   306→            mentions = sum(r.proposal.mention_count for r in results)\n   307→            chapters = sorted(set(r.proposal.chapter_index for r in results))\n   308→            logger.debug(f\"  '{name}': {mentions} mentions, chapters {chapters}\")\n   309→        if len(sorted_names) > 20:\n   310→            logger.debug(f\"  ... and {len(sorted_names) - 20} more names\")\n   311→\n   312→        # Separate proper names from descriptive handles\n   313→        proper_name_groups = {}\n   314→        epithet_groups = {}\n   315→        for name, results in name_groups.items():\n   316→            if self._is_descriptive_handle(name):\n   317→                epithet_groups[name] = results\n   318→            else:\n   319→                proper_name_groups[name] = results\n   320→\n   321→        if epithet_groups:\n   322→            logger.info(f\"CharacterConsensusBuilder: found {len(epithet_groups)} descriptive handles\")\n   323→\n   324→        # Resolve aliases for proper names\n   325→        if self.use_llm_alias_resolution and len(proper_name_groups) > 1:\n   326→            logger.info(\"CharacterConsensusBuilder: using LLM alias resolution\")\n   327→            alias_groups = self._llm_alias_resolution(proper_name_groups)\n   328→        else:\n   329→            logger.info(\"CharacterConsensusBuilder: using heuristic alias resolution\")\n   330→            alias_groups = self._heuristic_alias_resolution(proper_name_groups, valid_results)\n   331→\n   332→        # Resolve aliases for epithets separately\n   333→        if epithet_groups and self.use_llm_alias_resolution:\n   334→            logger.info(\"CharacterConsensusBuilder: running epithet alias resolution\")\n   335→            epithet_alias_groups = self._llm_epithet_resolution(epithet_groups)\n   336→            # Merge epithet alias groups into main alias groups\n   337→            for canonical, aliases in epithet_alias_groups.items():\n   338→                alias_groups[canonical] = aliases\n   339→        elif epithet_groups:\n   340→            # No LLM - just add epithets as separate characters\n   341→            for name in epithet_groups:\n   342→                alias_groups[name] = []\n   343→\n   344→        # Merge name_groups to include epithets for downstream processing\n   345→        name_groups.update(epithet_groups)\n   346→\n   347→        # Log alias groups\n   348→        logger.info(f\"CharacterConsensusBuilder: resolved to {len(alias_groups)} characters\")\n   349→        for canonical, aliases in sorted(alias_groups.items(), key=lambda x: -len(x[1])):\n   350→            if aliases:\n   351→                logger.info(f\"  '{canonical}' <- aliases: {aliases}\")\n   352→            else:\n   353→                logger.debug(f\"  '{canonical}' (no aliases)\")\n   354→\n   355→        # Build final characters\n   356→        characters = []\n   357→        low_confidence = []\n   358→\n   359→        for canonical_name, aliases in alias_groups.items():\n   360→            # Collect all mentions for this character\n   361→            all_mentions = []\n   362→            all_strategies = set()\n   363→            all_confidences = []\n   364→            chapters_present = set()\n   365→            all_types = []  # Track character types from all proposals\n   366→\n   367→            # Get mentions from canonical name\n   368→            if canonical_name in name_groups:\n   369→                for result in name_groups[canonical_name]:\n   370→                    all_mentions.extend(result.proposal.mentions)\n   371→                    all_strategies.add(result.proposal.strategy)\n   372→                    all_confidences.append(result.overall_score)\n   373→                    chapters_present.add(result.proposal.chapter_index)\n   374→                    # Collect character type if available\n   375→                    if hasattr(result.proposal, 'character_type'):\n   376→                        all_types.append(result.proposal.character_type)\n   377→\n   378→            # Get mentions from aliases\n   379→            for alias in aliases:\n   380→                if alias in name_groups:\n   381→                    for result in name_groups[alias]:\n   382→                        all_mentions.extend(result.proposal.mentions)\n   383→                        all_strategies.add(result.proposal.strategy)\n   384→                        all_confidences.append(result.overall_score)\n   385→                        chapters_present.add(result.proposal.chapter_index)\n   386→                        # Collect character type if available\n   387→                        if hasattr(result.proposal, 'character_type'):\n   388→                            all_types.append(result.proposal.character_type)\n   389→\n   390→            if not all_mentions:\n   391→                continue\n   392→\n   393→            # Deduplicate mentions by position (same position = same mention)\n   394→            # This handles cases where NER and LLM both find the same mention\n   395→            seen_positions = set()\n   396→            unique_mentions = []\n   397→            for mention in all_mentions:\n   398→                if mention.position not in seen_positions:\n   399→                    seen_positions.add(mention.position)\n   400→                    unique_mentions.append(mention)\n   401→            all_mentions = unique_mentions\n   402→\n   403→            # Sort mentions by position\n   404→            all_mentions.sort(key=lambda m: m.position)\n   405→\n   406→            # Calculate final confidence\n   407→            if not all_confidences:\n   408→                error_msg = f\"No confidences available for character '{canonical_name}' - cannot continue\"\n   409→                logger.error(error_msg)\n   410→                raise ValueError(error_msg)\n   411→            avg_confidence = sum(all_confidences) / len(all_confidences)\n   412→\n   413→            # Boost confidence for multiple strategies or many chapters\n   414→            if len(all_strategies) > 1:\n   415→                avg_confidence = min(1.0, avg_confidence + 0.1)\n   416→            if len(chapters_present) > 3:\n   417→                avg_confidence = min(1.0, avg_confidence + 0.05)\n   418→\n   419→            # Boost confidence based on mention count\n   420→            # High-mention characters should have high confidence (major characters)\n   421→            mention_count = len(all_mentions)\n   422→            if mention_count >= 100:\n   423→                avg_confidence = min(1.0, avg_confidence + 0.15)\n   424→            elif mention_count >= 50:\n   425→                avg_confidence = min(1.0, avg_confidence + 0.10)\n   426→            elif mention_count >= 20:\n   427→                avg_confidence = min(1.0, avg_confidence + 0.05)\n   428→\n   429→            # Determine final character type by majority vote (prefer non-UNCERTAIN)\n   430→            final_type = CharacterType.UNCERTAIN\n   431→            if all_types:\n   432→                type_counts = {}\n   433→                for t in all_types:\n   434→                    if t != CharacterType.UNCERTAIN:\n   435→                        type_counts[t] = type_counts.get(t, 0) + 1\n   436→                if type_counts:\n   437→                    final_type = max(type_counts.keys(), key=lambda t: type_counts[t])\n   438→\n   439→            # LLM fallback for uncertain character types\n   440→            if final_type == CharacterType.UNCERTAIN and self.llm:\n   441→                final_type = self._llm_classify_character_type(\n   442→                    canonical_name, all_mentions, chapters_present\n   443→                )\n   444→\n   445→            # Create character\n   446→            char_id = self._generate_id(canonical_name)\n   447→            first_chapter = min(chapters_present) if chapters_present else 1\n   448→\n   449→            character = Character(\n   450→                id=char_id,\n   451→                canonical_name=canonical_name,\n   452→                aliases=list(aliases),\n   453→                mentions=all_mentions,\n   454→                first_appearance_chapter=first_chapter,\n   455→                mention_count=len(all_mentions),\n   456→                chapters_present=sorted(chapters_present),\n   457→                confidence=avg_confidence,\n   458→                supporting_strategies=list(all_strategies),\n   459→                character_type=final_type,\n   460→            )\n   461→\n   462→            if avg_confidence >= self.confidence_threshold:\n   463→                characters.append(character)\n   464→            else:\n   465→                low_confidence.append(character)\n   466→\n   467→        # Sort by mention count\n   468→        characters.sort(key=lambda c: c.mention_count, reverse=True)\n   469→        low_confidence.sort(key=lambda c: c.mention_count, reverse=True)\n   470→\n   471→        total_mentions = sum(c.mention_count for c in characters)\n   472→        total_mentions += sum(c.mention_count for c in low_confidence)\n   473→\n   474→        return CharacterMap(\n   475→            characters=characters,\n   476→            low_confidence_characters=low_confidence,\n   477→            total_mentions=total_mentions,\n   478→            total_chapters=total_chapters,\n   479→            pipeline_metadata={\n   480→                \"high_confidence_count\": len(characters),\n   481→                \"low_confidence_count\": len(low_confidence),\n   482→                \"confidence_threshold\": self.confidence_threshold,\n   483→                \"used_llm_aliases\": self.use_llm_alias_resolution,\n   484→            },\n   485→        )\n   486→\n   487→    def _group_by_name(\n   488→        self,\n   489→        results: list[CharacterValidationResult],\n   490→    ) -> dict[str, list[CharacterValidationResult]]:\n   491→        \"\"\"Group validation results by character name.\"\"\"\n   492→        groups = defaultdict(list)\n   493→        for result in results:\n   494→            groups[result.proposal.name].append(result)\n   495→        return dict(groups)\n   496→\n   497→    def _heuristic_alias_resolution(\n   498→        self,\n   499→        name_groups: dict[str, list[CharacterValidationResult]],\n   500→        all_results: list[CharacterValidationResult],\n   501→    ) -> dict[str, list[str]]:\n   502→        \"\"\"\n   503→        Resolve aliases using heuristics.\n   504→\n   505→        Returns dict mapping canonical name to list of aliases.\n   506→        \"\"\"\n   507→        # Start with each name as its own group\n   508→        alias_map = {name: set() for name in name_groups.keys()}\n   509→\n   510→        # Collect alias candidates from validation\n   511→        alias_candidates = defaultdict(set)\n   512→        for result in all_results:\n   513→            name = result.proposal.name\n   514→            for candidate in result.alias_candidates:\n   515→                alias_candidates[name].add(candidate)\n   516→\n   517→        names = list(name_groups.keys())\n   518→\n   519→        # Find matches based on name components\n   520→        for i, name1 in enumerate(names):\n   521→            for name2 in names[i + 1:]:\n   522→                if self._names_match(name1, name2):\n   523→                    # Merge: keep longer/more complete name as canonical\n   524→                    # Calculate mention counts for both names\n   525→                    count1 = sum(r.proposal.mention_count for r in name_groups[name1])\n   526→                    count2 = sum(r.proposal.mention_count for r in name_groups[name2])\n   527→                    canonical, alias = self._pick_canonical(name1, name2, count1, count2)\n   528→                    if canonical in alias_map:\n   529→                        alias_map[canonical].add(alias)\n   530→                        # Merge alias's aliases\n   531→                        if alias in alias_map:\n   532→                            alias_map[canonical].update(alias_map[alias])\n   533→                            del alias_map[alias]\n   534→\n   535→        # Add validator's alias candidates if they match actual names\n   536→        for name, candidates in alias_candidates.items():\n   537→            if name in alias_map:\n   538→                for candidate in candidates:\n   539→                    # Check if candidate matches any actual name\n   540→                    for actual_name in name_groups.keys():\n   541→                        if actual_name != name and self._names_match(candidate, actual_name):\n   542→                            # Calculate mention counts for both names\n   543→                            count_name = sum(r.proposal.mention_count for r in name_groups[name])\n   544→                            count_actual = sum(r.proposal.mention_count for r in name_groups[actual_name])\n   545→                            canonical, alias = self._pick_canonical(name, actual_name, count_name, count_actual)\n   546→                            if canonical in alias_map and alias in alias_map:\n   547→                                alias_map[canonical].add(alias)\n   548→                                alias_map[canonical].update(alias_map[alias])\n   549→                                del alias_map[alias]\n   550→\n   551→        return {k: list(v) for k, v in alias_map.items()}\n   552→\n   553→    def _names_match(self, name1: str, name2: str) -> bool:\n   554→        \"\"\"\n   555→        Check if two names likely refer to the same person.\n   556→\n   557→        Note: This is a simple heuristic check. For last-name-only matches,\n   558→        the caller should verify there aren't multiple people with that last name.\n   559→        \"\"\"\n   560→        # Exact match (case insensitive)\n   561→        if name1.lower() == name2.lower():\n   562→            return True\n   563→\n   564→        # Normalize: remove titles, lowercase\n   565→        norm1 = self._normalize_name(name1)\n   566→        norm2 = self._normalize_name(name2)\n   567→\n   568→        if norm1 == norm2:\n   569→            return True\n   570→\n   571→        parts1 = norm1.split()\n   572→        parts2 = norm2.split()\n   573→\n   574→        # Check if one is FIRST name of the other (safe to match)\n   575→        if len(parts1) == 1 and len(parts2) > 1:\n   576→            # name1 might be first name of name2\n   577→            if parts1[0] == parts2[0]:\n   578→                return True\n   579→            # Note: We NO LONGER match last names here - too risky for family members\n   580→            # The LLM alias resolution with _validate_merge handles this case\n   581→\n   582→        if len(parts2) == 1 and len(parts1) > 1:\n   583→            # name2 might be first name of name1\n   584→            if parts2[0] == parts1[0]:\n   585→                return True\n   586→\n   587→        # Check for titled version (Mr. Smith == Smith) - but be careful\n   588→        # Only match if the title suggests same gender/role\n   589→        if len(parts1) == 1 and len(parts2) == 2:\n   590→            title = parts2[0].rstrip('.').lower()\n   591→            if title in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n   592→                if parts1[0] == parts2[1]:\n   593→                    # This is a last-name match - risky, don't auto-merge\n   594→                    # Let LLM handle it with proper validation\n   595→                    return False\n   596→\n   597→        if len(parts2) == 1 and len(parts1) == 2:\n   598→            title = parts1[0].rstrip('.').lower()\n   599→            if title in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n   600→                if parts2[0] == parts1[1]:\n   601→                    # This is a last-name match - risky, don't auto-merge\n   602→                    return False\n   603→\n   604→        return False\n   605→\n   606→    def _normalize_name(self, name: str) -> str:\n   607→        \"\"\"Normalize a name for comparison.\"\"\"\n   608→        # Remove common titles\n   609→        name = re.sub(\n   610→            r'^(mr|mrs|ms|miss|dr|sir|lady|lord)\\.?\\s+',\n   611→            '',\n   612→            name,\n   613→            flags=re.IGNORECASE\n   614→        )\n   615→        return ' '.join(name.lower().split())\n   616→\n   617→    def _pick_canonical(self, name1: str, name2: str, count1: int = 0, count2: int = 0) -> tuple[str, str]:\n   618→        \"\"\"\n   619→        Pick which name should be canonical vs alias.\n   620→\n   621→        F15: Priority order (mention count is PRIMARY):\n   622→        1. Higher mention count (most frequently used form is canonical)\n   623→        2. Longer names (more complete)\n   624→        3. Untitled over titled\n   625→        4. Alphabetically first (tiebreaker only)\n   626→        \"\"\"\n   627→        # F15: Prefer higher mention count FIRST (most used form is canonical)\n   628→        if count1 != count2:\n   629→            return (name1, name2) if count1 > count2 else (name2, name1)\n   630→\n   631→        # Prefer full names over first names\n   632→        parts1 = name1.split()\n   633→        parts2 = name2.split()\n   634→\n   635→        if len(parts1) > len(parts2):\n   636→            return name1, name2\n   637→        elif len(parts2) > len(parts1):\n   638→            return name2, name1\n   639→\n   640→        # Prefer untitled over titled (Jay Gatsby over Mr. Gatsby)\n   641→        has_title1 = parts1[0].rstrip('.').lower() in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n   642→        has_title2 = parts2[0].rstrip('.').lower() in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n   643→\n   644→        if has_title1 and not has_title2:\n   645→            return name2, name1\n   646→        elif has_title2 and not has_title1:\n   647→            return name1, name2\n   648→\n   649→        # Default: alphabetically first is canonical\n   650→        return (name1, name2) if name1 < name2 else (name2, name1)\n   651→\n   652→    def _is_ambiguous_name(self, name: str) -> bool:\n   653→        \"\"\"\n   654→        Heuristic for names that require more evidence during alias resolution.\n   655→\n   656→        Ambiguous examples:\n   657→        - Single-word names (often last-name-only)\n   658→        - Titled names (Mr./Mrs./Dr. X)\n   659→        \"\"\"\n   660→        words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n   661→        if not words:\n   662→            return True\n   663→        if words[0] in TITLES:\n   664→            return True\n   665→        significant = self._filter_title_words(words)\n   666→        return len(significant) <= 1\n   667→\n   668→    def _iter_all_mentions(self, results: list[CharacterValidationResult]) -> list[CharacterMention]:\n   669→        \"\"\"Collect all mentions from a list of validation results (can be many).\"\"\"\n   670→        mentions: list[CharacterMention] = []\n   671→        for r in results:\n   672→            if r.proposal and r.proposal.mentions:\n   673→                mentions.extend(r.proposal.mentions)\n   674→        return mentions\n   675→\n   676→    def _format_contexts(\n   677→        self,\n   678→        results: list[CharacterValidationResult],\n   679→        *,\n   680→        max_contexts: int,\n   681→        max_chars: int,\n   682→    ) -> str:\n   683→        \"\"\"\n   684→        Format diverse context snippets sampled across early/mid/late mentions.\n   685→\n   686→        Notes:\n   687→        - Mention contexts are already short (~100 chars) upstream; we avoid over-truncating further.\n   688→        - We prefer chapter diversity and narrative spread over \"first 2 mentions\".\n   689→        \"\"\"\n   690→        mentions = self._iter_all_mentions(results)\n   691→        if not mentions:\n   692→            return \"(no context)\"\n   693→\n   694→        # Sort for deterministic sampling across the narrative\n   695→        mentions_sorted = sorted(mentions, key=lambda m: (m.chapter_index, m.position))\n   696→\n   697→        # Seed picks: early / middle / late\n   698→        picks: list[CharacterMention] = []\n   699→        for idx in {0, len(mentions_sorted) // 2, len(mentions_sorted) - 1}:\n   700→            if 0 <= idx < len(mentions_sorted):\n   701→                picks.append(mentions_sorted[idx])\n   702→\n   703→        # Fill with additional mentions from new chapters if needed\n   704→        seen_chapters = {m.chapter_index for m in picks}\n   705→        seen_contexts = {m.context for m in picks if m.context}\n   706→\n   707→        for m in mentions_sorted:\n   708→            if len(picks) >= max_contexts:\n   709→                break\n   710→            if not m.context:\n   711→                continue\n   712→            if m.chapter_index in seen_chapters and m.context in seen_contexts:\n   713→                continue\n   714→            # Prefer new chapters\n   715→            if m.chapter_index not in seen_chapters:\n   716→                picks.append(m)\n   717→                seen_chapters.add(m.chapter_index)\n   718→                seen_contexts.add(m.context)\n   719→\n   720→        # Still short? Add any remaining distinct contexts (even same chapter)\n   721→        if len(picks) < max_contexts:\n   722→            for m in mentions_sorted:\n   723→                if len(picks) >= max_contexts:\n   724→                    break\n   725→                if not m.context or m.context in seen_contexts:\n   726→                    continue\n   727→                picks.append(m)\n   728→                seen_contexts.add(m.context)\n   729→\n   730→        # Render\n   731→        lines = []\n   732→        for i, m in enumerate(picks[:max_contexts], 1):\n   733→            ctx = (m.context or \"\").replace(\"\\n\", \" \").strip()\n   734→            if max_chars > 0 and len(ctx) > max_chars:\n   735→                ctx = ctx[:max_chars].rstrip() + \"...\"\n   736→            dlg = \"dialogue\" if getattr(m, \"in_dialogue\", False) else \"narrative\"\n   737→            lines.append(f\"{i}. [ch {m.chapter_index}, {dlg}] \\\"{ctx}\\\"\")\n   738→        return \"\\n\".join(lines) if lines else \"(no context)\"\n   739→\n   740→    def _total_mentions_for_name(\n   741→        self,\n   742→        name: str,\n   743→        name_groups: dict[str, list[CharacterValidationResult]],\n   744→    ) -> int:\n   745→        results = name_groups.get(name, [])\n   746→        return sum(r.proposal.mention_count for r in results)\n   747→\n   748→    def _chapters_for_name(\n   749→        self,\n   750→        name: str,\n   751→        name_groups: dict[str, list[CharacterValidationResult]],\n   752→        *,\n   753→        max_chapters: int = 12,\n   754→    ) -> str:\n   755→        results = name_groups.get(name, [])\n   756→        chapters = sorted(set(r.proposal.chapter_index for r in results))\n   757→        if not chapters:\n   758→            return \"(none)\"\n   759→        if len(chapters) <= max_chapters:\n   760→            return \", \".join(str(c) for c in chapters)\n   761→        return \", \".join(str(c) for c in chapters[:max_chapters]) + f\"... ({len(chapters)} total)\"\n   762→\n   763→    def _build_alias_prompt_global(\n   764→        self,\n   765→        name_groups: dict[str, list[CharacterValidationResult]],\n   766→    ) -> str:\n   767→        \"\"\"Build the global alias-resolution prompt with richer contexts.\"\"\"\n   768→        char_lines: list[str] = []\n   769→\n   770→        # Sort by total mention count (desc) for more salient characters first.\n   771→        sorted_items = sorted(\n   772→            name_groups.items(),\n   773→            key=lambda x: -sum(r.proposal.mention_count for r in x[1]),\n   774→        )\n   775→\n   776→        for name, results in sorted_items:\n   777→            total_mentions = sum(r.proposal.mention_count for r in results)\n   778→            chapters_str = self._chapters_for_name(name, name_groups, max_chapters=12)\n   779→\n   780→            # More evidence for ambiguous names (last-name-only, titled forms)\n   781→            ambiguous = self._is_ambiguous_name(name)\n   782→            max_ctx = 6 if ambiguous else 4\n   783→            max_chars = 180 if ambiguous else 140\n   784→            context_str = self._format_contexts(results, max_contexts=max_ctx, max_chars=max_chars)\n   785→\n   786→            char_lines.append(f\"- {name} ({total_mentions} mentions, chapters: {chapters_str})\")\n   787→            char_lines.append(f\"  Context:\\n{context_str}\")\n   788→\n   789→        characters_str = \"\\n\".join(char_lines)\n   790→        return ALIAS_RESOLUTION_PROMPT.format(characters=characters_str)\n   791→\n   792→    def _candidate_pairs_for_merge(\n   793→        self,\n   794→        name_groups: dict[str, list[CharacterValidationResult]],\n   795→        *,\n   796→        max_pairs: int = 250,\n   797→    ) -> list[tuple[str, str]]:\n   798→        \"\"\"\n   799→        Generate plausible alias candidate pairs using cheap heuristics.\n   800→\n   801→        Goal: avoid O(n^2) on large casts while still capturing obvious merges.\n   802→        \"\"\"\n   803→        names = list(name_groups.keys())\n   804→        if len(names) < 2:\n   805→            return []\n   806→\n   807→        # Token index for significant words (excluding titles)\n   808→        token_to_names: dict[str, list[str]] = defaultdict(list)\n   809→        for name in names:\n   810→            words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n   811→            sig = self._filter_title_words(words)\n   812→            for w in sig:\n   813→                token_to_names[w].append(name)\n   814→\n   815→        # Rank names by mention count for throttling big token buckets\n   816→        mention_rank = {n: self._total_mentions_for_name(n, name_groups) for n in names}\n   817→\n   818→        pairs_set: set[tuple[str, str]] = set()\n   819→\n   820→        def add_pair(a: str, b: str):\n   821→            if a == b:\n   822→                return\n   823→            x, y = (a, b) if a < b else (b, a)\n   824→            pairs_set.add((x, y))\n   825→\n   826→        # Generate within token buckets\n   827→        for token, bucket in token_to_names.items():\n   828→            if len(bucket) < 2:\n   829→                continue\n   830→            # For very common tokens, only consider the top-N by mentions to avoid blowup\n   831→            bucket_sorted = sorted(bucket, key=lambda n: -mention_rank.get(n, 0))\n   832→            cap = 20 if len(bucket_sorted) > 20 else len(bucket_sorted)\n   833→            bucket_sorted = bucket_sorted[:cap]\n   834→\n   835→            for i in range(len(bucket_sorted)):\n   836→                for j in range(i + 1, len(bucket_sorted)):\n   837→                    add_pair(bucket_sorted[i], bucket_sorted[j])\n   838→                    if len(pairs_set) >= max_pairs:\n   839→                        break\n   840→                if len(pairs_set) >= max_pairs:\n   841→                    break\n   842→            if len(pairs_set) >= max_pairs:\n   843→                break\n   844→\n   845→        # Add substring-based candidates (e.g., \"Gatsby\" in \"Jay Gatsby\")\n   846→        if len(pairs_set) < max_pairs:\n   847→            # Only compare top-N by mentions to keep it bounded\n   848→            top = sorted(names, key=lambda n: -mention_rank.get(n, 0))[:80]\n   849→            norm = {n: self._normalize_name(n) for n in top}\n   850→            for i in range(len(top)):\n   851→                for j in range(i + 1, len(top)):\n   852→                    n1, n2 = top[i], top[j]\n   853→                    a, b = norm[n1], norm[n2]\n   854→                    if a and b and (a in b or b in a):\n   855→                        add_pair(n1, n2)\n   856→                        if len(pairs_set) >= max_pairs:\n   857→                            break\n   858→                if len(pairs_set) >= max_pairs:\n   859→                    break\n   860→\n   861→        # Add nickname-based candidates (e.g., \"Kate\" and \"Cathy\", \"Elizabeth\" and \"Lizzy\")\n   862→        # This catches aliases that share no words but are known nickname variants\n   863→        if len(pairs_set) < max_pairs:\n   864→            # Build index of names by their first significant word (likely the first name)\n   865→            # Only consider top characters by mention count to avoid explosion\n   866→            top = sorted(names, key=lambda n: -mention_rank.get(n, 0))[:100]\n   867→\n   868→            # Extract the likely \"first name\" from each name for nickname matching\n   869→            def extract_first_name(name: str) -> str:\n   870→                \"\"\"Extract the first name (excluding titles) for nickname matching.\"\"\"\n   871→                words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n   872→                significant = self._filter_title_words(words)\n   873→                return list(significant)[0] if significant else \"\"\n   874→\n   875→            first_names = {n: extract_first_name(n) for n in top}\n   876→\n   877→            # Group names by their nickname variant sets\n   878→            # Names with overlapping variant sets should be paired\n   879→            for i in range(len(top)):\n   880→                if len(pairs_set) >= max_pairs:\n   881→                    break\n   882→                n1 = top[i]\n   883→                fn1 = first_names[n1]\n   884→                if not fn1:\n   885→                    continue\n   886→\n   887→                for j in range(i + 1, len(top)):\n   888→                    if len(pairs_set) >= max_pairs:\n   889→                        break\n   890→                    n2 = top[j]\n   891→                    fn2 = first_names[n2]\n   892→                    if not fn2:\n   893→                        continue\n   894→\n   895→                    # Check if the first names are potential nickname variants\n   896→                    if are_potential_nicknames(fn1, fn2):\n   897→                        add_pair(n1, n2)\n   898→                        logger.debug(\n   899→                            f\"Nickname match: '{n1}' ({fn1}) <-> '{n2}' ({fn2})\"\n   900→                        )\n   901→\n   902→        return list(pairs_set)\n   903→\n   904→    def _llm_pairwise_merge_decision(\n   905→        self,\n   906→        name_a: str,\n   907→        name_b: str,\n   908→        name_groups: dict[str, list[CharacterValidationResult]],\n   909→    ) -> tuple[bool, float, Optional[str], Optional[str]]:\n   910→        \"\"\"\n   911→        Ask the LLM whether two names should be merged.\n   912→\n   913→        Returns:\n   914→          (same_person, confidence, canonical, alias)\n   915→        \"\"\"\n   916→        results_a = name_groups.get(name_a, [])\n   917→        results_b = name_groups.get(name_b, [])\n   918→\n   919→        # More evidence when ambiguous\n   920→        amb = self._is_ambiguous_name(name_a) or self._is_ambiguous_name(name_b)\n   921→        ctx_a = self._format_contexts(results_a, max_contexts=6 if amb else 4, max_chars=200 if amb else 160)\n   922→        ctx_b = self._format_contexts(results_b, max_contexts=6 if amb else 4, max_chars=200 if amb else 160)\n   923→\n   924→        prompt = PAIRWISE_ALIAS_PROMPT.format(\n   925→            name_a=name_a,\n   926→            mentions_a=self._total_mentions_for_name(name_a, name_groups),\n   927→            chapters_a=self._chapters_for_name(name_a, name_groups, max_chapters=16),\n   928→            contexts_a=ctx_a,\n   929→            name_b=name_b,\n   930→            mentions_b=self._total_mentions_for_name(name_b, name_groups),\n   931→            chapters_b=self._chapters_for_name(name_b, name_groups, max_chapters=16),\n   932→            contexts_b=ctx_b,\n   933→        )\n   934→\n   935→        result, response = self.llm.query_json(prompt, system=PAIRWISE_ALIAS_SYSTEM)\n   936→        if not response.success or result is None or not isinstance(result, dict):\n   937→            raise ValueError(f\"Pairwise alias LLM failed for '{name_a}' vs '{name_b}'\")\n   938→\n   939→        same = bool(result.get(\"same_person\", False))\n   940→        conf = float(result.get(\"confidence\", 0.0) or 0.0)\n   941→        canonical = result.get(\"canonical\")\n   942→        alias = result.get(\"alias\")\n   943→\n   944→        # Enforce canonical/alias must be exactly one of the provided names\n   945→        if same:\n   946→            if canonical not in (name_a, name_b) or alias not in (name_a, name_b) or canonical == alias:\n   947→                # Fall back to deterministic canonical choice\n   948→                count_a = self._total_mentions_for_name(name_a, name_groups)\n   949→                count_b = self._total_mentions_for_name(name_b, name_groups)\n   950→                canonical, alias = self._pick_canonical(name_a, name_b, count_a, count_b)\n   951→        return same, conf, canonical, alias\n   952→\n   953→    def _llm_alias_resolution_pairwise(\n   954→        self,\n   955→        name_groups: dict[str, list[CharacterValidationResult]],\n   956→    ) -> dict[str, list[str]]:\n   957→        \"\"\"\n   958→        Two-stage alias resolution:\n   959→        1) Cheap heuristics propose candidate merges\n   960→        2) LLM evaluates candidates pairwise with richer evidence\n   961→        \"\"\"\n   962→        names = list(name_groups.keys())\n   963→        if len(names) < 2:\n   964→            return {n: [] for n in names}\n   965→\n   966→        candidates = self._candidate_pairs_for_merge(name_groups, max_pairs=250)\n   967→        logger.info(f\"Pairwise alias resolution: evaluating {len(candidates)} candidate pairs\")\n   968→\n   969→        # Union-Find to build clusters\n   970→        parent: dict[str, str] = {n: n for n in names}\n   971→\n   972→        def find(x: str) -> str:\n   973→            while parent[x] != x:\n   974→                parent[x] = parent[parent[x]]\n   975→                x = parent[x]\n   976→            return x\n   977→\n   978→        def union(a: str, b: str):\n   979→            ra, rb = find(a), find(b)\n   980→            if ra != rb:\n   981→                parent[rb] = ra\n   982→\n   983→        # Evaluate candidates\n   984→        accepted = 0\n   985→        for a, b in candidates:\n   986→            same, conf, canonical, alias = self._llm_pairwise_merge_decision(a, b, name_groups)\n   987→            if not same or conf < 0.7:\n   988→                continue\n   989→\n   990→            # Validate with our strict sanity checks before merging\n   991→            is_valid, _vconf = self._validate_merge(canonical or a, alias or b, name_groups)\n   992→            if not is_valid:\n   993→                continue\n   994→\n   995→            union(a, b)\n   996→            accepted += 1\n   997→\n   998→        logger.info(f\"Pairwise alias resolution: accepted {accepted}/{len(candidates)} merges\")\n   999→\n  1000→        # Build components\n  1001→        components: dict[str, list[str]] = defaultdict(list)\n  1002→        for n in names:\n  1003→            components[find(n)].append(n)\n  1004→\n  1005→        # Choose canonical for each component deterministically using mention counts + name completeness\n  1006→        # F15: Mention count is PRIMARY factor, then name quality indicators\n  1007→        alias_map: dict[str, list[str]] = {}\n  1008→        for _root, members in components.items():\n  1009→            if len(members) == 1:\n  1010→                alias_map[members[0]] = []\n  1011→                continue\n  1012→\n  1013→            def score(name: str) -> tuple[int, int, int, int, str]:\n  1014→                parts = name.split()\n  1015→                has_title = 1 if parts and parts[0].rstrip('.').lower() in TITLES else 0\n  1016→                mention_count = self._total_mentions_for_name(name, name_groups)\n  1017→                # F15: Priority order:\n  1018→                # 1. Higher mention count (PRIMARY - most used form is canonical)\n  1019→                # 2. More name parts (more complete names)\n  1020→                # 3. No title preferred (-has_title: untitled=0 > titled=-1)\n  1021→                # 4. Alphabetically first (tiebreaker only)\n  1022→                # Note: we negate name for alphabetically-first tiebreaker with max()\n  1023→                return (mention_count, len(parts), -has_title, 0, name)\n  1024→\n  1025→            # Use min on inverted tuple for alphabetical tiebreaker (first alphabetically wins)\n  1026→            def score_with_alpha_first(name: str) -> tuple:\n  1027→                parts = name.split()\n  1028→                has_title = 1 if parts and parts[0].rstrip('.').lower() in TITLES else 0\n  1029→                mention_count = self._total_mentions_for_name(name, name_groups)\n  1030→                # Negate values we want to maximize, so min() picks the best\n  1031→                return (-mention_count, -len(parts), has_title, name.lower())\n  1032→\n  1033→            canonical = min(members, key=score_with_alpha_first)\n  1034→            aliases = [m for m in members if m != canonical]\n  1035→            alias_map[canonical] = aliases\n  1036→\n  1037→        # Post-check obvious merges the LLM missed (still useful)\n  1038→        alias_map = self._post_llm_merge_check(alias_map, name_groups)\n  1039→        return alias_map\n  1040→\n  1041→    def _llm_alias_resolution(\n  1042→        self,\n  1043→        name_groups: dict[str, list[CharacterValidationResult]],\n  1044→    ) -> dict[str, list[str]]:\n  1045→        \"\"\"Use LLM to resolve aliases with rich context.\"\"\"\n  1046→        # If there are many unique names, a single giant \"merge everyone\" prompt becomes\n  1047→        # both expensive and error-prone. Switch to pairwise mode automatically.\n  1048→        if len(name_groups) > 60:\n  1049→            logger.info(f\"CharacterConsensusBuilder: large cast ({len(name_groups)} names) - using pairwise LLM alias resolution\")\n  1050→            return self._llm_alias_resolution_pairwise(name_groups)\n  1051→\n  1052→        prompt = self._build_alias_prompt_global(name_groups)\n  1053→\n  1054→        # Retry logic: LLM is essential for character merging\n  1055→        max_retries = 2\n  1056→        last_error = None\n  1057→\n  1058→        for attempt in range(max_retries + 1):\n  1059→            try:\n  1060→                result, response = self.llm.query_json(prompt, system=ALIAS_RESOLUTION_SYSTEM)\n  1061→\n  1062→                if result is None:\n  1063→                    raise ValueError(\"LLM returned None - possibly parsing failure\")\n  1064→\n  1065→                if not isinstance(result, list):\n  1066→                    raise ValueError(f\"LLM returned non-list: {type(result)}\")\n  1067→\n  1068→                # Success - break out of retry loop\n  1069→                break\n  1070→\n  1071→            except Exception as e:\n  1072→                last_error = e\n  1073→                logger.warning(f\"LLM alias resolution attempt {attempt + 1} failed: {e}\")\n  1074→\n  1075→                if attempt == max_retries:\n  1076→                    # All retries exhausted - fail loudly\n  1077→                    logger.error(\"All LLM attempts failed - character alias resolution cannot proceed\")\n  1078→                    raise RuntimeError(\n  1079→                        \"LLM alias resolution failed after all retries. \"\n  1080→                        \"LLM is required for accurate character merging. \"\n  1081→                        f\"Last error: {last_error}\"\n  1082→                    ) from last_error\n  1083→\n  1084→                # Wait before retry\n  1085→                time.sleep(1)\n  1086→\n  1087→        # Parse LLM response WITH VALIDATION\n  1088→        alias_map = {}\n  1089→        seen_names = set()\n  1090→\n  1091→        for group in result:\n  1092→            if not isinstance(group, dict):\n  1093→                continue\n  1094→\n  1095→            canonical = group.get(\"canonical\", \"\")\n  1096→            aliases = group.get(\"aliases\", [])\n  1097→\n  1098→            if not canonical:\n  1099→                continue\n  1100→\n  1101→            # Verify canonical exists in our names (strict matching)\n  1102→            matched_canonical = self._find_closest_name(canonical, name_groups.keys())\n  1103→            if not matched_canonical:\n  1104→                continue\n  1105→\n  1106→            if matched_canonical in seen_names:\n  1107→                continue\n  1108→\n  1109→            seen_names.add(matched_canonical)\n  1110→            alias_map[matched_canonical] = []\n  1111→\n  1112→            for alias in aliases:\n  1113→                matched_alias = self._find_closest_name(alias, name_groups.keys())\n  1114→                if not matched_alias or matched_alias in seen_names:\n  1115→                    continue\n  1116→\n  1117→                # VALIDATE the merge before accepting it\n  1118→                is_valid, confidence = self._validate_merge(\n  1119→                    matched_canonical, matched_alias, name_groups\n  1120→                )\n  1121→\n  1122→                if is_valid:\n  1123→                    alias_map[matched_canonical].append(matched_alias)\n  1124→                    seen_names.add(matched_alias)\n  1125→                    logger.debug(f\"Accepted merge: {matched_canonical} <- {matched_alias} (conf={confidence:.2f})\")\n  1126→                else:\n  1127→                    logger.debug(f\"Rejected merge: {matched_canonical} <- {matched_alias} (conf={confidence:.2f})\")\n  1128→\n  1129→        # Add any names not covered by LLM\n  1130→        for name in name_groups.keys():\n  1131→            if name not in seen_names:\n  1132→                alias_map[name] = []\n  1133→\n  1134→        # Post-LLM validation: Check for obvious merges the LLM missed\n  1135→        # e.g., \"Nick\" should merge with \"Nick Carraway\" even if LLM didn't suggest it\n  1136→        alias_map = self._post_llm_merge_check(alias_map, name_groups)\n  1137→\n  1138→        return alias_map\n  1139→\n  1140→    def _post_llm_merge_check(\n  1141→        self,\n  1142→        alias_map: dict[str, list[str]],\n  1143→        name_groups: dict[str, list[CharacterValidationResult]],\n  1144→    ) -> dict[str, list[str]]:\n  1145→        \"\"\"\n  1146→        Check for obvious merges the LLM missed.\n  1147→\n  1148→        Handles cases like \"Nick\" + \"Nick Carraway\" where the first name\n  1149→        clearly matches the full name.\n  1150→        \"\"\"\n  1151→        canonicals = list(alias_map.keys())\n  1152→        merged = set()  # Track names that get merged\n  1153→\n  1154→        for i, name1 in enumerate(canonicals):\n  1155→            if name1 in merged:\n  1156→                continue\n  1157→\n  1158→            for name2 in canonicals[i + 1:]:\n  1159→                if name2 in merged:\n  1160→                    continue\n  1161→\n  1162→                # Check if these should be merged\n  1163→                is_valid, confidence = self._validate_merge(name1, name2, name_groups)\n  1164→\n  1165→                # Higher threshold for post-LLM merges to avoid introducing false merges\n  1166→                if is_valid and confidence >= 0.85:\n  1167→                    # Merge: pick the more complete name as canonical\n  1168→                    # Calculate mention counts for both names\n  1169→                    count1 = sum(r.proposal.mention_count for r in name_groups[name1])\n  1170→                    count2 = sum(r.proposal.mention_count for r in name_groups[name2])\n  1171→                    canonical, alias = self._pick_canonical(name1, name2, count1, count2)\n  1172→\n  1173→                    # If canonical was name2, we need to swap in alias_map\n  1174→                    if canonical == name2:\n  1175→                        canonical, alias = name2, name1\n  1176→\n  1177→                    if canonical in alias_map and alias in alias_map:\n  1178→                        logger.info(\n  1179→                            f\"Post-LLM merge: '{canonical}' <- '{alias}' \"\n  1180→                            f\"(LLM missed this merge)\"\n  1181→                        )\n  1182→                        alias_map[canonical].append(alias)\n  1183→                        alias_map[canonical].extend(alias_map.get(alias, []))\n  1184→                        del alias_map[alias]\n  1185→                        merged.add(alias)\n  1186→\n  1187→        return alias_map\n  1188→\n  1189→    def _find_closest_name(\n  1190→        self,\n  1191→        target: str,\n  1192→        candidates: list[str],\n  1193→    ) -> Optional[str]:\n  1194→        \"\"\"Find the closest matching name from candidates (strict matching).\"\"\"\n  1195→        target_lower = target.lower()\n  1196→        target_norm = self._normalize_name(target)\n  1197→\n  1198→        # Priority 1: Exact match (case insensitive)\n  1199→        for candidate in candidates:\n  1200→            if candidate.lower() == target_lower:\n  1201→                return candidate\n  1202→\n  1203→        # Priority 2: Normalized match (after removing titles)\n  1204→        for candidate in candidates:\n  1205→            if self._normalize_name(candidate) == target_norm:\n  1206→                return candidate\n  1207→\n  1208→        # Priority 3: High similarity match (>0.85)\n  1209→        # This catches minor typos but not completely different names\n  1210→        best_match = None\n  1211→        best_score = 0.0\n  1212→        for candidate in candidates:\n  1213→            score = self._name_similarity(target, candidate)\n  1214→            if score > best_score and score > 0.85:\n  1215→                best_score = score\n  1216→                best_match = candidate\n  1217→\n  1218→        if best_match:\n  1219→            return best_match\n  1220→\n  1221→        # NO partial/component matching - too error-prone\n  1222→        # If we can't find a clear match, return None\n  1223→        return None\n  1224→\n  1225→    def _filter_title_words(self, words: list[str]) -> set[str]:\n  1226→        \"\"\"\n  1227→        Extract significant words from a name, excluding titles.\n  1228→\n  1229→        Titles like \"Mr.\", \"Miss\", \"Dr.\" are social indicators, not part of the actual name.\n  1230→        Filtering them prevents spurious merges like \"Miss X\" with \"Miss Y\" based solely\n  1231→        on the shared title word.\n  1232→\n  1233→        Args:\n  1234→            words: List of words from a character name\n  1235→\n  1236→        Returns:\n  1237→            Set of significant words (length >= 3, not titles)\n  1238→        \"\"\"\n  1239→        return {w for w in words if len(w) >= 3 and w.lower() not in TITLES}\n  1240→\n  1241→    def _check_aggressive_alias_patterns(self, name1: str, name2: str) -> tuple[bool, float]:\n  1242→        \"\"\"\n  1243→        Check for common alias patterns that should be merged aggressively.\n  1244→\n  1245→        Handles hyphenation and spacing variants like:\n  1246→        - \"Owl Eyes\" vs \"Owl-eyes\"\n  1247→        - \"Mc Donald\" vs \"McDonald\"\n  1248→\n  1249→        Returns:\n  1250→            (should_merge, confidence) tuple\n  1251→        \"\"\"\n  1252→        # Normalize: lowercase, remove hyphens/dots, collapse spaces\n  1253→        n1_lower = name1.lower().replace('-', ' ').replace('.', '')\n  1254→        n2_lower = name2.lower().replace('-', ' ').replace('.', '')\n  1255→\n  1256→        n1_normalized = ' '.join(n1_lower.split())\n  1257→        n2_normalized = ' '.join(n2_lower.split())\n  1258→\n  1259→        # Exact match after normalization (handles \"Owl-Eyes\" vs \"Owl Eyes\")\n  1260→        if n1_normalized == n2_normalized:\n  1261→            return True, 0.95\n  1262→\n  1263→        # Match after removing all spaces (handles \"Owl Eyes\" vs \"Owleyes\")\n  1264→        if n1_normalized.replace(' ', '') == n2_normalized.replace(' ', ''):\n  1265→            return True, 0.90\n  1266→\n  1267→        return False, 0.0\n  1268→\n  1269→    def _check_birth_name_pattern(\n  1270→        self,\n  1271→        canonical: str,\n  1272→        alias: str,\n  1273→        name_groups: dict[str, list[CharacterValidationResult]],\n  1274→    ) -> tuple[bool, float]:\n  1275→        \"\"\"\n  1276→        Check if two names represent a birth name / assumed name pattern.\n  1277→\n  1278→        Looks for context clues like \"born as\", \"real name\", \"changed his name\"\n  1279→        in the mentions for either name.\n  1280→\n  1281→        IMPORTANT: We iterate through each name's contexts separately and check\n  1282→        if they mention the OTHER name with an indicator. This catches patterns\n  1283→        like \"He was born as James Gatz\" in Jay Gatsby's context.\n  1284→\n  1285→        Returns:\n  1286→            (should_merge, confidence) tuple\n  1287→        \"\"\"\n  1288→        birth_name_indicators = [\n  1289→            \"born as\", \"real name\", \"birth name\", \"whose real name\",\n  1290→            \"formerly known as\", \"changed his name\", \"changed her name\",\n  1291→            \"once called\", \"used to be called\", \"originally named\",\n  1292→            \"actually named\", \"true name\", \"given name\",\n  1293→        ]\n  1294→\n  1295→        # Normalize names for matching\n  1296→        canonical_lower = canonical.lower()\n  1297→        alias_lower = alias.lower()\n  1298→\n  1299→        # Also check individual name components (first/last names, excluding short words)\n  1300→        canonical_parts = {p for p in canonical_lower.split() if len(p) > 2}\n  1301→        alias_parts = {p for p in alias_lower.split() if len(p) > 2}\n  1302→\n  1303→        def name_in_context(name_lower: str, parts: set, context: str) -> bool:\n  1304→            \"\"\"Check if a name (or its significant parts) appears in context.\"\"\"\n  1305→            if name_lower in context:\n  1306→                return True\n  1307→            return any(part in context for part in parts)\n  1308→\n  1309→        # Check canonical's contexts for mentions of alias (the OTHER name)\n  1310→        for result in name_groups.get(canonical, [])[:10]:\n  1311→            for mention in result.proposal.mentions[:5]:\n  1312→                if not mention.context:\n  1313→                    continue\n  1314→                context = mention.context.lower()\n  1315→                for indicator in birth_name_indicators:\n  1316→                    if indicator in context:\n  1317→                        # Check if the OTHER name (alias) appears in canonical's context\n  1318→                        if name_in_context(alias_lower, alias_parts, context):\n  1319→                            logger.info(\n  1320→                                f\"Birth name pattern detected: {canonical} <-> {alias} \"\n  1321→                                f\"(indicator: '{indicator}' in {canonical}'s context mentions {alias})\"\n  1322→                            )\n  1323→                            return True, 0.85\n  1324→\n  1325→        # Check alias's contexts for mentions of canonical (the OTHER name)\n  1326→        for result in name_groups.get(alias, [])[:10]:\n  1327→            for mention in result.proposal.mentions[:5]:\n  1328→                if not mention.context:\n  1329→                    continue\n  1330→                context = mention.context.lower()\n  1331→                for indicator in birth_name_indicators:\n  1332→                    if indicator in context:\n  1333→                        # Check if the OTHER name (canonical) appears in alias's context\n  1334→                        if name_in_context(canonical_lower, canonical_parts, context):\n  1335→                            logger.info(\n  1336→                                f\"Birth name pattern detected: {canonical} <-> {alias} \"\n  1337→                                f\"(indicator: '{indicator}' in {alias}'s context mentions {canonical})\"\n  1338→                            )\n  1339→                            return True, 0.85\n  1340→\n  1341→        return False, 0.0\n  1342→\n  1343→    def _llm_classify_character_type(\n  1344→        self,\n  1345→        name: str,\n  1346→        mentions: list[CharacterMention],\n  1347→        chapters_present: set[int],\n  1348→    ) -> CharacterType:\n  1349→        \"\"\"\n  1350→        Use LLM to classify uncertain character types.\n  1351→\n  1352→        Called when majority voting fails to determine character type.\n  1353→        Returns CharacterType based on LLM analysis of contexts.\n  1354→        \"\"\"\n  1355→        if not self.llm:\n  1356→            return CharacterType.UNCERTAIN\n  1357→\n  1358→        # Format contexts for prompt\n  1359→        context_lines = []\n  1360→        for i, mention in enumerate(mentions[:6]):  # Sample up to 6 contexts\n  1361→            if mention.context:\n  1362→                dlg = \"dialogue\" if mention.in_dialogue else \"narrative\"\n  1363→                context_lines.append(\n  1364→                    f\"{i+1}. [ch {mention.chapter_index}, {dlg}] \\\"{mention.context[:150]}\\\"\"\n  1365→                )\n  1366→\n  1367→        if not context_lines:\n  1368→            return CharacterType.UNCERTAIN\n  1369→\n  1370→        prompt = CHARACTER_TYPE_PROMPT.format(\n  1371→            name=name,\n  1372→            mention_count=len(mentions),\n  1373→            chapters=\", \".join(str(c) for c in sorted(chapters_present)),\n  1374→            contexts=\"\\n\".join(context_lines),\n  1375→        )\n  1376→\n  1377→        try:\n  1378→            result, response = self.llm.query_json(prompt, system=CHARACTER_TYPE_SYSTEM)\n  1379→\n  1380→            if result and isinstance(result, dict):\n  1381→                char_type_str = result.get(\"character_type\", \"\").lower()\n  1382→                confidence = float(result.get(\"confidence\", 0.0) or 0.0)\n  1383→\n  1384→                # Only accept high-confidence classifications\n  1385→                if confidence >= 0.7:\n  1386→                    if char_type_str == \"story\":\n  1387→                        logger.debug(f\"LLM classified '{name}' as STORY (conf={confidence:.2f})\")\n  1388→                        return CharacterType.STORY\n  1389→                    elif char_type_str == \"historical\":\n  1390→                        logger.debug(f\"LLM classified '{name}' as HISTORICAL (conf={confidence:.2f})\")\n  1391→                        return CharacterType.HISTORICAL\n  1392→                    elif char_type_str == \"referenced\":\n  1393→                        logger.debug(f\"LLM classified '{name}' as REFERENCED (conf={confidence:.2f})\")\n  1394→                        return CharacterType.REFERENCED\n  1395→\n  1396→        except Exception as e:\n  1397→            logger.warning(f\"LLM character type classification failed for '{name}': {e}\")\n  1398→\n  1399→        return CharacterType.UNCERTAIN\n  1400→\n  1401→    def _validate_merge(\n  1402→        self,\n  1403→        canonical: str,\n  1404→        alias: str,\n  1405→        name_groups: dict[str, list[CharacterValidationResult]],\n  1406→    ) -> tuple[bool, float]:\n  1407→        \"\"\"\n  1408→        Validate LLM merge decision with sanity checks.\n  1409→\n  1410→        Key checks:\n  1411→        1. Check aggressive alias patterns (hyphenation/spacing variants) first\n  1412→        2. Check birth name patterns (context clues like \"real name\", \"born as\")\n  1413→        3. Reject merges that only share a last name when multiple people have that last name\n  1414→        4. Reject merges with no shared words and no chapter overlap\n  1415→\n  1416→        Returns:\n  1417→            (is_valid, confidence) tuple\n  1418→        \"\"\"\n  1419→        # CHECK 1: Aggressive alias patterns (hyphenation/spacing variants)\n  1420→        # These should always merge regardless of other checks\n  1421→        is_alias_pattern, alias_conf = self._check_aggressive_alias_patterns(canonical, alias)\n  1422→        if is_alias_pattern:\n  1423→            logger.debug(\n  1424→                f\"Merge accepted: {canonical} <- {alias} \"\n  1425→                f\"(aggressive alias pattern, conf={alias_conf:.2f})\"\n  1426→            )\n  1427→            return True, alias_conf\n  1428→\n  1429→        # CHECK 2: Birth name patterns (context clues)\n  1430→        # These can merge names with no shared words if context supports it\n  1431→        is_birth_name, birth_conf = self._check_birth_name_pattern(canonical, alias, name_groups)\n  1432→        if is_birth_name:\n  1433→            logger.debug(\n  1434→                f\"Merge accepted: {canonical} <- {alias} \"\n  1435→                f\"(birth name pattern, conf={birth_conf:.2f})\"\n  1436→            )\n  1437→            return True, birth_conf\n  1438→\n  1439→        # Extract words from names, filtering out titles\n  1440→        words1 = re.sub(r'[^\\w\\s]', '', canonical.lower()).split()\n  1441→        words2 = re.sub(r'[^\\w\\s]', '', alias.lower()).split()\n  1442→        # Use helper to filter title words - prevents spurious merges on title alone\n  1443→        significant1 = self._filter_title_words(words1)\n  1444→        significant2 = self._filter_title_words(words2)\n  1445→        shared_words = significant1 & significant2\n  1446→\n  1447→        # SINGLE-WORD NAME HANDLING\n  1448→        # When comparing single-word vs multi-word names, assume the single word is the LAST NAME\n  1449→        # (most common pattern in literature: \"Smith\" is the last name in \"John Smith\")\n  1450→        is_single_word1 = len(significant1) == 1\n  1451→        is_single_word2 = len(significant2) == 1\n  1452→\n  1453→        if is_single_word1 and not is_single_word2:\n  1454→            # Comparing single-word (e.g., \"Smith\") vs multi-word (e.g., \"John Smith\")\n  1455→            # Assume single word is the LAST NAME\n  1456→            single_word = list(significant1)[0]\n  1457→            multi_words = significant2\n  1458→\n  1459→            # Check if single word appears in multi-word name\n  1460→            if single_word in multi_words:\n  1461→                # This is likely the same person (full name variant)\n  1462→                logger.debug(\n  1463→                    f\"Merge accepted: {canonical} <- {alias} \"\n  1464→                    f\"(single-word '{single_word}' appears in multi-word name)\"\n  1465→                )\n  1466→                return True, 0.90  # High confidence\n  1467→\n  1468→        elif is_single_word2 and not is_single_word1:\n  1469→            # Reverse case: multi-word vs single-word\n  1470→            single_word = list(significant2)[0]\n  1471→            multi_words = significant1\n  1472→\n  1473→            if single_word in multi_words:\n  1474→                logger.debug(\n  1475→                    f\"Merge accepted: {canonical} <- {alias} \"\n  1476→                    f\"(single-word '{single_word}' appears in multi-word name)\"\n  1477→                )\n  1478→                return True, 0.90  # High confidence\n  1479→\n  1480→        # NEW CHECK: Reject completely different single-word names\n  1481→        # If both are single-word names with NO shared words, reject UNLESS they are\n  1482→        # known nickname variants (e.g., Kate/Cathy, Elizabeth/Lizzy)\n  1483→        # NOTE: This prevents the worst over-merges (Alice + Robert) during validation\n  1484→        # while allowing legitimate nickname pairs to be merged.\n  1485→        if len(significant1) == 1 and len(significant2) == 1:\n  1486→            if not shared_words:  # Different single-word names\n  1487→                # Check if they're known nickname variants before rejecting\n  1488→                word1 = list(significant1)[0].lower()\n  1489→                word2 = list(significant2)[0].lower()\n  1490→                if not are_potential_nicknames(word1, word2):\n  1491→                    logger.debug(\n  1492→                        f\"Merge rejected: {canonical} <-> {alias} \"\n  1493→                        f\"(both single-word names with no similarity - likely different characters)\"\n  1494→                    )\n  1495→                    return False, 0.05\n  1496→                else:\n  1497→                    logger.debug(\n  1498→                        f\"Allowing potential nickname merge: {canonical} <-> {alias} \"\n  1499→                        f\"({word1} and {word2} are known nickname variants)\"\n  1500→                    )\n  1501→\n  1502→        # Check for gendered title conflicts\n  1503→        # Mr. vs Mrs./Miss suggests different people (likely spouses/family)\n  1504→        male_titles = {'mr', 'sir', 'lord'}\n  1505→        female_titles = {'mrs', 'ms', 'miss', 'lady'}\n  1506→        title1 = words1[0] if words1 and words1[0] in (male_titles | female_titles) else None\n  1507→        title2 = words2[0] if words2 and words2[0] in (male_titles | female_titles) else None\n  1508→\n  1509→        if title1 and title2:\n  1510→            if (title1 in male_titles and title2 in female_titles) or \\\n  1511→               (title1 in female_titles and title2 in male_titles):\n  1512→                logger.debug(\n  1513→                    f\"Merge rejected: {canonical} <-> {alias} \"\n  1514→                    f\"(gendered title conflict: {title1} vs {title2})\"\n  1515→                )\n  1516→                return False, 0.05\n  1517→\n  1518→        # Get chapter info\n  1519→        canonical_results = name_groups.get(canonical, [])\n  1520→        alias_results = name_groups.get(alias, [])\n  1521→        canonical_chapters = set(r.proposal.chapter_index for r in canonical_results)\n  1522→        alias_chapters = set(r.proposal.chapter_index for r in alias_results)\n  1523→        has_chapter_overlap = bool(canonical_chapters & alias_chapters)\n  1524→\n  1525→        # Calculate overlap ratio for weighted chapter overlap checks\n  1526→        if len(canonical_chapters) > 0 and len(alias_chapters) > 0:\n  1527→            overlap_count = len(canonical_chapters & alias_chapters)\n  1528→            total_chapters = len(canonical_chapters | alias_chapters)\n  1529→            overlap_ratio = overlap_count / total_chapters if total_chapters > 0 else 0\n  1530→        else:\n  1531→            overlap_ratio = 0\n  1532→\n  1533→        # Check for family member conflict:\n  1534→        # If names share ONLY a last name, check if multiple people have that last name\n  1535→        if shared_words:\n  1536→            # Check if shared word is likely a last name (appears at end of full names)\n  1537→            shared_might_be_lastname = False\n  1538→            for shared in shared_words:\n  1539→                # Is this word at the end of either multi-word name?\n  1540→                if len(words1) > 1 and words1[-1] == shared:\n  1541→                    shared_might_be_lastname = True\n  1542→                if len(words2) > 1 and words2[-1] == shared:\n  1543→                    shared_might_be_lastname = True\n  1544→\n  1545→            if shared_might_be_lastname:\n  1546→                # Count how many distinct full names share this last name\n  1547→                names_with_lastname = []\n  1548→                for shared in shared_words:\n  1549→                    for name in name_groups.keys():\n  1550→                        name_words = re.sub(r'[^\\w\\s]', '', name.lower()).split()\n  1551→                        if len(name_words) > 1 and name_words[-1] == shared:\n  1552→                            # This is a full name with this last name\n  1553→                            first_name = name_words[0]\n  1554→                            if first_name not in ['mr', 'mrs', 'ms', 'miss', 'dr']:\n  1555→                                names_with_lastname.append(name)\n  1556→\n  1557→                # If multiple DIFFERENT full names share this last name, reject merge\n  1558→                if len(names_with_lastname) > 1:\n  1559→                    # Check if canonical and alias have DIFFERENT first names\n  1560→                    first1 = words1[0] if words1 else \"\"\n  1561→                    first2 = words2[0] if words2 else \"\"\n  1562→\n  1563→                    # Skip titles when comparing first names\n  1564→                    titles = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n  1565→                    if first1 in titles and len(words1) > 1:\n  1566→                        first1 = words1[1]\n  1567→                    if first2 in titles and len(words2) > 1:\n  1568→                        first2 = words2[1]\n  1569→\n  1570→                    # If one is just a last name, it's ambiguous - reject\n  1571→                    if len(words1) == 1 or len(words2) == 1:\n  1572→                        logger.debug(\n  1573→                            f\"Merge rejected: {canonical} <-> {alias} \"\n  1574→                            f\"(ambiguous last name with multiple family members: {names_with_lastname})\"\n  1575→                        )\n  1576→                        return False, 0.2\n  1577→\n  1578→                    # BEFORE rejecting different first names, check for birth name / assumed name patterns\n  1579→                    # Look for phrases like \"born as\", \"real name\", \"formerly known as\", etc.\n  1580→                    if first1 != first2 and first1 and first2:\n  1581→                        birth_name_indicators = [\n  1582→                            \"born as\",\n  1583→                            \"real name\",\n  1584→                            \"formerly known as\",\n  1585→                            \"changed his name\",\n  1586→                            \"changed her name\",\n  1587→                            \"once called\",\n  1588→                            \"used to be called\",\n  1589→                            \"whose real name\",\n  1590→                            \"originally named\",\n  1591→                            \"birth name\",\n  1592→                        ]\n  1593→\n  1594→                        canonical_lower = canonical.lower()\n  1595→                        alias_lower = alias.lower()\n  1596→                        canonical_parts = {p for p in canonical_lower.split() if len(p) > 2}\n  1597→                        alias_parts = {p for p in alias_lower.split() if len(p) > 2}\n  1598→\n  1599→                        def name_in_ctx(name_lower: str, parts: set, ctx: str) -> bool:\n  1600→                            return name_lower in ctx or any(p in ctx for p in parts)\n  1601→\n  1602→                        # Check canonical's contexts for mentions of alias (OTHER name)\n  1603→                        for result in canonical_results[:5]:\n  1604→                            for mention in result.proposal.mentions[:3]:\n  1605→                                if not mention.context:\n  1606→                                    continue\n  1607→                                context = mention.context.lower()\n  1608→                                for indicator in birth_name_indicators:\n  1609→                                    if indicator in context:\n  1610→                                        # Check if the OTHER name (alias) appears\n  1611→                                        if name_in_ctx(alias_lower, alias_parts, context):\n  1612→                                            logger.info(\n  1613→                                                f\"Merge ALLOWED: {canonical} <- {alias} \"\n  1614→                                                f\"(birth name indicator '{indicator}' in {canonical}'s context)\"\n  1615→                                            )\n  1616→                                            return True, 0.85\n  1617→\n  1618→                        # Check alias's contexts for mentions of canonical (OTHER name)\n  1619→                        for result in alias_results[:5]:\n  1620→                            for mention in result.proposal.mentions[:3]:\n  1621→                                if not mention.context:\n  1622→                                    continue\n  1623→                                context = mention.context.lower()\n  1624→                                for indicator in birth_name_indicators:\n  1625→                                    if indicator in context:\n  1626→                                        # Check if the OTHER name (canonical) appears\n  1627→                                        if name_in_ctx(canonical_lower, canonical_parts, context):\n  1628→                                            logger.info(\n  1629→                                                f\"Merge ALLOWED: {canonical} <- {alias} \"\n  1630→                                                f\"(birth name indicator '{indicator}' in {alias}'s context)\"\n  1631→                                            )\n  1632→                                            return True, 0.85\n  1633→\n  1634→                    # If they have different first names and no birth name evidence, reject\n  1635→                    if first1 != first2 and first1 and first2:\n  1636→                        logger.debug(\n  1637→                            f\"Merge rejected: {canonical} <-> {alias} \"\n  1638→                            f\"(different first names, same last name - likely family members)\"\n  1639→                        )\n  1640→                        return False, 0.1\n  1641→\n  1642→            # Check for first-name-only conflict when BOTH names are multi-word:\n  1643→            # \"Martin Sharpe\" and \"Martin Luther King\" share first name but different last names\n  1644→            if len(words1) > 1 and len(words2) > 1:\n  1645→                titles = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n  1646→\n  1647→                # Get first name (skip title if present)\n  1648→                first1 = words1[0]\n  1649→                if first1 in titles and len(words1) > 1:\n  1650→                    first1 = words1[1]\n  1651→\n  1652→                first2 = words2[0]\n  1653→                if first2 in titles and len(words2) > 1:\n  1654→                    first2 = words2[1]\n  1655→\n  1656→                last1 = words1[-1]\n  1657→                last2 = words2[-1]\n  1658→\n  1659→                # Same first name but different last names = different people\n  1660→                if first1 == first2 and last1 != last2:\n  1661→                    logger.debug(\n  1662→                        f\"Merge rejected: {canonical} <-> {alias} \"\n  1663→                        f\"(same first name '{first1}', different last names '{last1}' vs '{last2}')\"\n  1664→                    )\n  1665→                    return False, 0.1\n  1666→\n  1667→            # Shared words and passed family check - accept\n  1668→            # But require higher confidence for single-word merges\n  1669→            confidence = 0.85\n  1670→            if len(words1) == 1 or len(words2) == 1:\n  1671→                if confidence < 0.85:\n  1672→                    logger.debug(\n  1673→                        f\"Merge rejected: {canonical} <-> {alias} \"\n  1674→                        f\"(single-word name, confidence {confidence:.2f} < 0.85 threshold)\"\n  1675→                    )\n  1676→                    return False, confidence * 0.5\n  1677→            logger.debug(f\"Merge accepted: {canonical} <- {alias} (shared words: {shared_words})\")\n  1678→            return True, confidence\n  1679→\n  1680→        # No shared words - be much more cautious\n  1681→        # First, reject if BOTH have 3+ chapters AND zero chapter overlap\n  1682→        if len(canonical_chapters) >= 3 and len(alias_chapters) >= 3:\n  1683→            if not has_chapter_overlap:\n  1684→                logger.debug(f\"Merge rejected: {canonical} <-> {alias} (no shared words, no chapter overlap, both multi-chapter)\")\n  1685→                return False, 0.1\n  1686→\n  1687→        # Additional safety: if one is single-word and other is multi-word,\n  1688→        # single word must match first or last name of multi-word\n  1689→        if len(words1) == 1 or len(words2) == 1:\n  1690→            if len(words1) == 1:\n  1691→                single_word = words1[0]\n  1692→                multi_words = words2\n  1693→            else:\n  1694→                single_word = words2[0]\n  1695→                multi_words = words1\n  1696→\n  1697→            if len(multi_words) > 1:\n  1698→                # Skip titles in multi-word name\n  1699→                titles = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n  1700→\n  1701→                # Check if multi-word is just \"Title LastName\" (e.g., \"Mr. Carraway\")\n  1702→                # In this case, single word could be first name (e.g., \"Nick\")\n  1703→                is_title_lastname = (\n  1704→                    len(multi_words) == 2 and\n  1705→                    multi_words[0].rstrip('.').lower() in titles\n  1706→                )\n  1707→\n  1708→                # If multi-word is title+lastname, only accept with strong evidence\n  1709→                # Chapter overlap alone is not enough (co-occurring characters can be different people)\n  1710→                # Require EITHER shared words OR strong chapter overlap (>60%)\n  1711→                # Lowered from 0.8 to 0.6 to allow legitimate title variations\n  1712→                # (e.g., \"Nick\" + \"Mr. Carraway\" where title form appears in subset of chapters)\n  1713→                if is_title_lastname:\n  1714→                    if shared_words or (has_chapter_overlap and overlap_ratio > 0.6):\n  1715→                        # Single-word names need higher confidence to merge\n  1716→                        confidence = 0.75\n  1717→                        if len(words1) == 1 or len(words2) == 1:\n  1718→                            if confidence < 0.85:\n  1719→                                logger.debug(\n  1720→                                    f\"Merge rejected: {canonical} <-> {alias} \"\n  1721→                                    f\"(single-word name, confidence {confidence:.2f} < 0.85 threshold)\"\n  1722→                                )\n  1723→                                return False, confidence * 0.5\n  1724→                        logger.debug(\n  1725→                            f\"Merge accepted: {canonical} <- {alias} \"\n  1726→                            f\"(title+lastname pattern with strong evidence: shared_words={bool(shared_words)}, \"\n  1727→                            f\"overlap_ratio={overlap_ratio:.2f})\"\n  1728→                        )\n  1729→                        return True, confidence\n  1730→                    else:\n  1731→                        logger.debug(\n  1732→                            f\"Merge rejected: {canonical} <-> {alias} \"\n  1733→                            f\"(title pattern but insufficient overlap or similarity: \"\n  1734→                            f\"shared_words={bool(shared_words)}, overlap_ratio={overlap_ratio:.2f})\"\n  1735→                        )\n  1736→                        return False, 0.3\n  1737→\n  1738→                first_word = multi_words[0]\n  1739→                if first_word in titles and len(multi_words) > 1:\n  1740→                    first_word = multi_words[1]\n  1741→\n  1742→                last_word = multi_words[-1]\n  1743→\n  1744→                # Single word must match first name or last name\n  1745→                if single_word != first_word and single_word != last_word:\n  1746→                    logger.debug(\n  1747→                        f\"Merge rejected: {canonical} <-> {alias} \"\n  1748→                        f\"(no shared words, '{single_word}' doesn't match first '{first_word}' or last '{last_word}')\"\n  1749→                    )\n  1750→                    return False, 0.1\n  1751→\n  1752→        # CRITICAL: We should NEVER merge names with zero shared words\n  1753→        # The only exceptions are specific patterns we've already handled above:\n  1754→        # - title+lastname pattern (already returned True if applicable)\n  1755→        # - single-word matching first/last (already returned False if not matched)\n  1756→        #\n  1757→        # If we reach here with no shared words, something is wrong - likely LLM hallucination\n  1758→        logger.debug(\n  1759→            f\"Merge rejected: {canonical} <-> {alias} \"\n  1760→            f\"(no shared words - LLM likely hallucinating or confused)\"\n  1761→        )\n  1762→        return False, 0.2\n  1763→\n  1764→    def _name_similarity(self, name1: str, name2: str) -> float:\n  1765→        \"\"\"Calculate similarity between two names (0.0 to 1.0).\"\"\"\n  1766→        # Normalize both names\n  1767→        n1 = self._normalize_name(name1)\n  1768→        n2 = self._normalize_name(name2)\n  1769→\n  1770→        # Exact match after normalization\n  1771→        if n1 == n2:\n  1772→            return 1.0\n  1773→\n  1774→        # Check if one is a substring of the other\n  1775→        # e.g., \"Nick\" in \"Nick Carraway\" or \"Gatsby\" in \"Jay Gatsby\"\n  1776→        if n1 in n2 or n2 in n1:\n  1777→            # Longer containment = higher confidence\n  1778→            shorter = min(len(n1), len(n2))\n  1779→            longer = max(len(n1), len(n2))\n  1780→            return 0.7 + (0.3 * shorter / longer)\n  1781→\n  1782→        # Use SequenceMatcher for general similarity\n  1783→        return SequenceMatcher(None, n1, n2).ratio()\n  1784→\n  1785→    def _is_descriptive_handle(self, name: str) -> bool:\n  1786→        \"\"\"\n  1787→        Detect if a name is a descriptive handle (epithet) like \"the creature\".\n  1788→\n  1789→        Descriptive handles start with \"the\" followed by a noun/adjective phrase.\n  1790→        \"\"\"\n  1791→        name_lower = name.lower().strip()\n  1792→        # Must start with \"the \"\n  1793→        if not name_lower.startswith(\"the \"):\n  1794→            return False\n  1795→        # Should not be a title pattern like \"the Mr. Smith\"\n  1796→        rest = name_lower[4:]\n  1797→        if rest.split()[0].rstrip('.') in TITLES:\n  1798→            return False\n  1799→        return True\n  1800→\n  1801→    def _llm_epithet_resolution(\n  1802→        self,\n  1803→        epithet_groups: dict[str, list[CharacterValidationResult]],\n  1804→    ) -> dict[str, list[str]]:\n  1805→        \"\"\"\n  1806→        Use LLM to resolve aliases among descriptive handles (epithets).\n  1807→\n  1808→        This handles cases like \"the creature\" = \"the monster\" = \"the wretch\"\n  1809→        that share no name components but refer to the same unnamed character.\n  1810→        \"\"\"\n  1811→        if not self.llm or len(epithet_groups) < 2:\n  1812→            return {name: [] for name in epithet_groups}\n  1813→\n  1814→        # Build prompt with epithet info\n  1815→        epithet_lines = []\n  1816→        sorted_epithets = sorted(\n  1817→            epithet_groups.items(),\n  1818→            key=lambda x: -sum(r.proposal.mention_count for r in x[1]),\n  1819→        )\n  1820→\n  1821→        for name, results in sorted_epithets:\n  1822→            total_mentions = sum(r.proposal.mention_count for r in results)\n  1823→            chapters_str = self._chapters_for_name(name, epithet_groups, max_chapters=12)\n  1824→            context_str = self._format_contexts(results, max_contexts=4, max_chars=140)\n  1825→\n  1826→            epithet_lines.append(f\"- {name} ({total_mentions} mentions, chapters: {chapters_str})\")\n  1827→            epithet_lines.append(f\"  Context:\\n{context_str}\")\n  1828→\n  1829→        epithets_str = \"\\n\".join(epithet_lines)\n  1830→        prompt = EPITHET_ALIAS_PROMPT.format(epithets=epithets_str)\n  1831→\n  1832→        try:\n  1833→            result, response = self.llm.query_json(prompt, system=EPITHET_ALIAS_SYSTEM)\n  1834→\n  1835→            if result is None or not isinstance(result, list):\n  1836→                logger.warning(\"LLM epithet resolution returned invalid response\")\n  1837→                return {name: [] for name in epithet_groups}\n  1838→\n  1839→            # Parse response\n  1840→            alias_map = {}\n  1841→            seen_names = set()\n  1842→\n  1843→            for group in result:\n  1844→                if not isinstance(group, dict):\n  1845→                    continue\n  1846→\n  1847→                canonical = group.get(\"canonical\", \"\")\n  1848→                aliases = group.get(\"aliases\", [])\n  1849→\n  1850→                if not canonical:\n  1851→                    continue\n  1852→\n  1853→                # Match to actual epithet names\n  1854→                matched_canonical = self._find_closest_name(canonical, epithet_groups.keys())\n  1855→                if not matched_canonical or matched_canonical in seen_names:\n  1856→                    continue\n  1857→\n  1858→                seen_names.add(matched_canonical)\n  1859→                alias_map[matched_canonical] = []\n  1860→\n  1861→                for alias in aliases:\n  1862→                    matched_alias = self._find_closest_name(alias, epithet_groups.keys())\n  1863→                    if not matched_alias or matched_alias in seen_names:\n  1864→                        continue\n  1865→\n  1866→                    alias_map[matched_canonical].append(matched_alias)\n  1867→                    seen_names.add(matched_alias)\n  1868→                    logger.info(f\"Epithet merge: '{matched_canonical}' <- '{matched_alias}'\")\n  1869→\n  1870→            # Add unmatched epithets\n  1871→            for name in epithet_groups:\n  1872→                if name not in seen_names:\n  1873→                    alias_map[name] = []\n  1874→\n  1875→            return alias_map\n  1876→\n  1877→        except Exception as e:\n  1878→            logger.error(f\"LLM epithet resolution failed: {e}\")\n  1879→            return {name: [] for name in epithet_groups}\n  1880→\n  1881→    def _pick_canonical_epithet(\n  1882→        self,\n  1883→        epithets: list[str],\n  1884→        epithet_groups: dict[str, list[CharacterValidationResult]],\n  1885→    ) -> str:\n  1886→        \"\"\"\n  1887→        Pick the best canonical name from a group of epithet aliases.\n  1888→\n  1889→        Priority:\n  1890→        1. Specificity: more words = more specific (e.g., \"the blind old man\" > \"the old man\")\n  1891→        2. Uniqueness: less common phrases are more unique\n  1892→        3. Frequency: higher mention count indicates more established usage\n  1893→        \"\"\"\n  1894→        if len(epithets) == 1:\n  1895→            return epithets[0]\n  1896→\n  1897→        def score(epithet: str) -> tuple[int, int, int]:\n  1898→            # Word count (more = more specific)\n  1899→            words = epithet.lower().split()\n  1900→            word_count = len(words)\n  1901→\n  1902→            # Uniqueness: inverse of how common each word is\n  1903→            # More unique words = better canonical\n  1904→            common_words = {'the', 'a', 'an', 'old', 'young', 'man', 'woman', 'person'}\n  1905→            unique_words = sum(1 for w in words if w not in common_words)\n  1906→\n  1907→            # Mention count\n  1908→            results = epithet_groups.get(epithet, [])\n  1909→            mention_count = sum(r.proposal.mention_count for r in results)\n  1910→\n  1911→            return (word_count, unique_words, mention_count)\n  1912→\n  1913→        return max(epithets, key=score)\n  1914→\n  1915→    def _generate_id(self, name: str) -> str:\n  1916→        \"\"\"Generate a unique ID for a character.\"\"\"\n  1917→        # Use hash of lowercase name for consistency\n  1918→        name_hash = hashlib.md5(name.lower().encode()).hexdigest()[:8]\n  1919→        safe_name = re.sub(r'[^a-zA-Z0-9]', '_', name.lower())[:20]\n  1920→        return f\"char_{safe_name}_{name_hash}\"\n  1921→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5e1dd3f8-a824-44bb-9974-11f838400830","uuid":"6da4a83d-81aa-4bf9-b142-cfa05471a523","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/consensus.py","content":"\"\"\"\nCross-chapter character consensus builder.\n\nMerges character proposals across chapters, resolves aliases,\nand produces the final CharacterMap.\n\"\"\"\n\nimport re\nimport hashlib\nimport time\nfrom typing import Optional, Iterable\nfrom collections import defaultdict\nfrom difflib import SequenceMatcher\nimport logging\n\nfrom .models import (\n    CharacterProposal,\n    CharacterValidationResult,\n    Character,\n    CharacterMap,\n    CharacterMention,\n    CharacterType,\n)\nfrom .constants import are_potential_nicknames, get_nickname_variants\nfrom ..llm import LLMClient\n\nlogger = logging.getLogger(__name__)\n\n# Character classification prompts\nCHARACTER_TYPE_SYSTEM = \"\"\"You are a literary analyst classifying character types.\n\nClassify each character as one of:\n- STORY: An active participant in the narrative who appears in scenes, speaks dialogue, or takes actions\n- HISTORICAL: A real historical figure mentioned in passing (e.g., Napoleon, Einstein)\n- REFERENCED: A fictional character from other works mentioned in passing (e.g., Hamlet, Sherlock Holmes)\n\nReturn ONLY valid JSON. No other text.\"\"\"\n\nCHARACTER_TYPE_PROMPT = \"\"\"Classify this character's role in the narrative.\n\nCHARACTER: {name}\nMENTION COUNT: {mention_count}\nCHAPTERS PRESENT: {chapters}\nSAMPLE CONTEXTS:\n{contexts}\n\nBased on the contexts, determine if this character:\n1. Actively participates (speaks, acts, appears in scenes) → STORY\n2. Is a real historical figure mentioned in passing → HISTORICAL\n3. Is a fictional character from other works → REFERENCED\n\nReturn JSON:\n{{\n  \"character_type\": \"story\" | \"historical\" | \"referenced\",\n  \"confidence\": 0.0-1.0,\n  \"reason\": \"brief justification\"\n}}\"\"\"\n\n# Common titles that should be ignored when comparing character names\n# These are not part of the actual name but indicate social status or role\nTITLES = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord', 'professor', 'captain', 'major'}\n\n# Epithet alias resolution prompt\nEPITHET_ALIAS_SYSTEM = \"\"\"You are a literary analyst identifying whether different descriptive handles (epithets) refer to the SAME unnamed character.\n\nDescriptive handles are phrases like \"the creature\", \"the monster\", \"the old man\", \"the detective\".\n\nCRITICAL RULES:\n1. Only merge epithets that CLEARLY refer to the same entity with HIGH CONFIDENCE\n2. Use chapter appearances and context clues to verify they're the same character\n3. Different descriptive characters (e.g., \"the old man\" in cottage vs \"the old man\" at inn) should NOT be merged\n4. Generic phrases that could refer to anyone should NOT be merged together\n\nReturn ONLY valid JSON. No other text.\"\"\"\n\nEPITHET_ALIAS_PROMPT = \"\"\"Identify which descriptive handles refer to the SAME unnamed character.\n\nDESCRIPTIVE HANDLES (with chapter info and sample contexts):\n{epithets}\n\nFor each group of handles that refer to the SAME entity:\n1. Pick the most specific/unique handle as canonical (e.g., \"the creature\" over \"the monster\")\n2. List all other handles as aliases\n\nReturn JSON array:\n```json\n[\n  {{\"canonical\": \"the creature\", \"aliases\": [\"the monster\", \"the wretch\", \"the fiend\"]}},\n  {{\"canonical\": \"the old man\", \"aliases\": []}}\n]\n```\n\nReturn ONLY the JSON array. Include only handles you're confident about - omit uncertain ones.\"\"\"\n\nPAIRWISE_ALIAS_SYSTEM = \"\"\"You are a literary analyst identifying whether two character names refer to the SAME PERSON.\n\nCRITICAL:\n- Use ONLY the evidence provided below (chapter appearances and context snippets).\n- Be conservative: false negatives (missing an alias) are better than false positives (merging different people).\n- Titles (Mr/Mrs/Miss/Dr/etc.) are not part of the name; treat them as address forms.\n\nReturn ONLY valid JSON. No other text.\"\"\"\n\nPAIRWISE_ALIAS_PROMPT = \"\"\"Decide whether these two names refer to the SAME PERSON in this novel.\n\nNAME A: {name_a}\nMENTIONS A: {mentions_a}\nCHAPTERS A: {chapters_a}\nCONTEXT A:\n{contexts_a}\n\nNAME B: {name_b}\nMENTIONS B: {mentions_b}\nCHAPTERS B: {chapters_b}\nCONTEXT B:\n{contexts_b}\n\nRules:\n- Only say same_person=true if there is strong evidence they are the same character (name overlap, title variants, obvious nickname/full-name relationship, or clear contextual cues).\n- If the only overlap is a last name, be VERY cautious (family members/spouses share last names).\n- If they never appear in overlapping chapters, be cautious unless it's clearly a full-name/short-name relationship.\n\nReturn JSON:\n{{\n  \"same_person\": true/false,\n  \"confidence\": 0.0-1.0,\n  \"canonical\": \"Which of the two names should be canonical if same_person=true (must be exactly one of the provided names)\",\n  \"alias\": \"The other name if same_person=true (must be exactly one of the provided names)\",\n  \"reason\": \"brief justification\"\n}}\"\"\"\n\n\nALIAS_RESOLUTION_SYSTEM = \"\"\"You are a literary analyst identifying character aliases.\n\nYour task is to determine which character names refer to the SAME PERSON.\n\nIMPORTANT: Titles, ranks, and honorifics should be IGNORED when matching names.\nThe underlying PERSON is what matters, not how they're addressed. Examples:\n- Military: \"SSgt Otto\" = \"Staff Sergeant Mark Otto\" = \"Mark Otto\" (but NOT just \"Otto\" alone)\n- Civilian: \"Mr. Smith\" = \"John Smith\" (but NOT just \"Smith\" alone - could be family member)\n- Religious: \"Father O'Brien\" = \"Patrick O'Brien\" (but NOT just \"O'Brien\" alone)\n- Academic: \"Professor Williams\" = \"Dr. Williams\" = \"Jane Williams\"\n\nCRITICAL RULES - BE CONSERVATIVE:\n1. Only merge names if they CLEARLY refer to the same individual with HIGH CONFIDENCE\n2. Different people with similar names should NEVER be merged\n3. Pay close attention to chapter appearances and context clues\n4. When in doubt, keep names SEPARATE - false negatives are better than false positives\n5. A bare FIRST name can merge with a full name (e.g., \"Mike\" → \"Michael Anderson\")\n6. A bare LAST name is RISKY - only merge if you're absolutely certain (could be family member)\n\nFor the canonical name, prefer the FULL CIVILIAN NAME (first + last) over titled versions.\n\nNEVER merge:\n- Different characters who happen to share only a first name (e.g., two characters named Michael)\n- Different characters who share ONLY a last name (family members, spouses, siblings)\n  - \"Mr. Anderson\" (father) ≠ \"Michael\" (son) even if both are Andersons\n  - \"Robert Wilson\" ≠ \"Mrs. Wilson\" (his wife Emma)\n- Characters who appear in completely different parts of the book with no overlap\n- Names that are clearly different major characters (check mention counts - if both have 50+ mentions, they're probably separate people!)\n\nBE EXTREMELY CAUTIOUS WITH:\n- Bare last names (could be family members)\n- Gendered titles (Mr. vs Mrs. vs Miss suggests different people)\n- Characters with similar but different names (e.g., \"Michael\" vs \"Michelle\")\n\nSPECIFIC ANTI-PATTERNS (DO NOT MERGE):\n- Different first names + same last name (likely family members): spouses, siblings, parents/children\n- Single-word names with no overlap: completely different characters with unrelated names\n- Characters who co-occur but have different identities: appearing together ≠ being the same person\n\nONLY merge when confident:\n1. Full name + partial name: full name contains the partial name as a component\n2. Title variations: titled form and untitled form of the same name\n3. Obvious nickname patterns: common nickname/full name pairs\n\nCRITICAL MERGE PATTERNS:\n\nMERGE these patterns (HIGH CONFIDENCE):\n- Full name variations: \"FirstName LastName\" = \"LastName\" = \"Title LastName\"\n- Nickname patterns: Shortened forms or diminutives of the same character\n- Birth/married names: Known alternate names for the same person (when contextually clear)\n\nDO NOT MERGE these patterns:\n- Title-only matches: Characters sharing only a title but different last names are DIFFERENT people\n- Family members: Different first names + same last name typically indicates spouses, siblings, or family (separate characters)\n- Similar titles: Same professional title (Professor, Doctor, Captain) doesn't indicate same person\n\nCONTEXTUAL CLUES to consider:\n- Relationship descriptors: \"his/her spouse\", \"his/her parent\", \"his/her sibling\" indicate SEPARATE characters\n- Gendered pronouns: Consistent he/she usage helps distinguish characters with ambiguous names\n- First-person narrative: First-person \"I\" may indicate narrator (check for self-references)\n\nMENTION COUNT HEURISTIC:\n- Large disparity (e.g., 200+ vs <10 mentions) often indicates full name vs shortened form\n- Similar counts (both >20 mentions) often indicates distinct characters of comparable importance\n\nWhen in doubt, keep SEPARATE. False negatives (missing an alias) are better than false positives (merging different characters).\"\"\"\n\n\nALIAS_RESOLUTION_PROMPT = \"\"\"Identify which character names refer to the SAME PERSON in this novel.\n\nCHARACTER NAMES (with chapter info and sample contexts):\n{characters}\n\nANALYZE CAREFULLY:\n1. Check if names appear in similar chapters (overlapping chapters = might be same person)\n2. Check if contexts suggest the same person\n3. Look at mention counts - if both names have many mentions (50+), they're likely different major characters\n4. Check for gendered title conflicts (Mr. vs Mrs. suggests different people)\n5. When uncertain, keep names SEPARATE - it's better to have duplicates than to merge different people\n\nEXAMPLES OF CORRECT MERGES:\n- \"Sarah Miller\" + \"Sarah\" → SAME (first name matches full name)\n- \"Robert Chen\" + \"Chen\" + \"Mr. Chen\" → SAME (last name and titled version)\n- \"Michael Anderson\" + \"Mike\" → SAME (nickname matches full name)\n- \"Emma Wilson\" + \"Wilson\" + \"Miss Wilson\" → SAME (last name and titled version)\n- \"Dr. Williams\" + \"James Williams\" → SAME (titled version of full name)\n- \"Elizabeth Harper\" + \"Liz\" → SAME (nickname matches full name)\n\nEXAMPLES OF INCORRECT MERGES (DO NOT DO THIS!):\n- \"Mr. Anderson\" + \"Chen\" → WRONG! (completely different people, no name overlap)\n- \"Mr. Anderson\" + \"Emma\" → WRONG! (completely different people)\n- \"Mr. Roberts\" + \"Mrs. Roberts\" → WRONG! (likely spouses, different people)\n- \"Michael Brown\" + \"Sarah Brown\" → WRONG! (different people with same last name)\n- \"Sarah\" + \"Emma\" → WRONG! (different first names = different people)\n\nReturn JSON array:\n```json\n[\n  {{\"canonical\": \"Full Name\", \"aliases\": [\"Nickname\", \"Title LastName\"]}},\n  {{\"canonical\": \"Another Character\", \"aliases\": []}}\n]\n```\n\nReturn ONLY the JSON array. Include only names you're confident about - omit uncertain names entirely rather than making bad merges.\"\"\"\n\n\nclass CharacterConsensusBuilder:\n    \"\"\"\n    Builds consensus across chapters and resolves aliases.\n\n    Takes validated proposals from all chapters and produces\n    the final character map with merged mentions and aliases.\n    \"\"\"\n\n    def __init__(\n        self,\n        llm_client: Optional[LLMClient] = None,\n        confidence_threshold: float = 0.6,\n        use_llm_alias_resolution: bool = True,\n    ):\n        \"\"\"\n        Args:\n            llm_client: LLM for alias resolution\n            confidence_threshold: Threshold for high-confidence characters\n            use_llm_alias_resolution: Whether to use LLM for alias resolution\n        \"\"\"\n        self.llm = llm_client\n        self.confidence_threshold = confidence_threshold\n        self.use_llm_alias_resolution = use_llm_alias_resolution and llm_client is not None\n\n    def build_consensus(\n        self,\n        validations: list[CharacterValidationResult],\n        total_chapters: int,\n    ) -> CharacterMap:\n        \"\"\"\n        Build the final character map from validated proposals.\n\n        Args:\n            validations: All validation results from all chapters\n            total_chapters: Total number of chapters in document\n\n        Returns:\n            Final CharacterMap with merged characters\n        \"\"\"\n        logger.info(f\"CharacterConsensusBuilder: received {len(validations)} validations\")\n\n        # Filter to valid proposals\n        valid_results = [v for v in validations if v.is_valid]\n        invalid_count = len(validations) - len(valid_results)\n        if invalid_count > 0:\n            logger.info(f\"CharacterConsensusBuilder: filtered {invalid_count} invalid proposals\")\n\n        if not valid_results:\n            return CharacterMap(\n                characters=[],\n                low_confidence_characters=[],\n                total_mentions=0,\n                total_chapters=total_chapters,\n                pipeline_metadata={\"warning\": \"No valid character proposals found\"},\n            )\n\n        # Group by name (exact match first)\n        name_groups = self._group_by_name(valid_results)\n        logger.info(f\"CharacterConsensusBuilder: grouped into {len(name_groups)} unique names\")\n\n        # Log the top names by mention count\n        sorted_names = sorted(\n            name_groups.items(),\n            key=lambda x: sum(r.proposal.mention_count for r in x[1]),\n            reverse=True\n        )\n        for name, results in sorted_names[:20]:\n            mentions = sum(r.proposal.mention_count for r in results)\n            chapters = sorted(set(r.proposal.chapter_index for r in results))\n            logger.debug(f\"  '{name}': {mentions} mentions, chapters {chapters}\")\n        if len(sorted_names) > 20:\n            logger.debug(f\"  ... and {len(sorted_names) - 20} more names\")\n\n        # Separate proper names from descriptive handles\n        proper_name_groups = {}\n        epithet_groups = {}\n        for name, results in name_groups.items():\n            if self._is_descriptive_handle(name):\n                epithet_groups[name] = results\n            else:\n                proper_name_groups[name] = results\n\n        if epithet_groups:\n            logger.info(f\"CharacterConsensusBuilder: found {len(epithet_groups)} descriptive handles\")\n\n        # Resolve aliases for proper names\n        if self.use_llm_alias_resolution and len(proper_name_groups) > 1:\n            logger.info(\"CharacterConsensusBuilder: using LLM alias resolution\")\n            alias_groups = self._llm_alias_resolution(proper_name_groups)\n        else:\n            logger.info(\"CharacterConsensusBuilder: using heuristic alias resolution\")\n            alias_groups = self._heuristic_alias_resolution(proper_name_groups, valid_results)\n\n        # Resolve aliases for epithets separately\n        if epithet_groups and self.use_llm_alias_resolution:\n            logger.info(\"CharacterConsensusBuilder: running epithet alias resolution\")\n            epithet_alias_groups = self._llm_epithet_resolution(epithet_groups)\n            # Merge epithet alias groups into main alias groups\n            for canonical, aliases in epithet_alias_groups.items():\n                alias_groups[canonical] = aliases\n        elif epithet_groups:\n            # No LLM - just add epithets as separate characters\n            for name in epithet_groups:\n                alias_groups[name] = []\n\n        # Merge name_groups to include epithets for downstream processing\n        name_groups.update(epithet_groups)\n\n        # Log alias groups\n        logger.info(f\"CharacterConsensusBuilder: resolved to {len(alias_groups)} characters\")\n        for canonical, aliases in sorted(alias_groups.items(), key=lambda x: -len(x[1])):\n            if aliases:\n                logger.info(f\"  '{canonical}' <- aliases: {aliases}\")\n            else:\n                logger.debug(f\"  '{canonical}' (no aliases)\")\n\n        # Build final characters\n        characters = []\n        low_confidence = []\n\n        for canonical_name, aliases in alias_groups.items():\n            # Collect all mentions for this character\n            all_mentions = []\n            all_strategies = set()\n            all_confidences = []\n            chapters_present = set()\n            all_types = []  # Track character types from all proposals\n\n            # Get mentions from canonical name\n            if canonical_name in name_groups:\n                for result in name_groups[canonical_name]:\n                    all_mentions.extend(result.proposal.mentions)\n                    all_strategies.add(result.proposal.strategy)\n                    all_confidences.append(result.overall_score)\n                    chapters_present.add(result.proposal.chapter_index)\n                    # Collect character type if available\n                    if hasattr(result.proposal, 'character_type'):\n                        all_types.append(result.proposal.character_type)\n\n            # Get mentions from aliases\n            for alias in aliases:\n                if alias in name_groups:\n                    for result in name_groups[alias]:\n                        all_mentions.extend(result.proposal.mentions)\n                        all_strategies.add(result.proposal.strategy)\n                        all_confidences.append(result.overall_score)\n                        chapters_present.add(result.proposal.chapter_index)\n                        # Collect character type if available\n                        if hasattr(result.proposal, 'character_type'):\n                            all_types.append(result.proposal.character_type)\n\n            if not all_mentions:\n                continue\n\n            # Deduplicate mentions by position (same position = same mention)\n            # This handles cases where NER and LLM both find the same mention\n            seen_positions = set()\n            unique_mentions = []\n            for mention in all_mentions:\n                if mention.position not in seen_positions:\n                    seen_positions.add(mention.position)\n                    unique_mentions.append(mention)\n            all_mentions = unique_mentions\n\n            # Sort mentions by position\n            all_mentions.sort(key=lambda m: m.position)\n\n            # Calculate final confidence\n            if not all_confidences:\n                error_msg = f\"No confidences available for character '{canonical_name}' - cannot continue\"\n                logger.error(error_msg)\n                raise ValueError(error_msg)\n            avg_confidence = sum(all_confidences) / len(all_confidences)\n\n            # Boost confidence for multiple strategies or many chapters\n            if len(all_strategies) > 1:\n                avg_confidence = min(1.0, avg_confidence + 0.1)\n            if len(chapters_present) > 3:\n                avg_confidence = min(1.0, avg_confidence + 0.05)\n\n            # Boost confidence based on mention count\n            # High-mention characters should have high confidence (major characters)\n            mention_count = len(all_mentions)\n            if mention_count >= 100:\n                avg_confidence = min(1.0, avg_confidence + 0.15)\n            elif mention_count >= 50:\n                avg_confidence = min(1.0, avg_confidence + 0.10)\n            elif mention_count >= 20:\n                avg_confidence = min(1.0, avg_confidence + 0.05)\n\n            # Determine final character type by majority vote (prefer non-UNCERTAIN)\n            final_type = CharacterType.UNCERTAIN\n            if all_types:\n                type_counts = {}\n                for t in all_types:\n                    if t != CharacterType.UNCERTAIN:\n                        type_counts[t] = type_counts.get(t, 0) + 1\n                if type_counts:\n                    final_type = max(type_counts.keys(), key=lambda t: type_counts[t])\n\n            # LLM fallback for uncertain character types\n            if final_type == CharacterType.UNCERTAIN and self.llm:\n                final_type = self._llm_classify_character_type(\n                    canonical_name, all_mentions, chapters_present\n                )\n\n            # Create character\n            char_id = self._generate_id(canonical_name)\n            first_chapter = min(chapters_present) if chapters_present else 1\n\n            character = Character(\n                id=char_id,\n                canonical_name=canonical_name,\n                aliases=list(aliases),\n                mentions=all_mentions,\n                first_appearance_chapter=first_chapter,\n                mention_count=len(all_mentions),\n                chapters_present=sorted(chapters_present),\n                confidence=avg_confidence,\n                supporting_strategies=list(all_strategies),\n                character_type=final_type,\n            )\n\n            if avg_confidence >= self.confidence_threshold:\n                characters.append(character)\n            else:\n                low_confidence.append(character)\n\n        # Sort by mention count\n        characters.sort(key=lambda c: c.mention_count, reverse=True)\n        low_confidence.sort(key=lambda c: c.mention_count, reverse=True)\n\n        total_mentions = sum(c.mention_count for c in characters)\n        total_mentions += sum(c.mention_count for c in low_confidence)\n\n        return CharacterMap(\n            characters=characters,\n            low_confidence_characters=low_confidence,\n            total_mentions=total_mentions,\n            total_chapters=total_chapters,\n            pipeline_metadata={\n                \"high_confidence_count\": len(characters),\n                \"low_confidence_count\": len(low_confidence),\n                \"confidence_threshold\": self.confidence_threshold,\n                \"used_llm_aliases\": self.use_llm_alias_resolution,\n            },\n        )\n\n    def _group_by_name(\n        self,\n        results: list[CharacterValidationResult],\n    ) -> dict[str, list[CharacterValidationResult]]:\n        \"\"\"Group validation results by character name.\"\"\"\n        groups = defaultdict(list)\n        for result in results:\n            groups[result.proposal.name].append(result)\n        return dict(groups)\n\n    def _heuristic_alias_resolution(\n        self,\n        name_groups: dict[str, list[CharacterValidationResult]],\n        all_results: list[CharacterValidationResult],\n    ) -> dict[str, list[str]]:\n        \"\"\"\n        Resolve aliases using heuristics.\n\n        Returns dict mapping canonical name to list of aliases.\n        \"\"\"\n        # Start with each name as its own group\n        alias_map = {name: set() for name in name_groups.keys()}\n\n        # Collect alias candidates from validation\n        alias_candidates = defaultdict(set)\n        for result in all_results:\n            name = result.proposal.name\n            for candidate in result.alias_candidates:\n                alias_candidates[name].add(candidate)\n\n        names = list(name_groups.keys())\n\n        # Find matches based on name components\n        for i, name1 in enumerate(names):\n            for name2 in names[i + 1:]:\n                if self._names_match(name1, name2):\n                    # Merge: keep longer/more complete name as canonical\n                    # Calculate mention counts for both names\n                    count1 = sum(r.proposal.mention_count for r in name_groups[name1])\n                    count2 = sum(r.proposal.mention_count for r in name_groups[name2])\n                    canonical, alias = self._pick_canonical(name1, name2, count1, count2)\n                    if canonical in alias_map:\n                        alias_map[canonical].add(alias)\n                        # Merge alias's aliases\n                        if alias in alias_map:\n                            alias_map[canonical].update(alias_map[alias])\n                            del alias_map[alias]\n\n        # Add validator's alias candidates if they match actual names\n        for name, candidates in alias_candidates.items():\n            if name in alias_map:\n                for candidate in candidates:\n                    # Check if candidate matches any actual name\n                    for actual_name in name_groups.keys():\n                        if actual_name != name and self._names_match(candidate, actual_name):\n                            # Calculate mention counts for both names\n                            count_name = sum(r.proposal.mention_count for r in name_groups[name])\n                            count_actual = sum(r.proposal.mention_count for r in name_groups[actual_name])\n                            canonical, alias = self._pick_canonical(name, actual_name, count_name, count_actual)\n                            if canonical in alias_map and alias in alias_map:\n                                alias_map[canonical].add(alias)\n                                alias_map[canonical].update(alias_map[alias])\n                                del alias_map[alias]\n\n        return {k: list(v) for k, v in alias_map.items()}\n\n    def _names_match(self, name1: str, name2: str) -> bool:\n        \"\"\"\n        Check if two names likely refer to the same person.\n\n        Note: This is a simple heuristic check. For last-name-only matches,\n        the caller should verify there aren't multiple people with that last name.\n        \"\"\"\n        # Exact match (case insensitive)\n        if name1.lower() == name2.lower():\n            return True\n\n        # Normalize: remove titles, lowercase\n        norm1 = self._normalize_name(name1)\n        norm2 = self._normalize_name(name2)\n\n        if norm1 == norm2:\n            return True\n\n        parts1 = norm1.split()\n        parts2 = norm2.split()\n\n        # Check if one is FIRST name of the other (safe to match)\n        if len(parts1) == 1 and len(parts2) > 1:\n            # name1 might be first name of name2\n            if parts1[0] == parts2[0]:\n                return True\n            # Note: We NO LONGER match last names here - too risky for family members\n            # The LLM alias resolution with _validate_merge handles this case\n\n        if len(parts2) == 1 and len(parts1) > 1:\n            # name2 might be first name of name1\n            if parts2[0] == parts1[0]:\n                return True\n\n        # Check for titled version (Mr. Smith == Smith) - but be careful\n        # Only match if the title suggests same gender/role\n        if len(parts1) == 1 and len(parts2) == 2:\n            title = parts2[0].rstrip('.').lower()\n            if title in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n                if parts1[0] == parts2[1]:\n                    # This is a last-name match - risky, don't auto-merge\n                    # Let LLM handle it with proper validation\n                    return False\n\n        if len(parts2) == 1 and len(parts1) == 2:\n            title = parts1[0].rstrip('.').lower()\n            if title in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}:\n                if parts2[0] == parts1[1]:\n                    # This is a last-name match - risky, don't auto-merge\n                    return False\n\n        return False\n\n    def _normalize_name(self, name: str) -> str:\n        \"\"\"Normalize a name for comparison.\"\"\"\n        # Remove common titles\n        name = re.sub(\n            r'^(mr|mrs|ms|miss|dr|sir|lady|lord)\\.?\\s+',\n            '',\n            name,\n            flags=re.IGNORECASE\n        )\n        return ' '.join(name.lower().split())\n\n    def _pick_canonical(self, name1: str, name2: str, count1: int = 0, count2: int = 0) -> tuple[str, str]:\n        \"\"\"\n        Pick which name should be canonical vs alias.\n\n        F15: Priority order (mention count is PRIMARY):\n        1. Higher mention count (most frequently used form is canonical)\n        2. Longer names (more complete)\n        3. Untitled over titled\n        4. Alphabetically first (tiebreaker only)\n        \"\"\"\n        # F15: Prefer higher mention count FIRST (most used form is canonical)\n        if count1 != count2:\n            return (name1, name2) if count1 > count2 else (name2, name1)\n\n        # Prefer full names over first names\n        parts1 = name1.split()\n        parts2 = name2.split()\n\n        if len(parts1) > len(parts2):\n            return name1, name2\n        elif len(parts2) > len(parts1):\n            return name2, name1\n\n        # Prefer untitled over titled (Jay Gatsby over Mr. Gatsby)\n        has_title1 = parts1[0].rstrip('.').lower() in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n        has_title2 = parts2[0].rstrip('.').lower() in {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n\n        if has_title1 and not has_title2:\n            return name2, name1\n        elif has_title2 and not has_title1:\n            return name1, name2\n\n        # Default: alphabetically first is canonical\n        return (name1, name2) if name1 < name2 else (name2, name1)\n\n    def _is_ambiguous_name(self, name: str) -> bool:\n        \"\"\"\n        Heuristic for names that require more evidence during alias resolution.\n\n        Ambiguous examples:\n        - Single-word names (often last-name-only)\n        - Titled names (Mr./Mrs./Dr. X)\n        \"\"\"\n        words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n        if not words:\n            return True\n        if words[0] in TITLES:\n            return True\n        significant = self._filter_title_words(words)\n        return len(significant) <= 1\n\n    def _iter_all_mentions(self, results: list[CharacterValidationResult]) -> list[CharacterMention]:\n        \"\"\"Collect all mentions from a list of validation results (can be many).\"\"\"\n        mentions: list[CharacterMention] = []\n        for r in results:\n            if r.proposal and r.proposal.mentions:\n                mentions.extend(r.proposal.mentions)\n        return mentions\n\n    def _format_contexts(\n        self,\n        results: list[CharacterValidationResult],\n        *,\n        max_contexts: int,\n        max_chars: int,\n    ) -> str:\n        \"\"\"\n        Format diverse context snippets sampled across early/mid/late mentions.\n\n        Notes:\n        - Mention contexts are already short (~100 chars) upstream; we avoid over-truncating further.\n        - We prefer chapter diversity and narrative spread over \"first 2 mentions\".\n        \"\"\"\n        mentions = self._iter_all_mentions(results)\n        if not mentions:\n            return \"(no context)\"\n\n        # Sort for deterministic sampling across the narrative\n        mentions_sorted = sorted(mentions, key=lambda m: (m.chapter_index, m.position))\n\n        # Seed picks: early / middle / late\n        picks: list[CharacterMention] = []\n        for idx in {0, len(mentions_sorted) // 2, len(mentions_sorted) - 1}:\n            if 0 <= idx < len(mentions_sorted):\n                picks.append(mentions_sorted[idx])\n\n        # Fill with additional mentions from new chapters if needed\n        seen_chapters = {m.chapter_index for m in picks}\n        seen_contexts = {m.context for m in picks if m.context}\n\n        for m in mentions_sorted:\n            if len(picks) >= max_contexts:\n                break\n            if not m.context:\n                continue\n            if m.chapter_index in seen_chapters and m.context in seen_contexts:\n                continue\n            # Prefer new chapters\n            if m.chapter_index not in seen_chapters:\n                picks.append(m)\n                seen_chapters.add(m.chapter_index)\n                seen_contexts.add(m.context)\n\n        # Still short? Add any remaining distinct contexts (even same chapter)\n        if len(picks) < max_contexts:\n            for m in mentions_sorted:\n                if len(picks) >= max_contexts:\n                    break\n                if not m.context or m.context in seen_contexts:\n                    continue\n                picks.append(m)\n                seen_contexts.add(m.context)\n\n        # Render\n        lines = []\n        for i, m in enumerate(picks[:max_contexts], 1):\n            ctx = (m.context or \"\").replace(\"\\n\", \" \").strip()\n            if max_chars > 0 and len(ctx) > max_chars:\n                ctx = ctx[:max_chars].rstrip() + \"...\"\n            dlg = \"dialogue\" if getattr(m, \"in_dialogue\", False) else \"narrative\"\n            lines.append(f\"{i}. [ch {m.chapter_index}, {dlg}] \\\"{ctx}\\\"\")\n        return \"\\n\".join(lines) if lines else \"(no context)\"\n\n    def _total_mentions_for_name(\n        self,\n        name: str,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> int:\n        results = name_groups.get(name, [])\n        return sum(r.proposal.mention_count for r in results)\n\n    def _chapters_for_name(\n        self,\n        name: str,\n        name_groups: dict[str, list[CharacterValidationResult]],\n        *,\n        max_chapters: int = 12,\n    ) -> str:\n        results = name_groups.get(name, [])\n        chapters = sorted(set(r.proposal.chapter_index for r in results))\n        if not chapters:\n            return \"(none)\"\n        if len(chapters) <= max_chapters:\n            return \", \".join(str(c) for c in chapters)\n        return \", \".join(str(c) for c in chapters[:max_chapters]) + f\"... ({len(chapters)} total)\"\n\n    def _build_alias_prompt_global(\n        self,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> str:\n        \"\"\"Build the global alias-resolution prompt with richer contexts.\"\"\"\n        char_lines: list[str] = []\n\n        # Sort by total mention count (desc) for more salient characters first.\n        sorted_items = sorted(\n            name_groups.items(),\n            key=lambda x: -sum(r.proposal.mention_count for r in x[1]),\n        )\n\n        for name, results in sorted_items:\n            total_mentions = sum(r.proposal.mention_count for r in results)\n            chapters_str = self._chapters_for_name(name, name_groups, max_chapters=12)\n\n            # More evidence for ambiguous names (last-name-only, titled forms)\n            ambiguous = self._is_ambiguous_name(name)\n            max_ctx = 6 if ambiguous else 4\n            max_chars = 180 if ambiguous else 140\n            context_str = self._format_contexts(results, max_contexts=max_ctx, max_chars=max_chars)\n\n            char_lines.append(f\"- {name} ({total_mentions} mentions, chapters: {chapters_str})\")\n            char_lines.append(f\"  Context:\\n{context_str}\")\n\n        characters_str = \"\\n\".join(char_lines)\n        return ALIAS_RESOLUTION_PROMPT.format(characters=characters_str)\n\n    def _candidate_pairs_for_merge(\n        self,\n        name_groups: dict[str, list[CharacterValidationResult]],\n        *,\n        max_pairs: int = 250,\n    ) -> list[tuple[str, str]]:\n        \"\"\"\n        Generate plausible alias candidate pairs using cheap heuristics.\n\n        Goal: avoid O(n^2) on large casts while still capturing obvious merges.\n        \"\"\"\n        names = list(name_groups.keys())\n        if len(names) < 2:\n            return []\n\n        # Token index for significant words (excluding titles)\n        token_to_names: dict[str, list[str]] = defaultdict(list)\n        for name in names:\n            words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n            sig = self._filter_title_words(words)\n            for w in sig:\n                token_to_names[w].append(name)\n\n        # Rank names by mention count for throttling big token buckets\n        mention_rank = {n: self._total_mentions_for_name(n, name_groups) for n in names}\n\n        pairs_set: set[tuple[str, str]] = set()\n\n        def add_pair(a: str, b: str):\n            if a == b:\n                return\n            x, y = (a, b) if a < b else (b, a)\n            pairs_set.add((x, y))\n\n        # Generate within token buckets\n        for token, bucket in token_to_names.items():\n            if len(bucket) < 2:\n                continue\n            # For very common tokens, only consider the top-N by mentions to avoid blowup\n            bucket_sorted = sorted(bucket, key=lambda n: -mention_rank.get(n, 0))\n            cap = 20 if len(bucket_sorted) > 20 else len(bucket_sorted)\n            bucket_sorted = bucket_sorted[:cap]\n\n            for i in range(len(bucket_sorted)):\n                for j in range(i + 1, len(bucket_sorted)):\n                    add_pair(bucket_sorted[i], bucket_sorted[j])\n                    if len(pairs_set) >= max_pairs:\n                        break\n                if len(pairs_set) >= max_pairs:\n                    break\n            if len(pairs_set) >= max_pairs:\n                break\n\n        # Add substring-based candidates (e.g., \"Gatsby\" in \"Jay Gatsby\")\n        if len(pairs_set) < max_pairs:\n            # Only compare top-N by mentions to keep it bounded\n            top = sorted(names, key=lambda n: -mention_rank.get(n, 0))[:80]\n            norm = {n: self._normalize_name(n) for n in top}\n            for i in range(len(top)):\n                for j in range(i + 1, len(top)):\n                    n1, n2 = top[i], top[j]\n                    a, b = norm[n1], norm[n2]\n                    if a and b and (a in b or b in a):\n                        add_pair(n1, n2)\n                        if len(pairs_set) >= max_pairs:\n                            break\n                if len(pairs_set) >= max_pairs:\n                    break\n\n        # Add nickname-based candidates (e.g., \"Kate\" and \"Cathy\", \"Elizabeth\" and \"Lizzy\")\n        # This catches aliases that share no words but are known nickname variants\n        if len(pairs_set) < max_pairs:\n            # Build index of names by their first significant word (likely the first name)\n            # Only consider top characters by mention count to avoid explosion\n            top = sorted(names, key=lambda n: -mention_rank.get(n, 0))[:100]\n\n            # Extract the likely \"first name\" from each name for nickname matching\n            def extract_first_name(name: str) -> str:\n                \"\"\"Extract the first name (excluding titles) for nickname matching.\"\"\"\n                words = re.sub(r\"[^\\w\\s]\", \"\", name.lower()).split()\n                significant = self._filter_title_words(words)\n                return list(significant)[0] if significant else \"\"\n\n            first_names = {n: extract_first_name(n) for n in top}\n\n            # Group names by their nickname variant sets\n            # Names with overlapping variant sets should be paired\n            for i in range(len(top)):\n                if len(pairs_set) >= max_pairs:\n                    break\n                n1 = top[i]\n                fn1 = first_names[n1]\n                if not fn1:\n                    continue\n\n                for j in range(i + 1, len(top)):\n                    if len(pairs_set) >= max_pairs:\n                        break\n                    n2 = top[j]\n                    fn2 = first_names[n2]\n                    if not fn2:\n                        continue\n\n                    # Check if the first names are potential nickname variants\n                    if are_potential_nicknames(fn1, fn2):\n                        add_pair(n1, n2)\n                        logger.debug(\n                            f\"Nickname match: '{n1}' ({fn1}) <-> '{n2}' ({fn2})\"\n                        )\n\n        return list(pairs_set)\n\n    def _llm_pairwise_merge_decision(\n        self,\n        name_a: str,\n        name_b: str,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> tuple[bool, float, Optional[str], Optional[str]]:\n        \"\"\"\n        Ask the LLM whether two names should be merged.\n\n        Returns:\n          (same_person, confidence, canonical, alias)\n        \"\"\"\n        results_a = name_groups.get(name_a, [])\n        results_b = name_groups.get(name_b, [])\n\n        # More evidence when ambiguous\n        amb = self._is_ambiguous_name(name_a) or self._is_ambiguous_name(name_b)\n        ctx_a = self._format_contexts(results_a, max_contexts=6 if amb else 4, max_chars=200 if amb else 160)\n        ctx_b = self._format_contexts(results_b, max_contexts=6 if amb else 4, max_chars=200 if amb else 160)\n\n        prompt = PAIRWISE_ALIAS_PROMPT.format(\n            name_a=name_a,\n            mentions_a=self._total_mentions_for_name(name_a, name_groups),\n            chapters_a=self._chapters_for_name(name_a, name_groups, max_chapters=16),\n            contexts_a=ctx_a,\n            name_b=name_b,\n            mentions_b=self._total_mentions_for_name(name_b, name_groups),\n            chapters_b=self._chapters_for_name(name_b, name_groups, max_chapters=16),\n            contexts_b=ctx_b,\n        )\n\n        result, response = self.llm.query_json(prompt, system=PAIRWISE_ALIAS_SYSTEM)\n        if not response.success or result is None or not isinstance(result, dict):\n            raise ValueError(f\"Pairwise alias LLM failed for '{name_a}' vs '{name_b}'\")\n\n        same = bool(result.get(\"same_person\", False))\n        conf = float(result.get(\"confidence\", 0.0) or 0.0)\n        canonical = result.get(\"canonical\")\n        alias = result.get(\"alias\")\n\n        # Enforce canonical/alias must be exactly one of the provided names\n        if same:\n            if canonical not in (name_a, name_b) or alias not in (name_a, name_b) or canonical == alias:\n                # Fall back to deterministic canonical choice\n                count_a = self._total_mentions_for_name(name_a, name_groups)\n                count_b = self._total_mentions_for_name(name_b, name_groups)\n                canonical, alias = self._pick_canonical(name_a, name_b, count_a, count_b)\n        return same, conf, canonical, alias\n\n    def _llm_alias_resolution_pairwise(\n        self,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> dict[str, list[str]]:\n        \"\"\"\n        Two-stage alias resolution:\n        1) Cheap heuristics propose candidate merges\n        2) LLM evaluates candidates pairwise with richer evidence\n        \"\"\"\n        names = list(name_groups.keys())\n        if len(names) < 2:\n            return {n: [] for n in names}\n\n        candidates = self._candidate_pairs_for_merge(name_groups, max_pairs=250)\n        logger.info(f\"Pairwise alias resolution: evaluating {len(candidates)} candidate pairs\")\n\n        # Union-Find to build clusters\n        parent: dict[str, str] = {n: n for n in names}\n\n        def find(x: str) -> str:\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n\n        def union(a: str, b: str):\n            ra, rb = find(a), find(b)\n            if ra != rb:\n                parent[rb] = ra\n\n        # Evaluate candidates\n        accepted = 0\n        for a, b in candidates:\n            same, conf, canonical, alias = self._llm_pairwise_merge_decision(a, b, name_groups)\n            if not same or conf < 0.7:\n                continue\n\n            # Validate with our strict sanity checks before merging\n            is_valid, _vconf = self._validate_merge(canonical or a, alias or b, name_groups)\n            if not is_valid:\n                continue\n\n            union(a, b)\n            accepted += 1\n\n        logger.info(f\"Pairwise alias resolution: accepted {accepted}/{len(candidates)} merges\")\n\n        # Build components\n        components: dict[str, list[str]] = defaultdict(list)\n        for n in names:\n            components[find(n)].append(n)\n\n        # Choose canonical for each component deterministically using mention counts + name completeness\n        # F15: Mention count is PRIMARY factor, then name quality indicators\n        alias_map: dict[str, list[str]] = {}\n        for _root, members in components.items():\n            if len(members) == 1:\n                alias_map[members[0]] = []\n                continue\n\n            def score(name: str) -> tuple[int, int, int, int, str]:\n                parts = name.split()\n                has_title = 1 if parts and parts[0].rstrip('.').lower() in TITLES else 0\n                mention_count = self._total_mentions_for_name(name, name_groups)\n                # F15: Priority order:\n                # 1. Higher mention count (PRIMARY - most used form is canonical)\n                # 2. More name parts (more complete names)\n                # 3. No title preferred (-has_title: untitled=0 > titled=-1)\n                # 4. Alphabetically first (tiebreaker only)\n                # Note: we negate name for alphabetically-first tiebreaker with max()\n                return (mention_count, len(parts), -has_title, 0, name)\n\n            # Use min on inverted tuple for alphabetical tiebreaker (first alphabetically wins)\n            def score_with_alpha_first(name: str) -> tuple:\n                parts = name.split()\n                has_title = 1 if parts and parts[0].rstrip('.').lower() in TITLES else 0\n                mention_count = self._total_mentions_for_name(name, name_groups)\n                # Negate values we want to maximize, so min() picks the best\n                return (-mention_count, -len(parts), has_title, name.lower())\n\n            canonical = min(members, key=score_with_alpha_first)\n            aliases = [m for m in members if m != canonical]\n            alias_map[canonical] = aliases\n\n        # Post-check obvious merges the LLM missed (still useful)\n        alias_map = self._post_llm_merge_check(alias_map, name_groups)\n        return alias_map\n\n    def _llm_alias_resolution(\n        self,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> dict[str, list[str]]:\n        \"\"\"Use LLM to resolve aliases with rich context.\"\"\"\n        # If there are many unique names, a single giant \"merge everyone\" prompt becomes\n        # both expensive and error-prone. Switch to pairwise mode automatically.\n        if len(name_groups) > 60:\n            logger.info(f\"CharacterConsensusBuilder: large cast ({len(name_groups)} names) - using pairwise LLM alias resolution\")\n            return self._llm_alias_resolution_pairwise(name_groups)\n\n        prompt = self._build_alias_prompt_global(name_groups)\n\n        # Retry logic: LLM is essential for character merging\n        max_retries = 2\n        last_error = None\n\n        for attempt in range(max_retries + 1):\n            try:\n                result, response = self.llm.query_json(prompt, system=ALIAS_RESOLUTION_SYSTEM)\n\n                if result is None:\n                    raise ValueError(\"LLM returned None - possibly parsing failure\")\n\n                if not isinstance(result, list):\n                    raise ValueError(f\"LLM returned non-list: {type(result)}\")\n\n                # Success - break out of retry loop\n                break\n\n            except Exception as e:\n                last_error = e\n                logger.warning(f\"LLM alias resolution attempt {attempt + 1} failed: {e}\")\n\n                if attempt == max_retries:\n                    # All retries exhausted - fail loudly\n                    logger.error(\"All LLM attempts failed - character alias resolution cannot proceed\")\n                    raise RuntimeError(\n                        \"LLM alias resolution failed after all retries. \"\n                        \"LLM is required for accurate character merging. \"\n                        f\"Last error: {last_error}\"\n                    ) from last_error\n\n                # Wait before retry\n                time.sleep(1)\n\n        # Parse LLM response WITH VALIDATION\n        alias_map = {}\n        seen_names = set()\n\n        for group in result:\n            if not isinstance(group, dict):\n                continue\n\n            canonical = group.get(\"canonical\", \"\")\n            aliases = group.get(\"aliases\", [])\n\n            if not canonical:\n                continue\n\n            # Verify canonical exists in our names (strict matching)\n            matched_canonical = self._find_closest_name(canonical, name_groups.keys())\n            if not matched_canonical:\n                continue\n\n            if matched_canonical in seen_names:\n                continue\n\n            seen_names.add(matched_canonical)\n            alias_map[matched_canonical] = []\n\n            for alias in aliases:\n                matched_alias = self._find_closest_name(alias, name_groups.keys())\n                if not matched_alias or matched_alias in seen_names:\n                    continue\n\n                # VALIDATE the merge before accepting it\n                is_valid, confidence = self._validate_merge(\n                    matched_canonical, matched_alias, name_groups\n                )\n\n                if is_valid:\n                    alias_map[matched_canonical].append(matched_alias)\n                    seen_names.add(matched_alias)\n                    logger.debug(f\"Accepted merge: {matched_canonical} <- {matched_alias} (conf={confidence:.2f})\")\n                else:\n                    logger.debug(f\"Rejected merge: {matched_canonical} <- {matched_alias} (conf={confidence:.2f})\")\n\n        # Add any names not covered by LLM\n        for name in name_groups.keys():\n            if name not in seen_names:\n                alias_map[name] = []\n\n        # Post-LLM validation: Check for obvious merges the LLM missed\n        # e.g., \"Nick\" should merge with \"Nick Carraway\" even if LLM didn't suggest it\n        alias_map = self._post_llm_merge_check(alias_map, name_groups)\n\n        return alias_map\n\n    def _post_llm_merge_check(\n        self,\n        alias_map: dict[str, list[str]],\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> dict[str, list[str]]:\n        \"\"\"\n        Check for obvious merges the LLM missed.\n\n        Handles cases like \"Nick\" + \"Nick Carraway\" where the first name\n        clearly matches the full name.\n        \"\"\"\n        canonicals = list(alias_map.keys())\n        merged = set()  # Track names that get merged\n\n        for i, name1 in enumerate(canonicals):\n            if name1 in merged:\n                continue\n\n            for name2 in canonicals[i + 1:]:\n                if name2 in merged:\n                    continue\n\n                # Check if these should be merged\n                is_valid, confidence = self._validate_merge(name1, name2, name_groups)\n\n                # Higher threshold for post-LLM merges to avoid introducing false merges\n                if is_valid and confidence >= 0.85:\n                    # Merge: pick the more complete name as canonical\n                    # Calculate mention counts for both names\n                    count1 = sum(r.proposal.mention_count for r in name_groups[name1])\n                    count2 = sum(r.proposal.mention_count for r in name_groups[name2])\n                    canonical, alias = self._pick_canonical(name1, name2, count1, count2)\n\n                    # If canonical was name2, we need to swap in alias_map\n                    if canonical == name2:\n                        canonical, alias = name2, name1\n\n                    if canonical in alias_map and alias in alias_map:\n                        logger.info(\n                            f\"Post-LLM merge: '{canonical}' <- '{alias}' \"\n                            f\"(LLM missed this merge)\"\n                        )\n                        alias_map[canonical].append(alias)\n                        alias_map[canonical].extend(alias_map.get(alias, []))\n                        del alias_map[alias]\n                        merged.add(alias)\n\n        return alias_map\n\n    def _find_closest_name(\n        self,\n        target: str,\n        candidates: list[str],\n    ) -> Optional[str]:\n        \"\"\"Find the closest matching name from candidates (strict matching).\"\"\"\n        target_lower = target.lower()\n        target_norm = self._normalize_name(target)\n\n        # Priority 1: Exact match (case insensitive)\n        for candidate in candidates:\n            if candidate.lower() == target_lower:\n                return candidate\n\n        # Priority 2: Normalized match (after removing titles)\n        for candidate in candidates:\n            if self._normalize_name(candidate) == target_norm:\n                return candidate\n\n        # Priority 3: High similarity match (>0.85)\n        # This catches minor typos but not completely different names\n        best_match = None\n        best_score = 0.0\n        for candidate in candidates:\n            score = self._name_similarity(target, candidate)\n            if score > best_score and score > 0.85:\n                best_score = score\n                best_match = candidate\n\n        if best_match:\n            return best_match\n\n        # NO partial/component matching - too error-prone\n        # If we can't find a clear match, return None\n        return None\n\n    def _filter_title_words(self, words: list[str]) -> set[str]:\n        \"\"\"\n        Extract significant words from a name, excluding titles.\n\n        Titles like \"Mr.\", \"Miss\", \"Dr.\" are social indicators, not part of the actual name.\n        Filtering them prevents spurious merges like \"Miss X\" with \"Miss Y\" based solely\n        on the shared title word.\n\n        Args:\n            words: List of words from a character name\n\n        Returns:\n            Set of significant words (length >= 3, not titles)\n        \"\"\"\n        return {w for w in words if len(w) >= 3 and w.lower() not in TITLES}\n\n    def _check_aggressive_alias_patterns(self, name1: str, name2: str) -> tuple[bool, float]:\n        \"\"\"\n        Check for common alias patterns that should be merged aggressively.\n\n        Handles hyphenation and spacing variants like:\n        - \"Owl Eyes\" vs \"Owl-eyes\"\n        - \"Mc Donald\" vs \"McDonald\"\n\n        Returns:\n            (should_merge, confidence) tuple\n        \"\"\"\n        # Normalize: lowercase, remove hyphens/dots, collapse spaces\n        n1_lower = name1.lower().replace('-', ' ').replace('.', '')\n        n2_lower = name2.lower().replace('-', ' ').replace('.', '')\n\n        n1_normalized = ' '.join(n1_lower.split())\n        n2_normalized = ' '.join(n2_lower.split())\n\n        # Exact match after normalization (handles \"Owl-Eyes\" vs \"Owl Eyes\")\n        if n1_normalized == n2_normalized:\n            return True, 0.95\n\n        # Match after removing all spaces (handles \"Owl Eyes\" vs \"Owleyes\")\n        if n1_normalized.replace(' ', '') == n2_normalized.replace(' ', ''):\n            return True, 0.90\n\n        return False, 0.0\n\n    def _check_birth_name_pattern(\n        self,\n        canonical: str,\n        alias: str,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> tuple[bool, float]:\n        \"\"\"\n        Check if two names represent a birth name / assumed name pattern.\n\n        Looks for context clues like \"born as\", \"real name\", \"changed his name\"\n        in the mentions for either name.\n\n        IMPORTANT: We iterate through each name's contexts separately and check\n        if they mention the OTHER name with an indicator. This catches patterns\n        like \"He was born as James Gatz\" in Jay Gatsby's context.\n\n        Returns:\n            (should_merge, confidence) tuple\n        \"\"\"\n        birth_name_indicators = [\n            \"born as\", \"real name\", \"birth name\", \"whose real name\",\n            \"formerly known as\", \"changed his name\", \"changed her name\",\n            \"once called\", \"used to be called\", \"originally named\",\n            \"actually named\", \"true name\", \"given name\",\n        ]\n\n        # Normalize names for matching\n        canonical_lower = canonical.lower()\n        alias_lower = alias.lower()\n\n        # Also check individual name components (first/last names, excluding short words)\n        canonical_parts = {p for p in canonical_lower.split() if len(p) > 2}\n        alias_parts = {p for p in alias_lower.split() if len(p) > 2}\n\n        def name_in_context(name_lower: str, parts: set, context: str) -> bool:\n            \"\"\"Check if a name (or its significant parts) appears in context.\"\"\"\n            if name_lower in context:\n                return True\n            return any(part in context for part in parts)\n\n        # Check canonical's contexts for mentions of alias (the OTHER name)\n        for result in name_groups.get(canonical, [])[:10]:\n            for mention in result.proposal.mentions[:5]:\n                if not mention.context:\n                    continue\n                context = mention.context.lower()\n                for indicator in birth_name_indicators:\n                    if indicator in context:\n                        # Check if the OTHER name (alias) appears in canonical's context\n                        if name_in_context(alias_lower, alias_parts, context):\n                            logger.info(\n                                f\"Birth name pattern detected: {canonical} <-> {alias} \"\n                                f\"(indicator: '{indicator}' in {canonical}'s context mentions {alias})\"\n                            )\n                            return True, 0.85\n\n        # Check alias's contexts for mentions of canonical (the OTHER name)\n        for result in name_groups.get(alias, [])[:10]:\n            for mention in result.proposal.mentions[:5]:\n                if not mention.context:\n                    continue\n                context = mention.context.lower()\n                for indicator in birth_name_indicators:\n                    if indicator in context:\n                        # Check if the OTHER name (canonical) appears in alias's context\n                        if name_in_context(canonical_lower, canonical_parts, context):\n                            logger.info(\n                                f\"Birth name pattern detected: {canonical} <-> {alias} \"\n                                f\"(indicator: '{indicator}' in {alias}'s context mentions {canonical})\"\n                            )\n                            return True, 0.85\n\n        return False, 0.0\n\n    def _llm_classify_character_type(\n        self,\n        name: str,\n        mentions: list[CharacterMention],\n        chapters_present: set[int],\n    ) -> CharacterType:\n        \"\"\"\n        Use LLM to classify uncertain character types.\n\n        Called when majority voting fails to determine character type.\n        Returns CharacterType based on LLM analysis of contexts.\n        \"\"\"\n        if not self.llm:\n            return CharacterType.UNCERTAIN\n\n        # Format contexts for prompt\n        context_lines = []\n        for i, mention in enumerate(mentions[:6]):  # Sample up to 6 contexts\n            if mention.context:\n                dlg = \"dialogue\" if mention.in_dialogue else \"narrative\"\n                context_lines.append(\n                    f\"{i+1}. [ch {mention.chapter_index}, {dlg}] \\\"{mention.context[:150]}\\\"\"\n                )\n\n        if not context_lines:\n            return CharacterType.UNCERTAIN\n\n        prompt = CHARACTER_TYPE_PROMPT.format(\n            name=name,\n            mention_count=len(mentions),\n            chapters=\", \".join(str(c) for c in sorted(chapters_present)),\n            contexts=\"\\n\".join(context_lines),\n        )\n\n        try:\n            result, response = self.llm.query_json(prompt, system=CHARACTER_TYPE_SYSTEM)\n\n            if result and isinstance(result, dict):\n                char_type_str = result.get(\"character_type\", \"\").lower()\n                confidence = float(result.get(\"confidence\", 0.0) or 0.0)\n\n                # Only accept high-confidence classifications\n                if confidence >= 0.7:\n                    if char_type_str == \"story\":\n                        logger.debug(f\"LLM classified '{name}' as STORY (conf={confidence:.2f})\")\n                        return CharacterType.STORY\n                    elif char_type_str == \"historical\":\n                        logger.debug(f\"LLM classified '{name}' as HISTORICAL (conf={confidence:.2f})\")\n                        return CharacterType.HISTORICAL\n                    elif char_type_str == \"referenced\":\n                        logger.debug(f\"LLM classified '{name}' as REFERENCED (conf={confidence:.2f})\")\n                        return CharacterType.REFERENCED\n\n        except Exception as e:\n            logger.warning(f\"LLM character type classification failed for '{name}': {e}\")\n\n        return CharacterType.UNCERTAIN\n\n    def _validate_merge(\n        self,\n        canonical: str,\n        alias: str,\n        name_groups: dict[str, list[CharacterValidationResult]],\n    ) -> tuple[bool, float]:\n        \"\"\"\n        Validate LLM merge decision with sanity checks.\n\n        Key checks:\n        1. Check aggressive alias patterns (hyphenation/spacing variants) first\n        2. Check birth name patterns (context clues like \"real name\", \"born as\")\n        3. Reject merges that only share a last name when multiple people have that last name\n        4. Reject merges with no shared words and no chapter overlap\n\n        Returns:\n            (is_valid, confidence) tuple\n        \"\"\"\n        # CHECK 1: Aggressive alias patterns (hyphenation/spacing variants)\n        # These should always merge regardless of other checks\n        is_alias_pattern, alias_conf = self._check_aggressive_alias_patterns(canonical, alias)\n        if is_alias_pattern:\n            logger.debug(\n                f\"Merge accepted: {canonical} <- {alias} \"\n                f\"(aggressive alias pattern, conf={alias_conf:.2f})\"\n            )\n            return True, alias_conf\n\n        # CHECK 2: Birth name patterns (context clues)\n        # These can merge names with no shared words if context supports it\n        is_birth_name, birth_conf = self._check_birth_name_pattern(canonical, alias, name_groups)\n        if is_birth_name:\n            logger.debug(\n                f\"Merge accepted: {canonical} <- {alias} \"\n                f\"(birth name pattern, conf={birth_conf:.2f})\"\n            )\n            return True, birth_conf\n\n        # Extract words from names, filtering out titles\n        words1 = re.sub(r'[^\\w\\s]', '', canonical.lower()).split()\n        words2 = re.sub(r'[^\\w\\s]', '', alias.lower()).split()\n        # Use helper to filter title words - prevents spurious merges on title alone\n        significant1 = self._filter_title_words(words1)\n        significant2 = self._filter_title_words(words2)\n        shared_words = significant1 & significant2\n\n        # SINGLE-WORD NAME HANDLING\n        # When comparing single-word vs multi-word names, assume the single word is the LAST NAME\n        # (most common pattern in literature: \"Smith\" is the last name in \"John Smith\")\n        is_single_word1 = len(significant1) == 1\n        is_single_word2 = len(significant2) == 1\n\n        if is_single_word1 and not is_single_word2:\n            # Comparing single-word (e.g., \"Smith\") vs multi-word (e.g., \"John Smith\")\n            # Assume single word is the LAST NAME\n            single_word = list(significant1)[0]\n            multi_words = significant2\n\n            # Check if single word appears in multi-word name\n            if single_word in multi_words:\n                # This is likely the same person (full name variant)\n                logger.debug(\n                    f\"Merge accepted: {canonical} <- {alias} \"\n                    f\"(single-word '{single_word}' appears in multi-word name)\"\n                )\n                return True, 0.90  # High confidence\n\n        elif is_single_word2 and not is_single_word1:\n            # Reverse case: multi-word vs single-word\n            single_word = list(significant2)[0]\n            multi_words = significant1\n\n            if single_word in multi_words:\n                logger.debug(\n                    f\"Merge accepted: {canonical} <- {alias} \"\n                    f\"(single-word '{single_word}' appears in multi-word name)\"\n                )\n                return True, 0.90  # High confidence\n\n        # NEW CHECK: Reject completely different single-word names\n        # If both are single-word names with NO shared words, reject UNLESS they are\n        # known nickname variants (e.g., Kate/Cathy, Elizabeth/Lizzy)\n        # NOTE: This prevents the worst over-merges (Alice + Robert) during validation\n        # while allowing legitimate nickname pairs to be merged.\n        if len(significant1) == 1 and len(significant2) == 1:\n            if not shared_words:  # Different single-word names\n                # Check if they're known nickname variants before rejecting\n                word1 = list(significant1)[0].lower()\n                word2 = list(significant2)[0].lower()\n                if not are_potential_nicknames(word1, word2):\n                    logger.debug(\n                        f\"Merge rejected: {canonical} <-> {alias} \"\n                        f\"(both single-word names with no similarity - likely different characters)\"\n                    )\n                    return False, 0.05\n                else:\n                    logger.debug(\n                        f\"Allowing potential nickname merge: {canonical} <-> {alias} \"\n                        f\"({word1} and {word2} are known nickname variants)\"\n                    )\n\n        # Check for gendered title conflicts\n        # Mr. vs Mrs./Miss suggests different people (likely spouses/family)\n        male_titles = {'mr', 'sir', 'lord'}\n        female_titles = {'mrs', 'ms', 'miss', 'lady'}\n        title1 = words1[0] if words1 and words1[0] in (male_titles | female_titles) else None\n        title2 = words2[0] if words2 and words2[0] in (male_titles | female_titles) else None\n\n        if title1 and title2:\n            if (title1 in male_titles and title2 in female_titles) or \\\n               (title1 in female_titles and title2 in male_titles):\n                logger.debug(\n                    f\"Merge rejected: {canonical} <-> {alias} \"\n                    f\"(gendered title conflict: {title1} vs {title2})\"\n                )\n                return False, 0.05\n\n        # Get chapter info\n        canonical_results = name_groups.get(canonical, [])\n        alias_results = name_groups.get(alias, [])\n        canonical_chapters = set(r.proposal.chapter_index for r in canonical_results)\n        alias_chapters = set(r.proposal.chapter_index for r in alias_results)\n        has_chapter_overlap = bool(canonical_chapters & alias_chapters)\n\n        # Calculate overlap ratio for weighted chapter overlap checks\n        if len(canonical_chapters) > 0 and len(alias_chapters) > 0:\n            overlap_count = len(canonical_chapters & alias_chapters)\n            total_chapters = len(canonical_chapters | alias_chapters)\n            overlap_ratio = overlap_count / total_chapters if total_chapters > 0 else 0\n        else:\n            overlap_ratio = 0\n\n        # Check for family member conflict:\n        # If names share ONLY a last name, check if multiple people have that last name\n        if shared_words:\n            # Check if shared word is likely a last name (appears at end of full names)\n            shared_might_be_lastname = False\n            for shared in shared_words:\n                # Is this word at the end of either multi-word name?\n                if len(words1) > 1 and words1[-1] == shared:\n                    shared_might_be_lastname = True\n                if len(words2) > 1 and words2[-1] == shared:\n                    shared_might_be_lastname = True\n\n            if shared_might_be_lastname:\n                # Count how many distinct full names share this last name\n                names_with_lastname = []\n                for shared in shared_words:\n                    for name in name_groups.keys():\n                        name_words = re.sub(r'[^\\w\\s]', '', name.lower()).split()\n                        if len(name_words) > 1 and name_words[-1] == shared:\n                            # This is a full name with this last name\n                            first_name = name_words[0]\n                            if first_name not in ['mr', 'mrs', 'ms', 'miss', 'dr']:\n                                names_with_lastname.append(name)\n\n                # If multiple DIFFERENT full names share this last name, reject merge\n                if len(names_with_lastname) > 1:\n                    # Check if canonical and alias have DIFFERENT first names\n                    first1 = words1[0] if words1 else \"\"\n                    first2 = words2[0] if words2 else \"\"\n\n                    # Skip titles when comparing first names\n                    titles = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n                    if first1 in titles and len(words1) > 1:\n                        first1 = words1[1]\n                    if first2 in titles and len(words2) > 1:\n                        first2 = words2[1]\n\n                    # If one is just a last name, it's ambiguous - reject\n                    if len(words1) == 1 or len(words2) == 1:\n                        logger.debug(\n                            f\"Merge rejected: {canonical} <-> {alias} \"\n                            f\"(ambiguous last name with multiple family members: {names_with_lastname})\"\n                        )\n                        return False, 0.2\n\n                    # BEFORE rejecting different first names, check for birth name / assumed name patterns\n                    # Look for phrases like \"born as\", \"real name\", \"formerly known as\", etc.\n                    if first1 != first2 and first1 and first2:\n                        birth_name_indicators = [\n                            \"born as\",\n                            \"real name\",\n                            \"formerly known as\",\n                            \"changed his name\",\n                            \"changed her name\",\n                            \"once called\",\n                            \"used to be called\",\n                            \"whose real name\",\n                            \"originally named\",\n                            \"birth name\",\n                        ]\n\n                        canonical_lower = canonical.lower()\n                        alias_lower = alias.lower()\n                        canonical_parts = {p for p in canonical_lower.split() if len(p) > 2}\n                        alias_parts = {p for p in alias_lower.split() if len(p) > 2}\n\n                        def name_in_ctx(name_lower: str, parts: set, ctx: str) -> bool:\n                            return name_lower in ctx or any(p in ctx for p in parts)\n\n                        # Check canonical's contexts for mentions of alias (OTHER name)\n                        for result in canonical_results[:5]:\n                            for mention in result.proposal.mentions[:3]:\n                                if not mention.context:\n                                    continue\n                                context = mention.context.lower()\n                                for indicator in birth_name_indicators:\n                                    if indicator in context:\n                                        # Check if the OTHER name (alias) appears\n                                        if name_in_ctx(alias_lower, alias_parts, context):\n                                            logger.info(\n                                                f\"Merge ALLOWED: {canonical} <- {alias} \"\n                                                f\"(birth name indicator '{indicator}' in {canonical}'s context)\"\n                                            )\n                                            return True, 0.85\n\n                        # Check alias's contexts for mentions of canonical (OTHER name)\n                        for result in alias_results[:5]:\n                            for mention in result.proposal.mentions[:3]:\n                                if not mention.context:\n                                    continue\n                                context = mention.context.lower()\n                                for indicator in birth_name_indicators:\n                                    if indicator in context:\n                                        # Check if the OTHER name (canonical) appears\n                                        if name_in_ctx(canonical_lower, canonical_parts, context):\n                                            logger.info(\n                                                f\"Merge ALLOWED: {canonical} <- {alias} \"\n                                                f\"(birth name indicator '{indicator}' in {alias}'s context)\"\n                                            )\n                                            return True, 0.85\n\n                    # If they have different first names and no birth name evidence, reject\n                    if first1 != first2 and first1 and first2:\n                        logger.debug(\n                            f\"Merge rejected: {canonical} <-> {alias} \"\n                            f\"(different first names, same last name - likely family members)\"\n                        )\n                        return False, 0.1\n\n            # Check for first-name-only conflict when BOTH names are multi-word:\n            # \"Martin Sharpe\" and \"Martin Luther King\" share first name but different last names\n            if len(words1) > 1 and len(words2) > 1:\n                titles = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n\n                # Get first name (skip title if present)\n                first1 = words1[0]\n                if first1 in titles and len(words1) > 1:\n                    first1 = words1[1]\n\n                first2 = words2[0]\n                if first2 in titles and len(words2) > 1:\n                    first2 = words2[1]\n\n                last1 = words1[-1]\n                last2 = words2[-1]\n\n                # Same first name but different last names = different people\n                if first1 == first2 and last1 != last2:\n                    logger.debug(\n                        f\"Merge rejected: {canonical} <-> {alias} \"\n                        f\"(same first name '{first1}', different last names '{last1}' vs '{last2}')\"\n                    )\n                    return False, 0.1\n\n            # Shared words and passed family check - accept\n            # But require higher confidence for single-word merges\n            confidence = 0.85\n            if len(words1) == 1 or len(words2) == 1:\n                if confidence < 0.85:\n                    logger.debug(\n                        f\"Merge rejected: {canonical} <-> {alias} \"\n                        f\"(single-word name, confidence {confidence:.2f} < 0.85 threshold)\"\n                    )\n                    return False, confidence * 0.5\n            logger.debug(f\"Merge accepted: {canonical} <- {alias} (shared words: {shared_words})\")\n            return True, confidence\n\n        # No shared words - be much more cautious\n        # First, reject if BOTH have 3+ chapters AND zero chapter overlap\n        if len(canonical_chapters) >= 3 and len(alias_chapters) >= 3:\n            if not has_chapter_overlap:\n                logger.debug(f\"Merge rejected: {canonical} <-> {alias} (no shared words, no chapter overlap, both multi-chapter)\")\n                return False, 0.1\n\n        # Additional safety: if one is single-word and other is multi-word,\n        # single word must match first or last name of multi-word\n        if len(words1) == 1 or len(words2) == 1:\n            if len(words1) == 1:\n                single_word = words1[0]\n                multi_words = words2\n            else:\n                single_word = words2[0]\n                multi_words = words1\n\n            if len(multi_words) > 1:\n                # Skip titles in multi-word name\n                titles = {'mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord'}\n\n                # Check if multi-word is just \"Title LastName\" (e.g., \"Mr. Carraway\")\n                # In this case, single word could be first name (e.g., \"Nick\")\n                is_title_lastname = (\n                    len(multi_words) == 2 and\n                    multi_words[0].rstrip('.').lower() in titles\n                )\n\n                # If multi-word is title+lastname, only accept with strong evidence\n                # Chapter overlap alone is not enough (co-occurring characters can be different people)\n                # Require EITHER shared words OR strong chapter overlap (>60%)\n                # Lowered from 0.8 to 0.6 to allow legitimate title variations\n                # (e.g., \"Nick\" + \"Mr. Carraway\" where title form appears in subset of chapters)\n                if is_title_lastname:\n                    if shared_words or (has_chapter_overlap and overlap_ratio > 0.6):\n                        # Single-word names need higher confidence to merge\n                        confidence = 0.75\n                        if len(words1) == 1 or len(words2) == 1:\n                            if confidence < 0.85:\n                                logger.debug(\n                                    f\"Merge rejected: {canonical} <-> {alias} \"\n                                    f\"(single-word name, confidence {confidence:.2f} < 0.85 threshold)\"\n                                )\n                                return False, confidence * 0.5\n                        logger.debug(\n                            f\"Merge accepted: {canonical} <- {alias} \"\n                            f\"(title+lastname pattern with strong evidence: shared_words={bool(shared_words)}, \"\n                            f\"overlap_ratio={overlap_ratio:.2f})\"\n                        )\n                        return True, confidence\n                    else:\n                        logger.debug(\n                            f\"Merge rejected: {canonical} <-> {alias} \"\n                            f\"(title pattern but insufficient overlap or similarity: \"\n                            f\"shared_words={bool(shared_words)}, overlap_ratio={overlap_ratio:.2f})\"\n                        )\n                        return False, 0.3\n\n                first_word = multi_words[0]\n                if first_word in titles and len(multi_words) > 1:\n                    first_word = multi_words[1]\n\n                last_word = multi_words[-1]\n\n                # Single word must match first name or last name\n                if single_word != first_word and single_word != last_word:\n                    logger.debug(\n                        f\"Merge rejected: {canonical} <-> {alias} \"\n                        f\"(no shared words, '{single_word}' doesn't match first '{first_word}' or last '{last_word}')\"\n                    )\n                    return False, 0.1\n\n        # CRITICAL: We should NEVER merge names with zero shared words\n        # The only exceptions are specific patterns we've already handled above:\n        # - title+lastname pattern (already returned True if applicable)\n        # - single-word matching first/last (already returned False if not matched)\n        #\n        # If we reach here with no shared words, something is wrong - likely LLM hallucination\n        logger.debug(\n            f\"Merge rejected: {canonical} <-> {alias} \"\n            f\"(no shared words - LLM likely hallucinating or confused)\"\n        )\n        return False, 0.2\n\n    def _name_similarity(self, name1: str, name2: str) -> float:\n        \"\"\"Calculate similarity between two names (0.0 to 1.0).\"\"\"\n        # Normalize both names\n        n1 = self._normalize_name(name1)\n        n2 = self._normalize_name(name2)\n\n        # Exact match after normalization\n        if n1 == n2:\n            return 1.0\n\n        # Check if one is a substring of the other\n        # e.g., \"Nick\" in \"Nick Carraway\" or \"Gatsby\" in \"Jay Gatsby\"\n        if n1 in n2 or n2 in n1:\n            # Longer containment = higher confidence\n            shorter = min(len(n1), len(n2))\n            longer = max(len(n1), len(n2))\n            return 0.7 + (0.3 * shorter / longer)\n\n        # Use SequenceMatcher for general similarity\n        return SequenceMatcher(None, n1, n2).ratio()\n\n    def _is_descriptive_handle(self, name: str) -> bool:\n        \"\"\"\n        Detect if a name is a descriptive handle (epithet) like \"the creature\".\n\n        Descriptive handles start with \"the\" followed by a noun/adjective phrase.\n        \"\"\"\n        name_lower = name.lower().strip()\n        # Must start with \"the \"\n        if not name_lower.startswith(\"the \"):\n            return False\n        # Should not be a title pattern like \"the Mr. Smith\"\n        rest = name_lower[4:]\n        if rest.split()[0].rstrip('.') in TITLES:\n            return False\n        return True\n\n    def _llm_epithet_resolution(\n        self,\n        epithet_groups: dict[str, list[CharacterValidationResult]],\n    ) -> dict[str, list[str]]:\n        \"\"\"\n        Use LLM to resolve aliases among descriptive handles (epithets).\n\n        This handles cases like \"the creature\" = \"the monster\" = \"the wretch\"\n        that share no name components but refer to the same unnamed character.\n        \"\"\"\n        if not self.llm or len(epithet_groups) < 2:\n            return {name: [] for name in epithet_groups}\n\n        # Build prompt with epithet info\n        epithet_lines = []\n        sorted_epithets = sorted(\n            epithet_groups.items(),\n            key=lambda x: -sum(r.proposal.mention_count for r in x[1]),\n        )\n\n        for name, results in sorted_epithets:\n            total_mentions = sum(r.proposal.mention_count for r in results)\n            chapters_str = self._chapters_for_name(name, epithet_groups, max_chapters=12)\n            context_str = self._format_contexts(results, max_contexts=4, max_chars=140)\n\n            epithet_lines.append(f\"- {name} ({total_mentions} mentions, chapters: {chapters_str})\")\n            epithet_lines.append(f\"  Context:\\n{context_str}\")\n\n        epithets_str = \"\\n\".join(epithet_lines)\n        prompt = EPITHET_ALIAS_PROMPT.format(epithets=epithets_str)\n\n        try:\n            result, response = self.llm.query_json(prompt, system=EPITHET_ALIAS_SYSTEM)\n\n            if result is None or not isinstance(result, list):\n                logger.warning(\"LLM epithet resolution returned invalid response\")\n                return {name: [] for name in epithet_groups}\n\n            # Parse response\n            alias_map = {}\n            seen_names = set()\n\n            for group in result:\n                if not isinstance(group, dict):\n                    continue\n\n                canonical = group.get(\"canonical\", \"\")\n                aliases = group.get(\"aliases\", [])\n\n                if not canonical:\n                    continue\n\n                # Match to actual epithet names\n                matched_canonical = self._find_closest_name(canonical, epithet_groups.keys())\n                if not matched_canonical or matched_canonical in seen_names:\n                    continue\n\n                seen_names.add(matched_canonical)\n                alias_map[matched_canonical] = []\n\n                for alias in aliases:\n                    matched_alias = self._find_closest_name(alias, epithet_groups.keys())\n                    if not matched_alias or matched_alias in seen_names:\n                        continue\n\n                    alias_map[matched_canonical].append(matched_alias)\n                    seen_names.add(matched_alias)\n                    logger.info(f\"Epithet merge: '{matched_canonical}' <- '{matched_alias}'\")\n\n            # Add unmatched epithets\n            for name in epithet_groups:\n                if name not in seen_names:\n                    alias_map[name] = []\n\n            return alias_map\n\n        except Exception as e:\n            logger.error(f\"LLM epithet resolution failed: {e}\")\n            return {name: [] for name in epithet_groups}\n\n    def _pick_canonical_epithet(\n        self,\n        epithets: list[str],\n        epithet_groups: dict[str, list[CharacterValidationResult]],\n    ) -> str:\n        \"\"\"\n        Pick the best canonical name from a group of epithet aliases.\n\n        Priority:\n        1. Specificity: more words = more specific (e.g., \"the blind old man\" > \"the old man\")\n        2. Uniqueness: less common phrases are more unique\n        3. Frequency: higher mention count indicates more established usage\n        \"\"\"\n        if len(epithets) == 1:\n            return epithets[0]\n\n        def score(epithet: str) -> tuple[int, int, int]:\n            # Word count (more = more specific)\n            words = epithet.lower().split()\n            word_count = len(words)\n\n            # Uniqueness: inverse of how common each word is\n            # More unique words = better canonical\n            common_words = {'the', 'a', 'an', 'old', 'young', 'man', 'woman', 'person'}\n            unique_words = sum(1 for w in words if w not in common_words)\n\n            # Mention count\n            results = epithet_groups.get(epithet, [])\n            mention_count = sum(r.proposal.mention_count for r in results)\n\n            return (word_count, unique_words, mention_count)\n\n        return max(epithets, key=score)\n\n    def _generate_id(self, name: str) -> str:\n        \"\"\"Generate a unique ID for a character.\"\"\"\n        # Use hash of lowercase name for consistency\n        name_hash = hashlib.md5(name.lower().encode()).hexdigest()[:8]\n        safe_name = re.sub(r'[^a-zA-Z0-9]', '_', name.lower())[:20]\n        return f\"char_{safe_name}_{name_hash}\"\n","numLines":1921,"startLine":1,"totalLines":1921}}}
