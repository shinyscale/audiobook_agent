   53→            border-bottom: 3px solid transparent;\n    54→            cursor: pointer;\n    55→            position: relative;\n    56→        }\n    57→        nav a:hover {\n    58→            background: var(--primary);\n    59→        }\n    60→        nav a.active {\n    61→            background: var(--surface-alt);\n    62→            border-bottom-color: var(--accent);\n    63→            color: var(--accent);\n    64→            font-weight: 600;\n    65→        }\n    66→\n    67→        /* Hide all tab content by default, show only active tab */\n    68→        .tab-content {\n    69→            display: none;\n    70→        }\n    71→        .tab-content.active {\n    72→            display: block;\n    73→        }\n    74→\n    75→        /* View toggle buttons */\n    76→        .view-toggle {\n    77→            padding: 0.5rem 1rem;\n    78→            border: 1px solid var(--primary);\n    79→            background: transparent;\n    80→            color: var(--text);\n    81→            border-radius: 4px;\n    82→            cursor: pointer;\n    83→            transition: all 0.2s;\n    84→        }\n    85→        .view-toggle:hover {\n    86→            background: var(--primary);\n    87→        }\n    88→        .view-toggle.active {\n    89→            background: var(--accent);\n    90→            border-color: var(--accent);\n    91→            font-weight: 600;\n    92→        }\n    93→\n    94→        /* Pronunciation views */\n    95→        .pron-view {\n    96→            display: none;\n    97→        }\n    98→        .pron-view.active {\n    99→            display: block;\n   100→        }\n   101→\n   102→        /* Glossary styles */\n   103→        .alphabet-nav a:hover {\n   104→            background: var(--accent) !important;\n   105→        }\n   106→        .glossary-item:hover {\n   107→            background: var(--primary) !important;\n   108→        }\n   109→\n   110→        /* Print view: show all tabs and al