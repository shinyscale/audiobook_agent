lid JSON matching the above structure. No other text.\\\"\\\"\\\"\\n  1677→\\n  1678→        # Helper to parse JSON from LLM response\\n  1679→        def _parse_json_blob(s: str):\\n  1680→            try:\\n  1681→                return json.loads(s)\\n  1682→            except json.JSONDecodeError:\\n  1683→                start = s.find(\\\"{\\\")\\n  1684→                end = s.rfind(\\\"}\\\")\\n  1685→                if start != -1 and end != -1 and end > start:\\n  1686→                    try:\\n  1687→                        return json.loads(s[start:end + 1])\\n  1688→                    except json.JSONDecodeError:\\n  1689→                        return None\\n  1690→                return None\\n  1691→\\n  1692→        # Retry loop: try up to 2 times on LLM errors\\n  1693→        max_attempts = 2\\n  1694→        for attempt in range(max_attempts):\\n  1695→            try:\\n  1696→                response = llm.query(prompt, system=CHARACTER_PROFILE_SYSTEM)\\n  1697→                if response.success:\\n  1698→                    # Clean up any thinking tags or extra formatting\\n  1699→                    content = response.content.strip()\\n  1700→\\n  1701→                    # Try to extract JSON if wrapped in markdown code blocks\\n  1702→                    if \\\"```json\\\" in content:\\n  1703→                        content = content.split(\\\"```json\\\")[1].split(\\\"```\\\")[0].strip()\\n  1704→                    elif \\\"```\\\" in content:\\n  1705→                        content = content.split(\\\"```\\\")[1].split(\\\"```\\\")[0].strip()\\n  1706→\\n  1707→                    try:\\n  1708→                        result = _parse_json_blob(content)\\n  1709→                        if result is None:\\n  1710→                            raise json.JSONDecodeError(\\\"Could not parse JSON\\\", content, 0)\\n  1711→\\n  1712→                        # Check if \\\"profile\\\" field itself contains JSON (double-encoded)\\n  1713→                        profile = result.get(\\\"profile\\\", \\\"\\\")\\n  1714→                        if profile and (profile.startswith(\\\"{\\\") or profile.startswith(\\\"[\\\")):\\n  1715→                            # LLM returned nested JSON - try to parse it\\n  1716→                            logger.warning(\\n  1717→                                f\\\"Character profile for {character.canonical_name} contains nested JSON, attempting to parse\\\"\\n  1718→                            )\\n  1719→                            try:\\n  1720→                                nested = json.loads(profile)\\n  1721→                                if isinstance(nested, dict) and \\\"profile\\\" in nested:\\n  1722→                                    # Double-encoded JSON\\n  1723→                                    profile = nested[\\\"profile\\\"]\\n  1724→                                    logger.info(f\\\"Successfully extracted profile from nested JSON for {character.canonical_name}\\\")\\n  1725→                            except json.JSONDecodeError:\\n  1726→                                # Not valid JSON - try to extract readable text\\n  1727→                                logger.warning(f\\\"Nested JSON parse failed for {character.canonical_name}, extracting text\\\")\\n  1728→                                profile = self._extract_text_from_malformed_json(profile)\\n  1729→                                if not profile:\\n  1730→                                    logger.warning(f\\\"Could not salvage text from malformed profile for {character.canonical_name}\\\")\\n  1731→\\n  1732→                        evidence = result.get(\\\"evidence\\\", [])\\n  1733→                        confidence = float(result.get(\\\"confidence\\\", 0.5))\\n  1734→\\n  1735→                        # Extract structured fields (F8: Simplified Character Output)\\n  1736→                        appearance = result.get(\\\"appearance\\\")\\n  1737→                        personality = result.get(\\\"personality\\\")\\n  1738→                        voice_guidance = result.get(\\\"voice_guidance\\\")\\n  1739→\\n  1740→                        # Debug logging\\n  1741→                        logger.info(\\n  1742→                            f\\\"Profile generation for {character.canonical_name}: \\\"\\n  1743→                            f\\\"keys={list(result.keys())}, \\\"\\n  1744→                            f\\\"appearance={'present' if appearance else 'missing'}, \\\"\\n  1745→                            f\\\"personality={'present' if personality else 'missing'}, \\\"\\n  1746→                            f\\\"voice_guidance={'present' if voice_guidance else 'missing'}\\\"\\n  1747→                        )\\n  1748→\\n  1749→                        # Clean up \\\"unknown\\\" values to maintain consistency\\n  1750→                        def _clean_dict(d):\\n  1751→                            if not isinstance(d, dict):\\n  1752→                                return None\\n  1753→                            # Remove keys with \\\"unknown\\\" values or empty arrays\\n  1754→                            cleaned = {}\\n  1755→                            for k, v in d.items():\\n  1756→                                if v == \\\"unknown\\\" or v == [] or v == \\\"\\\":\\n  1757→                                    continue\\n  1758→                                if isinstance(v, list) and all(x == \\\"unknown\\\" or x == \\\"\\\" for x in v):\\n  1759→                                    continue\\n  1760→                                cleaned[k] = v\\n  1761→                            return cleaned if cleaned else None\\n  1762→\\n  1763→                        appearance = _clean_dict(appearance)\\n  1764→                        personality = _clean_dict(personality)\\n  1765→                        voice_guidance = _clean_dict(voice_guidance)\\n  1766→\\n  1767→                        # Fallback: If LLM didn't provide structured fields, attempt to structure the profile text\\n  1768→                        if not appearance and not personality and not voice_guidance and profile:\\n  1769→                            logger.warning(\\n  1770→                                f\\\"Structured fields missing for {character.canonical_name}, \\\"\\n  1771→                                f\\\"attempting to structure profile text via secondary LLM call\\\"\\n  1772→                            )\\n  1773→                            # Use LLM to structure the existing profile text\\n  1774→                            structuring_prompt = f\\\"\\\"\\\"The following character profile needs to be organized into structured fields.\\n  1775→Extract information into the specified categories. Only use information explicitly present in the profile.\\n  1776→\\n  1777→Profile text:\\n  1778→{profile}\\n  1779→\\n  1780→Return a JSON object with these fields:\\n  1781→{{\\n  1782→  \\\"appearance\\\": {{\\\"summary\\\": \\\"Physical description if mentioned\\\", \\\"age_indication\\\": \\\"age if mentioned\\\", \\\"distinguishing_features\\\": []}},\\n  1783→  \\\"personality\\\": {{\\\"summary\\\": \\\"Personality traits and behavior\\\", \\\"traits\\\": [\\\"trait1\\\", \\\"trait2\\\"], \\\"temperament\\\": \\\"overall temperament\\\"}},\\n  1784→  \\\"voice_guidance\\\": {{\\\"suggested_tone\\\": \\\"tone based on character's manner\\\", \\\"formality_level\\\": \\\"formal/informal/moderate\\\"}}\\n  1785→}}\\n  1786→\\n  1787→If a category has no information in the profile, use \\\"unknown\\\" or [] for that field.\\n  1788→Return ONLY the JSON object.\\\"\\\"\\\"\\n  1789→\\n  1790→                            try:\\n  1791→                                struct_response = llm.query(structuring_prompt, system=\\\"You are a helpful assistant that structures character information.\\\")\\n  1792→                                if struct_response.success:\\n  1793→                                    struct_content = struct_response.content.strip()\\n  1794→                                    if \\\"```json\\\" in struct_content:\\n  1795→                                        struct_content = struct_content.split(\\\"```json\\\")[1].split(\\\"```\\\")[0].strip()\\n  1796→                                    elif \\\"```\\\" in struct_content:\\n  1797→                                        struct_content = struct_content.split(\\\"```\\\")[1].split(\\\"```\\\")[0].strip()\\n  1798→\\n  1799→                                    struct_result = json.loads(struct_content)\\n  1800→                                    appearance = _clean_dict(struct_result.get(\\\"appearance\\\"))\\n  1801→                                    personality = _clean_dict(struct_result.get(\\\"personality\\\"))\\n  1802→                                    voice_guidance = _clean_dict(struct_result.get(\\\"voice_guidance\\\"))\\n  1803→                                    logger.warning(f\\\"Successfully structured profile for {character.canonical_name}\\\")\\n  1804→                            except Exception as e:\\n  1805→                                logger.warning(f\\\"Failed to structure profile for {character.canonical_name}: {e}\\\")\\n  1806→\\n  1807→                        # Validate evidence structure\\n  1808→                        validated_evidence = []\\n  1809→                        for ev in evidence:\\n  1810→                            if isinstance(ev, dict) and \\\"statement\\\" in ev and \\\"quote\\\" in ev:\\n  1811→                                validated_evidence.append({\\n  1812→                                    \\\"statement\\\": ev[\\\"statement\\\"],\\n  1813→                                    \\\"quote\\\": ev[\\\"quote\\\"],\\n  1814→                                    \\\"position\\\": ev.get(\\\"position\\\", 0),\\n  1815→                                    \\\"confidence\\\": \\\"high\\\" if confidence >= 0.7 else \\\"medium\\\" if confidence >= 0.4 else \\\"low\\\"\\