ix:"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":1343,"cache_read_input_tokens":67291,"cache_creation":{"ephemeral_5m_input_tokens":1343,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e997cab0-83eb-433b-9542-1e76bfa619d0","uuid":"6a59c08b-e002-4094-b517-240df68155c3"}
