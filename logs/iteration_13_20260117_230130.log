{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RWxkREHExTjnq5YyK6DSA5","type":"tool_result","content":"     1→\"\"\"\n     2→NER-based character proposer.\n     3→\n     4→Wraps the existing CharacterExtractor from src/analysis/characters.py\n     5→to work as a proposer in the pipeline.\n     6→\"\"\"\n     7→\n     8→import re\n     9→from typing import Optional\n    10→from collections import defaultdict\n    11→import logging\n    12→\n    13→from .base import BaseCharacterProposer\n    14→from ..models import CharacterProposal, CharacterMention, CharacterType\n    15→\n    16→logger = logging.getLogger(__name__)\n    17→\n    18→# Try to import spaCy\n    19→try:\n    20→    import spacy\n    21→    _HAS_SPACY = True\n    22→except ImportError:\n    23→    spacy = None\n    24→    _HAS_SPACY = False\n    25→\n    26→\n    27→# Common false positive names (copied from characters.py for independence)\n    28→FALSE_POSITIVE_NAMES = {\n    29→    'god', 'lord', 'sir', 'madam', 'ma\\'am', 'mr', 'mrs', 'ms', 'miss',\n    30→    'dr', 'doctor', 'professor', 'captain', 'colonel', 'general',\n    31→    'king', 'queen', 'prince', 'princess', 'duke', 'duchess',\n    32→    'dear', 'honey', 'sweetheart', 'darling',\n    33→    'mom', 'dad', 'mother', 'father', 'grandma', 'grandpa',\n    34→    'uncle', 'aunt', 'brother', 'sister', 'son', 'daughter',\n    35→    'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday',\n    36→    'january', 'february', 'march', 'april', 'may', 'june',\n    37→    'july', 'august', 'september', 'october', 'november', 'december',\n    38→    'chapter', 'prologue', 'epilogue', 'part', 'the', 'and', 'but',\n    39→    # Pronouns - should never be extracted as characters\n    40→    'he', 'she', 'it', 'they', 'we', 'i', 'you',\n    41→    'him', 'her', 'them', 'us', 'me',\n    42→}\n    43→\n    44→PLACE_SUFFIXES = {\n    45→    'manor', 'house', 'castle', 'hall', 'park', 'gardens', 'street',\n    46→    'road', 'abbey', 'priory', 'inn', 'hotel', 'cottage', 'estate',\n    47→    'cemetery', 'boulangerie', 'café', 'château', 'salon', 'island',\n    48→    'city', 'town', 'village', 'county', 'state', 'country',\n    49→}\n    50→\n    51→\n    52→class NERProposer(BaseCharacterProposer):\n    53→    \"\"\"\n    54→    Proposes characters using Named Entity Recognition.\n    55→\n    56→    Uses spaCy NER when available, falls back to regex patterns.\n    57→    \"\"\"\n    58→\n    59→    name = \"ner\"\n    60→\n    61→    def __init__(\n    62→        self,\n    63→        spacy_model: str = \"en_core_web_sm\",\n    64→        min_mentions: int = 1,\n    65→        context_window: int = 100,\n    66→    ):\n    67→        \"\"\"\n    68→        Args:\n    69→            spacy_model: spaCy model to use\n    70→            min_mentions: Minimum mentions in chapter to propose\n    71→            context_window: Characters of context around each mention\n    72→        \"\"\"\n    73→        self.min_mentions = min_mentions\n    74→        self.context_window = context_window\n    75→        self.nlp = None\n    76→        self.use_spacy = False\n    77→\n    78→        if _HAS_SPACY:\n    79→            for model_name in [spacy_model, \"en_core_web_sm\", \"en_core_web_md\", \"en_core_web_lg\"]:\n    80→                try:\n    81→                    self.nlp = spacy.load(model_name)\n    82→                    self.use_spacy = True\n    83→                    logger.info(f\"NER proposer using spaCy model: {model_name}\")\n    84→                    break\n    85→                except OSError:\n    86→                    continue\n    87→\n    88→        if not self.use_spacy:\n    89→            logger.warning(\"spaCy not available, NER proposer will use regex fallback\")\n    90→\n    91→    def propose(\n    92→        self,\n    93→        chapter_text: str,\n    94→        chapter_index: int,\n    95→        chapter_start_position: int,\n    96→    ) -> list[CharacterProposal]:\n    97→        \"\"\"Extract character proposals from a chapter using NER.\"\"\"\n    98→        if self.use_spacy:\n    99→            candidates = self._extract_with_spacy(chapter_text, chapter_index, chapter_start_position)\n   100→        else:\n   101→            candidates = self._extract_with_regex(chapter_text, chapter_index, chapter_start_position)\n   102→\n   103→        # Convert candidates to proposals\n   104→        proposals = []\n   105→        for name, mentions in candidates.items():\n   106→            if len(mentions) >= self.min_mentions:\n   107→                # Calculate confidence based on mention count and consistency\n   108→                confidence = min(0.9, 0.5 + len(mentions) * 0.1)\n   109→\n   110→                # Infer character type from context\n   111→                char_type = self._infer_character_type(name, mentions)\n   112→\n   113→                proposals.append(CharacterProposal(\n   114→                    strategy=self.name,\n   115→                    name=name,\n   116→                    mentions=mentions,\n   117→                    confidence=confidence,\n   118→                    chapter_index=chapter_index,\n   119→                    reasoning=f\"Found {len(mentions)} mentions via {'spaCy NER' if self.use_spacy else 'regex patterns'}\",\n   120→                    character_type=char_type,\n   121→                ))\n   122→\n   123→        # Extract first names from full names and create additional proposals\n   124→        # This helps with alias resolution (e.g., \"Jordan\" from \"Jordan Baker\" or \"Miss Jordan Baker\")\n   125→        first_name_proposals = []\n   126→        for proposal in proposals:\n   127→            if ' ' in proposal.name:\n   128→                first_names = self._extract_first_names(proposal.name)\n   129→                for fname in first_names:\n   130→                    # Skip if this first name already exists as a standalone proposal\n   131→                    if any(p.name == fname for p in proposals):\n   132→                        continue\n   133→\n   134→                    # Create new proposals for first name using same mentions as full name\n   135→                    # (consensus stage will merge these appropriately)\n   136→                    first_name_proposals.append(CharacterProposal(\n   137→                        strategy=f\"{self.name}_firstname\",\n   138→                        name=fname,\n   139→                        mentions=proposal.mentions,  # Share mentions with full name\n   140→                        confidence=0.7,  # Lower confidence than full name\n   141→                        chapter_index=chapter_index,\n   142→                        reasoning=f\"First name extracted from '{proposal.name}'\",\n   143→                    ))\n   144→\n   145→        proposals.extend(first_name_proposals)\n   146→        if first_name_proposals:\n   147→            logger.debug(f\"Extracted {len(first_name_proposals)} first-name proposals from full names\")\n   148→\n   149→        return proposals\n   150→\n   151→    def _extract_with_spacy(\n   152→        self,\n   153→        text: str,\n   154→        chapter_index: int,\n   155→        chapter_start: int,\n   156→    ) -> dict[str, list[CharacterMention]]:\n   157→        \"\"\"Extract characters using spaCy NER.\"\"\"\n   158→        candidates = defaultdict(list)\n   159→\n   160→        doc = self.nlp(text)\n   161→\n   162→        for ent in doc.ents:\n   163→            if ent.label_ != \"PERSON\":\n   164→                continue\n   165→\n   166→            # Normalize name\n   167→            name = ' '.join(ent.text.split())\n   168→\n   169→            # Skip false positives\n   170→            if not self._is_valid_name(name):\n   171→                continue\n   172→\n   173→            # Create mention\n   174→            local_pos = ent.start_char\n   175→            global_pos = chapter_start + local_pos\n   176→            context = self._extract_context(text, local_pos, self.context_window)\n   177→            in_dialogue = self._is_in_dialogue(text, local_pos)\n   178→\n   179→            mention = CharacterMention(\n   180→                text=name,\n   181→                position=global_pos,\n   182→                chapter_index=chapter_index,\n   183→                context=context,\n   184→                in_dialogue=in_dialogue,\n   185→            )\n   186→\n   187→            # Use normalized name as key\n   188→            normalized = self._normalize_name(name)\n   189→            candidates[name].append(mention)  # Keep original case for display\n   190→\n   191→        return dict(candidates)\n   192→\n   193→    def _extract_with_regex(\n   194→        self,\n   195→        text: str,\n   196→        chapter_index: int,\n   197→        chapter_start: int,\n   198→    ) -> dict[str, list[CharacterMention]]:\n   199→        \"\"\"Extract characters using regex patterns (fallback).\"\"\"\n   200→        candidates = defaultdict(list)\n   201→\n   202→        patterns = [\n   203→            # Title + Name\n   204→            r'\\b((?:Mr|Mrs|Ms|Miss|Dr|Sir|Lady|Lord)\\.?\\s+[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)?)\\b',\n   205→            # Full name (two capitalized words, not at sentence start)\n   206→            r'(?<=[a-z]\\s)([A-Z][a-z]+\\s+[A-Z][a-z]+)\\b',\n   207→            # Name in dialogue tag\n   208→            r'[,\"\"]\\s*said\\s+([A-Z][a-z]+)',\n   209→            r'[,\"\"]\\s*asked\\s+([A-Z][a-z]+)',\n   210→            r'[,\"\"]\\s*replied\\s+([A-Z][a-z]+)',\n   211→        ]\n   212→\n   213→        for pattern in patterns:\n   214→            for match in re.finditer(pattern, text):\n   215→                name = match.group(1).strip()\n   216→\n   217→                if not self._is_valid_name(name):\n   218→                    continue\n   219→\n   220→                local_pos = match.start(1)\n   221→                global_pos = chapter_start + local_pos\n   222→                context = self._extract_context(text, local_pos, self.context_window)\n   223→                in_dialogue = self._is_in_dialogue(text, local_pos)\n   224→\n   225→                mention = CharacterMention(\n   226→                    text=name,\n   227→                    position=global_pos,\n   228→                    chapter_index=chapter_index,\n   229→                    context=context,\n   230→                    in_dialogue=in_dialogue,\n   231→                )\n   232→\n   233→                candidates[name].append(mention)\n   234→\n   235→        return dict(candidates)\n   236→\n   237→    def _is_valid_name(self, name: str) -> bool:\n   238→        \"\"\"Check if a name is valid (not a false positive).\"\"\"\n   239→        if len(name) < 2:\n   240→            return False\n   241→\n   242→        # Check against false positives\n   243→        name_lower = name.lower()\n   244→        if name_lower in FALSE_POSITIVE_NAMES:\n   245→            return False\n   246→\n   247→        # Check for place suffixes\n   248→        words = name_lower.split()\n   249→        if words and words[-1] in PLACE_SUFFIXES:\n   250→            return False\n   251→\n   252→        # Check that it's mostly alphabetic\n   253→        alpha_count = sum(1 for c in name if c.isalpha())\n   254→        if alpha_count < len(name) * 0.5:\n   255→            return False\n   256→\n   257→        return True\n   258→\n   259→    def _normalize_name(self, name: str) -> str:\n   260→        \"\"\"Normalize a name for comparison.\"\"\"\n   261→        name = name.lower()\n   262→        name = re.sub(r'^(mr|mrs|ms|miss|dr|sir|lady|lord)\\s*\\.?\\s*', '', name)\n   263→        name = ' '.join(name.split())\n   264→        return name\n   265→\n   266→    def _extract_first_names(self, full_name: str) -> list[str]:\n   267→        \"\"\"\n   268→        Extract standalone first name from full name.\n   269→\n   270→        Examples:\n   271→        - \"Jordan Baker\" → [\"Jordan\"]\n   272→        - \"Miss Jordan Baker\" → [\"Jordan\"]\n   273→        - \"Jay Gatsby\" → [\"Jay\"]\n   274→        - \"Mr. Nick Carraway\" → [\"Nick\"]\n   275→        \"\"\"\n   276→        # Remove titles\n   277→        titles = ['mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord', 'professor']\n   278→        words = full_name.lower().split()\n   279→\n   280→        # Filter out title words\n   281→        name_words = [w for w in words if w.rstrip('.') not in titles]\n   282→\n   283→        # If multi-word name, first word is likely first name\n   284→        if len(name_words) >= 2:\n   285→            return [name_words[0].capitalize()]\n   286→\n   287→        return []\n   288→\n   289→    def _infer_character_type(\n   290→        self,\n   291→        name: str,\n   292→        mentions: list[CharacterMention],\n   293→    ) -> CharacterType:\n   294→        \"\"\"\n   295→        Infer character type based on context patterns.\n   296→\n   297→        Characters with dialogue or action verb associations are likely STORY characters.\n   298→        Returns UNCERTAIN when there's insufficient evidence.\n   299→        \"\"\"\n   300→        story_signals = 0\n   301→        action_verbs = {\n   302→            'said', 'asked', 'replied', 'answered', 'whispered', 'shouted',\n   303→            'looked', 'walked', 'turned', 'smiled', 'laughed', 'nodded',\n   304→            'sat', 'stood', 'ran', 'came', 'went', 'told', 'thought',\n   305→            'felt', 'knew', 'saw', 'heard', 'took', 'put', 'gave',\n   306→        }\n   307→\n   308→        for mention in mentions[:10]:  # Check first 10 mentions for efficiency\n   309→            # Dialogue is strong signal for story character\n   310→            if mention.in_dialogue:\n   311→                story_signals += 2\n   312→\n   313→            # Check for action verbs in context\n   314→            if mention.context:\n   315→                context_lower = mention.context.lower()\n   316→                for verb in action_verbs:\n   317→                    if verb in context_lower:\n   318→                        story_signals += 1\n   319→                        break  # Only count once per mention\n   320→\n   321→        # Strong evidence threshold\n   322→        if story_signals >= 3:\n   323→            return CharacterType.STORY\n   324→\n   325→        # Any dialogue is a good indicator\n   326→        if any(m.in_dialogue for m in mentions):\n   327→            return CharacterType.STORY\n   328→\n   329→        # Not enough evidence\n   330→        return CharacterType.UNCERTAIN\n   331→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"4d22d227-e441-4958-ab08-fc52b629bcf5","uuid":"de6f4003-1aba-4b14-adc9-afb4b43981a7","tool_use_result":{"type":"text","file":{"filePath":"/home/zacharymandrews/Tools/audiobook_agent/src/pipeline/character_extraction/proposers/ner.py","content":"\"\"\"\nNER-based character proposer.\n\nWraps the existing CharacterExtractor from src/analysis/characters.py\nto work as a proposer in the pipeline.\n\"\"\"\n\nimport re\nfrom typing import Optional\nfrom collections import defaultdict\nimport logging\n\nfrom .base import BaseCharacterProposer\nfrom ..models import CharacterProposal, CharacterMention, CharacterType\n\nlogger = logging.getLogger(__name__)\n\n# Try to import spaCy\ntry:\n    import spacy\n    _HAS_SPACY = True\nexcept ImportError:\n    spacy = None\n    _HAS_SPACY = False\n\n\n# Common false positive names (copied from characters.py for independence)\nFALSE_POSITIVE_NAMES = {\n    'god', 'lord', 'sir', 'madam', 'ma\\'am', 'mr', 'mrs', 'ms', 'miss',\n    'dr', 'doctor', 'professor', 'captain', 'colonel', 'general',\n    'king', 'queen', 'prince', 'princess', 'duke', 'duchess',\n    'dear', 'honey', 'sweetheart', 'darling',\n    'mom', 'dad', 'mother', 'father', 'grandma', 'grandpa',\n    'uncle', 'aunt', 'brother', 'sister', 'son', 'daughter',\n    'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday',\n    'january', 'february', 'march', 'april', 'may', 'june',\n    'july', 'august', 'september', 'october', 'november', 'december',\n    'chapter', 'prologue', 'epilogue', 'part', 'the', 'and', 'but',\n    # Pronouns - should never be extracted as characters\n    'he', 'she', 'it', 'they', 'we', 'i', 'you',\n    'him', 'her', 'them', 'us', 'me',\n}\n\nPLACE_SUFFIXES = {\n    'manor', 'house', 'castle', 'hall', 'park', 'gardens', 'street',\n    'road', 'abbey', 'priory', 'inn', 'hotel', 'cottage', 'estate',\n    'cemetery', 'boulangerie', 'café', 'château', 'salon', 'island',\n    'city', 'town', 'village', 'county', 'state', 'country',\n}\n\n\nclass NERProposer(BaseCharacterProposer):\n    \"\"\"\n    Proposes characters using Named Entity Recognition.\n\n    Uses spaCy NER when available, falls back to regex patterns.\n    \"\"\"\n\n    name = \"ner\"\n\n    def __init__(\n        self,\n        spacy_model: str = \"en_core_web_sm\",\n        min_mentions: int = 1,\n        context_window: int = 100,\n    ):\n        \"\"\"\n        Args:\n            spacy_model: spaCy model to use\n            min_mentions: Minimum mentions in chapter to propose\n            context_window: Characters of context around each mention\n        \"\"\"\n        self.min_mentions = min_mentions\n        self.context_window = context_window\n        self.nlp = None\n        self.use_spacy = False\n\n        if _HAS_SPACY:\n            for model_name in [spacy_model, \"en_core_web_sm\", \"en_core_web_md\", \"en_core_web_lg\"]:\n                try:\n                    self.nlp = spacy.load(model_name)\n                    self.use_spacy = True\n                    logger.info(f\"NER proposer using spaCy model: {model_name}\")\n                    break\n                except OSError:\n                    continue\n\n        if not self.use_spacy:\n            logger.warning(\"spaCy not available, NER proposer will use regex fallback\")\n\n    def propose(\n        self,\n        chapter_text: str,\n        chapter_index: int,\n        chapter_start_position: int,\n    ) -> list[CharacterProposal]:\n        \"\"\"Extract character proposals from a chapter using NER.\"\"\"\n        if self.use_spacy:\n            candidates = self._extract_with_spacy(chapter_text, chapter_index, chapter_start_position)\n        else:\n            candidates = self._extract_with_regex(chapter_text, chapter_index, chapter_start_position)\n\n        # Convert candidates to proposals\n        proposals = []\n        for name, mentions in candidates.items():\n            if len(mentions) >= self.min_mentions:\n                # Calculate confidence based on mention count and consistency\n                confidence = min(0.9, 0.5 + len(mentions) * 0.1)\n\n                # Infer character type from context\n                char_type = self._infer_character_type(name, mentions)\n\n                proposals.append(CharacterProposal(\n                    strategy=self.name,\n                    name=name,\n                    mentions=mentions,\n                    confidence=confidence,\n                    chapter_index=chapter_index,\n                    reasoning=f\"Found {len(mentions)} mentions via {'spaCy NER' if self.use_spacy else 'regex patterns'}\",\n                    character_type=char_type,\n                ))\n\n        # Extract first names from full names and create additional proposals\n        # This helps with alias resolution (e.g., \"Jordan\" from \"Jordan Baker\" or \"Miss Jordan Baker\")\n        first_name_proposals = []\n        for proposal in proposals:\n            if ' ' in proposal.name:\n                first_names = self._extract_first_names(proposal.name)\n                for fname in first_names:\n                    # Skip if this first name already exists as a standalone proposal\n                    if any(p.name == fname for p in proposals):\n                        continue\n\n                    # Create new proposals for first name using same mentions as full name\n                    # (consensus stage will merge these appropriately)\n                    first_name_proposals.append(CharacterProposal(\n                        strategy=f\"{self.name}_firstname\",\n                        name=fname,\n                        mentions=proposal.mentions,  # Share mentions with full name\n                        confidence=0.7,  # Lower confidence than full name\n                        chapter_index=chapter_index,\n                        reasoning=f\"First name extracted from '{proposal.name}'\",\n                    ))\n\n        proposals.extend(first_name_proposals)\n        if first_name_proposals:\n            logger.debug(f\"Extracted {len(first_name_proposals)} first-name proposals from full names\")\n\n        return proposals\n\n    def _extract_with_spacy(\n        self,\n        text: str,\n        chapter_index: int,\n        chapter_start: int,\n    ) -> dict[str, list[CharacterMention]]:\n        \"\"\"Extract characters using spaCy NER.\"\"\"\n        candidates = defaultdict(list)\n\n        doc = self.nlp(text)\n\n        for ent in doc.ents:\n            if ent.label_ != \"PERSON\":\n                continue\n\n            # Normalize name\n            name = ' '.join(ent.text.split())\n\n            # Skip false positives\n            if not self._is_valid_name(name):\n                continue\n\n            # Create mention\n            local_pos = ent.start_char\n            global_pos = chapter_start + local_pos\n            context = self._extract_context(text, local_pos, self.context_window)\n            in_dialogue = self._is_in_dialogue(text, local_pos)\n\n            mention = CharacterMention(\n                text=name,\n                position=global_pos,\n                chapter_index=chapter_index,\n                context=context,\n                in_dialogue=in_dialogue,\n            )\n\n            # Use normalized name as key\n            normalized = self._normalize_name(name)\n            candidates[name].append(mention)  # Keep original case for display\n\n        return dict(candidates)\n\n    def _extract_with_regex(\n        self,\n        text: str,\n        chapter_index: int,\n        chapter_start: int,\n    ) -> dict[str, list[CharacterMention]]:\n        \"\"\"Extract characters using regex patterns (fallback).\"\"\"\n        candidates = defaultdict(list)\n\n        patterns = [\n            # Title + Name\n            r'\\b((?:Mr|Mrs|Ms|Miss|Dr|Sir|Lady|Lord)\\.?\\s+[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)?)\\b',\n            # Full name (two capitalized words, not at sentence start)\n            r'(?<=[a-z]\\s)([A-Z][a-z]+\\s+[A-Z][a-z]+)\\b',\n            # Name in dialogue tag\n            r'[,\"\"]\\s*said\\s+([A-Z][a-z]+)',\n            r'[,\"\"]\\s*asked\\s+([A-Z][a-z]+)',\n            r'[,\"\"]\\s*replied\\s+([A-Z][a-z]+)',\n        ]\n\n        for pattern in patterns:\n            for match in re.finditer(pattern, text):\n                name = match.group(1).strip()\n\n                if not self._is_valid_name(name):\n                    continue\n\n                local_pos = match.start(1)\n                global_pos = chapter_start + local_pos\n                context = self._extract_context(text, local_pos, self.context_window)\n                in_dialogue = self._is_in_dialogue(text, local_pos)\n\n                mention = CharacterMention(\n                    text=name,\n                    position=global_pos,\n                    chapter_index=chapter_index,\n                    context=context,\n                    in_dialogue=in_dialogue,\n                )\n\n                candidates[name].append(mention)\n\n        return dict(candidates)\n\n    def _is_valid_name(self, name: str) -> bool:\n        \"\"\"Check if a name is valid (not a false positive).\"\"\"\n        if len(name) < 2:\n            return False\n\n        # Check against false positives\n        name_lower = name.lower()\n        if name_lower in FALSE_POSITIVE_NAMES:\n            return False\n\n        # Check for place suffixes\n        words = name_lower.split()\n        if words and words[-1] in PLACE_SUFFIXES:\n            return False\n\n        # Check that it's mostly alphabetic\n        alpha_count = sum(1 for c in name if c.isalpha())\n        if alpha_count < len(name) * 0.5:\n            return False\n\n        return True\n\n    def _normalize_name(self, name: str) -> str:\n        \"\"\"Normalize a name for comparison.\"\"\"\n        name = name.lower()\n        name = re.sub(r'^(mr|mrs|ms|miss|dr|sir|lady|lord)\\s*\\.?\\s*', '', name)\n        name = ' '.join(name.split())\n        return name\n\n    def _extract_first_names(self, full_name: str) -> list[str]:\n        \"\"\"\n        Extract standalone first name from full name.\n\n        Examples:\n        - \"Jordan Baker\" → [\"Jordan\"]\n        - \"Miss Jordan Baker\" → [\"Jordan\"]\n        - \"Jay Gatsby\" → [\"Jay\"]\n        - \"Mr. Nick Carraway\" → [\"Nick\"]\n        \"\"\"\n        # Remove titles\n        titles = ['mr', 'mrs', 'ms', 'miss', 'dr', 'sir', 'lady', 'lord', 'professor']\n        words = full_name.lower().split()\n\n        # Filter out title words\n        name_words = [w for w in words if w.rstrip('.') not in titles]\n\n        # If multi-word name, first word is likely first name\n        if len(name_words) >= 2:\n            return [name_words[0].capitalize()]\n\n        return []\n\n    def _infer_character_type(\n        self,\n        name: str,\n        mentions: list[CharacterMention],\n    ) -> CharacterType:\n        \"\"\"\n        Infer character type based on context patterns.\n\n        Characters with dialogue or action verb associations are likely STORY characters.\n        Returns UNCERTAIN when there's insufficient evidence.\n        \"\"\"\n        story_signals = 0\n        action_verbs = {\n            'said', 'asked', 'replied', 'answered', 'whispered', 'shouted',\n            'looked', 'walked', 'turned', 'smiled', 'laughed', 'nodded',\n            'sat', 'stood', 'ran', 'came', 'went', 'told', 'thought',\n            'felt', 'knew', 'saw', 'heard', 'took', 'put', 'gave',\n        }\n\n        for mention in mentions[:10]:  # Check first 10 mentions for efficiency\n            # Dialogue is strong signal for story character\n            if mention.in_dialogue:\n                story_signals += 2\n\n            # Check for action verbs in context\n            if mention.context:\n                context_lower = mention.context.lower()\n                for verb in action_verbs:\n                    if verb in context_lower:\n                        story_signals += 1\n                        break  # Only count once per mention\n\n        # Strong evidence threshold\n        if story_signals >= 3:\n            return CharacterType.STORY\n\n        # Any dialogue is a good indicator\n        if any(m.in_dialogue for m in mentions):\n            return CharacterType.STORY\n\n        # Not enough evidence\n        return CharacterType.UNCERTAIN\n","numLines":331,"startLine":1,"totalLines":331}}}
