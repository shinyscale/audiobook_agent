      },
      {
        "phase": 3,
        "name": "Update Exports and Create Shims",
        "risk": "Low",
        "tasks": [
          {
            "id": "3.1",
            "action": "MODIFY",
            "file": "src/llm/__init__.py",
            "description": "Update with complete exports from all new submodules",
            "exports": [
              "LLMClient", "LLMConfig", "LLMResponse", "create_client",
              "LLMProvider", "DEFAULT_URLS", "get_default_url", "detect_available_models", "detect_context_length", "test_connection",
              "CONTEXT_PERCENT", "ModelConfig", "RECOMMENDED_MODELS", "get_model_for_hardware", "get_default_model",
              "pull_ollama_model", "delete_ollama_model", "get_ollama_model_info",
              "PromptConfig", "DEFAULT_PROMPTS",
              "LLMAnalysisError", "ChapterDetectionError", "CharacterProfileError", "ChapterSummaryError", "PronunciationFilterError", "CharacterMergeError", "RelationshipExtractionError"
            ],
            "status": "pending"
