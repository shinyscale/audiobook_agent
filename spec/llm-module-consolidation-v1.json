{
  "metadata": {
    "title": "LLM Module Consolidation",
    "version": "1.0",
    "status": "Ready for Implementation",
    "priority": "Medium",
    "target": "Technical debt reduction and code maintainability"
  },
  "executive_summary": "The codebase has two LLM modules with overlapping functionality: src/llm/ (legacy, 4 files, ~2,700 LOC) and src/pipeline/llm.py (modern, 1 file, 520 LOC). This duplication creates confusion about which module to use, potential import conflicts, and maintenance burden. Solution: Consolidate to a single src/llm/ module that combines the clean API from pipeline/llm.py with the useful utilities from the legacy module, while deprecating redundant code.",
  "problem_statement": {
    "current_state": {
      "legacy_module": {
        "path": "src/llm/",
        "files": 4,
        "lines_of_code": 2700,
        "purpose": "config, refiner, prompts, exceptions"
      },
      "modern_module": {
        "path": "src/pipeline/llm.py",
        "files": 1,
        "lines_of_code": 520,
        "purpose": "clean LLMClient API"
      }
    },
    "duplication_analysis": {
      "overlapping_features": [
        {
          "feature": "Provider enum",
          "legacy": "LLMProvider in config.py",
          "modern": "Literal type in LLMConfig"
        },
        {
          "feature": "Configuration class",
          "legacy": "ModelConfig (hardware-focused)",
          "modern": "LLMConfig (API-focused)"
        },
        {
          "feature": "API calls",
          "legacy": "LLMRefiner._query()",
          "modern": "LLMClient.query()"
        },
        {
          "feature": "JSON parsing",
          "legacy": "In refiner.py",
          "modern": "LLMClient.query_json()"
        },
        {
          "feature": "Connection testing",
          "legacy": "test_connection()",
          "modern": "LLMClient.test_connection()"
        },
        {
          "feature": "Thinking tag cleanup",
          "legacy": "Not present",
          "modern": "_clean_thinking_tags()"
        }
      ],
      "unique_to_legacy": [
        "config.py: Model recommendations, VRAM calculations, Ollama model management",
        "prompts.py: Prompt templates (PromptConfig, DEFAULT_PROMPTS)",
        "exceptions.py: Custom exceptions",
        "refiner.py: Legacy batch refinement methods (UNUSED)"
      ],
      "unique_to_modern": [
        "Clean LLMClient class with lazy initialization",
        "LLMResponse dataclass with token tracking",
        "Thinking tag cleanup for reasoning models",
        "JSON repair utilities",
        "Health check functionality",
        "Metrics integration"
      ]
    },
    "current_usage": {
      "pipeline_llm_py": {
        "status": "PRIMARY API",
        "used_by": [
          "src/pipeline/chapter_detection/ (5 files)",
          "src/pipeline/character_extraction/ (4 files)",
          "src/pipeline/character_profiling/ (9 files)",
          "src/pipeline/chapter_summary/ (2 files)",
          "src/pipeline/pronunciation_guide/ (2 files)",
          "src/pipeline/overview/ (1 file)",
          "src/agents/ (4 files)",
          "src/analyzer.py (1 file)",
          "tests/ (3 files)"
        ],
        "total_importers": 27
      },
      "src_llm": {
        "status": "LIMITED USAGE",
        "used_by": [
          "src/gui/desktop.py - imports config.py and prompts.py",
          "src/analyzer.py - imports prompts.py for PromptConfig"
        ]
      }
    },
    "problems": [
      "Confusion: Developers don't know which module to use",
      "Inconsistency: Two different ways to make LLM calls",
      "Maintenance burden: Bug fixes may need to be applied in two places",
      "Import complexity: from ..llm could resolve to either module",
      "Dead code: refiner.py (1,654 LOC) is completely unused"
    ]
  },
  "target_architecture": {
    "structure": {
      "src/llm/__init__.py": "Public API exports",
      "src/llm/client.py": "LLMClient, LLMConfig, LLMResponse, create_client (from pipeline/llm.py)",
      "src/llm/providers.py": "LLMProvider enum, DEFAULT_URLS, detect_available_models, detect_context_length, test_connection",
      "src/llm/models.py": "CONTEXT_PERCENT, ModelConfig, RECOMMENDED_MODELS, get_model_for_hardware, get_default_model",
      "src/llm/ollama.py": "pull_ollama_model, delete_ollama_model, get_ollama_model_info",
      "src/llm/prompts.py": "PromptConfig, DEFAULT_PROMPTS (unchanged)",
      "src/llm/exceptions.py": "Custom exceptions (unchanged)"
    },
    "benefits": [
      "Single source of truth for LLM interactions",
      "Clear separation of concerns (client, providers, models, ollama, prompts)",
      "Consistent import paths",
      "No dead code",
      "~1,654 LOC removed"
    ]
  },
  "implementation": {
    "phases": [
      {
        "phase": 1,
        "name": "Delete Unused Code",
